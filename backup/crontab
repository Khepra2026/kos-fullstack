# ═══════════════════════════════════════════════════════════════
# KOS BACKUP CRON — Planification
# DB-002 + RES-001 : pg_dump quotidien + test restauration trimestriel
# ═══════════════════════════════════════════════════════════════

# Backup quotidien à 02:00 GMT
0 2 * * * /backup/backup.sh >> /backup/backup.log 2>&1

# Test de restauration trimestriel (1er Jan, Avr, Jul, Oct à 03:00 GMT)
0 3 1 1,4,7,10 * /backup/test-restore.sh >> /backup/restore-test.log 2>&1

# Nettoyage des backups > 30 jours chaque dimanche à 04:00 GMT
0 4 * * 0 find /backup/dumps -name "*.sql.gz" -mtime +30 -delete