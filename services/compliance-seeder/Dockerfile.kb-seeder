# ═══════════════════════════════════════════════════════════════
# KOS KB DOCS SEEDER v1.0 — Seed BCEAO PDFs + Big Four Best Practices
# Python psycopg2 + PyMuPDF — 100% Local — 0 API Externe
# ═══════════════════════════════════════════════════════════════
FROM python:3.12-slim

LABEL kos.layer="compliance"
LABEL kos.criticality="AAAA"
LABEL kos.version="1.0"
LABEL kos.audit="ISAE3402"

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

ENV TZ=GMT
RUN cp /usr/share/zoneinfo/GMT /etc/localtime && echo "GMT" > /etc/timezone

COPY requirements-py.txt .
RUN pip install --no-cache-dir -r requirements-py.txt

COPY seed_kb_docs.py .

RUN mkdir -p /app/data /var/log/kos-kb-seeder

ENV DATA_DIR=/app/data
ENV LOG_DIR=/var/log/kos-kb-seeder
ENV EMBEDDER_URL=http://kos-embedder:8001
ENV BCEAO_PDF_DIR=/app/data/bceao_pdf
ENV BATCH_SIZE=50

HEALTHCHECK --interval=60s --timeout=15s --start-period=30s --retries=3 \
    CMD pgrep -f "python.*seed_kb_docs" > /dev/null || exit 1

CMD ["python", "seed_kb_docs.py", "--run-once"]