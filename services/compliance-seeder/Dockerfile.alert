FROM node:20-alpine
WORKDIR /app
COPY package*.json ./
RUN npm ci --only=production
COPY alert-config.js kos-alert-worker.js ./
RUN mkdir -p /var/log/kos-alert /app/data
HEALTHCHECK --interval=60s --timeout=10s --retries=3 CMD wget --spider -q http://localhost:3200/health || exit 1
EXPOSE 3200
CMD ["node", "kos-alert-worker.js"]