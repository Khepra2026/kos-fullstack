# ═══════════════════════════════════════════════════════════════
# KOS MEMORY SEEDER + VALIDATOR v5.3 — Python Edition
# Playwright + Chromium headless — Crawl hebdo BCEAO/COBAC/OHADA
# Contrôle 4 Yeux Big Four L1-L4 post-seed
# Big Four compliant — ISAE 3402 audit trail
# ═══════════════════════════════════════════════════════════════
FROM mcr.microsoft.com/playwright/python:v1.44.0-jammy

LABEL kos.layer="compliance"
LABEL kos.criticality="AAAA"
LABEL kos.version="5.3"
LABEL kos.audit="ISAE3402"

WORKDIR /app

# Installer les dépendances système pour cron et timezone
RUN apt-get update && apt-get install -y --no-install-recommends \
    cron \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# Timezone GMT pour alignement cron
ENV TZ=GMT
RUN cp /usr/share/zoneinfo/GMT /etc/localtime && echo "GMT" > /etc/timezone

# Dépendances Python
COPY requirements-py.txt .
RUN pip install --no-cache-dir -r requirements-py.txt \
    && playwright install chromium \
    && playwright install-deps chromium

# Scripts — Seeder v5.1 + Validator v5.3
COPY seed_kos_memory.py .
COPY kos_validate.py .

# Créer les dossiers de données et logs
RUN mkdir -p /app/data /var/log/kos-memory-seeder

# Variables d'environnement par défaut
ENV DATA_DIR=/app/data
ENV LOG_DIR=/var/log/kos-memory-seeder
ENV REDIS_URL=redis://redis-audit:6379
ENV RUN_ONCE=false

# Health check: vérifier que le processus tourne
HEALTHCHECK --interval=60s --timeout=15s --start-period=120s --retries=3 \
    CMD pgrep -f "python.*seed_kos_memory" > /dev/null || exit 1

# Lancement en mode cron continu (seed lundi 02:00 GMT + validate lundi 03:00 GMT)
CMD ["python", "seed_kos_memory.py"]