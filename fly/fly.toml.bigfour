
app = "kos-khepraexperts"
primary_region = "cdg"
[build]
  dockerfile = "Dockerfile"

[env]
  PORT = "8080"
  NODE_ENV = "production"

[http_service]
  internal_port = 8080
  force_https = true
  auto_stop_machines = "off"
  auto_start_machines = true
  min_machines_running = 1
  processes = ["app"]

  [[http_service.checks]]
    interval = "15s"
    timeout = "3s"
    grace_period = "20s"
    method = "GET"
    path = "/healthz"
    protocol = "http"

[[services]]
  internal_port = 8080
  protocol = "tcp"
  [[services.http_checks]]
    interval = "10s"
    timeout = "2s"
    grace_period = "15s"
    method = "GET"
    path = "/ready"
    protocol = "http"

[checks]
  [checks.liveness]
    port = 8080
    type = "http"
    interval = "15s"
    timeout = "3s"
    method = "GET"
    path = "/healthz"
  [checks.readiness]
    port = 8080
    type = "http"
    interval = "10s"
    timeout = "2s"
    method = "GET"
    path = "/ready"
