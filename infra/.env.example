# KOS v3 — Infrastructure Environment
# Copy this file to .env and fill in your values

# ═══════════════════════════════════════════
# HuggingFace
# ═══════════════════════════════════════════
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ═══════════════════════════════════════════
# vLLM — Llama-3.1-70B KHEPRA
# ═══════════════════════════════════════════
VLLM_API_KEY=kos-vllm-secret-key-change-me

# ═══════════════════════════════════════════
# Ollama — BGE-M3 + Reranker
# ═══════════════════════════════════════════
OLLAMA_API_KEY=kos-ollama-secret-key-change-me

# ═══════════════════════════════════════════
# n8n — PostgreSQL (instance dédiée, pas Supabase)
# ═══════════════════════════════════════════
N8N_POSTGRES_HOST=postgres-n8n
N8N_POSTGRES_PORT=5432
N8N_POSTGRES_DB=n8n
N8N_POSTGRES_USER=n8n
N8N_POSTGRES_PASSWORD=change-me-strong-password
N8N_ENCRYPTION_KEY=change-me-32-char-random-key
N8N_WEBHOOK_URL=https://kos.khepraexperts.com/n8n/
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-admin-password

# ═══════════════════════════════════════════
# Supabase (Edge Functions → DB)
# ═══════════════════════════════════════════
SUPABASE_URL=https://pgfwhahiwqvqeahpirjx.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ═══════════════════════════════════════════
# Domaines
# ═══════════════════════════════════════════
VLLM_HOST=https://vllm.kos.khepraexperts.com
OLLAMA_HOST=https://ollama.kos.khepraexperts.com
N8N_HOST=https://n8n.kos.khepraexperts.com