# Cloudflare Pages _headers - Big Four Compliant
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https: blob:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://api.khepraexperts.com https://kos.khepraexperts.com https://*.supabase.co; frame-ancestors 'none'
  Cross-Origin-Opener-Policy: same-origin
  X-Robots-Tag: noindex

/.well-known/security.txt
  Content-Type: text/plain
  Cache-Control: public, max-age=3600
