import { useState, useMemo } from 'react';
import { useKOSIntelligentOrchestrator } from '@/hooks/useKOSIntelligentOrchestrator';

const CATEGORY_LABELS: Record<TaskCategory, { label: string; icon: string; description: string }> = {
  content_generation: { label: 'Contenu', icon: 'ri-article-line', description: 'kosData.Articles, blogs, scripts, newsletters' },
  seo_audit: { label: 'SEO/Audit', icon: 'ri-search-eye-line', description: 'Audit SEO, conformité' },
  regulatory_analysis: { label: 'Régulation', icon: 'ri-scales-3-line', description: 'BCEAO, COBAC, OHADA, ESG' },
  social_media: { label: 'Réseaux Sociaux', icon: 'ri-share-line', description: 'LinkedIn, X, YouTube' },
  report_generation: { label: 'Rapports', icon: 'ri-file-text-line', description: 'PDF, PowerPoint, Excel' },
  ui_design: { label: 'Design UI', icon: 'ri-paint-brush-line', description: 'Interfaces, dashboards' },
  code_generation: { label: 'Code', icon: 'ri-code-s-slash-line', description: 'React, animations' },
  data_analysis: { label: 'kosData.Data', icon: 'ri-bar-chart-2-line', description: 'KYC, veille, scoring' },
  workflow_automation: { label: 'Workflow', icon: 'ri-git-branch-line', description: 'Automatisation, prompts' },
  quality_scoring: { label: 'Qualité', icon: 'ri-shield-star-line', description: 'Scoring Big Four' },
  link_verification: { label: 'Liens', icon: 'ri-link', description: 'URLs, OG tags' },
  prompt_engineering: { label: 'Prompts', icon: 'ri-brain-line', description: 'Génération, optimisation' },
};

const STATUS_BADGES: Record<ExecutionStatus, { bg: string; text: string; label: string }> = {
  queued: { bg: 'bg-amber-50', text: 'text-amber-700', label: 'En file' },
  dispatched: { bg: 'bg-sky-50', text: 'text-sky-700', label: 'Dispatché' },
  in_progress: { bg: 'bg-violet-50', text: 'text-violet-700', label: 'En cours' },
  completed: { bg: 'bg-emerald-50', text: 'text-emerald-700', label: 'Terminé' },
  failed: { bg: 'bg-red-50', text: 'text-red-700', label: 'Échoué' },
  blocked: { bg: 'bg-gray-50', text: 'text-gray-500', label: 'Bloqué' },
};

const DECISION_BADGES: Record<string, { bg: string; text: string; label: string; icon: string }> = {
  kos_internal: { bg: 'bg-emerald-50', text: 'text-emerald-700', label: 'KOS Local', icon: 'ri-cpu-line' },
  readdy_ai: { bg: 'bg-amber-50', text: 'text-amber-700', label: 'Readdy AI', icon: 'ri-external-link-line' },
  supabase: { bg: 'bg-primary-50', text: 'text-primary-700', label: 'Supabase', icon: 'ri-database-2-line' },
  manual: { bg: 'bg-red-50', text: 'text-red-700', label: 'Manuel', icon: 'ri-user-line' },
  shopify: { bg: 'bg-secondary-50', text: 'text-secondary-700', label: 'Shopify', icon: 'ri-shopping-bag-line' },
  stripe: { bg: 'bg-violet-50', text: 'text-violet-700', label: 'Stripe', icon: 'ri-bank-card-line' },
};

function formatFCFA(amount: number): string {
  return amount.toLocaleString('fr-FR') + ' FCFA';
}

function formatDuration(ms: number): string {
  if (ms < 1000) return `${ms}ms`;
  return `${(ms / 1000).toFixed(1)}s`;
}

export default function IntelligentOrchestratorPanel() {
  const [kosData, setKosData] = useState<any>(null);
  useEffect(() => {
    fetch('/mocks/kos-blog.json').then(r => r.json()).then(setKosData);
  }, []);
  if (!kosData) return null;

  const orchestrator = useKOSIntelligentOrchestrator();
  const {
    kpis,
    recentTasks,
    costLog,
    internalRate,
    externalRate,
    totalCostSaved,
    avoidedCalls,
    costReductionRate,
    internalTasks,
    externalTasks,
    recentAvoidedCalls,
    recentExternalCalls,
    orchestratorHealth,
    categoryStats,
    allAgents,
    agentsByDomain,
    runArbitration,
    toggleProductionMode,
    getAgentsForCategory,
    arbitrating,
    lastArbitration,
    lastMemoryConsult,
    productionMode,
    supabaseConnected,
    supabaseStatus,
    config,
    authorizedUseCases,
    decisionThreshold,
  } = orchestrator;

  const [activeSection, setActiveSection] = useState<'overview' | 'arbitration' | 'agents-catalog' | 'execution' | 'cost-guardian' | 'memory' | 'config'>('overview');
  const [simulationTask, setSimulationTask] = useState('');
  const [simulationCategory, setSimulationCategory] = useState<TaskCategory>('content_generation');
  const [selectedDomain, setSelectedDomain] = useState<string | null>(null);
  const [executionFilter, setExecutionFilter] = useState<ExecutionStatus | 'all'>('all');

  const handleSimulate = async () => {
    if (!simulationTask.trim()) return;
    await runArbitration(simulationTask.trim(), simulationCategory);
  };

  const targetInternalRate = config.internal_execution_target;
  const targetCostReduction = config.cost_reduction_target;

  const filteredTasks = executionFilter === 'all'
    ? recentTasks
    : recentTasks.filter(t => t.execution_status === executionFilter);

  return (
    <div className="space-y-6">
      {/* Production Mode Banner */}
      <div className={`rounded-2xl p-5 border ${
        productionMode
          ? 'bg-gradient-to-r from-emerald-500/10 via-emerald-500/5 to-background-50 border-emerald-500/20'
          : 'bg-gradient-to-r from-amber-500/10 via-amber-500/5 to-background-50 border-amber-500/20'
      }`}>
        <div className="flex flex-col lg:flex-row items-start lg:items-center gap-6">
          <div className="flex items-center gap-4">
            <div className="relative">
              <svg className="w-16 h-16 transform -rotate-90" viewBox="0 0 64 64">
                <circle cx="32" cy="32" r="28" fill="none" stroke="currentColor" strokeWidth="5" className="text-background-200" />
                <circle
                  cx="32" cy="32" r="28" fill="none" strokeWidth="5"
                  strokeLinecap="round"
                  stroke="currentColor"
                  className={productionMode ? 'text-emerald-500' : 'text-amber-500'}
                  strokeDasharray={`${(orchestratorHealth / 100) * 176} 176`}
                />
              </svg>
              <span className={`absolute inset-0 flex items-center justify-center text-lg font-bold font-heading ${productionMode ? 'text-emerald-700' : 'text-amber-700'}`}>
                {orchestratorHealth}
              </span>
            </div>
            <div>
              <div className="flex items-center gap-2 flex-wrap">
                <span className={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-bold ${
                  productionMode
                    ? 'bg-emerald-500/15 text-emerald-600'
                    : 'bg-amber-500/15 text-amber-600'
                }`}>
                  <span className={`w-1.5 h-1.5 rounded-full animate-pulse ${productionMode ? 'bg-emerald-500' : 'bg-amber-500'}`} />
                  {productionMode ? 'PRODUCTION' : 'SIMULATION'}
                </span>
                {supabaseStatus === 'connected' && (
                  <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-600 text-[10px] font-bold">
                    <span className="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse" />
                    Supabase LIVE
                  </span>
                )}
              </div>
              <h2 className="font-heading text-xl font-bold text-foreground-950">KOS Intelligent Orchestrator™ v2.0</h2>
              <p className="text-xs text-foreground-500 mt-0.5">
                {productionMode
                  ? 'Mode Production — Dispatch réel vers 75 agents KOS · Persistance Supabase'
                  : 'Mode Simulation — Démonstration du moteur d\'arbitrage'}
              </p>
            </div>
          </div>

          {/* Toggle Production Mode */}
          <button
            onClick={toggleProductionMode}
            className={`flex items-center gap-2 px-5 py-3 rounded-xl font-bold text-sm cursor-pointer transition-all whitespace-nowrap ${
              productionMode
                ? 'bg-emerald-600 text-white hover:bg-emerald-700'
                : 'bg-amber-500 text-white hover:bg-amber-600'
            }`}
          >
            <i className={`${productionMode ? 'ri-toggle-line' : 'ri-toggle-fill'} text-lg`} />
            {productionMode ? 'Mode PRODUCTION Actif' : 'Passer en PRODUCTION'}
          </button>

          {/* KPI Summary */}
          <div className="flex-1 grid grid-cols-2 sm:grid-cols-4 gap-3">
            {[
              { label: 'Taux Interne', value: `${internalRate}%`, target: `≥ ${targetInternalRate}%`, icon: 'ri-cpu-line', ok: internalRate >= targetInternalRate },
              { label: 'Réduction Externe', value: `${costReductionRate}%`, target: `≥ ${targetCostReduction}%`, icon: 'ri-money-dollar-circle-line', ok: costReductionRate >= targetCostReduction },
              { label: 'Agents Dispatchés', value: String(kpis.agents_dispatched), target: '75 disponibles', icon: 'ri-robot-2-line', ok: true },
              { label: 'Tâches Complétées', value: String(kpis.tasks_completed), target: `${kpis.total_requests} total`, icon: 'ri-check-double-line', ok: kpis.tasks_failed === 0 },
            ].map((stat) => (
              <div key={stat.label} className="rounded-xl bg-white/80 backdrop-blur-sm p-3">
                <div className="flex items-center gap-1.5 mb-1">
                  <i className={`${stat.icon} text-xs ${stat.ok ? 'text-emerald-500' : 'text-red-500'}`} />
                  <span className="text-[10px] text-foreground-400 uppercase tracking-wider">{stat.label}</span>
                </div>
                <span className="text-lg font-bold font-heading text-foreground-950">{stat.value}</span>
                <span className="block text-[10px] text-foreground-400 mt-0.5">{stat.target}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      {/* Section Navigation */}
      <div className="flex gap-1 overflow-x-auto">
        {[
          { id: 'overview', label: 'Vue d\'Ensemble', icon: 'ri-dashboard-line', badge: String(kpis.total_requests) },
          { id: 'arbitration', label: 'Arbitrage', icon: 'ri-scales-line', badge: 'LIVE' },
          { id: 'agents-catalog', label: 'Agents KOS', icon: 'ri-robot-2-line', badge: String(allAgents.length) },
          { id: 'execution', label: 'Exécution', icon: 'ri-play-list-line', badge: String(recentTasks.length) },
          { id: 'cost-guardian', label: 'Cost Guardian', icon: 'ri-shield-flash-line', badge: formatFCFA(totalCostSaved) },
          { id: 'memory', label: 'Mémoire', icon: 'ri-book-open-line', badge: '8' },
          { id: 'config', label: 'Config', icon: 'ri-settings-3-line', badge: productionMode ? 'PROD' : 'SIM' },
        ].map((tab) => (
          <button
            key={tab.id}
            onClick={() => setActiveSection(tab.id as typeof activeSection)}
            className={`flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-bold cursor-pointer transition-all whitespace-nowrap ${
              activeSection === tab.id
                ? 'bg-foreground-950 text-background-50'
                : 'text-foreground-600 hover:bg-background-100 hover:text-foreground-900'
            }`}
          >
            <i className={`${tab.icon} text-base`} />
            {tab.label}
            <span className={`text-[10px] px-1.5 py-0.5 rounded-full ${activeSection === tab.id ? 'bg-white/20' : 'bg-background-200'}`}>
              {tab.badge}
            </span>
          </button>
        ))}
      </div>

      {/* SECTION: Vue d'Ensemble */}
      {activeSection === 'overview' && (
        <div className="space-y-6">
          {/* KPIs Principaux */}
          <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
            {[
              { label: 'Requêtes Totales', value: kpis.total_requests, icon: 'ri-global-line', color: '#0A66C2' },
              { label: 'Exécutions KOS', value: kpis.internal_count, icon: 'ri-cpu-line', color: '#059669' },
              { label: 'Agents Dispatchés', value: kpis.agents_dispatched, icon: 'ri-robot-2-line', color: '#7C3AED' },
              { label: 'Appels Évités', value: avoidedCalls, icon: 'ri-close-circle-line', color: '#DC2626' },
              { label: 'Coût Économisé', value: formatFCFA(totalCostSaved), icon: 'ri-money-dollar-circle-line', color: '#059669' },
              { label: 'Tâches Complétées', value: kpis.tasks_completed, icon: 'ri-check-double-line', color: '#059669' },
              { label: 'Mode', value: productionMode ? 'PRODUCTION' : 'SIMULATION', icon: productionMode ? 'ri-toggle-fill' : 'ri-toggle-line', color: productionMode ? '#059669' : '#D97706' },
              { label: 'Supabase', value: supabaseStatus === 'connected' ? 'Connecté' : 'Déconnecté', icon: 'ri-database-2-line', color: supabaseStatus === 'connected' ? '#059669' : '#DC2626' },
            ].map((kpi) => (
              <div key={kpi.label} className="rounded-xl bg-white border border-background-200 p-4">
                <div className="flex items-center gap-2 mb-2">
                  <div className="w-8 h-8 rounded-lg flex items-center justify-center" style={{ backgroundColor: `${kpi.color}15` }}>
                    <i className={`${kpi.icon} text-sm`} style={{ color: kpi.color }} />
                  </div>
                  <span className="text-xs text-foreground-400">{kpi.label}</span>
                </div>
                <span className="text-xl font-bold font-heading text-foreground-950">{kpi.value}</span>
              </div>
            ))}
          </div>

          {/* Barre de Progression Objectifs */}
          <div className="rounded-2xl bg-white border border-background-200 p-5">
            <h3 className="font-heading text-lg font-bold text-foreground-950 mb-4">Objectifs Stratégiques — {productionMode ? 'Production' : 'Simulation'}</h3>
            <div className="space-y-4">
              {[
                { label: 'Exécution Interne', current: internalRate, target: targetInternalRate, color: 'bg-emerald-500' },
                { label: 'Réduction Crédits Externes', current: costReductionRate, target: targetCostReduction, color: 'bg-amber-500' },
                { label: 'Qualité Big Four', current: kpis.quality_average, target: config.quality_target, color: 'bg-violet-500' },
                { label: 'Conformité', current: kpis.compliance_average, target: config.compliance_target, color: 'bg-primary-500' },
              ].map((obj) => (
                <div key={obj.label}>
                  <div className="flex items-center justify-between mb-1.5">
                    <span className="text-sm font-semibold text-foreground-700">{obj.label}</span>
                    <span className="text-xs font-bold text-foreground-500">
                      {obj.current}% / {obj.target}%
                      {obj.current >= obj.target && <i className="ri-check-line text-emerald-500 ml-1" />}
                    </span>
                  </div>
                  <div className="h-2.5 rounded-full bg-background-100 overflow-hidden">
                    <div className={`h-full rounded-full ${obj.color} transition-all duration-500`} style={{ width: `${Math.min(100, obj.current)}%` }} />
                  </div>
                </div>
              ))}
            </div>
          </div>

          {/* Dernières Tâches */}
          <div className="rounded-2xl bg-white border border-background-200 overflow-hidden">
            <div className="px-5 py-3 border-b border-background-100 flex items-center justify-between">
              <h3 className="font-heading font-bold text-foreground-950">Dernières Décisions d'Arbitrage</h3>
              <span className="text-xs text-foreground-400">{recentTasks.length} tâches</span>
            </div>
            <div className="divide-y divide-background-100 max-h-[420px] overflow-y-auto">
              {recentTasks.slice(0, 12).map((task) => {
                const badge = DECISION_BADGES[task.decision] || DECISION_BADGES.manual;
                const cat = CATEGORY_LABELS[task.category] || CATEGORY_LABELS.content_generation;
                const sBadge = STATUS_BADGES[task.execution_status] || STATUS_BADGES.blocked;
                return (
                  <div key={task.task_id} className="px-5 py-3 hover:bg-background-50/50 transition-colors">
                    <div className="flex items-start gap-3">
                      <div className="w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0" style={{ backgroundColor: task.decision === 'kos_internal' ? '#05966915' : '#D9770615' }}>
                        <i className={`${cat.icon} text-sm ${task.decision === 'kos_internal' ? 'text-emerald-600' : 'text-amber-600'}`} />
                      </div>
                      <div className="flex-1 min-w-0">
                        <div className="flex items-center gap-2 flex-wrap">
                          <span className="text-sm font-semibold text-foreground-900 truncate">{task.task_description}</span>
                          <span className={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold ${badge.bg} ${badge.text}`}>
                            <i className={`${badge.icon} text-[10px]`} />
                            {badge.label}
                          </span>
                          <span className={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold ${sBadge.bg} ${sBadge.text}`}>
                            {sBadge.label}
                          </span>
                        </div>
                        {task.assigned_agent_name && (
                          <div className="flex items-center gap-2 mt-1">
                            <i className="ri-robot-line text-[10px] text-violet-500" />
                            <span className="text-xs text-violet-600 font-semibold">{task.assigned_agent_name}</span>
                          </div>
                        )}
                        <div className="flex items-center gap-3 mt-1">
                          <span className="text-xs text-foreground-400">{cat.label}</span>
                          <span className="text-xs font-bold text-foreground-500">Score {task.decision_score}/100</span>
                          {task.cost_avoided_fcfa > 0 && (
                            <span className="text-xs font-bold text-emerald-600">{formatFCFA(task.cost_avoided_fcfa)} évité</span>
                          )}
                          <span className="text-xs text-foreground-300">{formatDuration(task.duration_ms)}</span>
                        </div>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      )}

      {/* SECTION: Arbitrage */}
      {activeSection === 'arbitration' && (
        <div className="space-y-6">
          <div className="rounded-2xl bg-white border border-background-200 p-5">
            <h3 className="font-heading text-lg font-bold text-foreground-950 mb-1">
              {productionMode ? 'Dispatch en Production' : 'Simulateur d\'Arbitrage'}
            </h3>
            <p className="text-xs text-foreground-500 mb-4">
              {productionMode
                ? `Mode PRODUCTION actif — les tâches sont dispatchées vers les agents KOS réels et persistées dans Supabase. Score ≥ ${decisionThreshold} = exécution KOS locale.`
                : `Testez le moteur d'arbitrage avec une tâche. Score ≥ ${decisionThreshold} = exécution KOS locale.`}
            </p>

            <div className="space-y-4">
              <div>
                <label className="block text-xs font-bold text-foreground-500 mb-1.5">Description de la tâche</label>
                <textarea
                  value={simulationTask}
                  onChange={(e) => setSimulationTask(e.target.value)}
                  placeholder="Ex: Rédaction article blog sur la réforme du ratio de solvabilité UEMOA..."
                  className="w-full rounded-xl border border-background-200 bg-background-50 px-4 py-2.5 text-sm text-foreground-900 placeholder:text-foreground-300 focus:outline-none focus:ring-2 focus:ring-emerald-400/50 focus:border-emerald-400/50 resize-none h-20"
                  rows={2}
                />
              </div>
              <div className="flex flex-col sm:flex-row gap-3">
                <div className="flex-1">
                  <label className="block text-xs font-bold text-foreground-500 mb-1.5">Catégorie</label>
                  <select
                    value={simulationCategory}
                    onChange={(e) => setSimulationCategory(e.target.value as TaskCategory)}
                    className="w-full rounded-xl border border-background-200 bg-background-50 px-4 py-2.5 text-sm text-foreground-900 focus:outline-none focus:ring-2 focus:ring-emerald-400/50"
                  >
                    {Object.entries(CATEGORY_LABELS).map(([key, val]) => (
                      <option key={key} value={key}>{val.label} — {val.description}</option>
                    ))}
                  </select>
                </div>
                <button
                  onClick={handleSimulate}
                  disabled={arbitrating || !simulationTask.trim()}
                  className={`flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-sm transition-colors cursor-pointer whitespace-nowrap disabled:opacity-50 disabled:cursor-not-allowed self-end ${
                    productionMode
                      ? 'bg-emerald-600 text-white hover:bg-emerald-700'
                      : 'bg-foreground-950 text-white hover:bg-foreground-800'
                  }`}
                >
                  {arbitrating ? (
                    <>
                      <i className="ri-loader-4-line animate-spin" />
                      {productionMode ? 'Dispatch...' : 'Analyse...'}
                    </>
                  ) : (
                    <>
                      <i className={productionMode ? 'ri-send-plane-line' : 'ri-scales-line'} />
                      {productionMode ? 'Dispatcher' : 'Arbitrer'}
                    </>
                  )}
                </button>
              </div>
            </div>

            {/* Résultat du dernier arbitrage */}
            {lastArbitration && (
              <div className={`mt-5 p-4 rounded-xl border ${lastArbitration.decision === 'kos_internal' ? 'bg-emerald-50 border-emerald-200' : 'bg-amber-50 border-amber-200'}`}>
                <div className="flex items-center gap-2 mb-2">
                  <i className={`${lastArbitration.decision === 'kos_internal' ? 'ri-check-double-line text-emerald-600' : 'ri-alert-line text-amber-600'} text-lg`} />
                  <span className={`text-sm font-bold ${lastArbitration.decision === 'kos_internal' ? 'text-emerald-700' : 'text-amber-700'}`}>
                    {lastArbitration.decision === 'kos_internal' ? 'EXÉCUTÉ DANS KOS' : 'ESCALADE EXTERNE'}
                  </span>
                  <span className="text-xs text-foreground-400 ml-auto">Score {lastArbitration.decision_score}/100</span>
                </div>
                {lastArbitration.assigned_agent_name && (
                  <div className="flex items-center gap-2 mb-2">
                    <i className="ri-robot-line text-violet-500 text-sm" />
                    <span className="text-sm font-semibold text-violet-700">Agent : {lastArbitration.assigned_agent_name}</span>
                    <span className={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold ${STATUS_BADGES[lastArbitration.execution_status].bg} ${STATUS_BADGES[lastArbitration.execution_status].text}`}>
                      {STATUS_BADGES[lastArbitration.execution_status].label}
                    </span>
                    {lastArbitration.execution_log_id && (
                      <span className="text-[10px] text-emerald-600 font-bold">
                        <i className="ri-database-2-line mr-0.5" />Supabase LIVE
                      </span>
                    )}
                  </div>
                )}
                <p className="text-sm text-foreground-600">{lastArbitration.reasoning}</p>
                <div className="grid grid-cols-4 gap-2 mt-3">
                  {[
                    { label: 'Capacité', value: `${lastArbitration.internal_capability}%`, weight: '40%' },
                    { label: 'Coût évité', value: formatFCFA(lastArbitration.external_cost), weight: '30%' },
                    { label: 'Impact', value: `${lastArbitration.business_impact}%`, weight: '20%' },
                    { label: 'Réutilisabilité', value: `${lastArbitration.reusability}%`, weight: '10%' },
                  ].map((dim) => (
                    <div key={dim.label} className="rounded-lg bg-white/60 p-2 text-center">
                      <span className="block text-[10px] text-foreground-400">{dim.label} ({dim.weight})</span>
                      <span className="text-sm font-bold font-heading text-foreground-950">{dim.value}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>

          {/* Matrice des Capacités */}
          <div className="rounded-2xl bg-white border border-background-200 overflow-hidden">
            <div className="px-5 py-3 border-b border-background-100">
              <h3 className="font-heading font-bold text-foreground-950">Matrice de Capacités KOS</h3>
            </div>
            <div className="divide-y divide-background-100 max-h-[400px] overflow-y-auto">
              {categoryStats.map((cat) => {
                const label = CATEGORY_LABELS[cat.key] || { label: cat.key, icon: 'ri-question-line', description: '' };
                const isInternal = cat.capability >= 80;
                return (
                  <div key={cat.key} className="px-5 py-3 flex items-center gap-3 hover:bg-background-50/50">
                    <div className={`w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0 ${isInternal ? 'bg-emerald-100' : 'bg-amber-100'}`}>
                      <i className={`${label.icon} text-sm ${isInternal ? 'text-emerald-600' : 'text-amber-600'}`} />
                    </div>
                    <div className="flex-1 min-w-0">
                      <span className="text-sm font-semibold text-foreground-900">{label.label}</span>
                      <span className="text-xs text-foreground-400 block">{label.description} · {cat.agentCount} agents</span>
                    </div>
                    <div className="text-right">
                      <span className={`text-lg font-bold font-heading ${isInternal ? 'text-emerald-600' : 'text-amber-600'}`}>{cat.capability}%</span>
                    </div>
                    <div className="w-20">
                      <div className="h-2 rounded-full bg-background-100 overflow-hidden">
                        <div className={`h-full rounded-full ${isInternal ? 'bg-emerald-500' : 'bg-amber-500'}`} style={{ width: `${cat.capability}%` }} />
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      )}

      {/* SECTION: Catalogue Agents KOS */}
      {activeSection === 'agents-catalog' && (
        <div className="space-y-6">
          {/* Stats Agents */}
          <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
            {[
              { label: 'Agents Catalogués', value: String(allAgents.length), icon: 'ri-robot-2-line', color: '#7C3AED' },
              { label: 'Domaines', value: String(Object.keys(agentsByDomain).length), icon: 'ri-stack-line', color: '#0A66C2' },
              { label: 'Taux Succès Moyen', value: `${Math.round(allAgents.reduce((s, a) => s + a.success_rate, 0) / allAgents.length)}%`, icon: 'ri-check-double-line', color: '#059669' },
              { label: 'Latence Moyenne', value: `${Math.round(allAgents.reduce((s, a) => s + a.avg_latency_ms, 0) / allAgents.length)}ms`, icon: 'ri-timer-line', color: '#D97706' },
            ].map((kpi) => (
              <div key={kpi.label} className="rounded-xl bg-white border border-background-200 p-4">
                <div className="flex items-center gap-2 mb-2">
                  <div className="w-8 h-8 rounded-lg flex items-center justify-center" style={{ backgroundColor: `${kpi.color}15` }}>
                    <i className={`${kpi.icon} text-sm`} style={{ color: kpi.color }} />
                  </div>
                  <span className="text-xs text-foreground-400">{kpi.label}</span>
                </div>
                <span className="text-xl font-bold font-heading text-foreground-950">{kpi.value}</span>
              </div>
            ))}
          </div>

          {/* Domain Filter */}
          <div className="flex gap-1 overflow-x-auto">
            <button
              onClick={() => setSelectedDomain(null)}
              className={`px-3 py-1.5 rounded-full text-xs font-bold cursor-pointer whitespace-nowrap transition-all ${
                !selectedDomain ? 'bg-foreground-950 text-background-50' : 'bg-background-100 text-foreground-600 hover:bg-background-200'
              }`}
            >
              Tous ({allAgents.length})
            </button>
            {Object.entries(agentsByDomain).map(([domain, agents]) => (
              <button
                key={domain}
                onClick={() => setSelectedDomain(domain)}
                className={`px-3 py-1.5 rounded-full text-xs font-bold cursor-pointer whitespace-nowrap transition-all ${
                  selectedDomain === domain ? 'bg-foreground-950 text-background-50' : 'bg-background-100 text-foreground-600 hover:bg-background-200'
                }`}
              >
                {domain} ({agents.length})
              </button>
            ))}
          </div>

          {/* Agents par Domaine */}
          <div className="space-y-4">
            {Object.entries(agentsByDomain)
              .filter(([domain]) => !selectedDomain || domain === selectedDomain)
              .map(([domain, agents]) => (
                <div key={domain} className="rounded-2xl bg-white border border-background-200 overflow-hidden">
                  <div className="px-5 py-3 border-b border-background-100 bg-background-50">
                    <h3 className="font-heading font-bold text-foreground-950">{domain} · {agents.length} agents</h3>
                  </div>
                  <div className="divide-y divide-background-100 max-h-[500px] overflow-y-auto">
                    {agents.map((agent) => (
                      <div key={agent.agent_id} className="px-5 py-3 hover:bg-background-50/50 transition-colors">
                        <div className="flex items-start gap-3">
                          <div className="w-8 h-8 rounded-lg bg-violet-100 flex items-center justify-center flex-shrink-0">
                            <i className="ri-robot-line text-violet-600 text-sm" />
                          </div>
                          <div className="flex-1 min-w-0">
                            <div className="flex items-center gap-2 flex-wrap">
                              <span className="text-sm font-semibold text-foreground-900">{agent.agent_name}</span>
                              <span className={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold ${
                                agent.status === 'active' ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700'
                              }`}>
                                <span className={`w-1.5 h-1.5 rounded-full ${agent.status === 'active' ? 'bg-emerald-500' : 'bg-amber-500'}`} />
                                {agent.status === 'active' ? 'Actif' : agent.status}
                              </span>
                              <span className="text-[10px] text-foreground-400">{agent.capability_score}% capable</span>
                            </div>
                            <div className="flex items-center gap-3 mt-1">
                              <span className="text-xs text-foreground-400">{agent.total_tasks.toLocaleString()} tâches</span>
                              <span className="text-xs text-emerald-600 font-semibold">{agent.success_rate}% succès</span>
                              <span className="text-xs text-foreground-400">{agent.avg_latency_ms}ms moy.</span>
                              {agent.last_dispatch && (
                                <span className="text-xs text-foreground-300">Dernier: {new Date(agent.last_dispatch).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' })}</span>
                              )}
                            </div>
                          </div>
                          <div className="w-16">
                            <div className="h-1.5 rounded-full bg-background-100 overflow-hidden">
                              <div className="h-full rounded-full bg-violet-500" style={{ width: `${agent.capability_score}%` }} />
                            </div>
                          </div>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              ))}
          </div>
        </div>
      )}

      {/* SECTION: File d'Exécution */}
      {activeSection === 'execution' && (
        <div className="space-y-6">
          {/* Stats Exécution */}
          <div className="grid grid-cols-2 md:grid-cols-5 gap-3">
            {[
              { label: 'Total', value: recentTasks.length, color: '#0A66C2' },
              { label: 'Complétées', value: recentTasks.filter(t => t.execution_status === 'completed').length, color: '#059669' },
              { label: 'Dispatchées', value: recentTasks.filter(t => t.execution_status === 'dispatched').length, color: '#7C3AED' },
              { label: 'En Cours', value: recentTasks.filter(t => t.execution_status === 'in_progress').length, color: '#D97706' },
              { label: 'Échouées', value: recentTasks.filter(t => t.execution_status === 'failed').length, color: '#DC2626' },
            ].map((s) => (
              <div key={s.label} className="rounded-xl bg-white border border-background-200 p-3 text-center">
                <span className="block text-[10px] text-foreground-400 mb-1">{s.label}</span>
                <span className="text-xl font-bold font-heading" style={{ color: s.color }}>{s.value}</span>
              </div>
            ))}
          </div>

          {/* Filter */}
          <div className="flex gap-1 overflow-x-auto">
            {(['all', 'completed', 'dispatched', 'in_progress', 'failed', 'blocked'] as const).map((f) => (
              <button
                key={f}
                onClick={() => setExecutionFilter(f)}
                className={`px-3 py-1.5 rounded-full text-xs font-bold cursor-pointer whitespace-nowrap transition-all ${
                  executionFilter === f ? 'bg-foreground-950 text-background-50' : 'bg-background-100 text-foreground-600 hover:bg-background-200'
                }`}
              >
                {f === 'all' ? 'Tous' : STATUS_BADGES[f]?.label || f}
              </button>
            ))}
          </div>

          {/* Execution Log */}
          <div className="rounded-2xl bg-white border border-background-200 overflow-hidden">
            <div className="divide-y divide-background-100 max-h-[500px] overflow-y-auto">
              {filteredTasks.length === 0 && (
                <div className="px-5 py-8 text-center text-foreground-400 text-sm">
                  <i className="ri-inbox-line text-2xl block mb-2" />
                  Aucune tâche ne correspond au filtre
                </div>
              )}
              {filteredTasks.map((task) => {
                const badge = DECISION_BADGES[task.decision] || DECISION_BADGES.manual;
                const sBadge = STATUS_BADGES[task.execution_status] || STATUS_BADGES.blocked;
                return (
                  <div key={task.task_id} className={`px-5 py-3 hover:bg-background-50/50 transition-colors ${
                    task.execution_status === 'completed' ? 'border-l-4 border-l-emerald-500' :
                    task.execution_status === 'failed' ? 'border-l-4 border-l-red-500' :
                    task.execution_status === 'in_progress' ? 'border-l-4 border-l-violet-500' :
                    ''
                  }`}>
                    <div className="flex items-start gap-3">
                      <i className={`${task.execution_status === 'completed' ? 'ri-check-double-line text-emerald-600' :
                        task.execution_status === 'failed' ? 'ri-close-circle-line text-red-600' :
                        task.execution_status === 'in_progress' ? 'ri-loader-4-line text-violet-600 animate-spin' :
                        task.execution_status === 'dispatched' ? 'ri-send-plane-line text-sky-600' :
                        'ri-time-line text-foreground-400'} text-lg flex-shrink-0 mt-0.5`} />
                      <div className="flex-1 min-w-0">
                        <div className="flex items-center gap-2 flex-wrap">
                          <span className="text-sm font-semibold text-foreground-900 truncate">{task.task_description}</span>
                          <span className={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold ${badge.bg} ${badge.text}`}>
                            {badge.label}
                          </span>
                          <span className={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold ${sBadge.bg} ${sBadge.text}`}>
                            {sBadge.label}
                          </span>
                        </div>
                        {task.assigned_agent_name && (
                          <div className="flex items-center gap-1 mt-1">
                            <i className="ri-robot-line text-[10px] text-violet-500" />
                            <span className="text-xs text-violet-600 font-semibold">{task.assigned_agent_name}</span>
                          </div>
                        )}
                        <div className="flex items-center gap-3 mt-1">
                          <span className="text-xs text-foreground-400">Score {task.decision_score}/100</span>
                          {task.cost_avoided_fcfa > 0 && (
                            <span className="text-xs font-bold text-emerald-600">{formatFCFA(task.cost_avoided_fcfa)} évité</span>
                          )}
                          <span className="text-xs text-foreground-300">{formatDuration(task.duration_ms)}</span>
                        </div>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      )}

      {/* SECTION: Cost Guardian */}
      {activeSection === 'cost-guardian' && (
        <div className="space-y-6">
          {/* Résumé */}
          <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
            {[
              { label: 'Coût Total Économisé', value: formatFCFA(totalCostSaved), icon: 'ri-money-dollar-circle-line', color: '#059669' },
              { label: 'Appels Externes Évités', value: String(avoidedCalls), icon: 'ri-shield-check-line', color: '#059669' },
              { label: 'Taux Réduction', value: `${costReductionRate}%`, icon: 'ri-arrow-down-line', color: costReductionRate >= targetCostReduction ? '#059669' : '#D97706' },
              { label: 'Statut Supabase', value: supabaseStatus === 'connected' ? 'LIVE' : 'Offline', icon: 'ri-database-2-line', color: supabaseStatus === 'connected' ? '#059669' : '#DC2626' },
            ].map((card) => (
              <div key={card.label} className="rounded-xl bg-white border border-background-200 p-4">
                <div className="flex items-center gap-2 mb-2">
                  <div className="w-8 h-8 rounded-lg flex items-center justify-center" style={{ backgroundColor: `${card.color}15` }}>
                    <i className={`${card.icon} text-sm`} style={{ color: card.color }} />
                  </div>
                  <span className="text-xs text-foreground-400">{card.label}</span>
                </div>
                <span className="text-xl font-bold font-heading text-foreground-950">{card.value}</span>
              </div>
            ))}
          </div>

          {/* Journal */}
          <div className="rounded-2xl bg-white border border-background-200 overflow-hidden">
            <div className="px-5 py-3 border-b border-background-100 flex items-center justify-between">
              <h3 className="font-heading font-bold text-foreground-950">Journal Cost Guardian™</h3>
              <span className="text-xs text-foreground-400">
                {recentAvoidedCalls.length} évités · {recentExternalCalls.length} escaladés
              </span>
            </div>
            <div className="divide-y divide-background-100 max-h-[500px] overflow-y-auto">
              {costLog.map((entry) => (
                <div key={entry.call_id} className={`px-5 py-3 hover:bg-background-50/50 ${entry.avoided ? 'border-l-4 border-l-emerald-500' : 'border-l-4 border-l-amber-500'}`}>
                  <div className="flex items-start gap-3">
                    <div className={`w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0 ${entry.avoided ? 'bg-emerald-100' : 'bg-amber-100'}`}>
                      <i className={`${entry.avoided ? 'ri-close-circle-line text-emerald-600' : 'ri-external-link-line text-amber-600'} text-sm`} />
                    </div>
                    <div className="flex-1 min-w-0">
                      <div className="flex items-center gap-2 flex-wrap">
                        <span className={`text-xs font-bold ${entry.avoided ? 'text-emerald-600' : 'text-amber-600'}`}>
                          {entry.avoided ? 'BLOQUÉ' : 'ESCALADÉ'}
                        </span>
                        <span className="text-sm text-foreground-700 truncate">{entry.endpoint}</span>
                        {entry.task_id && (
                          <span className="text-[10px] text-foreground-400">{entry.task_id}</span>
                        )}
                      </div>
                      <p className="text-xs text-foreground-400 mt-0.5">{entry.reason}</p>
                      <div className="flex items-center gap-3 mt-1.5">
                        <span className="text-xs text-foreground-500">
                          {entry.avoided
                            ? `Coût évité : ${formatFCFA(entry.estimated_cost_fcfa)}`
                            : `Coût : ${formatFCFA(entry.actual_cost_fcfa || entry.estimated_cost_fcfa)}`
                          }
                        </span>
                        {!entry.avoided && (
                          <span className="text-xs text-violet-600 font-semibold">ROI {entry.roi_estimate}%</span>
                        )}
                        {productionMode && entry.avoided && (
                          <span className="text-[10px] text-emerald-600 font-bold">
                            <i className="ri-database-2-line mr-0.5" />
                            Supabase LIVE
                          </span>
                        )}
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      )}

      {/* SECTION: Mémoire */}
      {activeSection === 'memory' && (
        <div className="space-y-6">
          <div className="rounded-2xl bg-white border border-background-200 p-5">
            <h3 className="font-heading text-lg font-bold text-foreground-950 mb-1">Mémoire Organisationnelle KHEPRA</h3>
            <p className="text-xs text-foreground-500 mb-4">Sources de connaissance consultées automatiquement avant toute génération externe.</p>
            <div className="space-y-3">
              {[
                { name: 'Base documentaire KHEPRA', docs: 150, cat: 'Gouvernance' },
                { name: 'Référentiels BCEAO', docs: 52, cat: 'Régulation' },
                { name: 'Référentiels COBAC', docs: 38, cat: 'Régulation' },
                { name: 'Référentiels OHADA', docs: 45, cat: 'Régulation' },
                { name: 'Bibliothèque KOS', docs: 2500, cat: 'Interne' },
                { name: 'kosData.Articles Blog KHEPRA', docs: 100, cat: 'Contenu' },
                { name: 'RAG Documents (Supabase)', docs: 52, cat: 'RAG' },
                { name: 'Knowledge Graph', docs: 2847, cat: 'Connaissance' },
              ].map((source) => (
                <div key={source.name} className="flex items-center gap-3 p-3 rounded-xl bg-background-50 border border-background-200">
                  <div className="w-10 h-10 rounded-lg bg-primary-100 flex items-center justify-center flex-shrink-0">
                    <i className="ri-book-open-line text-primary-600" />
                  </div>
                  <div className="flex-1 min-w-0">
                    <span className="text-sm font-semibold text-foreground-900">{source.name}</span>
                  </div>
                  <div className="text-right flex-shrink-0">
                    <span className="block text-lg font-bold font-heading text-foreground-950">{source.docs.toLocaleString()}</span>
                    <span className="text-[10px] text-foreground-400">{source.cat}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
          {lastMemoryConsult && (
            <div className={`rounded-2xl p-5 border ${lastMemoryConsult.consulted ? 'bg-emerald-50 border-emerald-200' : 'bg-amber-50 border-amber-200'}`}>
              <h4 className="font-heading font-bold text-foreground-950 mb-2">Dernière Consultation</h4>
              <div className="space-y-2 text-sm">
                <p className="text-foreground-600">
                  <i className={`${lastMemoryConsult.consulted ? 'ri-check-line text-emerald-600' : 'ri-close-line text-amber-600'} mr-1.5`} />
                  {lastMemoryConsult.consulted ? `${lastMemoryConsult.sources_found.length} source(s) consultée(s)` : 'Aucune source'}
                </p>
                {lastMemoryConsult.consulted && (
                  <p className="text-foreground-600">
                    <i className="ri-file-text-line mr-1.5" />
                    {lastMemoryConsult.document_count.toLocaleString()} documents pertinents
                  </p>
                )}
              </div>
            </div>
          )}
        </div>
      )}

      {/* SECTION: Configuration */}
      {activeSection === 'config' && (
        <div className="space-y-6">
          <div className="rounded-2xl bg-white border border-background-200 p-5">
            <h3 className="font-heading text-lg font-bold text-foreground-950 mb-4">Configuration Orchestrateur v2.0</h3>
            <div className="space-y-4">
              <div className={`p-4 rounded-xl border ${productionMode ? 'bg-emerald-50 border-emerald-200' : 'bg-amber-50 border-amber-200'}`}>
                <h4 className="text-sm font-bold text-foreground-950 mb-2">
                  <i className={`${productionMode ? 'ri-toggle-fill text-emerald-600' : 'ri-toggle-line text-amber-600'} mr-1.5`} />
                  Mode Opératoire : {productionMode ? 'PRODUCTION' : 'SIMULATION'}
                </h4>
                <p className="text-sm text-foreground-600">
                  {productionMode
                    ? 'Dispatch réel vers les 75 agents KOS. Persistance dans Supabase kos_execution_logs. Cost Guardian LIVE. Catalogue agents actif.'
                    : 'Simulation du moteur d\'arbitrage. Pas de persistance. Démonstration.'}
                </p>
              </div>
              <div className="p-4 rounded-xl bg-background-50 border border-background-200">
                <h4 className="text-sm font-bold text-foreground-950 mb-2">
                  <i className="ri-scales-line mr-1.5 text-amber-600" />
                  Seuil d'Arbitrage : {decisionThreshold}/100
                </h4>
                <p className="text-sm text-foreground-600">
                  Score ≥ {decisionThreshold} → Dispatch vers agent KOS. Score &lt; {decisionThreshold} → Escalade. (Capacité × 40%) + (Coût évité × 30%) + (Impact × 20%) + (Réutilisabilité × 10%).
                </p>
              </div>
              <div className="p-4 rounded-xl bg-background-50 border border-background-200">
                <h4 className="text-sm font-bold text-foreground-950 mb-2">
                  <i className="ri-robot-2-line mr-1.5 text-violet-600" />
                  Catalogue Agents : {allAgents.length} agents · {Object.keys(agentsByDomain).length} domaines
                </h4>
                <div className="space-y-1.5">
                  {Object.entries(agentsByDomain).map(([domain, agents]) => (
                    <div key={domain} className="flex items-center justify-between text-xs">
                      <span className="text-foreground-600">{domain}</span>
                      <span className="font-bold text-foreground-950">{agents.length} agents</span>
                    </div>
                  ))}
                </div>
              </div>
              <div className="p-4 rounded-xl bg-background-50 border border-background-200">
                <h4 className="text-sm font-bold text-foreground-950 mb-2">
                  <i className="ri-database-2-line mr-1.5 text-emerald-600" />
                  Supabase : {supabaseStatus === 'connected' ? 'Connecté — kos_execution_logs LIVE' : supabaseStatus === 'checking' ? 'Vérification...' : 'Déconnecté — fallback local'}
                </h4>
                <p className="text-sm text-foreground-600">
                  {supabaseStatus === 'connected'
                    ? 'Logs d\'exécution persistés en temps réel. Journal d\'audit complet. Traçabilité Big Four.'
                    : 'Mode dégradé — les logs sont disponibles localement. Reconnexion automatique.'}
                </p>
              </div>
              <div className="p-4 rounded-xl bg-background-50 border border-background-200">
                <h4 className="text-sm font-bold text-foreground-950 mb-2">
                  <i className="ri-focus-3-line mr-1.5 text-violet-600" />
                  Objectifs Cibles
                </h4>
                <div className="grid grid-cols-2 gap-3">
                  {[
                    { label: 'Exécution Interne', target: `≥ ${targetInternalRate}%` },
                    { label: 'Qualité', target: `≥ ${config.quality_target}%` },
                    { label: 'Conformité', target: `≥ ${config.compliance_target}%` },
                    { label: 'Réduction Externe', target: `≥ ${targetCostReduction}%` },
                  ].map((obj) => (
                    <div key={obj.label} className="text-xs text-foreground-600">
                      {obj.label} : <strong>{obj.target}</strong>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
