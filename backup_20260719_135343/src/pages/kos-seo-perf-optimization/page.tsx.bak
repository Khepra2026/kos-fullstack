import { useState } from 'react';
import KOSHubLayout from '@/components/feature/KOSHubLayout';
import SeoHead from '@/components/feature/SeoHead';
import { useKOSSEOPerfOptimization } from '@/hooks/useKOSSEOPerfOptimization';

type TabKey = 'overview' | 'metrics' | 'cwv' | 'seo' | 'aeo' | 'actions' | 'history';

const TABS: { key: TabKey; label: string; icon: string }[] = [
  { key: 'overview', label: 'Vue d\'Ensemble', icon: 'ri-dashboard-3-line' },
  { key: 'metrics', label: 'Métriques', icon: 'ri-bar-chart-2-line' },
  { key: 'cwv', label: 'Core Web Vitals', icon: 'ri-pulse-line' },
  { key: 'seo', label: 'SEO Rankings', icon: 'ri-google-line' },
  { key: 'aeo', label: 'AEO / GEO', icon: 'ri-robot-line' },
  { key: 'actions', label: 'Actions Correctives', icon: 'ri-tools-line' },
  { key: 'history', label: 'Historique', icon: 'ri-history-line' },
];

function GaugeCircle({ value, size = 48, strokeWidth = 4 }: { value: number; size?: number; strokeWidth?: number }) {
  const radius = (size - strokeWidth) / 2;
  const circumference = radius * 2 * Math.PI;
  const offset = circumference - (value / 100) * circumference;
  const color = value >= 95 ? 'stroke-emerald-500' : value >= 85 ? 'stroke-accent-500' : value >= 70 ? 'stroke-amber-500' : 'stroke-red-500';
  const textColor = value >= 95 ? 'text-emerald-700' : value >= 85 ? 'text-accent-700' : value >= 70 ? 'text-amber-700' : 'text-red-700';
  return (
    <div className="relative inline-flex items-center justify-center" style={{ width: size, height: size }}>
      <svg width={size} height={size} className="-rotate-90">
        <circle cx={size / 2} cy={size / 2} r={radius} fill="none" strokeWidth={strokeWidth} className="stroke-background-200" />
        <circle cx={size / 2} cy={size / 2} r={radius} fill="none" strokeWidth={strokeWidth} strokeLinecap="round" className={`${color} transition-all duration-700`} style={{ strokeDasharray: circumference, strokeDashoffset: offset }} />
      </svg>
      <span className={`absolute text-sm font-bold ${textColor}`}>{value}</span>
    </div>
  );
}

function MetricCard({ metric }: { metric: OptimizationMetric }) {
  const statusColors: Record<string, string> = {
    optimal: 'border-emerald-200/60 bg-emerald-50/30',
    good: 'border-accent-200/60 bg-accent-50/30',
    needs_work: 'border-amber-200/60 bg-amber-50/30',
    critical: 'border-red-200/60 bg-red-50/30',
  };
  const statusBadge: Record<string, string> = {
    optimal: 'bg-emerald-100 text-emerald-700',
    good: 'bg-accent-100 text-accent-700',
    needs_work: 'bg-amber-100 text-amber-700',
    critical: 'bg-red-100 text-red-700',
  };
  return (
    <div className={`rounded-xl border p-5 ${statusColors[metric.status]} transition-all hover:border-background-300/80`}>
      <div className="flex items-start justify-between gap-3 mb-3">
        <div className="flex items-center gap-3">
          <div className="w-10 h-10 rounded-lg bg-background-100 flex items-center justify-center">
            <i className={`${metric.icon} text-lg text-foreground-700`}></i>
          </div>
          <div>
            <h3 className="text-sm font-semibold text-foreground-950">{metric.category}</h3>
            <span className={`inline-flex text-xs px-1.5 py-0.5 rounded-full font-medium ${statusBadge[metric.status]}`}>
              {metric.status === 'optimal' ? 'Optimal' : metric.status === 'good' ? 'Bon' : metric.status === 'needs_work' ? 'À améliorer' : 'Critique'}
            </span>
          </div>
        </div>
        <GaugeCircle value={metric.score} size={42} strokeWidth={3} />
      </div>
      <p className="text-xs text-foreground-600 mb-2">{metric.description}</p>
      <div className="flex items-center justify-between text-xs">
        <span className="text-foreground-400">Cible: {metric.target}/100</span>
        <span className="text-foreground-400">{new Date(metric.lastChecked).toLocaleDateString('fr-FR')}</span>
      </div>
    </div>
  );
}

function ActionCard({ action }: { action: OptimizationAction }) {
  const prioColors: Record<string, string> = {
    P0: 'bg-red-100 text-red-700 border-red-200',
    P1: 'bg-amber-100 text-amber-700 border-amber-200',
    P2: 'bg-background-100 text-foreground-600 border-background-200',
  };
  return (
    <div className="bg-background-50 border border-background-200/70 rounded-xl p-4 flex items-start gap-4">
      <div className="w-10 h-10 rounded-lg bg-background-100 flex items-center justify-center shrink-0">
        <i className={`${action.icon} text-lg text-foreground-700`}></i>
      </div>
      <div className="flex-1 min-w-0">
        <div className="flex items-center gap-2 mb-1 flex-wrap">
          <span className={`inline-flex text-xs px-1.5 py-0.5 rounded-full border font-medium ${prioColors[action.priority]}`}>{action.priority}</span>
          <span className="text-xs font-mono text-foreground-400">{action.id}</span>
          <span className="text-xs text-foreground-500">{action.agent}</span>
          <span className={`inline-flex text-xs px-1.5 py-0.5 rounded-full font-medium ${action.status === 'completed' ? 'bg-emerald-100 text-emerald-700' : action.status === 'in_progress' ? 'bg-accent-100 text-accent-700' : 'bg-background-100 text-foreground-500'}`}>
            {action.status === 'completed' ? 'Terminé' : action.status === 'in_progress' ? 'En cours' : 'En attente'}
          </span>
        </div>
        <p className="text-sm font-semibold text-foreground-950 mb-1">{action.action}</p>
        <p className="text-xs text-emerald-700 font-medium">{action.impact}</p>
        <div className="flex items-center gap-3 mt-2 text-xs text-foreground-400">
          <span><i className="ri-calendar-line mr-1"></i>{action.eta}</span>
          <span><i className="ri-timer-line mr-1"></i>{action.progress}%</span>
        </div>
      </div>
    </div>
  );
}

