                          </td>
                          <td className={`p-3 text-xs text-right font-semibold ${snap.pagespeedMobile >= 95 ? 'text-emerald-600' : snap.pagespeedMobile >= 85 ? 'text-accent-600' : 'text-red-600'}`}>{snap.pagespeedMobile}</td>
                          <td className={`p-3 text-xs text-right font-semibold ${snap.pagespeedDesktop >= 95 ? 'text-emerald-600' : snap.pagespeedDesktop >= 85 ? 'text-accent-600' : 'text-red-600'}`}>{snap.pagespeedDesktop}</td>
                          <td className={`p-3 text-xs text-right font-semibold ${snap.lcpMobile <= 2.5 ? 'text-emerald-600' : 'text-red-600'}`}>{snap.lcpMobile}s</td>
                          <td className={`p-3 text-xs text-right font-semibold ${snap.seoScore >= 95 ? 'text-emerald-600' : 'text-amber-600'}`}>{snap.seoScore}</td>
                          <td className={`p-3 text-xs text-right font-semibold ${snap.aeoScore >= 90 ? 'text-emerald-600' : 'text-amber-600'}`}>{snap.aeoScore}</td>
                          <td className={`p-3 text-xs text-right font-semibold ${snap.totalWeightMB <= 2 ? 'text-emerald-600' : snap.totalWeightMB <= 5 ? 'text-amber-600' : 'text-red-600'}`}>{snap.totalWeightMB} Mo</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                <div className="bg-background-50 border border-background-200/70 rounded-xl p-5">
                  <h3 className="text-sm font-semibold text-foreground-950 mb-2 flex items-center gap-2">
                    <i className="ri-history-line"></i>Progression — 17 Juin → 7 Juillet 2026
                  </h3>
                  <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
                    <div className="text-center bg-background-100 rounded-lg p-3">
                      <p className="text-2xl font-bold text-emerald-600">+41</p>
                      <p className="text-xs text-foreground-500">PageSpeed Mobile (56→97)</p>
                    </div>
                    <div className="text-center bg-background-100 rounded-lg p-3">
                      <p className="text-2xl font-bold text-emerald-600">-31.5s</p>
                      <p className="text-xs text-foreground-500">LCP (33.1s→1.6s)</p>
                    </div>
                    <div className="text-center bg-background-100 rounded-lg p-3">
                      <p className="text-2xl font-bold text-emerald-600">+15</p>
                      <p className="text-xs text-foreground-500">Score SEO (85→100)</p>
                    </div>
                    <div className="text-center bg-background-100 rounded-lg p-3">
                      <p className="text-2xl font-bold text-emerald-600">-7.3 Mo</p>
                      <p className="text-xs text-foreground-500">Poids pages (9.1→1.8 Mo)</p>
                    </div>
                  </div>
                </div>
              </div>
            )}
          </div>

          {/* Footer */}
          <footer className="border-t border-background-200/70 bg-background-100 mt-8">
            <div className="max-w-7xl mx-auto px-4 md:px-6 py-4">
              <div className="flex flex-col sm:flex-row items-center justify-between gap-3">
                <div className="flex items-center gap-4 text-[10px] text-foreground-500 font-body">
                  <span className="flex items-center gap-1">
                    <span className={`w-1.5 h-1.5 rounded-full ${isLive ? 'bg-emerald-500' : 'bg-amber-500'}`}></span>
                    Dernier scan : {new Date(globalScore.lastScan).toLocaleString('fr-FR')}
                  </span>
                  <span className="flex items-center gap-1">
                    <span className="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    Score Global : {globalScore.overall}/100
                  </span>
                  <span className="flex items-center gap-1">
                    <span className="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    {globalScore.totalImagesOptimized} images · {globalScore.featuredSnippets} snippets
                  </span>
                </div>
                <div className="flex items-center gap-2 text-[10px] text-foreground-400 font-body">
                  <i className={`text-xs ${isLive ? 'ri-database-2-line text-emerald-500' : 'ri-computer-line text-amber-500'}`}></i>
                  <span>{isLive ? 'Données Live — Supabase' : 'Données Mock — Démo'} · Auto-scan quotidien 06:00 GMT · {globalScore.certification}</span>
                </div>
              </div>
            </div>
          </footer>
        </div>
      </KOSHubLayout>
    </>
  );
}
