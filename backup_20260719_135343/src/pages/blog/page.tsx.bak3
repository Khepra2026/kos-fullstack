import { useState, useMemo, useEffect } from 'react';
import { useNavigate, useParams } from 'react-router-dom';
import { useTranslation } from 'react-i18next';
import { Navigation } from '@/pages/home/components/Navigation';
import { Footer } from '@/pages/home/components/Footer';
import { SeoHead } from '@/components/feature/SeoHead';
import { NewsletterSection } from './components/NewsletterSection';
import { ArticleTags } from './components/ArticleTags';
import { BlogNewsletterBanner } from './components/BlogNewsletterBanner';
import { BlogRelatedLinks } from './components/BlogRelatedLinks';
import { Breadcrumb } from '@/components/feature/Breadcrumb';
import { STATIC_HREFLANG_MAP } from '@/utils/hreflang';
import { optimizeImageUrl } from '@/utils/imageWebP';
import { OG_IMAGES, OG_IMAGE_DIMENSIONS } from '@/components/feature/OgImages';
import BlogFilters, { BlogFiltersState, SECTOR_TAG_MAP } from './components/BlogFilters';
import type { CategoryKey, SectorKey } from './components/BlogFilters';
import { resolveIdToSlug } from '@/data/articleSlugMap';
import { getOgPreviewUrl } from '@/utils/ogPreview';
import LazySection from '@/components/base/LazySection';
import OptimizedImage from '@/components/base/OptimizedImage';
import ScrollReveal from '@/components/feature/ScrollReveal';
import SocialSharePremium from '@/components/feature/SocialSharePremium';
import KOSSmartSearchBar from '@/components/feature/KOSSmartSearchBar';
import ItemListSchema from '@/components/feature/ItemListSchema';
import BUBilingualCrossLinks from '@/components/feature/BUBilingualCrossLinks';
import { useState, useEffect } from 'react';
const [BLOG_WRITING_AUTOMATES_KPIS, setBLOG_WRITING_AUTOMATES_KPIS] = useState<any>(null);
useEffect(() => { import('@/mocks/kosBlogWritingAutomates').then(m => setBLOG_WRITING_AUTOMATES_KPIS(m.BLOG_WRITING_AUTOMATES_KPIS || m.default)); }, []);
const [pipelineKPIs, setpipelineKPIs] = useState<any>(null);
useEffect(() => { import('@/mocks/kosBlogWritingAutomates').then(m => setpipelineKPIs(m.pipelineKPIs || m.default)); }, []);
const [dailyPipeline, setdailyPipeline] = useState<any>(null);
useEffect(() => { import('@/mocks/kosBlogWritingAutomates').then(m => setdailyPipeline(m.dailyPipeline || m.default)); }, []);

const SITE_URL = import.meta.env.VITE_SITE_URL || 'https://khepraexperts.com';

const CATEGORY_VALUES_FR: Record<Exclude<CategoryKey, 'all'>, string> = {
  governance: 'Gouvernance',
  finance: 'Finance',
  entrepreneurship: 'Entrepreneuriat',
  digital: 'Transformation digitale',
  policy: 'Politiques publiques',
  hr: 'Ressources Humaines',
  management: 'Management',
  compliance: 'Conformité & Réglementation',
  fiscalite: 'Prix de Transfert & Fiscalité',
  strategy: 'Stratégie & Croissance',
};

const CATEGORY_VALUES_EN: Record<Exclude<CategoryKey, 'all'>, string> = {
  governance: 'Governance',
  finance: 'Finance',
  entrepreneurship: 'Entrepreneurship',
  digital: 'Digital Transformation',
  policy: 'Public Policy',
  hr: 'Human Resources',
  management: 'Management',
  compliance: 'Compliance & Regulation',
  fiscalite: 'Transfer Pricing & Tax',
  strategy: 'Strategy & Growth',
};

function formatViews(views: number): string {
  if (views >= 1000) return `${(views / 1000).toFixed(1)}k`;
  return String(views);
}

const POPULAR_THRESHOLD = 4000;
const ARTICLES_PER_PAGE = 12;

type SortMode = 'latest' | 'popular';

const DEFAULT_FILTERS: BlogFiltersState = {
  category: 'all',
  sector: 'all',
  lang: 'all',
  tag: null,
  search: '',
};

const QUICK_CATEGORIES = [
  { key: 'governance' as CategoryKey, icon: 'ri-shield-check-line', color: 'from-amber-50 to-amber-100 border-amber-200 text-amber-800', iconBg: 'bg-amber-100', iconColor: 'text-amber-600' },
  { key: 'finance' as CategoryKey, icon: 'ri-line-chart-line', color: 'from-emerald-50 to-emerald-100 border-emerald-200 text-emerald-800', iconBg: 'bg-emerald-100', iconColor: 'text-emerald-600' },
  { key: 'compliance' as CategoryKey, icon: 'ri-file-shield-2-line', color: 'from-rose-50 to-rose-100 border-rose-200 text-rose-800', iconBg: 'bg-rose-100', iconColor: 'text-rose-600' },
  { key: 'strategy' as CategoryKey, icon: 'ri-compass-3-line', color: 'from-violet-50 to-violet-100 border-violet-200 text-violet-800', iconBg: 'bg-violet-100', iconColor: 'text-violet-600' },
  { key: 'digital' as CategoryKey, icon: 'ri-smartphone-line', color: 'from-teal-50 to-teal-100 border-teal-200 text-teal-800', iconBg: 'bg-teal-100', iconColor: 'text-teal-600' },
  { key: 'fiscalite' as CategoryKey, icon: 'ri-money-euro-circle-line', color: 'from-orange-50 to-orange-100 border-orange-200 text-orange-800', iconBg: 'bg-orange-100', iconColor: 'text-orange-600' },
];

export default function BlogPage() {
  const [blogData, setBlogData] = useState<any>(null);
  useEffect(() => {
    fetch('/mocks/kos-blog.json').then(r => r.json()).then(setBlogData);
  }, []);
  if (!blogData) return <div className="flex items-center justify-center min-h-screen">Loading...</div>;
  const { blogArticles } = blogData;

                  const { t, i18n } = useTranslation();
  const navigate = useNavigate();
  const { pageNumber } = useParams<{ pageNumber?: string }>();
  const currentPage = Math.max(1, parseInt(pageNumber ?? '1', 10) || 1);
  const [filters, setFilters] = useState<BlogFiltersState>(DEFAULT_FILTERS);
  const [copiedId, setCopiedId] = useState<string | null>(null);
  const [filterTop, setFilterTop] = useState(81);
  const [sortMode, setSortMode] = useState<SortMode>('latest');

  const handleFiltersChange = (newFilters: BlogFiltersState) => {
    setFilters(newFilters);
    setSortMode('latest');
    if (currentPage !== 1) navigate('/blog/');
  };

  useEffect(() => {
    const measure = () => {
      const nav = document.querySelector<HTMLElement>('nav.fixed');
      const navH = nav ? nav.offsetHeight : 80;
      setFilterTop(navH);
    };
    measure();
    const ro = new ResizeObserver(measure);
    const nav = document.querySelector<HTMLElement>('nav.fixed');
    if (nav) ro.observe(nav);
    window.addEventListener('resize', measure, { passive: true });
    return () => { ro.disconnect(); window.removeEventListener('resize', measure); };
  }, []);

  const isEn = i18n.language === 'en';

  const allArticlesFr = blogArticles;
  const allArticlesEn = blogArticlesEn;

  const CATEGORY_VALUES = isEn ? CATEGORY_VALUES_EN : CATEGORY_VALUES_FR;

  const filteredArticles = useMemo(() => {
    let pool: typeof blogArticles = [];
    if (filters.lang === 'all') {
      const frIds = new Set(allArticlesFr.map(a => a.id));
      const enIds = new Set(allArticlesEn.map(a => a.id));
      pool = isEn
        ? [...allArticlesEn, ...allArticlesFr.filter(a => !enIds.has(a.id))]
        : [...allArticlesFr, ...allArticlesEn.filter(a => !frIds.has(a.id))];
    } else if (filters.lang === 'fr') {
      pool = allArticlesFr;
    } else {
      pool = allArticlesEn;
    }

    if (filters.category !== 'all') {
      const catValue = CATEGORY_VALUES[filters.category as Exclude<CategoryKey, 'all'>];
      pool = pool.filter(a => (a.category || '').includes(catValue));
    }

    if (filters.sector !== 'all') {
      const sectorTags = SECTOR_TAG_MAP[filters.sector as SectorKey];
      pool = pool.filter(a => (a.tags || []).some(tag => sectorTags.includes(tag)));
    }

    if (filters.tag) {
      pool = pool.filter(a => (a.tags || []).includes(filters.tag as string));
    }

    const query = filters.search.trim().toLowerCase();
    if (query !== '') {
      pool = pool.filter(a =>
        a.title.toLowerCase().includes(query) ||
        (a.excerpt || '').toLowerCase().includes(query) ||
        (a.tags || []).some(tag => tag.toLowerCase().includes(query))
      );
    }

    return pool;
  }, [filters, allArticlesFr, allArticlesEn, isEn, CATEGORY_VALUES]);

  const sortedArticles = useMemo(() => {
    const pool = [...filteredArticles];
    if (sortMode === 'popular') {
      pool.sort((a, b) => (b.views ?? 0) - (a.views ?? 0));
    }
    return pool;
  }, [filteredArticles, sortMode]);

  const featuredArticles = useMemo(() => {
    const frPool = [...allArticlesFr].sort((a, b) => (b.views ?? 0) - (a.views ?? 0));
    return frPool.slice(0, 3);
  }, [allArticlesFr]);

  const availableTags = useMemo(() => {
    let pool: typeof blogArticles = [];
    if (filters.lang === 'all') {
      const frIds = new Set(allArticlesFr.map(a => a.id));
      const enIds = new Set(allArticlesEn.map(a => a.id));
      pool = isEn ? [...allArticlesEn, ...allArticlesFr.filter(a => !enIds.has(a.id))] : [...allArticlesFr, ...allArticlesEn.filter(a => !frIds.has(a.id))];
    } else if (filters.lang === 'fr') {
      pool = allArticlesFr;
    } else {
      pool = allArticlesEn;
    }
    if (filters.category !== 'all') {
      const catValue = CATEGORY_VALUES[filters.category as Exclude<CategoryKey, 'all'>];
      pool = pool.filter(a => (a.category || '').includes(catValue));
    }
    if (filters.sector !== 'all') {
      const sectorTags = SECTOR_TAG_MAP[filters.sector as SectorKey];
      pool = pool.filter(a => (a.tags || []).some(tag => sectorTags.includes(tag)));
    }
    const tagSet = new Set<string>();
    pool.forEach(a => (a.tags || []).forEach(tag => tagSet.add(tag)));
    return Array.from(tagSet).sort();
  }, [filters.lang, filters.category, filters.sector, allArticlesFr, allArticlesEn, isEn, CATEGORY_VALUES]);

  const totalArticles = sortedArticles.length;
  const totalPages = Math.max(1, Math.ceil(totalArticles / ARTICLES_PER_PAGE));
  const paginatedArticles = useMemo(() => {
    const safePage = Math.min(currentPage, totalPages);
    const start = (safePage - 1) * ARTICLES_PER_PAGE;
    return sortedArticles.slice(start, start + ARTICLES_PER_PAGE);
  }, [sortedArticles, currentPage, totalPages]);

  const handlePageChange = (page: number) => {
    if (page === 1) navigate('/blog/');
    else navigate(`/blog/page/${page}/`);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  const handleCopyLink = (e: React.MouseEvent, articleId: string) => {
    e.stopPropagation();
    const url = `${SITE_URL}/blog/${resolveIdToSlug(articleId) || articleId}/`;
    navigator.clipboard.writeText(url).then(() => {
      setCopiedId(articleId);
      setTimeout(() => setCopiedId(null), 2000);
    });
  };

  const blogOgTitle = isEn
    ? 'Blog — Governance, Compliance & Africa Insights | Khepra'
    : 'Blog — Conformité, Gouvernance & Finance | Afrique Francophone';
  const blogOgDescription = isEn
    ? 'Expert analysis on governance, BCEAO/COBAC compliance and finance across Francophone Africa. 22 years of field expertise, bilingual FR/EN articles.'
    : "Analyses d'expert sur la gouvernance, la conformité BCEAO/COBAC et la finance en Afrique francophone. 22 ans d'expérience terrain. Articles bilingues FR/EN.";
  const blogOgKeywords = isEn
    ? 'governance Africa, BCEAO compliance, financial analysis, due diligence, digital transformation, strategic consulting blog'
    : 'gouvernance Afrique, conformité BCEAO, analyse financière, due diligence, transformation digitale, blog conseil stratégique';

  const blogSchema = {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Blog',
        '@id': `${SITE_URL}/blog#blog`,
        name: 'Blog & Ressources — KHEPRA EXPERTS',
        url: `${SITE_URL}/blog`,
        inLanguage: 'fr-FR',
        publisher: { '@type': 'Organization', name: 'KHEPRA EXPERTS', url: SITE_URL },
      },
      {
        '@type': 'WebPage',
        '@id': `${SITE_URL}/blog#webpage`,
        url: `${SITE_URL}/blog`,
        name: blogOgTitle,
        description: blogOgDescription,
        inLanguage: isEn ? 'en-US' : 'fr-FR',
        isPartOf: { '@type': 'WebSite', url: SITE_URL },
      },
    ],
  };

  return (
    <div className="min-h-screen bg-background-50">
      <SeoHead
        title={currentPage > 1 ? `${blogOgTitle} — Page ${currentPage}` : blogOgTitle}
        description={currentPage > 1
          ? (isEn ? `Page ${currentPage} of the KHEPRA EXPERTS blog.` : `Page ${currentPage} du blog KHEPRA EXPERTS.`)
          : (isEn ? 'Expert insights on governance, finance, BCEAO compliance and digital transformation for African leaders. 22+ years of field expertise, bilingual FR/EN articles.' : "Analyses d'expert sur la gouvernance, finance, conformité BCEAO et transformation digitale pour décideurs africains. 22 ans d'expertise, bilingue FR/EN.")}
        keywords={blogOgKeywords}
        canonicalPath={currentPage === 1 ? '/blog' : `/blog/page/${currentPage}`}
        ogType="website"
        ogImage={OG_IMAGES.BLOG}
        ogImageAlt={isEn ? 'KHEPRA EXPERTS Blog – Finance, Governance & Entrepreneurship in Africa' : 'Blog KHEPRA EXPERTS – Gouvernance, Finance et Entrepreneuriat en Afrique'}
        ogImageWidth={OG_IMAGE_DIMENSIONS.width}
        ogImageHeight={OG_IMAGE_DIMENSIONS.height}
        schemaJson={currentPage === 1 ? blogSchema : undefined}
        hreflangLinks={currentPage === 1 ? STATIC_HREFLANG_MAP['/blog/'] : undefined}
        noIndex={currentPage > 1}
      />
      <Navigation />

      {/* Schema.org — ItemList pour la liste d'articles */}
      {currentPage === 1 && (
        <ItemListSchema
          url="/blog/"
          listType="Article"
          items={allArticlesFr.slice(0, 50).map((a, i) => ({
            name: a.title,
            url: `/blog/${resolveIdToSlug(a.id) || a.id}/`,
            description: a.excerpt,
            position: i + 1,
            image: a.image,
          }))}
        />
      )}

      {/* ═══════════════════════════════════════════ HERO — Editorial ═══════════════════════════════════════════ */}
      <section className="relative min-h-[520px] flex items-center overflow-hidden">
        <div className="absolute inset-0">
          <OptimizedImage
            src="https://readdy.ai/api/search-image?query=Modern%20professional%20editorial%20workspace%20with%20warm%20ambient%20lighting%20dark%20wood%20desk%20leather%20chair%20premium%20business%20books%20stacked%20neatly%20architectural%20digest%20style%20refined%20sophisticated%20atmosphere%20soft%20natural%20window%20light%20warm%20amber%20and%20ivory%20tones%20elegant%20minimal%20composition%20no%20people&width=1600&height=800&seq=blog-hero-editorial-bf-2026&orientation=landscape"
            alt=""
            className="w-full h-full"
            width={1600}
            height={800}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            objectFit="cover"
          />
          <div className="absolute inset-0 bg-gradient-to-r from-foreground-950/85 via-foreground-950/60 to-foreground-950/30"></div>
        </div>

        <div className="relative z-10 w-full max-w-7xl mx-auto px-6 lg:px-8 py-28">
          <Breadcrumb
            variant="light"
            className="mb-8"
            items={[
              { label: isEn ? 'Home' : 'Accueil', href: '/' },
              { label: isEn ? 'Blog & Insights' : 'Blog & Analyses' },
            ]}
          />

          <div className="max-w-3xl">
            <div className="inline-flex items-center gap-3 bg-background-50/10 backdrop-blur-sm border border-white/15 rounded-full px-4 py-2 mb-8">
              <div className="w-8 h-8 rounded-full overflow-hidden border-2 border-gold-400 flex-shrink-0">
                <OptimizedImage
                  src={optimizeImageUrl("https://readdy.ai/api/search-image?query=Professional%20African%20business%20consultant%20expert%20portrait%20headshot%20formal%20attire%20confident%20smile%20studio%20lighting%20corporate%20executive%20leadership&width=80&height=80&seq=simda-author-photo&orientation=squarish")}
                  alt="SIMDA Essoyomèwè"
                  className="w-full h-full object-cover"
                  width={32} height={32}
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                  placeholder="none"
                />
              </div>
              <span className="text-white/85 text-sm font-medium leading-none">
                {isEn ? 'Strategic insights by' : 'Analyses stratégiques par'}{' '}
                <strong className="text-gold-400 font-semibold">SIMDA Essoyomèwè</strong>
              </span>
            </div>

            <h1 className="text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6">
              {isEn ? (
                <>Strategic Intelligence for <span className="text-gold-400">African Leaders</span></>
              ) : (
                <>Intelligence Stratégique pour <span className="text-gold-400">Décideurs Africains</span></>
              )}
            </h1>

            <p className="text-lg text-white/70 leading-relaxed max-w-2xl mb-8">
              {isEn
                ? 'In-depth analyses on governance, regulation, finance and digital transformation — crafted by practitioners for executives, investors and board members operating across Francophone Africa.'
                : "Analyses approfondies sur la gouvernance, la régulation, la finance et la transformation digitale — conçues par des praticiens pour les dirigeants, investisseurs et administrateurs opérant en Afrique francophone."}
            </p>

            {/* Compact stats row */}
            <div className="flex flex-wrap items-center gap-6 text-white/65 text-sm">
              <div className="flex items-center gap-2">
                <i className="ri-article-line text-gold-400 text-lg"></i>
                <span><strong className="text-white font-semibold">{(BLOG_WRITING_AUTOMATES_KPIS.articles_published / 1000).toFixed(1)}k+</strong> {isEn ? 'articles' : 'articles'}</span>
              </div>
              <span className="text-white/20">|</span>
              <div className="flex items-center gap-2">
                <i className="ri-robot-line text-gold-400 text-lg"></i>
                <span><strong className="text-white font-semibold">{BLOG_WRITING_AUTOMATES_KPIS.deployed}</strong> {isEn ? 'AI agents' : 'agents IA'}</span>
              </div>
              <span className="text-white/20">|</span>
              <div className="flex items-center gap-2">
                <i className="ri-user-star-line text-gold-400 text-lg"></i>
                <span><strong className="text-white font-semibold">22+</strong> {isEn ? 'years expertise' : "ans d'expertise"}</span>
              </div>
              <span className="text-white/20">|</span>
              <div className="flex items-center gap-2">
                <i className="ri-global-line text-gold-400 text-lg"></i>
                <span><strong className="text-white font-semibold">15+</strong> {isEn ? 'countries' : 'pays'}</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* ═══════════════════════════════════════════ BLOG COMMAND CENTER — KPI Dashboard ═══════════════════════════════════════════ */}
      {currentPage === 1 && (
        <section className="py-8 bg-background-100 border-b border-background-200">
          <div className="max-w-7xl mx-auto px-6 lg:px-8">
            <div className="flex flex-col lg:flex-row items-start lg:items-center gap-4 mb-6">
              <div className="flex items-center gap-3">
                <div className="w-9 h-9 rounded-xl bg-accent-500/15 flex items-center justify-center">
                  <i className="ri-dashboard-3-line text-accent-600 text-lg"></i>
                </div>
                <div>
                  <h2 className="text-lg font-bold text-foreground-950">
                    {isEn ? 'KOS Blog Command Center' : 'KOS Blog Command Center'}
                  </h2>
                  <p className="text-xs text-foreground-500">
                    {isEn ? 'Editorial intelligence — Institutional Standard' : 'Intelligence éditoriale — Exigence institutionnelle'}
                  </p>
                </div>
              </div>
              <div className="flex items-center gap-2 ml-auto">
                <span className="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-100 border border-emerald-200 text-xs font-bold text-emerald-800">
                  <span className="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                  {BLOG_WRITING_AUTOMATES_KPIS.deployed}/{BLOG_WRITING_AUTOMATES_KPIS.total_agents} {isEn ? 'Agents Active' : 'Agents Actifs'}
                </span>
                {BLOG_WRITING_AUTOMATES_KPIS.master_prompt_active && (
                  <span className="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-100 border border-amber-200 text-xs font-bold text-amber-800">
                    <i className="ri-sparkling-line text-[10px]"></i>
                    {isEn ? 'Master Prompt Active' : 'Master Prompt Actif'}
                  </span>
                )}
              </div>
            </div>

            {/* KPI Cards Row */}
            <div className="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-8 gap-3">
              {/* Total Articles */}
              <div className="bg-background-50 rounded-xl p-4 border border-background-200 hover:border-accent-200 transition-colors">
                <div className="flex items-center gap-2 mb-2">
                  <div className="w-7 h-7 rounded-lg bg-accent-100 flex items-center justify-center">
                    <i className="ri-article-line text-accent-600 text-sm"></i>
                  </div>
                </div>
                <p className="text-2xl font-bold text-foreground-950 font-heading">{(BLOG_WRITING_AUTOMATES_KPIS.articles_published / 1000).toFixed(1)}k</p>
                <p className="text-[11px] text-foreground-500 mt-0.5">{isEn ? 'Articles' : 'Articles'}</p>
              </div>

              {/* This Week */}
              <div className="bg-background-50 rounded-xl p-4 border border-background-200 hover:border-accent-200 transition-colors">
                <div className="flex items-center gap-2 mb-2">
                  <div className="w-7 h-7 rounded-lg bg-emerald-100 flex items-center justify-center">
                    <i className="ri-calendar-check-line text-emerald-600 text-sm"></i>
                  </div>
                </div>
                <p className="text-2xl font-bold text-foreground-950 font-heading">{pipelineKPIs.articles_this_week}</p>
                <p className="text-[11px] text-foreground-500 mt-0.5">{isEn ? 'This Week' : 'Cette Semaine'}</p>
              </div>

              {/* SEO Score */}
              <div className="bg-background-50 rounded-xl p-4 border border-background-200 hover:border-accent-200 transition-colors">
                <div className="flex items-center gap-2 mb-2">
                  <div className="w-7 h-7 rounded-lg bg-primary-100 flex items-center justify-center">
                    <i className="ri-search-line text-primary-600 text-sm"></i>
                  </div>
                </div>
                <p className="text-2xl font-bold text-foreground-950 font-heading">{pipelineKPIs.avg_seo_score}<span className="text-sm font-normal text-foreground-400">/100</span></p>
                <p className="text-[11px] text-foreground-500 mt-0.5">{isEn ? 'SEO Score' : 'Score SEO'}</p>
              </div>

              {/* Quality Score */}
              <div className="bg-background-50 rounded-xl p-4 border border-background-200 hover:border-accent-200 transition-colors">
                <div className="flex items-center gap-2 mb-2">
                  <div className="w-7 h-7 rounded-lg bg-amber-100 flex items-center justify-center">
                    <i className="ri-star-line text-amber-600 text-sm"></i>
                  </div>
                </div>
                <p className="text-2xl font-bold text-foreground-950 font-heading">{pipelineKPIs.avg_quality_score}<span className="text-sm font-normal text-foreground-400">/10</span></p>
                <p className="text-[11px] text-foreground-500 mt-0.5">{isEn ? 'Quality' : 'Qualité'}</p>
              </div>

              {/* Weekly Traffic */}
              <div className="bg-background-50 rounded-xl p-4 border border-background-200 hover:border-accent-200 transition-colors">
                <div className="flex items-center gap-2 mb-2">
                  <div className="w-7 h-7 rounded-lg bg-rose-100 flex items-center justify-center">
                    <i className="ri-eye-line text-rose-600 text-sm"></i>
                  </div>
                </div>
                <p className="text-2xl font-bold text-foreground-950 font-heading">{(pipelineKPIs.estimated_weekly_traffic / 1000).toFixed(0)}k</p>
                <p className="text-[11px] text-foreground-500 mt-0.5">{isEn ? 'Traffic/wk' : 'Trafic/sem.'}</p>
              </div>

              {/* Pipeline */}
              <div className="bg-background-50 rounded-xl p-4 border border-background-200 hover:border-accent-200 transition-colors">
                <div className="flex items-center gap-2 mb-2">
                  <div className="w-7 h-7 rounded-lg bg-indigo-100 flex items-center justify-center">
                    <i className="ri-git-branch-line text-indigo-600 text-sm"></i>
                  </div>
                </div>
                <p className="text-2xl font-bold text-foreground-950 font-heading">{pipelineKPIs.articles_in_pipeline}</p>
                <p className="text-[11px] text-foreground-500 mt-0.5">{isEn ? 'In Pipeline' : 'En Pipeline'}</p>
              </div>

              {/* Streak */}
              <div className="bg-background-50 rounded-xl p-4 border border-background-200 hover:border-accent-200 transition-colors">
                <div className="flex items-center gap-2 mb-2">
                  <div className="w-7 h-7 rounded-lg bg-orange-100 flex items-center justify-center">
                    <i className="ri-fire-line text-orange-600 text-sm"></i>
                  </div>
                </div>
                <p className="text-2xl font-bold text-foreground-950 font-heading">{pipelineKPIs.streak_days}j</p>
                <p className="text-[11px] text-foreground-500 mt-0.5">{isEn ? 'Streak' : 'Série'}</p>
              </div>

              {/* Hub Link */}
              <a
                href="/kos-blog-writing-automates"
                onClick={(e) => { e.preventDefault(); navigate('/kos-blog-writing-automates'); }}
                className="bg-foreground-950 rounded-xl p-4 border border-foreground-800 hover:border-accent-500 transition-all group cursor-pointer flex flex-col justify-between"
              >
                <div className="flex items-center gap-2 mb-2">
                  <div className="w-7 h-7 rounded-lg bg-accent-500/20 flex items-center justify-center">
                    <i className="ri-robot-line text-accent-400 text-sm"></i>
                  </div>
                </div>
                <div>
                  <p className="text-sm font-bold text-white leading-tight group-hover:text-accent-400 transition-colors">
                    {isEn ? 'Automation Hub' : 'Hub Automates'}
                  </p>
                  <p className="text-[10px] text-white/50 mt-0.5">
                    {BLOG_WRITING_AUTOMATES_KPIS.deployed} agents &rarr;
                  </p>
                </div>
              </a>
            </div>

            {/* Latest Pipeline Article Teaser */}
            {dailyPipeline.length > 0 && (() => {
              const latest = dailyPipeline[dailyPipeline.length - 1];
              return (
                <div className="mt-4 p-4 rounded-xl bg-background-50 border border-background-200 flex flex-col sm:flex-row items-start sm:items-center gap-4">
                  <div className="flex items-center gap-2 flex-shrink-0">
                    <span className="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span className="text-xs font-bold text-emerald-700 uppercase tracking-wider">
                      {isEn ? 'Latest Published' : 'Dernier Publié'}
                    </span>
                  </div>
                  <div className="flex-1 min-w-0">
                    <p className="text-sm font-semibold text-foreground-900 truncate">{latest.title}</p>
                    <p className="text-xs text-foreground-500">{latest.author} · {latest.date} · {latest.word_count.toLocaleString()} mots · SEO {latest.seo_score}/100</p>
                  </div>
                  <div className="flex items-center gap-2 flex-shrink-0">
                    <span className="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-accent-100 border border-accent-200 text-xs font-semibold text-accent-700">
                      <i className="ri-verified-badge-line text-[10px]"></i>
                      Quality Verified
                    </span>
                  </div>
                </div>
              );
            })()}
          </div>
        </section>
      )}

      {/* ═══════════════════════════════════════════ EXPLORE BY TOPIC ═══════════════════════════════════════════ */}
      <section className="py-14 bg-background-50 border-b border-background-200">
        <div className="max-w-7xl mx-auto px-6 lg:px-8">
          <div className="text-center mb-10">
            <span className="inline-block text-xs font-bold text-foreground-400 uppercase tracking-[0.15em] mb-3">
              {isEn ? 'Explore by Topic' : 'Explorer par Thématique'}
            </span>
            <h2 className="text-2xl md:text-3xl font-bold text-foreground-950">
              {isEn ? 'Find the insights that matter to you' : 'Trouvez les analyses qui comptent pour vous'}
            </h2>
          </div>

          <div className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
            {QUICK_CATEGORIES.map((cat) => {
              const count = allArticlesFr.filter(a => (a.category || '').includes(CATEGORY_VALUES_FR[cat.key])).length;
              const targetCategory = CATEGORY_VALUES[cat.key];
              const isActive = filters.category === cat.key;
              return (
                <button
                  key={cat.key}
                  onClick={() => handleFiltersChange({
                    ...DEFAULT_FILTERS,
                    category: isActive ? 'all' : cat.key,
                  })}
                  className={`group relative flex flex-col items-center gap-3 p-5 rounded-2xl border transition-all duration-300 cursor-pointer ${
                    isActive
                      ? 'bg-foreground-950 border-foreground-950 shadow-lg scale-[1.02]'
                      : `bg-gradient-to-br ${cat.color} hover:shadow-md hover:-translate-y-0.5`
                  }`}
                >
                  <div className={`w-11 h-11 rounded-xl flex items-center justify-center transition-transform duration-300 group-hover:scale-110 ${isActive ? 'bg-white/15' : cat.iconBg}`}>
                    <i className={`${cat.icon} text-xl ${isActive ? 'text-white' : cat.iconColor}`}></i>
                  </div>
                  <span className={`text-xs font-semibold leading-tight text-center ${isActive ? 'text-white' : ''}`}>
                    {isEn ? (cat.key === 'compliance' ? 'Compliance' : cat.key === 'fiscalite' ? 'Transfer Pricing' : cat.key === 'digital' ? 'Digital' : CATEGORY_VALUES_FR[cat.key]) : CATEGORY_VALUES_FR[cat.key]}
                  </span>
                  <span className={`text-[10px] font-medium rounded-full px-2 py-0.5 ${isActive ? 'bg-white/20 text-white/80' : 'bg-white/50 text-foreground-500'}`}>
                    {count}
                  </span>
                </button>
              );
            })}
          </div>
        </div>
      </section>

      {/* ═══════════════════════════════════════════ FEATURED INSIGHTS ═══════════════════════════════════════════ */}
      {currentPage === 1 && (
        <section className="py-14 bg-background-100">
          <div className="max-w-7xl mx-auto px-6 lg:px-8">
            <div className="flex items-center gap-3 mb-10">
              <div className="w-10 h-10 rounded-xl bg-gold-100 flex items-center justify-center">
                <i className="ri-star-fill text-gold-600 text-lg"></i>
              </div>
              <div>
                <h2 className="text-xl md:text-2xl font-bold text-foreground-950">
                  {isEn ? "Editor's Picks" : 'À la Une'}
                </h2>
                <p className="text-sm text-foreground-500">
                  {isEn ? 'Essential reading for decision-makers' : 'Lectures essentielles pour les décideurs'}
                </p>
              </div>
            </div>

            <div className="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
              {featuredArticles.map((article, idx) => {
                const articleIsEn = allArticlesEn.some(a => a.id === article.id) && !allArticlesFr.some(a => a.id === article.id);
                return (
                  <ScrollReveal key={article.id} animation="fadeSlideUp" delay={idx * 100}>
                    <div
                      onClick={() => navigate(`/blog/${resolveIdToSlug(article.id) || article.id}/`)}
                      className="group cursor-pointer bg-background-50 rounded-2xl overflow-hidden border border-background-200 hover:border-gold-300 hover:shadow-xl transition-all duration-300 h-full flex flex-col"
                    >
                      <div className="relative h-52 overflow-hidden">
                        <OptimizedImage
                          src={optimizeImageUrl(article.image || '')}
                          alt={article.title}
                          className="w-full h-full group-hover:scale-105 transition-transform duration-700"
                          width={600} height={208}
                          loading={idx === 0 ? 'eager' : 'lazy'}
                          fetchpriority={idx === 0 ? 'high' : 'low'}
                          decoding="async"
                          rootMargin="300px"
                          objectFit="cover"
                        />
                        <div className="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
                        <div className="absolute top-3 left-3">
                          <span className="inline-block px-3 py-1 rounded-full text-[11px] font-semibold bg-gold-500/90 text-white shadow-sm">
                            {article.category}
                          </span>
                        </div>
                        <div className="absolute top-3 right-3">
                          <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-bold bg-background-50/90 text-foreground-700 shadow-sm">
                            {articleIsEn ? 'EN' : 'FR'}
                          </span>
                        </div>
                        <div className="absolute bottom-3 left-3 right-3">
                          <div className="flex items-center gap-3 text-white/85 text-xs">
                            <span className="flex items-center gap-1">
                              <i className="ri-calendar-line text-gold-400"></i>
                              {article.date}
                            </span>
                            <span className="flex items-center gap-1">
                              <i className="ri-time-line text-gold-400"></i>
                              {article.readTime}
                            </span>
                          </div>
                        </div>
                      </div>

                      <div className="p-5 flex flex-col flex-1">
                        <h3 className="font-bold text-foreground-950 mb-2 line-clamp-2 group-hover:text-gold-700 transition-colors text-base leading-snug">
                          {article.title}
                        </h3>
                        <p className="text-foreground-500 text-sm line-clamp-2 mb-4 leading-relaxed">{article.excerpt}</p>
                        <div className="mt-auto flex items-center justify-between pt-3 border-t border-background-200">
                          <div className="flex items-center gap-2">
                            <div className="w-7 h-7 rounded-full overflow-hidden border border-gold-300">
                              <img
                                src={optimizeImageUrl("https://readdy.ai/api/search-image?query=Professional%20African%20business%20consultant%20expert%20portrait%20headshot%20formal%20attire%20confident%20smile%20studio%20lighting%20corporate%20executive%20leadership&width=80&height=80&seq=simda-author-photo&orientation=squarish")}
                                alt="SIMDA" className="w-full h-full object-cover" width={28} height={28} loading="lazy" decoding="async"
                              />
                            </div>
                            <span className="text-xs font-medium text-foreground-600">SIMDA Essoyomèwè</span>
                          </div>
                          <span className="text-xs font-semibold text-gold-600 flex items-center gap-1 group-hover:gap-2 transition-all">
                            {isEn ? 'Read' : 'Lire'}
                            <i className="ri-arrow-right-line"></i>
                          </span>
                        </div>
                      </div>
                    </div>
                  </ScrollReveal>
                );
              })}
            </div>
          </div>
        </section>
      )}

      {/* ═══════════════════════════════════════════ KOS SEMANTIC SEARCH ═══════════════════════════════════════════ */}
      <section className="py-10 bg-background-50">
        <div className="max-w-5xl mx-auto px-6 lg:px-8">
          <div className="text-center mb-5">
            <div className="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-primary-50 border border-primary-200 mb-3">
              <i className="ri-brain-line text-primary-600 text-sm" />
              <span className="text-xs font-semibold text-primary-700 uppercase tracking-wider">
                {isEn ? 'KOS Semantic Search — AI-Powered' : 'Recherche Sémantique KOS — IA'}
              </span>
            </div>
          </div>
          <KOSSmartSearchBar
            placeholder={isEn
              ? 'Search the KHEPRA documentary base — regulations, methodologies, guides...'
              : 'Recherchez dans la base documentaire KHEPRA — textes, méthodologies, guides...'}
          />
        </div>
      </section>

      {/* ═══════════════════════════════════════════ FILTERS ═══════════════════════════════════════════ */}
      <BlogFilters
        filters={filters}
        availableTags={availableTags}
        totalResults={filteredArticles.length}
        isEn={isEn}
        onFiltersChange={handleFiltersChange}
        filterTop={filterTop}
      />

      {/* ═══════════════════════════════════════════ ARTICLES GRID ═══════════════════════════════════════════ */}
      <div className="py-14">
        <div className="max-w-7xl mx-auto px-6 lg:px-8">
          {/* Tabs + count */}
          <div className="flex flex-col sm:flex-row sm:items-center justify-between mb-10 gap-4">
            <div className="inline-flex bg-background-100 rounded-full p-1 border border-background-200">
              <button
                onClick={() => setSortMode('latest')}
                className={`px-5 py-2 rounded-full text-sm font-semibold transition-all cursor-pointer whitespace-nowrap ${
                  sortMode === 'latest'
                    ? 'bg-background-50 text-foreground-950 shadow-sm'
                    : 'text-foreground-500 hover:text-foreground-700'
                }`}
              >
                <i className="ri-timer-line mr-1.5"></i>
                {isEn ? 'Latest' : 'Récents'}
              </button>
              <button
                onClick={() => setSortMode('popular')}
                className={`px-5 py-2 rounded-full text-sm font-semibold transition-all cursor-pointer whitespace-nowrap ${
                  sortMode === 'popular'
                    ? 'bg-background-50 text-foreground-950 shadow-sm'
                    : 'text-foreground-500 hover:text-foreground-700'
                }`}
              >
                <i className="ri-fire-line mr-1.5"></i>
                {isEn ? 'Most Read' : 'Plus Lus'}
              </button>
            </div>

            <span className="text-sm text-foreground-400">
              <strong className="text-foreground-700">{filteredArticles.length}</strong>{' '}
              {isEn ? 'article(s) available' : 'article(s) disponible(s)'}
            </span>
          </div>

          {filteredArticles.length === 0 ? (
            <div className="text-center py-20">
              <div className="w-16 h-16 flex items-center justify-center mx-auto mb-4 bg-secondary-100 rounded-full">
                <i className="ri-article-line text-2xl text-foreground-400"></i>
              </div>
              <p className="text-foreground-500 text-lg mb-2">
                {isEn ? 'No articles found for this selection.' : 'Aucun article trouvé pour cette sélection.'}
              </p>
              <p className="text-foreground-400 text-sm mb-6">
                {isEn ? 'Try adjusting your filters or browse by topic above.' : 'Essayez de modifier vos filtres ou explorez par thématique ci-dessus.'}
              </p>
              <button
                onClick={() => { handleFiltersChange(DEFAULT_FILTERS); setSortMode('latest'); }}
                className="inline-flex items-center gap-2 text-accent-700 font-semibold hover:underline cursor-pointer"
              >
                <i className="ri-refresh-line"></i>
                {isEn ? 'Reset all filters' : 'Réinitialiser tous les filtres'}
              </button>
            </div>
          ) : (
            <div className="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
              {paginatedArticles.map((article, articleIdx) => {
                const isPopular = (article.views ?? 0) >= POPULAR_THRESHOLD;
                const linkedInUrl = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(getOgPreviewUrl(`/blog/${resolveIdToSlug(article.id) || article.id}/`))}`;
                const articleIsEn = allArticlesEn.some(a => a.id === article.id) && !allArticlesFr.some(a => a.id === article.id);
                return (
                  <ScrollReveal key={article.id} animation="fadeSlideUp" delay={(articleIdx % 3) * 60} className="h-full">
                    <div
                      onClick={() => navigate(`/blog/${resolveIdToSlug(article.id) || article.id}/`)}
                      className="group cursor-pointer bg-background-50 rounded-2xl overflow-hidden border border-background-200 hover:border-foreground-300 hover:shadow-lg transition-all duration-300 h-full flex flex-col"
                    >
                      {/* Image */}
                      <div className="relative h-48 overflow-hidden flex-shrink-0">
                        <OptimizedImage
                          src={optimizeImageUrl(article.image || '')}
                          alt={article.title}
                          title={article.title}
                          className="w-full h-full group-hover:scale-105 transition-transform duration-700"
                          width={600} height={192}
                          loading="lazy"
                          fetchpriority={articleIdx < 3 ? 'high' : 'low'}
                          decoding="async"
                          rootMargin="400px"
                          placeholder="shimmer"
                          objectFit="cover"
                        />
                        {/* Category badge */}
                        <div className="absolute top-3 left-3">
                          <span className="inline-block px-2.5 py-1 rounded-full text-[11px] font-semibold bg-background-50/85 text-foreground-800 backdrop-blur-sm border border-background-200/50 shadow-sm">
                            {article.category}
                          </span>
                        </div>
                        {isPopular && (
                          <div className="absolute top-3 right-3">
                            <span className="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[11px] font-bold bg-accent-500 text-white shadow-sm">
                              <i className="ri-fire-line text-[10px]"></i>
                              {isEn ? 'Popular' : 'Populaire'}
                            </span>
                          </div>
                        )}
                        {!isPopular && (
                          <div className="absolute top-3 right-3">
                            <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-background-50/85 text-foreground-600 backdrop-blur-sm border border-background-200/50 shadow-sm">
                              {articleIsEn ? 'EN' : 'FR'}
                            </span>
                          </div>
                        )}
                        {article.views !== undefined && (
                          <div className="absolute bottom-3 right-3 flex items-center gap-1 bg-foreground-950/60 backdrop-blur-sm text-white text-[11px] px-2.5 py-1 rounded-full">
                            <i className="ri-eye-line text-[10px]"></i>
                            <span>{formatViews(article.views)}</span>
                          </div>
                        )}
                      </div>

                      {/* Content */}
                      <div className="p-5 flex flex-col flex-1">
                        {/* Meta line */}
                        <div className="flex items-center gap-3 mb-3 pb-3 border-b border-background-200 flex-shrink-0">
                          <div className="w-7 h-7 rounded-full overflow-hidden border border-gold-300 flex-shrink-0">
                            <img
                              src={optimizeImageUrl("https://readdy.ai/api/search-image?query=Professional%20African%20business%20consultant%20expert%20portrait%20headshot%20formal%20attire%20confident%20smile%20studio%20lighting%20corporate%20executive%20leadership&width=80&height=80&seq=simda-author-photo&orientation=squarish")}
                              alt="SIMDA" className="w-full h-full object-cover" width={28} height={28} loading="lazy" decoding="async"
                            />
                          </div>
                          <div className="flex-1 min-w-0">
                            <p className="text-xs font-semibold text-foreground-950 truncate">SIMDA Essoyomèwè</p>
                          </div>
                          <div className="flex items-center gap-2 text-xs text-foreground-400 flex-shrink-0">
                            <i className="ri-calendar-line text-[10px]"></i>
                            <span>{article.date}</span>
                            <span className="text-foreground-300">·</span>
                            <i className="ri-time-line text-[10px]"></i>
                            <span className="whitespace-nowrap">{article.readTime}</span>
                          </div>
                        </div>

                        {/* Title + excerpt */}
                        <h3 className="font-bold text-foreground-950 mb-2 line-clamp-2 group-hover:text-accent-700 transition-colors text-[15px] leading-snug flex-shrink-0">
                          {article.title}
                        </h3>
                        <p className="text-foreground-500 mb-4 line-clamp-2 text-sm leading-relaxed flex-shrink-0">{article.excerpt}</p>

                        {/* Tags */}
                        {article.tags && article.tags.length > 0 && (
                          <div className="mb-3 flex-shrink-0" onClick={e => e.stopPropagation()}>
                            <ArticleTags
                              tags={article.tags.slice(0, 3)}
                              selectedTag={filters.tag}
                              onTagClick={(tag) => handleFiltersChange({ ...filters, tag: filters.tag === tag ? null : tag })}
                              size="sm"
                              clickable
                            />
                          </div>
                        )}

                        {/* Bottom actions */}
                        <div className="mt-auto flex items-center justify-between pt-2 border-t border-background-100 flex-shrink-0">
                          <span className="flex items-center gap-1.5 text-accent-700 font-semibold group-hover:gap-2.5 transition-all text-sm">
                            {t('blogPage.readArticle')}
                            <i className="ri-arrow-right-line text-xs"></i>
                          </span>
                          <div className="flex items-center gap-1.5" onClick={e => e.stopPropagation()}>
                            <button
                              onClick={(e) => handleCopyLink(e, article.id)}
                              title={isEn ? 'Copy link' : 'Copier le lien'}
                              className={`whitespace-nowrap inline-flex items-center gap-1 text-[11px] font-semibold px-2.5 py-1 rounded-full transition-all duration-200 cursor-pointer ${
                                copiedId === article.id
                                  ? 'bg-emerald-500 text-white'
                                  : 'bg-background-100 text-foreground-500 hover:bg-background-200'
                              }`}
                            >
                              <div className="w-3 h-3 flex items-center justify-center">
                                <i className={copiedId === article.id ? 'ri-check-line text-[10px]' : 'ri-links-line text-[10px]'}></i>
                              </div>
                              {copiedId === article.id ? (isEn ? 'Copied!' : 'Copié !') : ''}
                            </button>
                            <a
                              href={linkedInUrl}
                              target="_blank"
                              rel="noopener noreferrer"
                              onClick={e => e.stopPropagation()}
                              title={isEn ? 'Share on LinkedIn' : 'Partager sur LinkedIn'}
                              className="whitespace-nowrap inline-flex items-center gap-1 text-[11px] font-semibold px-2.5 py-1 rounded-full bg-[#0A66C2]/10 text-[#0A66C2] hover:bg-[#0A66C2] hover:text-white transition-all duration-200 cursor-pointer"
                            >
                              <div className="w-3 h-3 flex items-center justify-center">
                                <i className="ri-linkedin-fill text-[10px]"></i>
                              </div>
                            </a>
                          </div>
                        </div>
                      </div>
                    </div>
                  </ScrollReveal>
                );
              })}
            </div>
          )}

          {/* ── Pagination ── */}
          {totalPages > 1 && filteredArticles.length > 0 && (
            <div className="flex items-center justify-center gap-2 mt-14 flex-wrap">
              <button
                onClick={() => handlePageChange(currentPage - 1)}
                disabled={currentPage <= 1}
                className="whitespace-nowrap inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl border border-background-200 text-sm font-medium text-foreground-600 hover:bg-background-100 disabled:opacity-40 disabled:cursor-not-allowed transition-colors cursor-pointer"
              >
                <i className="ri-arrow-left-line"></i>
                {isEn ? 'Prev' : 'Préc.'}
              </button>

              {Array.from({ length: totalPages }, (_, i) => i + 1)
                .filter(page => {
                  if (totalPages <= 7) return true;
                  if (page === 1 || page === totalPages) return true;
                  if (Math.abs(page - currentPage) <= 2) return true;
                  return false;
                })
                .reduce<(number | 'ellipsis')[]>((acc, page, idx, arr) => {
                  if (idx > 0 && (page as number) - (arr[idx - 1] as number) > 1) acc.push('ellipsis');
                  acc.push(page);
                  return acc;
                }, [])
                .map((item, idx) =>
                  item === 'ellipsis' ? (
                    <span key={`ellipsis-${idx}`} className="px-2 text-foreground-400 text-sm select-none">…</span>
                  ) : (
                    <button
                      key={item}
                      onClick={() => handlePageChange(item as number)}
                      className={`whitespace-nowrap inline-flex items-center justify-center w-10 h-10 rounded-xl text-sm font-semibold transition-colors cursor-pointer ${
                        currentPage === item
                          ? 'bg-foreground-950 text-background-50'
                          : 'border border-background-200 text-foreground-700 hover:bg-background-100'
                      }`}
                    >
                      {item}
                    </button>
                  )
                )}

              <button
                onClick={() => handlePageChange(currentPage + 1)}
                disabled={currentPage >= totalPages}
                className="whitespace-nowrap inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl border border-background-200 text-sm font-medium text-foreground-600 hover:bg-background-100 disabled:opacity-40 disabled:cursor-not-allowed transition-colors cursor-pointer"
              >
                {isEn ? 'Next' : 'Suiv.'}
                <i className="ri-arrow-right-line"></i>
              </button>

              <span className="text-xs text-foreground-400 ml-3">
                {isEn
                  ? `Page ${currentPage} of ${totalPages} — ${totalArticles} articles`
                  : `Page ${currentPage} sur ${totalPages} — ${totalArticles} articles`}
              </span>
            </div>
          )}
        </div>
      </div>

      {/* ═══════════════════════════════════════════ BOTTOM SECTIONS ═══════════════════════════════════════════ */}
      <LazySection rootMargin="200px" minHeight="400px">
        <BlogNewsletterBanner />
      </LazySection>
      <LazySection rootMargin="200px" minHeight="300px">
        <BlogRelatedLinks />
      </LazySection>
      <LazySection rootMargin="200px" minHeight="400px">
        <BUBilingualCrossLinks />
      </LazySection>
      <LazySection rootMargin="200px" minHeight="400px">
        <NewsletterSection />
      </LazySection>

      {/* Share */}
      <section className="py-12 bg-background-100">
        <div className="max-w-7xl mx-auto px-6 lg:px-8">
          <SocialSharePremium
            url={`${SITE_URL}/blog/`}
            title={isEn ? 'KHEPRA EXPERTS Blog — Strategic Insights for African Leaders' : 'KHEPRA EXPERTS Blog — Analyses Stratégiques pour Décideurs Africains'}
            description={isEn ? 'Expert analyses on governance, finance, compliance and entrepreneurship in Francophone Africa.' : 'Analyses d\'expert sur la gouvernance, la finance, la conformité et l\'entrepreneuriat en Afrique francophone.'}
            variant="horizontal"
            className="justify-center"
          />
        </div>
      </section>

      {/* ── CTA ── */}
      <section className="py-20 relative overflow-hidden bg-foreground-950">
        <div className="absolute inset-0">
          <div className="absolute top-10 right-10 w-96 h-96 bg-gold-400/15 rounded-full blur-3xl"></div>
          <div className="absolute bottom-10 left-10 w-96 h-96 bg-foreground-800 rounded-full blur-3xl"></div>
        </div>
        <div className="relative z-10 max-w-3xl mx-auto px-6 lg:px-8 text-center">
          <div className="inline-flex items-center justify-center w-16 h-16 bg-gold-500/15 rounded-2xl mb-6">
            <i className="ri-lightbulb-flash-line text-gold-400 text-3xl"></i>
          </div>
          <h2 className="text-3xl lg:text-4xl font-bold text-white mb-4">
            {isEn ? 'Transform Your Strategic Challenges' : 'Transformez Vos Défis Stratégiques'}
          </h2>
          <p className="text-lg text-white/60 leading-relaxed max-w-xl mx-auto mb-10">
            {isEn
              ? "Get a free 30-minute strategic diagnosis to identify transformation levers and accelerate your organization's performance."
              : "Obtenez un diagnostic stratégique gratuit de 30 minutes pour identifier les leviers de transformation et accélérer la performance de votre organisation."}
          </p>
          <button
            onClick={() => navigate('/#diagnostic-offer')}
            className="inline-flex items-center gap-2 bg-gold-500 text-foreground-950 px-8 py-4 rounded-xl hover:bg-gold-400 transition-all font-semibold text-base whitespace-nowrap cursor-pointer shadow-xl shadow-gold-900/20"
          >
            {isEn ? 'Request My Strategic Diagnosis' : 'Demander Mon Diagnostic Stratégique'}
            <i className="ri-arrow-right-line"></i>
          </button>
          <div className="flex flex-wrap items-center justify-center gap-6 text-white/40 text-sm mt-8">
            <div className="flex items-center gap-2">
              <i className="ri-shield-check-line text-gold-400/70 text-lg"></i>
              <span>{isEn ? 'Confidential exchange' : 'Échange confidentiel'}</span>
            </div>
            <div className="flex items-center gap-2">
              <i className="ri-time-line text-gold-400/70 text-lg"></i>
              <span>30 minutes</span>
            </div>
            <div className="flex items-center gap-2">
              <i className="ri-user-star-line text-gold-400/70 text-lg"></i>
              <span>{isEn ? 'Dedicated expert' : 'Expert dédié'}</span>
            </div>
            <div className="flex items-center gap-2">
              <i className="ri-calendar-check-line text-gold-400/70 text-lg"></i>
              <span>{isEn ? 'Response within 24h' : 'Réponse sous 24h'}</span>
            </div>
          </div>
        </div>
      </section>

      <Footer />
    </div>
  );
}






