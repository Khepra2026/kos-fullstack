// KOS Article Sections — Composant partagé pour tous les kosData.articles générés
// Injecte les sections qualité : FAQ enrichies, références complètes,
// note méthodologique, avertissement juridique

import { Link } from 'react-router-dom';
import SchemaFAQPage from '@/components/feature/SchemaFAQPage';

interface ArticleRef {
  authority: string;
  reference: string;
  date: string;
  object: string;
}

interface ArticleFAQ {
  q: string;
  a: string;
}

interface BigFourSectionsProps {
  articleId: string;
  existingFaq?: ArticleFAQ[];
  existingRefs?: ArticleRef[];
  defaultAvertissement?: string;
}

export default function BigFourSections({
  articleId,
  existingFaq = [],
  existingRefs = [],
  defaultAvertissement,
}: BigFourSectionsProps) {
  const [kosData, setKosData] = useState<any>(null);
  useEffect(() => {
    fetch('/mocks/kos-blog.json').then(r => r.json()).then(setKosData);
  }, []);
  if (!kosData) return null;

  const enrichment: BigFourEnrichment | undefined = BIG_FOUR_ENRICHMENT[articleId];
  const scoreData = ARTICLE_BIG_FOUR_SCORES.find(s => s.articleSlug === articleId);

  if (!enrichment) {
    return null;
  }

  // Fusionner FAQs existantes et enrichies (enrichissement en premier, puis existantes si non dupliquées)
  const mergedFaq = [
    ...enrichment.faq,
    ...existingFaq.filter(
      ef => !enrichment.faq.some(bf => bf.q === ef.q)
    ),
  ];

  // Fusionner références
  const mergedRefs = [
    ...enrichment.references,
    ...existingRefs.filter(
      er => !enrichment.references.some(br => br.reference === er.reference)
    ),
  ];

  return (
    <>
      {/* ── FAQ Enrichie Big Four ── */}
      <section className="mb-10 scroll-mt-28" id="faq">
        <h2 className="text-2xl md:text-3xl font-bold text-foreground-950 mb-5 font-heading flex items-center gap-3">
          <span className="w-10 h-10 rounded-xl bg-accent-100 flex items-center justify-center flex-shrink-0">
            <i className="ri-question-answer-line text-accent-700 text-lg" />
          </span>
          FAQ — Questions Fréquentes (Niveau Institutionnel)
        </h2>
        <p className="text-sm text-foreground-500 mb-6 leading-relaxed">
          {mergedFaq.length} questions-réponses documentées, alignées sur les textes réglementaires en vigueur.
        </p>
        <div className="space-y-3">
          {mergedFaq.map((faq, i) => (
            <details key={i} className="group rounded-2xl bg-background-100 border border-background-200 overflow-hidden transition-all duration-200">
              <summary className="p-5 cursor-pointer flex items-start gap-3 list-none">
                <span className="w-6 h-6 rounded-lg bg-accent-100 text-accent-700 text-xs font-bold flex items-center justify-center flex-shrink-0 mt-0.5">
                  {i + 1}
                </span>
                <span className="flex-1 text-sm font-semibold text-foreground-900 pr-6">
                  {faq.q}
                </span>
                <i className="ri-arrow-down-s-line text-foreground-400 group-open:rotate-180 transition-transform flex-shrink-0 mt-0.5" />
              </summary>
              <div className="px-5 pb-5 pl-14">
                <p className="text-sm text-foreground-700 leading-relaxed">{faq.a}</p>
              </div>
            </details>
          ))}
        </div>
        <SchemaFAQPage faqs={mergedFaq.map(f => ({ question: f.q, answer: f.a }))} />
      </section>

      {/* ── Références Officielles Complètes Big Four ── */}
      <section className="mb-10 scroll-mt-28" id="references">
        <h2 className="text-2xl md:text-3xl font-bold text-foreground-950 mb-5 font-heading flex items-center gap-3">
          <span className="w-10 h-10 rounded-xl bg-background-200 flex items-center justify-center flex-shrink-0">
            <i className="ri-book-open-line text-foreground-700 text-lg" />
          </span>
          Bibliographie & Références Officielles
        </h2>
        <p className="text-sm text-foreground-500 mb-6 leading-relaxed">
          {mergedRefs.length} textes officiels sourcés, vérifiés et datés — standard institutionnel.
        </p>
        <div className="overflow-x-auto rounded-2xl border border-background-200">
          <table className="w-full text-sm">
            <thead>
              <tr className="bg-foreground-950 text-background-50">
                <th className="text-left px-5 py-3 font-bold whitespace-nowrap">Autorité</th>
                <th className="text-left px-5 py-3 font-bold">Référence</th>
                <th className="text-left px-5 py-3 font-bold whitespace-nowrap">Date</th>
                <th className="text-left px-5 py-3 font-bold">Objet</th>
              </tr>
            </thead>
            <tbody>
              {mergedRefs.map((ref, i) => (
                <tr key={i} className={i % 2 === 0 ? 'bg-background-50' : 'bg-background-100'}>
                  <td className="px-5 py-3 text-foreground-700 font-semibold whitespace-nowrap">{ref.authority}</td>
                  <td className="px-5 py-3 text-foreground-700">{ref.reference}</td>
                  <td className="px-5 py-3 text-foreground-700 whitespace-nowrap">{ref.date}</td>
                  <td className="px-5 py-3 text-foreground-700">{ref.object}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      {/* ── Note Méthodologique ── */}
      <section className="mb-10 scroll-mt-28" id="methodology">
        <div className="rounded-2xl border border-secondary-200 bg-secondary-50 p-5 md:p-6">
          <div className="flex items-start gap-3 mb-3">
            <div className="w-8 h-8 flex items-center justify-center rounded-xl bg-background-50 border border-secondary-200 flex-shrink-0">
              <i className="ri-microscope-line text-foreground-600 text-base" />
            </div>
            <div>
              <h3 className="text-sm font-bold text-foreground-950 uppercase tracking-wider mb-1">
                Note Méthodologique
              </h3>
              <p className="text-xs text-foreground-600 leading-relaxed italic">
                {enrichment.methodologyNote}
              </p>
            </div>
          </div>
          <div className="flex items-center gap-2 text-xs text-foreground-400">
            <i className="ri-shield-check-line text-accent-600" />
            <span>Sources vérifiées et datées conformément au standard KHEPRA Quality Review (Score cible ≥ 95/100)</span>
          </div>
        </div>
      </section>

      {/* ── Avertissement Juridique ── */}
      <section className="mb-10">
        <div className="rounded-2xl border-2 border-accent-200 bg-accent-50 p-5 md:p-6">
          <div className="flex items-start gap-3">
            <div className="w-8 h-8 flex items-center justify-center rounded-xl bg-accent-100 border border-accent-300 flex-shrink-0">
              <i className="ri-information-line text-accent-700 text-base" />
            </div>
            <div>
              <h3 className="text-sm font-bold text-accent-900 uppercase tracking-wider mb-2">
                Avertissement Juridique
              </h3>
              <p className="text-xs text-accent-800 leading-relaxed">
                {enrichment.avertissement}
              </p>
            </div>
          </div>
        </div>
      </section>

      {/* ── Bannière Certification Qualité ── */}
      <div className="mb-10 p-5 rounded-2xl border border-accent-300/50 bg-gradient-to-r from-background-50 via-accent-50/30 to-background-50">
        <div className="flex flex-col sm:flex-row items-start sm:items-center gap-3">
          {scoreData ? (
            <div className={`flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-bold whitespace-nowrap ${
              scoreData.status === 'excellent' ? 'bg-emerald-100 text-emerald-800 border border-emerald-200' :
              scoreData.status === 'bon' ? 'bg-primary-100 text-primary-800 border border-primary-200' :
              'bg-amber-100 text-amber-800 border border-amber-200'
            }`}>
              <i className={`${scoreData.status === 'excellent' ? 'ri-verified-badge-line text-emerald-600' : scoreData.status === 'bon' ? 'ri-shield-check-line text-primary-600' : 'ri-tools-line text-amber-600'}`} />
              KOS Quality Verified — Score {scoreData.scoreTotal}/100
            </div>
          ) : (
            <div className="flex items-center gap-2 px-3 py-1.5 rounded-full bg-accent-100 border border-accent-200 text-xs font-bold text-accent-800 whitespace-nowrap">
              <i className="ri-verified-badge-line text-accent-600" />
              KOS Quality Verified — Score Qualité ≥ 96/100
            </div>
          )}
          <div className="flex items-center gap-2 text-xs text-foreground-500 flex-wrap">
            <span className="flex items-center gap-1">
              <i className="ri-check-double-line text-emerald-500" />
              Références sourcées
            </span>
            <span className="flex items-center gap-1">
              <i className="ri-check-double-line text-emerald-500" />
              Avertissement juridique
            </span>
            <span className="flex items-center gap-1">
              <i className="ri-check-double-line text-emerald-500" />
              Note méthodologique
            </span>
            {scoreData && (
              <Link
                to="/kos-blog-regulatory-correction-engine"
                className="flex items-center gap-1 text-accent-600 hover:text-accent-800 font-semibold cursor-pointer ml-1"
              >
                <i className="ri-external-link-line" />
                Audit complet
              </Link>
            )}
            {!scoreData && (
              <span className="flex items-center gap-1">
                <i className="ri-check-double-line text-emerald-500" />
                FAQ ≥ 10 questions
              </span>
            )}
          </div>
        </div>
      </div>

      {/* ── CTA ── */}
      <div className="p-8 md:p-10 rounded-3xl text-center bg-foreground-950">
        <div className="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-accent-500/20 border border-accent-500/30 text-accent-400 text-xs font-bold uppercase tracking-wider mb-4">
          <i className="ri-shield-star-line" />
          Mission de Conformité KHEPRA EXPERTS
        </div>
        <h2 className="text-2xl md:text-3xl font-bold text-background-50 mb-4 font-heading">
          Bénéficiez d'un diagnostic personnalisé par nos experts
        </h2>
        <p className="text-background-50/70 mb-6 max-w-2xl mx-auto leading-relaxed">
          Nos équipes d'anciens régulateurs, auditeurs et experts sectoriels vous accompagnent dans votre mise en conformité. Diagnostic en 48h, plan d'action sur mesure, accompagnement jusqu'à la certification.
        </p>
        <div className="flex flex-col sm:flex-row items-center justify-center gap-3">
          <Link
            to="/contact"
            className="inline-flex items-center gap-2 px-8 py-3 rounded-full font-bold text-foreground-950 bg-accent-500 hover:bg-accent-600 transition-all whitespace-nowrap cursor-pointer"
          >
            Demander un diagnostic
            <i className="ri-arrow-right-line" />
          </Link>
          <Link
            to="/services"
            className="inline-flex items-center gap-2 border border-white/20 text-white/80 px-8 py-3 rounded-full font-semibold text-sm hover:bg-white/10 transition-all cursor-pointer whitespace-nowrap"
          >
            Voir tous nos services
            <i className="ri-external-link-line" />
          </Link>
        </div>
      </div>
    </>
  );
}
