
interface AccessibilityCheck {
  check: string;
  passRate: number;
  totalElements: number;
  failures: number;
  severity: string;
}

interface AccessibilityTabProps {
  accessibility?: AccessibilityCheck[];
  isLive?: boolean;
}

export default function AccessibilityTab({ accessibility: propAccessibility, isLive }: AccessibilityTabProps) {
  const [kosData, setKosData] = useState<any>(null);
  useEffect(() => {
    fetch('/mocks/kos-blog.json').then(r => r.json()).then(setKosData);
  }, []);
  if (!kosData) return null;

  const accessibilityAudit = propAccessibility || mockAccessibility;

  return (
    <div className="space-y-8">
      {/* Live kosData.Data Badge */}
      {isLive !== undefined && (
        <div className={`inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium ${isLive ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-amber-50 text-amber-700 border border-amber-200'}`}>
          <span className={`w-2 h-2 rounded-full ${isLive ? 'bg-emerald-500 animate-pulse' : 'bg-amber-500'}`}></span>
          {isLive ? 'Données Live — Supabase' : 'Données Mock — Démo'}
        </div>
      )}

      <div className="bg-background-50 rounded-xl border border-background-200/70 p-5">
        <div className="flex items-center gap-3 mb-4">
          <div className="w-10 h-10 flex items-center justify-center rounded-lg bg-accent-100 text-accent-700">
            <i className="ri-wheelchair-line text-lg"></i>
          </div>
          <div>
            <h3 className="text-sm font-semibold text-foreground-950 font-heading">WCAG 2.2 AA — Conformité Accessibilité</h3>
            <p className="text-xs text-foreground-500 font-body">Score cible Lighthouse Accessibilité ≥ 100</p>
          </div>
        </div>

        <div className="space-y-3">
          {accessibilityAudit.map((check, i) => {
            const isPass = check.passRate >= 95;
            const colorBar = check.passRate >= 95 ? 'bg-emerald-500' : check.passRate >= 85 ? 'bg-amber-500' : 'bg-red-500';
            const severityColor = check.severity === 'critical' ? 'bg-red-100 text-red-700' : check.severity === 'high' ? 'bg-amber-100 text-amber-700' : check.severity === 'medium' ? 'bg-primary-100 text-primary-700' : 'bg-secondary-100 text-secondary-700';
            return (
              <div key={i} className="bg-background-100 rounded-xl border border-background-200/70 p-4">
                <div className="flex items-start justify-between mb-2">
                  <div className="flex items-center gap-2">
                    <span className={`w-2 h-2 rounded-full ${isPass ? 'bg-emerald-500' : check.passRate >= 85 ? 'bg-amber-500' : 'bg-red-500'}`}></span>
                    <span className="text-sm font-medium text-foreground-950 font-body">{check.check}</span>
                  </div>
                  <div className="flex items-center gap-2 shrink-0">
                    <span className={`px-1.5 py-0.5 rounded-full text-[9px] font-semibold font-body ${severityColor}`}>{check.severity}</span>
                    <span className={`text-sm font-bold font-heading ${isPass ? 'text-emerald-600' : 'text-amber-600'}`}>{check.passRate}%</span>
                  </div>
                </div>
                <div className="h-1.5 bg-background-200 rounded-full overflow-hidden mb-2">
                  <div className={`h-full rounded-full ${colorBar}`} style={{ width: `${check.passRate}%` }}></div>
                </div>
                <div className="flex items-center justify-between text-[10px] text-foreground-500 font-body">
                  <span>{check.totalElements} éléments testés</span>
                  <span>{check.failures > 0 ? `${check.failures} échec(s)` : 'Aucun échec'}</span>
                </div>
              </div>
            );
          })}
        </div>

        <div className="mt-4 p-4 bg-emerald-50 rounded-xl border border-emerald-200">
          <div className="flex items-center justify-between">
            <div className="flex items-center gap-2">
              <i className="ri-check-double-line text-emerald-600"></i>
              <span className="text-sm font-semibold text-emerald-900 font-heading">Score Accessibilité Global — WCAG 2.2 AA</span>
            </div>
            <span className="text-lg font-bold text-emerald-700 font-heading">
              {Math.round(accessibilityAudit.reduce((s, c) => s + c.passRate, 0) / accessibilityAudit.length)}%
            </span>
          </div>
        </div>
      </div>
    </div>
  );
}
