import { useState, useEffect, useCallback } from 'react';
import { supabase } from '@/lib/supabase';

export type { KOSReferentMetierAutomate, ReferentMetierCategory };

export interface ReferentsMetiersKPIs {
  total_agents: number;
  deployed: number;
  partial: number;
  mock: number;
  auto_enabled: number;
  total_interactions: number;
  total_visitors_helped: number;
  total_deals_closed: number;
  overall_conversion_rate: number;
  avg_response_time_ms: number;
  total_tasks: number;
  avg_success_rate: number;
  critical_agents: number;
  high_priority: number;
  medium_priority: number;
  categories: number;
  languages: number;
  revenue_generated: number;
}

export interface ReferentsMetiersData {
  automates: KOSReferentMetierAutomate[];
  categories: ReferentMetierCategory[];
  kpis: ReferentsMetiersKPIs;
  isLive: boolean;
}

function mapAutomate(row: Record<string, unknown>): KOSReferentMetierAutomate {
  return {
    id: row.id as string,
    name: row.name as string,
    category: row.category as string,
    tech_stack: typeof row.tech_stack === 'string' ? (row.tech_stack ? row.tech_stack.split(',').map((s: string) => s.trim()) : []) : Array.isArray(row.tech_stack) ? row.tech_stack as string[] : [],
    status: row.status as KOSReferentMetierAutomate['status'],
    version: row.version as string,
    description: row.description as string,
    capabilities: typeof row.capabilities === 'string' ? (row.capabilities ? row.capabilities.split(',').map((s: string) => s.trim()) : []) : Array.isArray(row.capabilities) ? row.capabilities as string[] : [],
    success_rate: Number(row.success_rate),
    tasks_completed: Number(row.tasks_completed),
    interactions_count: Number(row.interactions_count),
    visitors_helped: Number(row.visitors_helped),
    deals_closed: Number(row.deals_closed),
    conversion_rate: Number(row.conversion_rate),
    auto_enabled: Boolean(row.auto_enabled),
    icon: row.icon as string,
    color: row.color as string,
    last_execution: row.last_execution as string,
    priority: row.priority as KOSReferentMetierAutomate['priority'],
    languages: typeof row.languages === 'string' ? (row.languages ? row.languages.split(',').map((s: string) => s.trim()) : []) : Array.isArray(row.languages) ? row.languages as string[] : [],
    availability: row.availability as string,
    response_time_avg_ms: Number(row.response_time_avg_ms),
    kpis: Array.isArray(row.kpis) ? row.kpis as KOSReferentMetierAutomate['kpis'] : [],
  };
}

export function useReferentsMetiersAutomates() {
  const [kosData.data, setData] = useState<ReferentsMetiersData>({
    automates: [],
    categories: [],
    kpis: { total_agents: 0, deployed: 0, partial: 0, mock: 0, auto_enabled: 0, total_interactions: 0, total_visitors_helped: 0, total_deals_closed: 0, overall_conversion_rate: 0, avg_response_time_ms: 0, total_tasks: 0, avg_success_rate: 0, critical_agents: 0, high_priority: 0, medium_priority: 0, categories: 0, languages: 0, revenue_generated: 0 },
    isLive: false,
  });
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  const fetchData = useCallback(async () => {
    setLoading(true);
    setError(null);

    try {
      const { data: automates, error: err } = await supabase
        .from('kos_referents_metiers_automates')
        .select('*')
        .order('success_rate', { ascending: false });

      if (err) throw err;

      const rows = (automates as Record<string, unknown>[]) || [];
      const mapped = rows.map(mapAutomate);
      const hasData = mapped.length > 0;

      const deployedCount = mapped.filter(a => a.status === 'deployed').length;

      const computedKPIs: ReferentsMetiersKPIs = {
        total_agents: mapped.length,
        deployed: deployedCount,
        partial: mapped.filter(a => a.status === 'partial').length,
        mock: mapped.filter(a => a.status === 'mock').length,
        auto_enabled: mapped.filter(a => a.auto_enabled).length,
        total_interactions: mapped.reduce((s, a) => s + (a.interactions_count || 0), 0),
        total_visitors_helped: mapped.reduce((s, a) => s + (a.visitors_helped || 0), 0),
        total_deals_closed: mapped.reduce((s, a) => s + (a.deals_closed || 0), 0),
        overall_conversion_rate: mapped.filter(a => a.deals_closed > 0).length > 0 ? Math.round(mapped.reduce((s, a) => s + (a.conversion_rate || 0), 0) / mapped.filter(a => a.deals_closed > 0).length * 10) / 10 : 0,
        avg_response_time_ms: mapped.length > 0 ? Math.round(mapped.reduce((s, a) => s + (a.response_time_avg_ms || 0), 0) / mapped.length) : 0,
        total_tasks: mapped.reduce((s, a) => s + (a.tasks_completed || 0), 0),
        avg_success_rate: mapped.length > 0 ? Math.round(mapped.reduce((s, a) => s + a.success_rate, 0) / mapped.length * 10) / 10 : 0,
        critical_agents: mapped.filter(a => a.priority === 'critical').length,
        high_priority: mapped.filter(a => a.priority === 'high').length,
        medium_priority: mapped.filter(a => a.priority === 'medium').length,
        categories: [...new Set(mapped.map(a => a.category))].length,
        languages: 3,
        revenue_generated: mapped.reduce((s, a) => s + ((a.deals_closed || 0) * 18000), 0),
      };

      setData({
        automates: mapped,
        categories: mockCategories,
        kpis: computedKPIs,
        isLive: hasData,
      });
    } catch (err: unknown) {
      const message = err instanceof Error ? err.message : 'Erreur inconnue';
      setError(message);
      setData({
        automates: mockAutomates,
        categories: mockCategories,
        kpis: mockKPIs as ReferentsMetiersKPIs,
        isLive: false,
      });
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    fetchData();
  }, [fetchData]);

  return { ...kosData.data, loading, error, refetch: fetchData };
}
