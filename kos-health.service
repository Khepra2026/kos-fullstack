# ═══════════════════════════════════════════════════════════════
# KOS SELF-HEALING — Service de vérification périodique
# Appelé par kos-health.timer toutes les 5 minutes
# Fichier : /etc/systemd/system/kos-health.service
# ═══════════════════════════════════════════════════════════════

[Unit]
Description=KOS Self-Healing — Auto-réparation des conteneurs Docker
Documentation=https://khepra-experts.com
After=kos-stack.service

[Service]
Type=oneshot
ExecStart=/usr/bin/bash /opt/kos-stack/kos-health-check.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kos-health

# Timeout généreux pour les restart/recréations
TimeoutStartSec=300s

# L'utilisateur doit avoir accès à Docker
User=root
Group=docker

[Install]
WantedBy=multi-user.target