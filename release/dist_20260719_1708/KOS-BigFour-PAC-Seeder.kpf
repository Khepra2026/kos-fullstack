  "files": {
    "workflow_jira_automation": {
      "path": "/jira-automation/kos-pac-workflow.json",
      "description": "Workflow Jira Automation importable. Incoming Webhook → Create Issue (13 champs) → Comment Big Four → Alerte DG Highest/High → Création page Confluence → Link evidence.",
      "usage": "Project Settings > Automation > Import rule > Sélectionner ce fichier",
      "actions": [
        "Create Issue (13 champs mappés: project, issuetype, summary, description, priority, labels, duedate, components, cf[10001], cf[10002], cf[10003])",
        "Comment Big Four (Quality Gates + RACI + SLA + Execution ID)",
        "Alerte DG (si Highest ou High — escalade J+1 ISA 265)",
        "Create Confluence Page (Evidence Pack ISA 265 / ISAE 3000)",
        "Edit Issue (customfield_10004 = lien Confluence)",
        "Comment Confluence Link (Panels CWV + GSC + Dette)"
      ]
    },
    "postman_collection": {
      "path": "/jira-automation/kos-pac-postman-collection.json",
      "description": "Collection Postman v2.1 pour tester le webhook KOS → Jira en 1 clic. Simule KHEPRA DD™ Phase 2 qui pousse un Red Flag SOC2-CC6.1 High.",
      "usage": "File > Import > Choisir ce fichier > Configurer {{jira_webhook_url}}",
      "tests": [
        "CWV LCP <2000ms",
        "HTTP 200/201/204",
        "Priority = High",
        "SLA 30j respecté (duedate = detection + 30j)",
        "ISAE 3000 assignee ≠ reporter",
        "ISAE 3000 validator ≠ reporter",
        "SOC 2 Labels inclut SOC2-CC61",
        "GSC Summary [STD][CRIT] Title",
        "CWV Description <32KB",
        "Big Four Customfields 10001/10002/10003 mappés"
      ]
    },
    "confluence_template": {
      "path": "/jira-automation/kos-pac-confluence-template.html",
      "description": "Template Confluence Evidence Pack complet. 8 sections ISA 265 + ISAE 3000. Copie-colle dans Confluence ou auto-généré par Jira Automation.",
      "usage": "Insertion > Markup dans Confluence > Coller le contenu > Remplacer {{placeholders}}",
      "sections": [
        "Section 1 — Finding Summary (ID, Standard, Criticité, RACI)",
        "Section 2 — Root Cause Analysis (ISAE 3000 Panel)",
        "Section 3 — Risk Impact (Matérialité Financière & Réglementaire)",
        "Section 4 — Evidence Avant (SSAE 18, Capture + Commande Bash)",
        "Section 5 — Actions Correctives (Immédiate + LT + SLA dueDate)",
        "Section 6 — Test d'Audit (SOC 2 CC8.1, Procédure Bash)",
        "Section 7 — Evidence Après (Audit Trail, Lien Jira)",
        "Section 8 — Sign-off (RACI ISAE 3000, Séparation Vérifiée)"
      ]
    },
    "validate_script": {
      "path": "/jira-automation/kos-validate-bigfour-seeding.js",
      "description": "Script Node.js de validation Pre-Flight. Vérifie que Jira est 100% configuré avant d'importer le KPF. 10 checks: projet, issuetype, customfields, components, reporter, permissions, CWV, GSC, ISAE 3000.",
      "usage": "node validate_bigfour_seeding.js (prérequis: JIRA_BASE_URL, JIRA_EMAIL, JIRA_API_TOKEN en env)",
      "checks": [
        "PROJ — Projet KOS existe",
        "ISSUETYPE — IssueType Task existe",
        "Customfields 10001/10002/10003",
        "Components KOS-Prod/KHEPRA-DD/Security/Compliance",
        "REPORTER — kos-audit@ existe (ISAE 3000)",
        "PERM — Permissions Automation (CREATE_ISSUES)",
        "CWV — ADF template <32KB (LCP <2.5s garanti)",
        "GSC — Format summary [STD][CRIT] compliant",
        "ISAE3000 — Séparation assignee!=reporter"
      ]
    },
    "cli_one_liner": {
      "path": "/jira-automation/kos-cli-one-liner.sh",
      "description": "One-liner CLI bash — Validation + Import Auto du KPF en 1 commande. Gate ISAE 3000 bloque si FAIL. Auto-activation + rollback on error. Notification #kos-alerts si échec.",
      "usage": "export KOS_API_TOKEN=... && bash kos-cli-one-liner.sh",
      "etapes": [
        "1. curl validate_bigfour_seeding → /tmp/kos_validate.json (preuve ISA 265)",
        "2. jq gate ISAE 3000 : bloque si bigfour_compliant=false",
        "3. curl packs/import → auto_activate + rollback_on_error",
        "4. Confirmation + résumé des components chargés",
        "5. Si FAIL → curl notify #kos-alerts Critical + diagnostic"
      ]
    },
    "cron_audit": {
      "path": "/jira-automation/kos-cron-audit.sh",
      "description": "Script cron audit continu Big Four (SOC 2 CC7.2 Monitoring Continu). Re-valide tous les lundis 6h. Si FAIL → ticket Jira Critical auto + notification #compliance.",
      "usage": "crontab: 0 6 * * 1 /usr/bin/bash /opt/kos/bin/kos-cron-audit.sh",
      "features": [
        "Re-validation Big Four hebdomadaire (SOC 2 CC7.2)",
        "Détection suppression customfields/components/reporter",
        "Ticket Jira Critical auto si FAIL (SLA J+0)",
        "Notification RSSI/DG immédiate (#compliance)",
        "Rotation automatique des logs (52 semaines)"
      ]
    }
  },
  "jql_dashboard": {
    "dashboard_name": "KOS Big Four PAC",
    "description": "Dashboard Jira avec 6 gadgets JQL natifs. 100% Core Web Vitals — pas de requête lourde.",
    "gadgets": [
      {
        "id": 1,
        "name": "SLA Overdue",
        "jql": "project = KOS AND status not in (Done, Closed) AND duedate < now() ORDER BY priority DESC",
        "objective": "ISA 265 Material Weakness si >0"
      },
      {
        "id": 2,
        "name": "Critical Open",
        "jql": "project = KOS AND priority = Highest AND status != Done",
        "objective": "Escalade DG J+1"
      },
      {
        "id": 3,
        "name": "SOC 2 Coverage",
        "jql": "project = KOS AND labels in (SOC2-CC61, SOC2-CC71, SOC2-CC81)",
        "objective": "Preuve couverture TSC pour audit CPA"
      },
      {
        "id": 4,
        "name": "BCEAO Findings",
        "jql": "project = KOS AND labels = BCEAO-001-04-2018-ART12",
        "objective": "Reporting COBAC"
      },
      {
        "id": 5,
        "name": "CWV Performance",
        "jql": "project = KOS AND labels = CWV AND updated >= -30d",
        "objective": "LCP <2.5s : desc <32KB"
      },
      {
        "id": 6,
        "name": "GSC Santé",
        "jql": "project = KOS AND summary ~ \"[[]*]\" AND status = Done AND resolution = Fixed",
        "objective": "100% tickets GSC-indexables clos"
      }
    ],
    "board_filter": {
      "name": "Board PAC Big Four",
      "jql": "project = KOS AND labels = BigFour ORDER BY CASE priority WHEN \"Highest\" THEN 1 WHEN \"High\" THEN 2 WHEN \"Medium\" THEN 3 ELSE 4 END ASC, duedate ASC",
      "usage": "Partager au régulateur"
    },
    "two_dimension_filter": {
      "x_axis": "priority",
      "y_axis": "customfield_10002 (Criticité)",
      "result": "Matrice Matérialité Big Four"
    }
  },
  "big_four_rules": {
    "description": "Les 8 règles Big Four implémentées dans le PAC Engine",
    "rules": [
      {
        "id": 1,
        "name": "Traçabilité ISA 265",
        "description": "Chaque action a evidence_link vers Confluence ou S3. Obligatoire pour High/Critical.",
        "iso_ref": "ISA 265",
        "implementation": "evidence_link dans meta.quality_gates.isa_265_tracabilite"
      },
      {
        "id": 2,
        "name": "Séparation ISAE 3000",
        "description": "assignee ≠ reporter ≠ validator. RACI: A=R, R=system, C=A.",
        "iso_ref": "ISAE 3000",
        "implementation": "meta.raci: assignee, reporter, validator distincts"
      },
      {
        "id": 3,
        "name": "Matérialité ISA 320",
        "description": "Si impact >50M FCFA ou BCEAO block = priority Highest.",
        "iso_ref": "ISA 320",
        "implementation": "computePriority(): impact_financier_fcfa > 50000000 ou blocage_bceao = true"
      },
      {
        "id": 4,
        "name": "SLA Strict",
        "description": "Critical=15j, High=30j, Medium=60j, Low=90j. dueDate calculé depuis date_detection.",
        "iso_ref": "ISO 9001",
        "implementation": "computeDueDate(): date_detection + slaDays"
      },
      {
        "id": 5,
        "name": "Performance CWV",
        "description": "Description ADF <10KB pour Core Web Vitals Jira. Pas d'images base64.",
        "iso_ref": "Google CWV",
        "implementation": "generateADFDescription(): contenu optimisé, pas de base64, pas d'iframe"
      },
      {
        "id": 6,
        "name": "GSC Indexable",
        "description": "Summary commence par [Standard][Criticité] Title pour SEO interne Jira.",
        "iso_ref": "SEO GSC",
        "implementation": "summary = `[${finding.standard}][${severity}] ${title}`"
      },
      {
        "id": 7,
        "name": "0 Dette Technique",
        "description": "Si champ manque, utiliser labels[] ou components[]. Customfields 10001/10002/10003 uniquement. Jamais créer.",
        "iso_ref": "ISO 27001",
        "implementation": "cf[10001]=Standard, cf[10002]=Criticité, cf[10003]=RootCause"
      },
      {
        "id": 8,
        "name": "Hallucination Gate",
        "description": "Validation Big Four avant output. Si FINDING invalide, retourne FINDING_SCHEMA_INVALID + missing_fields.",
        "iso_ref": "ISO 27001 A.12",
        "implementation": "validateFinding(): vérifie finding_id, title, severity, date_detection, standard"
      }
    ]
  },
  "checklist_mise_en_prod": {
    "description": "6 checks de mise en production — 0 dette technique",
    "checks": [
      {
        "id": 1,
        "check": "Customfields",
        "action": "Vérifier que cf[10001] Standard, cf[10002] Criticité, cf[10003] RootCause existent",
        "command": "GET /rest/api/3/field"
      },
      {
        "id": 2,
        "check": "Webhook",
        "action": "Créer Automation > Incoming webhook > Copier le secret dans l'URL du PAC Engine",
        "command": "Test avec Postman (collection fournie)"
      },
      {
        "id": 3,
        "check": "CWV Performance",
        "action": "Limiter la description Jira à 32KB (le PAC Engine génère déjà <10KB ADF)",
        "command": "description.length < 32000"
      },
      {
        "id": 4,
        "check": "GSC Indexation",
        "action": "Vérifier le format summary = [Standard][Criticité] Title (généré automatiquement)",
        "command": "summary regex ^\\[[A-Z0-9-]*\\]\\[[A-Za-z]*\\]"
      },
      {
        "id": 5,
        "check": "ISAE 3000 Séparation",
        "action": "Règle : assignee.emailAddress != reporter.emailAddress (RACI intégré)",
        "command": "Jira Automation Condition"
      },
      {
        "id": 6,
        "check": "SLA Notification",
        "action": "Automation : J-3 avant dueDate → comment automatique @validator",
        "command": "Big Four SLA"
      }
    ]
  },
