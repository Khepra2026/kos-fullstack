{
  "framework": "nextjs",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/kos/:path*", "destination": "/kos/:path*" },
    { "source": "/app/:path*", "destination": "/app/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://*.supabase.co https://va.vercel-scripts.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co; img-src 'self' data: https:;" }
      ]
    }
  ]
}
