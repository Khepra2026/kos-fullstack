import { useState, useEffect } from 'react';
import { SeoHead } from '@/components/feature/SeoHead';
import { Link } from 'react-router-dom';

interface PlatformField {
  key: string;
  label: string;
  type: string;
  placeholder: string;
  value: string;
  required: boolean;
}

interface PlatformConfig {
  id: string;
  configured: boolean;
  lastSaved: string | null;
  values: Record<string, string>;
}

const STORAGE_KEY = 'kos_external_api_configs';
const CREDENTIALS_EDGE_URL = 'https://pgfwhahiwqvqeahpirjx.supabase.co/functions/v1/kos-platform-credentials';

export default function KOSExternalApiConfigCommandPage() {
  const [kosData, setKosData] = useState<any>(null);
  useEffect(() => {
    fetch('/mocks/kos-blog.json').then(r => r.json()).then(setKosData);
  }, []);
  if (!kosData) return null;

  const [platformConfigs, setPlatformConfigs] = useState<Record<string, PlatformConfig>>({});
  const [expandedPlatform, setExpandedPlatform] = useState<string | null>(null);
  const [savingPlatform, setSavingPlatform] = useState<string | null>(null);
  const [toast, setToast] = useState<{ msg: string; type: 'success' | 'error' } | null>(null);
  const [fieldValues, setFieldValues] = useState<Record<string, Record<string, string>>>({});
  const [syncingPlatform, setSyncingPlatform] = useState<string | null>(null);
  const [supabaseConfigured, setSupabaseConfigured] = useState<Set<string>>(new Set());

  // Load from localStorage on mount, then check Supabase for synced creds
  useEffect(() => {
    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved) {
      try {
        const parsed = JSON.parse(saved) as Record<string, PlatformConfig>;
        setPlatformConfigs(parsed);
        const values: Record<string, Record<string, string>> = {};
        Object.entries(parsed).forEach(([id, config]) => {
          values[id] = { ...config.values };
        });
        setFieldValues(values);
      } catch {
        // ignore
      }
    }

    // Check Supabase for previously synced credentials
    fetchSupabaseStatus();
  }, []);

  const fetchSupabaseStatus = async () => {
    try {
      const resp = await fetch(CREDENTIALS_EDGE_URL, {
        method: 'POST',
        headers: { 'kosData.Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'list' }),
      });
      const data = await resp.json();
      if (kosData.data.success && kosData.data.platforms) {
        const configured = new Set<string>();
        kosData.data.platforms.forEach((p: { platform: string; configured: boolean }) => {
          if (p.configured) configured.add(p.platform);
        });
        setSupabaseConfigured(configured);
      }
    } catch {
      // Silently ignore — Supabase might not be reachable
    }
  };

  const showToast = (msg: string, type: 'success' | 'error' = 'success') => {
    setToast({ msg, type });
    setTimeout(() => setToast(null), 4000);
  };

  const handleFieldChange = (platformId: string, fieldKey: string, value: string) => {
    setFieldValues(prev => ({
      ...prev,
      [platformId]: {
        ...(prev[platformId] || {}),
        [fieldKey]: value,
      },
    }));
  };

  const handleSave = async (platformId: string) => {
    const platform = externalApiPlatforms.find(p => p.id === platformId);
    if (!platform) return;

    const values = fieldValues[platformId] || {};
    const allFilled = platform.fields.every(f => values[f.key]?.trim());

    if (!allFilled && platform.fields.some(f => f.required)) {
      showToast('Veuillez remplir tous les champs obligatoires.', 'error');
      return;
    }

    setSavingPlatform(platformId);

    const now = new Date().toISOString();
    const updatedConfig: PlatformConfig = {
      id: platformId,
      configured: allFilled,
      lastSaved: now,
      values: { ...values },
    };

    const updatedConfigs = {
      ...platformConfigs,
      [platformId]: updatedConfig,
    };

    setPlatformConfigs(updatedConfigs);
    localStorage.setItem(STORAGE_KEY, JSON.stringify(updatedConfigs));

    // Sync to Supabase for Edge Function access
    setSyncingPlatform(platformId);
    try {
      const credentials: Record<string, string> = {};
      platform.fields.forEach(f => {
        if (values[f.key]?.trim()) {
          credentials[f.key] = values[f.key].trim();
        }
      });

      const syncResp = await fetch(CREDENTIALS_EDGE_URL, {
        method: 'POST',
        headers: { 'kosData.Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'save',
          platform: platformId,
          credentials,
        }),
      });
      const syncData = await syncResp.json();

      if (syncData.success) {
        setSupabaseConfigured(prev => new Set([...prev, platformId]));
        setSavingPlatform(null);
        showToast(
          `${platform.name} — Configuré et synchronisé avec KOS ! ✅ Prêt pour la production.`,
          'success'
        );
      } else {
        setSavingPlatform(null);
        showToast(
          `${platform.name} — Sauvegardé localement mais la synchro Supabase a échoué. Réessayez.`,
          'error'
        );
      }
    } catch {
      setSavingPlatform(null);
      showToast(
        `${platform.name} — Sauvegardé localement. Synchro Supabase non disponible. Vérifiez la connexion.`,
        'error'
      );
    }
  };

  const handleClear = async (platformId: string) => {
    const platform = externalApiPlatforms.find(p => p.id === platformId);
    if (!platform) return;

    setFieldValues(prev => ({
      ...prev,
      [platformId]: {},
    }));

    const updatedConfigs = { ...platformConfigs };
    delete updatedConfigs[platformId];
    setPlatformConfigs(updatedConfigs);
    localStorage.setItem(STORAGE_KEY, JSON.stringify(updatedConfigs));

    // Also clear from Supabase
    try {
      await fetch(CREDENTIALS_EDGE_URL, {
        method: 'POST',
        headers: { 'kosData.Content-Type': 'application/json' },
        body: JSON.stringify({ action: 'delete', platform: platformId }),
      });
      setSupabaseConfigured(prev => {
        const next = new Set(prev);
        next.delete(platformId);
        return next;
      });
    } catch {
      // Silently ignore
    }

    showToast(`${platform.name} — Configuration effacée localement et sur KOS.`, 'success');
  };

  const getPlatformStatus = (platformId: string) => {
    const config = platformConfigs[platformId];
    const synced = supabaseConfigured.has(platformId);

    if (config?.configured && synced) {
      return { label: 'Production Ready', color: 'bg-emerald-100 text-emerald-700', dot: 'bg-emerald-500' };
    }
    if (config?.configured) {
      return { label: 'Local uniquement', color: 'bg-secondary-100 text-secondary-700', dot: 'bg-secondary-500' };
    }
    return { label: 'Non configuré', color: 'bg-amber-100 text-amber-700', dot: 'bg-amber-500' };
  };

  const configuredCount = Object.values(platformConfigs).filter(c => c.configured).length;
  const syncedCount = supabaseConfigured.size;

  return (
    <div className="min-h-screen bg-background-50">
      <SeoHead
        title="KOS External API Config Command™ — Configuration OAuth & Clés API | KHEPRA EXPERTS"
        description="Configurez les IDs OAuth 2.0, clés API et secrets pour YouTube, LinkedIn, ElevenLabs et Podcast RSS. Cockpit centralisé de gestion des connexions externes KOS."
        keywords="KOS API config, YouTube OAuth, LinkedIn OAuth, ElevenLabs API, Podcast RSS, configuration OAuth, KHEPRA EXPERTS"
        canonicalPath="/kos-external-api-config-command"
        ogType="website"
        ogLocale="fr_FR"
      />

      {/* Hero */}
      <section className="relative bg-foreground-950 overflow-hidden">
        <div className="absolute inset-0">
          <img
            src="https://readdy.ai/api/search-image?query=abstract%20dark%20technological%20dashboard%20background%20with%20interconnected%20glowing%20API%20endpoints%20and%20OAuth%20security%20lock%20symbols%20on%20deep%20charcoal%20surface%2C%20warm%20emerald%20green%20and%20amber%20accent%20lights%20forming%20network%20topology%2C%20enterprise%20cybersecurity%20aesthetic%20with%20digital%20key%20exchange%20visualization%2C%20clean%20modern%20data%20center%20interface%20pattern%2C%20no%20text%20no%20human%20figures%2C%20sophisticated%20API%20gateway%20infrastructure%20concept%20art%20with%20subtle%20circuit%20board%20textures%20and%20secure%20connection%20pathways&width=1920&height=500&seq=kos-api-config-hero&orientation=landscape"
            alt=""
            className="w-full h-full object-cover object-center opacity-12"
            width="1920"
            height="500"
          />
        </div>
        <div className="absolute inset-0 bg-gradient-to-b from-foreground-950/60 via-foreground-950/80 to-foreground-950" />

        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-20 relative z-10">
          <div className="text-center max-w-3xl mx-auto">
            <div className="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-amber-500/20 border border-amber-400/30 backdrop-blur-sm mb-6">
              <i className="ri-key-2-line text-amber-400 text-sm" />
              <span className="text-sm font-semibold text-amber-300 uppercase tracking-wider">
                KOS External API Config Command™
              </span>
            </div>
            <h1 className="font-[family-name:var(--font-heading)] text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-5 leading-tight">
              Configurez vos connexions API.
              <span className="block text-amber-400 mt-2">YouTube · LinkedIn · ElevenLabs · Podcast RSS.</span>
            </h1>
            <p className="text-base sm:text-lg text-gray-300 leading-relaxed mb-6">
              Centralisez tous vos IDs OAuth 2.0, clés API et secrets dans un cockpit unique.{' '}
              <strong className="text-white">{configuredCount}/{externalApiPlatforms.length}</strong> plateformes configurées,{' '}
              <strong className="text-emerald-400">{syncedCount}</strong> synchronisées avec KOS.{' '}
              Une fois enregistrées, KOS publie automatiquement sur tous vos canaux.
            </p>
            <div className="flex flex-wrap justify-center gap-3">
              <Link
                to="/youtube-connect"
                className="flex items-center gap-2 px-5 py-2.5 rounded-full bg-red-600 text-white text-sm font-bold hover:bg-red-700 transition-colors cursor-pointer whitespace-nowrap"
              >
                <i className="ri-youtube-fill" />YouTube Connect
              </Link>
              <Link
                to="/kos-multichannel-command"
                className="flex items-center gap-2 px-5 py-2.5 rounded-full bg-white/10 border border-white/20 text-white text-sm font-bold hover:bg-white/20 transition-colors cursor-pointer whitespace-nowrap"
              >
                <i className="ri-radar-line" />Multichannel Command
              </Link>
              <Link
                to="/kos-voice-ai-studio"
                className="flex items-center gap-2 px-5 py-2.5 rounded-full bg-white/10 border border-white/20 text-white text-sm font-bold hover:bg-white/20 transition-colors cursor-pointer whitespace-nowrap"
              >
                <i className="ri-mic-line" />Voice AI Studio
              </Link>
            </div>
          </div>
        </div>
      </section>

      {/* Status Summary Bar */}
      <section className="py-3 bg-foreground-950 border-b border-white/10">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="flex flex-wrap items-center justify-between gap-3">
            <div className="flex items-center gap-2">
              <i className="ri-dashboard-3-line text-amber-400" />
              <span className="text-sm font-semibold text-white">
                État global : <span className={syncedCount === externalApiPlatforms.length ? 'text-emerald-400' : syncedCount > 0 ? 'text-amber-400' : 'text-red-400'}>
                  {syncedCount === externalApiPlatforms.length ? 'PRODUCTION READY — Toutes les plateformes synchronisées' : syncedCount > 0 ? 'PRODUCTION PARTIELLE' : 'CONFIGURATION REQUISE'}
                </span>
              </span>
            </div>
            <div className="flex items-center gap-4 text-xs text-gray-400">
              <span><strong className="text-white">{syncedCount}</strong>/{externalApiPlatforms.length} synchronisées KOS</span>
              <span>·</span>
              <span>Stockage sécurisé Supabase</span>
            </div>
          </div>
        </div>
      </section>

      {/* Toast */}
      {toast && (
        <div className={`fixed top-6 right-6 z-50 px-5 py-3 rounded-xl text-sm font-medium flex items-center gap-2 shadow-lg transition-all animate-in ${
          toast.type === 'success' ? 'bg-emerald-600 text-white' : 'bg-red-600 text-white'
        }`}>
          <i className={toast.type === 'success' ? 'ri-checkbox-circle-line' : 'ri-error-warning-line'} />
          {toast.msg}
        </div>
      )}

      {/* Main kosData.Content */}
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div className="grid grid-cols-1 lg:grid-cols-4 gap-8">
          {/* LEFT: Platform Cards */}
          <div className="lg:col-span-3 space-y-6">
            {externalApiPlatforms.map(platform => {
              const isExpanded = expandedPlatform === platform.id;
              const status = getPlatformStatus(platform.id);
              const config = platformConfigs[platform.id];
              const values = fieldValues[platform.id] || {};

              return (
                <div
                  key={platform.id}
                  className={`rounded-2xl bg-white border transition-all ${
                    isExpanded ? 'border-foreground-300 shadow-sm' : 'border-background-200/70 hover:border-background-300'
                  }`}
                >
                  {/* Header */}
                  <button
                    onClick={() => setExpandedPlatform(isExpanded ? null : platform.id)}
                    className="w-full p-5 sm:p-6 text-left cursor-pointer"
                  >
                    <div className="flex items-start gap-4">
                      <div className={`w-12 h-12 rounded-xl bg-gradient-to-br ${platform.color} flex items-center justify-center flex-shrink-0`}>
                        <i className={`${platform.icon} text-white text-xl`} />
                      </div>
                      <div className="flex-1 min-w-0">
                        <div className="flex items-center gap-3 flex-wrap mb-1">
                          <h2 className="font-[family-name:var(--font-heading)] text-lg font-bold text-foreground-950">
                            {platform.name}
                          </h2>
                          <span className={`inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold ${status.color}`}>
                            <span className={`w-1.5 h-1.5 rounded-full ${status.dot}`} />
                            {status.label}
                          </span>
                          {config?.lastSaved && (
                            <span className="text-[10px] text-foreground-400">
                              Sauvegardé le {new Date(config.lastSaved).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })}
                            </span>
                          )}
                        </div>
                        <p className="text-sm text-foreground-500">{platform.description}</p>

                        {!isExpanded && config?.configured && (
                          <div className="mt-2 flex items-center gap-4 text-xs text-foreground-500">
                            <span className="flex items-center gap-1">
                              <i className="ri-check-line text-emerald-500" />
                              {Object.keys(config.values).filter(k => config.values[k]).length} champ(s) renseigné(s)
                            </span>
                            <span className="flex items-center gap-1">
                              <i className="ri-function-line" />
                              Edge: {platform.edgeFunction}
                            </span>
                          </div>
                        )}
                      </div>
                      <div className="flex-shrink-0">
                        <i className={`text-foreground-400 text-lg transition-transform ${isExpanded ? 'ri-arrow-up-s-line' : 'ri-arrow-down-s-line'}`} />
                      </div>
                    </div>
                  </button>

                  {/* Expanded Config */}
                  {isExpanded && (
                    <div className="px-5 sm:px-6 pb-6 border-t border-background-200/70 pt-5 space-y-5">
                      {/* Fields */}
                      <div className="space-y-4">
                        {platform.fields.map(field => (
                          <div key={field.key}>
                            <label className="block text-sm font-semibold text-foreground-700 mb-1.5">
                              {field.label}
                              {field.required && <span className="text-red-500 ml-1">*</span>}
                            </label>
                            <div className="relative">
                              <input
                                type={field.type === 'password' ? 'password' : 'text'}
                                value={values[field.key] || ''}
                                onChange={e => handleFieldChange(platform.id, field.key, e.target.value)}
                                placeholder={field.placeholder}
                                className="w-full px-4 py-3 pr-10 rounded-xl border border-background-200 bg-background-50 text-sm text-foreground-900 font-mono placeholder:text-foreground-300 focus:outline-none focus:ring-2 focus:ring-amber-500/30 focus:border-amber-400 transition-all"
                              />
                              {values[field.key] && (
                                <button
                                  onClick={() => handleFieldChange(platform.id, field.key, '')}
                                  className="absolute right-3 top-1/2 -translate-y-1/2 text-foreground-300 hover:text-foreground-500 cursor-pointer"
                                >
                                  <i className="ri-close-circle-line" />
                                </button>
                              )}
                            </div>
                          </div>
                        ))}
                      </div>

                      {/* Redirect URI (if exists) */}
                      {platform.redirectUri && (
                        <div className="p-4 rounded-xl bg-amber-50 border border-amber-200/70">
                          <div className="flex items-center gap-2 mb-1">
                            <i className="ri-link text-amber-600 text-sm" />
                            <span className="text-xs font-bold text-amber-800">URI de redirection OAuth</span>
                          </div>
                          <code className="block text-xs font-mono text-amber-700 break-all bg-white/60 rounded-lg px-3 py-2 border border-amber-100">
                            {platform.redirectUri}
                          </code>
                          <p className="text-[10px] text-amber-600 mt-1.5">
                            Copiez cette URL dans les paramètres OAuth de votre application {platform.name.split(' ')[0]}.
                          </p>
                        </div>
                      )}

                      {/* Setup Steps */}
                      <div>
                        <h4 className="text-xs font-bold text-foreground-400 uppercase tracking-wider mb-3">
                          Guide de configuration
                        </h4>
                        <div className="space-y-2">
                          {platform.setupSteps.map(step => (
                            <div key={step.step} className="flex gap-3 p-3 rounded-lg bg-background-50 border border-background-200/50">
                              <div className="w-7 h-7 rounded-full bg-foreground-950 text-white flex items-center justify-center text-xs font-bold flex-shrink-0">
                                {step.step}
                              </div>
                              <div className="text-sm text-foreground-700 pt-0.5">
                                {step.link ? (
                                  <>
                                    {step.text.split(step.link ? 'sur ' : '')[0]}
                                    {step.text.includes('sur ') && 'sur '}
                                    <a
                                      href={step.link}
                                      target="_blank"
                                      rel="noopener noreferrer"
                                      className="text-amber-600 underline font-semibold"
                                    >
                                      {step.link.replace('https://', '').split('/')[0]}
                                    </a>
                                    {step.text.includes('console.cloud.google.com') && step.text.split('console.cloud.google.com')[1] || ''}
                                    {step.text.includes('developer.linkedin.com') && step.text.split('developer.linkedin.com')[1] || ''}
                                    {step.text.includes('elevenlabs.io') && step.text.split('elevenlabs.io')[1] || ''}
                                  </>
                                ) : (
                                  step.text
                                )}
                              </div>
                            </div>
                          ))}
                        </div>
                      </div>

                      {/* Actions */}
                      <div className="flex items-center gap-3 pt-2">
                        <button
                          onClick={() => handleSave(platform.id)}
                          disabled={savingPlatform === platform.id}
                          className={`flex items-center gap-2 px-6 py-3 rounded-xl font-bold text-sm cursor-pointer whitespace-nowrap transition-all ${
                            savingPlatform === platform.id
                              ? 'bg-amber-400 text-white cursor-not-allowed'
                              : 'bg-gradient-to-r from-amber-500 to-amber-600 text-white hover:from-amber-600 hover:to-amber-700'
                          }`}
                        >
                          {savingPlatform === platform.id ? (
                            <>
                              <div className="w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin" />
                              Enregistrement...
                            </>
                          ) : (
                            <>
                              <i className="ri-save-line" />
                              Enregistrer la configuration
                            </>
                          )}
                        </button>

                        {config?.configured && (
                          <button
                            onClick={() => handleClear(platform.id)}
                            className="flex items-center gap-2 px-4 py-3 rounded-xl border border-red-200 text-red-600 text-sm font-bold hover:bg-red-50 transition-colors cursor-pointer whitespace-nowrap"
                          >
                            <i className="ri-delete-back-line" />
                            Effacer
                          </button>
                        )}
                      </div>

                      {/* Connection hint */}
                      {platform.id === 'youtube' && config?.configured && (
                        <div className="p-4 rounded-xl bg-emerald-50 border border-emerald-200/70">
                          <div className="flex items-center gap-2 mb-1">
                            <i className="ri-information-line text-emerald-600" />
                            <span className="text-xs font-bold text-emerald-800">Prochaine étape</span>
                          </div>
                          <p className="text-xs text-emerald-700">
                            Votre configuration YouTube est enregistrée. Allez sur{' '}
                            <Link to="/youtube-connect" className="text-emerald-800 underline font-bold">
                              YouTube Connect
                            </Link>{' '}
                            pour authentifier votre chaîne @KHEPRAEXPERTS via OAuth 2.0 et activer la publication automatique.
                          </p>
                        </div>
                      )}

                      {platform.id === 'linkedin' && config?.configured && (
                        <div className="p-4 rounded-xl bg-blue-50 border border-blue-200/70">
                          <div className="flex items-center gap-2 mb-1">
                            <i className="ri-information-line text-blue-600" />
                            <span className="text-xs font-bold text-blue-800">Prochaine étape</span>
                          </div>
                          <p className="text-xs text-blue-700">
                            LinkedIn nécessite l'approbation du Marketing Developer Platform (délai 2-4 semaines). Une fois approuvée, KOS pourra publier automatiquement sur votre page.
                          </p>
                        </div>
                      )}

                      {platform.id === 'elevenlabs' && config?.configured && (
                        <div className="p-4 rounded-xl bg-violet-50 border border-violet-200/70">
                          <div className="flex items-center gap-2 mb-1">
                            <i className="ri-information-line text-violet-600" />
                            <span className="text-xs font-bold text-violet-800">Prochaine étape</span>
                          </div>
                          <p className="text-xs text-violet-700">
                            Votre clé API ElevenLabs est enregistrée. Rendez-vous sur{' '}
                            <Link to="/kos-voice-ai-studio" className="text-violet-800 underline font-bold">
                              Voice AI Studio
                            </Link>{' '}
                            pour générer des voix IA avec vos 6 profils KHEPRA personnalisés.
                          </p>
                        </div>
                      )}

                      {platform.id === 'podcast_rss' && config?.configured && (
                        <div className="p-4 rounded-xl bg-amber-50 border border-amber-200/70">
                          <div className="flex items-center gap-2 mb-1">
                            <i className="ri-information-line text-amber-600" />
                            <span className="text-xs font-bold text-amber-800">Prochaine étape</span>
                          </div>
                          <p className="text-xs text-amber-700">
                            Flux RSS enregistré. Soumettez-le à Spotify for Podcasters, Apple Podcasts Connect, Deezer et Amazon Music pour distribution automatique.
                          </p>
                        </div>
                      )}

                      {/* Edge Function */}
                      <div className="text-xs text-foreground-400 flex items-center gap-1">
                        <i className="ri-function-line" />
                        Edge Functions associées : <strong className="text-foreground-600">{platform.edgeFunction}</strong>
                      </div>
                    </div>
                  )}
                </div>
              );
            })}
          </div>

          {/* RIGHT: Sidebar */}
          <div className="lg:col-span-1 space-y-6">
            {/* Summary Card */}
            <div className="rounded-2xl bg-white border border-background-200/70 p-5 sticky top-24">
              <div className="flex items-center gap-3 mb-5">
                <div className="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-500 to-amber-600 flex items-center justify-center">
                  <i className="ri-settings-3-line text-white text-lg" />
                </div>
                <div>
                  <h3 className="font-[family-name:var(--font-heading)] text-base font-bold text-foreground-950">État Global</h3>
                  <p className="text-xs text-foreground-500">4 plateformes externes</p>
                </div>
              </div>

              <div className="space-y-3 mb-5">
                {externalApiPlatforms.map(platform => {
                  const status = getPlatformStatus(platform.id);
                  const config = platformConfigs[platform.id];
                  const synced = supabaseConfigured.has(platform.id);
                  return (
                    <div key={platform.id} className="flex items-center justify-between">
                      <div className="flex items-center gap-2">
                        <span className={`w-2 h-2 rounded-full ${status.dot}`} />
                        <span className="text-sm font-medium text-foreground-700">{platform.name.split(' ')[0]}</span>
                      </div>
                      <span className={`text-xs font-bold ${synced ? 'text-emerald-600' : config?.configured ? 'text-secondary-600' : 'text-amber-600'}`}>
                        {synced ? 'Sync OK' : config?.configured ? 'Local' : 'À configurer'}
                      </span>
                    </div>
                  );
                })}
              </div>

              <div className={`p-4 rounded-xl border mb-5 ${
                syncedCount === externalApiPlatforms.length
                  ? 'bg-emerald-50 border-emerald-200'
                  : syncedCount > 0
                    ? 'bg-amber-50 border-amber-200'
                    : 'bg-red-50 border-red-200'
              }`}>
                <div className="flex items-center gap-2 mb-1">
                  <i className={`${
                    syncedCount === externalApiPlatforms.length
                      ? 'ri-checkbox-circle-fill text-emerald-500'
                      : syncedCount > 0
                        ? 'ri-error-warning-fill text-amber-500'
                        : 'ri-close-circle-fill text-red-500'
                  }`} />
                  <span className="text-sm font-bold text-foreground-950">
                    {syncedCount === externalApiPlatforms.length
                      ? 'Production Ready'
                      : syncedCount > 0
                        ? 'Production partielle'
                        : 'Setup requis'}
                  </span>
                </div>
                <p className="text-xs text-foreground-600">
                  {syncedCount === externalApiPlatforms.length
                    ? 'Toutes les plateformes synchronisées avec KOS. Publication automatique activée.'
                    : syncedCount > 0
                      ? `${syncedCount}/${externalApiPlatforms.length} plateformes synchronisées. Complétez la configuration.`
                      : 'Aucune plateforme synchronisée. Sauvegardez vos credentials pour activer la publication.'}
                </p>
              </div>

              {/* Quick Links */}
              <h4 className="text-xs font-bold text-foreground-400 uppercase tracking-wider mb-3">Liens Rapides</h4>
              <div className="space-y-1.5">
                {[
                  { label: 'YouTube Connect', path: '/youtube-connect', icon: 'ri-youtube-fill', color: 'text-red-600' },
                  { label: 'Voice AI Studio', path: '/kos-voice-ai-studio', icon: 'ri-mic-line', color: 'text-violet-600' },
                  { label: 'Multichannel Command', path: '/kos-multichannel-command', icon: 'ri-radar-line', color: 'text-amber-600' },
                  { label: 'Production Package', path: '/kos-production-package-factory', icon: 'ri-folder-open-line', color: 'text-teal-600' },
                  { label: 'Dashboard KOS', path: '/kos-dashboard', icon: 'ri-dashboard-line', color: 'text-emerald-600' },
                ].map(link => (
                  <Link
                    key={link.path}
                    to={link.path}
                    className="flex items-center gap-2.5 px-3 py-2.5 rounded-xl hover:bg-background-100 transition-colors cursor-pointer group"
                  >
                    <i className={`${link.icon} ${link.color} text-base`} />
                    <span className="text-sm text-foreground-700 group-hover:text-foreground-950 font-medium">{link.label}</span>
                    <i className="ri-arrow-right-s-line text-foreground-300 ml-auto group-hover:text-foreground-500" />
                  </Link>
                ))}
              </div>

              {/* Sync Status Note */}
              <div className="mt-5 p-4 rounded-xl bg-emerald-50 border border-emerald-200/70">
                <div className="flex items-center gap-2 mb-1">
                  <i className="ri-cloud-line text-emerald-500" />
                  <span className="text-xs font-bold text-foreground-700">Synchronisation KOS</span>
                </div>
                <p className="text-[11px] text-foreground-500 leading-relaxed">
                  {syncedCount > 0
                    ? `${syncedCount} plateforme(s) synchronisée(s) avec le backend KOS via Supabase. Les Edge Functions peuvent accéder à ces credentials pour la publication automatique.`
                    : 'Aucune plateforme synchronisée. Cliquez sur "Enregistrer la configuration" pour synchroniser vos credentials avec le backend KOS.'}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Cross-link Ecosystem */}
      <section className="py-12 bg-background-100 border-t border-background-200/70">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <h3 className="font-[family-name:var(--font-heading)] text-lg font-bold text-foreground-950 mb-6 text-center">
            Écosystème KOS — Production & Distribution de Contenu
          </h3>
          <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
            {[
              { label: 'API Config', path: '/kos-external-api-config-command', icon: 'ri-key-2-line', color: 'text-amber-500', current: true },
              { label: 'YouTube Connect', path: '/youtube-connect', icon: 'ri-youtube-fill', color: 'text-red-500' },
              { label: 'Multichannel', path: '/kos-multichannel-command', icon: 'ri-radar-line', color: 'text-teal-500' },
              { label: 'Voice AI Studio', path: '/kos-voice-ai-studio', icon: 'ri-mic-line', color: 'text-violet-500' },
              { label: 'Studio Média', path: '/studio-media', icon: 'ri-magic-line', color: 'text-primary-500' },
              { label: 'Package Factory', path: '/kos-production-package-factory', icon: 'ri-folder-open-line', color: 'text-emerald-500' },
              { label: 'Community Mgr', path: '/kos-community-manager-command', icon: 'ri-message-2-line', color: 'text-blue-500' },
              { label: 'kosData.Content Factory', path: '/kos-kosData.content-factory-command', icon: 'ri-file-text-line', color: 'text-secondary-500' },
              { label: 'SEO Autopilot', path: '/kos-seo-autopilot', icon: 'ri-search-line', color: 'text-teal-500' },
              { label: 'Dashboard KOS', path: '/kos-dashboard', icon: 'ri-dashboard-line', color: 'text-emerald-500' },
              { label: 'LinkedIn Dist.', path: '/kos-linkedin-distribution-program', icon: 'ri-linkedin-fill', color: 'text-blue-500' },
              { label: 'YouTube Analytics', path: '/kos-youtube-analytics', icon: 'ri-line-chart-line', color: 'text-red-500' },
            ].map(link => (
              <Link
                key={link.path}
                to={link.path}
                className={`rounded-xl border p-3 text-center hover:shadow-sm transition-all cursor-pointer block ${
                  link.current ? 'border-amber-300 bg-amber-50/40 ring-1 ring-amber-200' : 'border-background-200 bg-white hover:border-foreground-200'
                }`}
              >
                <i className={`${link.icon} text-lg mb-1 block ${link.color}`} />
                <span className="text-xs font-bold text-foreground-800">{link.label}</span>
                {link.current && <span className="block text-[10px] text-amber-600 font-bold mt-0.5">Actif</span>}
              </Link>
            ))}
          </div>
        </div>
      </section>
    </div>
  );
}
