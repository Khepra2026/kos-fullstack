import { Link } from 'react-router-dom';

interface CorrectionHistoryPanelProps {
  records: CorrectionRecord[];
}

export default function CorrectionHistoryPanel({ records }: CorrectionHistoryPanelProps) {
  const [kosData, setKosData] = useState<any>(null);
  useEffect(() => {
    fetch('/mocks/kos-blog.json').then(r => r.json()).then(setKosData);
  }, []);
  if (!kosData) return null;

  const sorted = [...records].sort((a, b) =>
    new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime()
  );

  return (
    <div className="space-y-4">
      <div className="overflow-x-auto rounded-2xl border border-background-200">
        <table className="w-full text-sm">
          <thead>
            <tr className="bg-foreground-950 text-background-50">
              <th className="text-left px-4 py-3 font-bold">Date</th>
              <th className="text-left px-4 py-3 font-bold">Article</th>
              <th className="text-left px-4 py-3 font-bold">Avant</th>
              <th className="text-left px-4 py-3 font-bold">Après</th>
              <th className="text-left px-4 py-3 font-bold">Motif</th>
              <th className="text-center px-3 py-3 font-bold whitespace-nowrap">Score</th>
              <th className="text-center px-3 py-3 font-bold whitespace-nowrap">Validé par</th>
            </tr>
          </thead>
          <tbody>
            {sorted.map((record, i) => (
              <tr key={record.id} className={i % 2 === 0 ? 'bg-background-50' : 'bg-background-100'}>
                <td className="px-4 py-3 text-xs text-foreground-500 whitespace-nowrap">
                  {new Date(record.timestamp).toLocaleDateString('fr-FR')}
                </td>
                <td className="px-4 py-3">
                  <Link
                    to={`/blog/${record.articleSlug}`}
                    className="text-xs text-foreground-800 font-medium hover:text-accent-600 transition-colors cursor-pointer line-clamp-1"
                  >
                    {record.articleTitle}
                  </Link>
                </td>
                <td className="px-4 py-3 text-xs text-red-700 line-through line-clamp-1 max-w-[180px]">{record.before}</td>
                <td className="px-4 py-3 text-xs text-emerald-700 font-semibold line-clamp-1 max-w-[180px]">{record.after}</td>
                <td className="px-4 py-3 text-xs text-foreground-600 max-w-[200px] line-clamp-2">{record.motif}</td>
                <td className="px-3 py-3 text-center">
                  <div className="flex items-center justify-center gap-1">
                    <span className="text-xs text-red-500">{record.scoreBefore}</span>
                    <i className="ri-arrow-right-line text-[10px] text-foreground-300"></i>
                    <span className="text-xs font-bold text-emerald-600">{record.scoreAfter}</span>
                  </div>
                </td>
                <td className="px-3 py-3 text-center text-[10px] text-foreground-400 whitespace-nowrap">
                  {record.validatedBy}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );
}
