import { useState } from 'react';
import KOSHubLayout from '@/components/feature/KOSHubLayout';
import {
  RAG_TIERS, RAG_SAMPLE_QUERIES, RAG_BILLING_KPI,
  RAG_MOCK_RESPONSE_STANDARD, RAG_MOCK_RESPONSE_PREMIUM,
  STRIPE_CHECKOUT_CONFIG, type RagTier,
} from '@/mocks/kosRagBillingRouter';

type Tab = 'orchestrateur' | 'tiers' | 'monetisation' | 'master_prompt' | 'kpi';

function TierCard({ tier, config, isActive, onSelect }: {
  tier: RagTier;
  config: typeof RAG_TIERS['standard'];
  isActive: boolean;
  onSelect: () => void;
}) {
  const colorMap: Record<RagTier, string> = {
    standard: 'border-secondary-300 bg-secondary-50',
    premium: 'border-primary-400 bg-primary-50 ring-2 ring-primary-300',
    anonymous: 'border-background-200 bg-background-100',
  };

  return (
    <button
      onClick={onSelect}
      className={`w-full text-left p-5 rounded-xl border-2 transition-all cursor-pointer ${colorMap[tier]} ${isActive ? 'ring-2 ring-offset-2' : 'hover:border-foreground-300'}`}
    >
      <div className="flex items-center justify-between mb-3">
        <span className={`text-base font-bold font-heading ${tier === 'premium' ? 'text-primary-700' : tier === 'standard' ? 'text-secondary-700' : 'text-foreground-500'}`}>
          {config.label}
        </span>
        <span className={`px-3 py-1 rounded-full text-xs font-semibold font-body ${tier === 'premium' ? 'bg-primary-100 text-primary-700' : tier === 'standard' ? 'bg-secondary-100 text-secondary-700' : 'bg-background-200 text-foreground-500'}`}>
          {config.price_label}
        </span>
      </div>
      <ul className="space-y-1">
        {config.features.map((f, i) => (
          <li key={i} className="flex items-start gap-2 text-xs text-foreground-600 font-body">
            <i className={`ri-check-line mt-0.5 flex-shrink-0 ${tier === 'premium' ? 'text-primary-500' : tier === 'standard' ? 'text-secondary-500' : 'text-foreground-400'}`}></i>
            {f}
          </li>
        ))}
      </ul>
      {isActive && (
        <div className={`mt-3 flex items-center gap-1.5 text-xs font-bold font-body ${tier === 'premium' ? 'text-primary-600' : 'text-secondary-600'}`}>
          <i className="ri-check-double-line"></i> Tier actif
        </div>
      )}
    </button>
  );
}

function RAGQueryPanel() {
  const [activeTier, setActiveTier] = useState<RagTier>('standard');
  const [query, setQuery] = useState('');
  const [loading, setLoading] = useState(false);
  const [response, setResponse] = useState<typeof RAG_MOCK_RESPONSE_STANDARD | typeof RAG_MOCK_RESPONSE_PREMIUM | null>(null);

  const handleQuery = async () => {
    if (!query.trim()) return;
    setLoading(true);
    setResponse(null);
    await new Promise(r => setTimeout(r, activeTier === 'premium' ? 2400 : 1200));
    setResponse(activeTier === 'premium' ? RAG_MOCK_RESPONSE_PREMIUM : RAG_MOCK_RESPONSE_STANDARD);
    setLoading(false);
  };

  return (
    <div className="space-y-6">
      {/* Tier Selector */}
      <div>
        <h3 className="text-sm font-bold text-foreground-700 mb-3 font-heading">1. Sélectionner votre tier</h3>
        <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {(['anonymous', 'standard', 'premium'] as RagTier[]).map(t => (
            <TierCard
              key={t}
              tier={t}
              config={RAG_TIERS[t]}
              isActive={activeTier === t}
              onSelect={() => setActiveTier(t)}
            />
          ))}
        </div>
      </div>

      {/* Query Input */}
      <div>
        <h3 className="text-sm font-bold text-foreground-700 mb-3 font-heading">2. Votre question réglementaire</h3>
        <textarea
          value={query}
          onChange={e => setQuery(e.target.value)}
          rows={3}
          placeholder="Ex: Quelles sont les exigences de fonds propres pour les banques UEMOA selon le dispositif prudentiel BCEAO 2016 ?"
          className="w-full px-4 py-3 bg-background-100 border border-background-200/70 rounded-lg text-sm text-foreground-950 placeholder:text-foreground-400 font-body focus:outline-none focus:border-primary-300 resize-none"
        />
        <div className="flex items-center justify-between mt-2">
          <div className="flex items-center gap-2 flex-wrap">
            {RAG_SAMPLE_QUERIES.filter(q => q.tier === activeTier || activeTier === 'standard').slice(0, 2).map(sq => (
              <button
                key={sq.id}
                onClick={() => setQuery(sq.query)}
                className="px-2.5 py-1 text-xs bg-background-200 hover:bg-background-300 rounded-lg text-foreground-600 font-body cursor-pointer transition-colors line-clamp-1 max-w-xs"
              >
                {sq.domaine}
              </button>
            ))}
          </div>
          <button
            onClick={handleQuery}
            disabled={loading || !query.trim()}
            className="px-5 py-2 bg-primary-500 hover:bg-primary-600 disabled:opacity-40 text-white text-sm font-semibold rounded-lg transition-all cursor-pointer whitespace-nowrap font-body flex items-center gap-2"
          >
            {loading ? <><i className="ri-loader-4-line animate-spin"></i> Analyse...</> : <><i className="ri-search-eye-line"></i> Analyser</>}
          </button>
        </div>
      </div>

      {/* Response */}
      {response && (
        <div className="bg-background-100 rounded-xl border border-background-200/70 p-5">
          <div className="flex items-center justify-between mb-4">
            <div className="flex items-center gap-2 flex-wrap">
              <span className={`px-2.5 py-1 rounded-full text-xs font-semibold font-body ${response.tier_used === 'premium' ? 'bg-primary-100 text-primary-700' : 'bg-secondary-100 text-secondary-700'}`}>
                {response.tier_used === 'premium' ? 'Premium' : 'Standard'}
              </span>
              <span className="text-xs text-foreground-500 font-body">
                Confiance: <strong className="text-foreground-700">{Math.round(response.confidence_global * 100)}%</strong>
              </span>
              <span className="text-xs text-foreground-500 font-body">
                Indice KOS: <strong className="text-foreground-700">{response.indice_fiabilite_kos}/100</strong>
              </span>
            </div>
            <span className="text-xs text-foreground-400 font-body">{response.audit_trail_id}</span>
          </div>

          <div className="prose prose-sm max-w-none text-foreground-700 font-body text-sm leading-relaxed mb-4 whitespace-pre-line">
            {response.answer_markdown}
          </div>

          {/* Sources */}
          <div className="border-t border-background-200/70 pt-3 mt-3">
            <p className="text-xs font-bold text-foreground-600 mb-2 font-heading">Sources vérifiées ({response.sources.length})</p>
            <div className="space-y-1">
              {response.sources.map((s, i) => (
                <div key={i} className="flex items-start gap-2 text-xs text-foreground-500 font-body">
                  <span className="w-5 h-5 flex items-center justify-center rounded-full bg-primary-100 text-primary-700 flex-shrink-0 font-bold">{i + 1}</span>
                  <span><strong className="text-foreground-700">{s.authority}</strong> — {s.reference} — {s.article}</span>
                  <span className="ml-auto text-emerald-600 font-semibold">{Math.round(s.confidence * 100)}%</span>
                </div>
              ))}
            </div>
          </div>

          {/* Upgrade CTA */}
          {'upgrade_cta' in response && response.upgrade_cta && (
            <div className="mt-4 p-4 rounded-lg bg-primary-50 border border-primary-200">
              <p className="text-xs text-primary-800 font-body">
                <i className="ri-star-line mr-1"></i>
                {response.upgrade_cta}
              </p>
              <button className="mt-2 px-4 py-1.5 bg-primary-500 hover:bg-primary-600 text-white text-xs font-semibold rounded-lg transition-all cursor-pointer font-body">
                Passer en Premium — 75 000 FCFA/mois
              </button>
            </div>
          )}
        </div>
      )}
    </div>
  );
}

function MonetisationPanel() {
  return (
    <div className="space-y-6">
      <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
        {[
          { label: 'Utilisateurs Standard', value: RAG_BILLING_KPI.standard_users.toLocaleString(), icon: 'ri-user-line', color: 'bg-secondary-100 text-secondary-700' },
          { label: 'Utilisateurs Premium', value: RAG_BILLING_KPI.premium_users.toLocaleString(), icon: 'ri-vip-crown-line', color: 'bg-primary-100 text-primary-700' },
          { label: 'Taux Conversion', value: `${RAG_BILLING_KPI.conversion_rate_pct}%`, icon: 'ri-funds-line', color: 'bg-emerald-100 text-emerald-700' },
          { label: 'MRR FCFA', value: `${(RAG_BILLING_KPI.mrr_fcfa / 1000000).toFixed(1)} M`, icon: 'ri-money-dollar-circle-line', color: 'bg-accent-100 text-accent-700' },
        ].map(kpi => (
          <div key={kpi.label} className="bg-background-50 rounded-lg border border-background-200/70 p-4">
            <div className={`w-10 h-10 flex items-center justify-center rounded-lg mb-3 ${kpi.color}`}>
              <i className={`${kpi.icon} text-lg`}></i>
            </div>
            <div className="text-2xl font-bold text-foreground-950 font-heading">{kpi.value}</div>
            <div className="text-xs text-foreground-500 font-body">{kpi.label}</div>
          </div>
        ))}
      </div>

      <div className="bg-background-100 rounded-xl p-5 border border-background-200/70">
        <h3 className="text-sm font-bold text-foreground-800 mb-4 font-heading flex items-center gap-2">
          <i className="ri-route-line text-primary-500"></i>
          Funnel Standard → Premium
        </h3>
        <div className="space-y-3">
          {[
            { etape: 'Visiteurs → Standard (gratuit)', taux: '100%', valeur: RAG_BILLING_KPI.standard_users, color: 'bg-secondary-400' },
            { etape: 'Standard → Premium (cible J+60)', taux: `${RAG_BILLING_KPI.conversion_rate_pct}% (cible ${RAG_BILLING_KPI.target_conversion_j60}%)`, valeur: RAG_BILLING_KPI.premium_users, color: 'bg-primary-500' },
            { etape: 'MRR cible (15% × 847 users × 75K)', taux: '9.5 M FCFA/mois', valeur: RAG_BILLING_KPI.mrr_fcfa, color: 'bg-emerald-500' },
          ].map((row, i) => (
            <div key={i} className="flex items-center gap-4">
              <div className={`h-2 rounded-full ${row.color} transition-all`} style={{ width: `${30 + i * 20}%` }}></div>
              <div className="flex-1 min-w-0">
                <span className="text-xs text-foreground-700 font-body">{row.etape}</span>
                <span className="ml-2 text-xs font-semibold text-foreground-500">{row.taux}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      {/* Stripe Config */}
      <div className="bg-background-100 rounded-xl p-5 border border-background-200/70">
        <h3 className="text-sm font-bold text-foreground-800 mb-3 font-heading flex items-center gap-2">
          <i className="ri-bank-card-line text-accent-500"></i>
          Configuration Stripe (Activation Requise)
        </h3>
        <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {Object.entries(STRIPE_CHECKOUT_CONFIG.tiers).map(([tier, config]) => (
            <div key={tier} className="p-4 rounded-lg bg-background-50 border border-background-200/70">
              <div className="flex items-center justify-between mb-2">
                <span className="text-sm font-bold text-foreground-800 font-heading">{config.name}</span>
                <span className="text-xs text-foreground-500 font-body">{config.amount === 0 ? 'Gratuit' : `${config.amount.toLocaleString()} FCFA`}</span>
              </div>
              <code className="text-xs text-foreground-500 font-body break-all">{config.price_id}</code>
            </div>
          ))}
        </div>
        <p className="mt-3 text-xs text-amber-600 font-body">
          <i className="ri-information-line mr-1"></i>
          Pour activer Stripe, connectez votre compte via <strong>Intégrations → Stripe</strong>.
        </p>
      </div>
    </div>
  );
}

function MasterPromptPanel() {
  const prompt = `Tu es KOS-RAG-Orchestrator, niveau McKinsey LegalTech + PwC Compliance AI.

CONTEXTE: User tier = {standard|premium|anonymous}. Query = {query_user}. Contexte client UEMOA/CEMAC = {context}.

RÈGLES BIG FOUR:
1. TRACABILITÉ: Chaque réponse cite minimum 3 sources avec URL + date JO/BCEAO/OHADA.
   Format: [Source: BCEAO Instruction 2016-03, Art.12, 15/03/2016]
2. CONFIDENCE: Si confidence <0.85, réponds "Analyse préliminaire uniquement" + flag auto-correction.
3. DIFFÉRENCIATION TIERS:
   - standard: RAG top 5 chunks, 300 mots max, 3 sources, latence <2s.
     Toujours finir par: "Pour un rapport complet 5 pages avec analyse comparative OHADA vs CEMAC
     + matrice risques, passez en Premium."
   - premium: RAG top 20 chunks, chaîne de pensée, structure HBR:
     Executive Summary + Contexte Réglementaire + Analyse Comparative
     + Matrice Risques + Recommandations Actionnables + Annexes.
     Watermark "Khepra Premium".
4. COMPLIANCE: Refuse interprétation si texte <2020 sans mise à jour.
   Renvoie vers source officielle.
5. ANTI-HALLUCINATION: Ne jamais inventer numéro d'article.
   Si absent de chunks, dire "Article non trouvé dans base 2026".

OUTPUT JSON:
{
  answer_markdown: string,
  sources: [{authority, reference, article, url_officielle, confidence}],
  confidence_global: number (0-1),
  tier_used: "standard" | "premium",
  upgrade_cta: string | null,
  audit_trail_id: string
}`;

  return (
    <div>
      <div className="flex items-center gap-2 mb-3">
        <span className="px-2 py-1 rounded-md text-xs font-semibold bg-accent-100 text-accent-700 font-body">Master Prompt P1</span>
        <span className="text-xs text-foreground-500 font-body">Gap P3 (Monétisation) + Gap P6 (RAG) — Edge Function déployée</span>
      </div>
      <pre className="text-xs text-foreground-700 font-body bg-background-100 rounded-xl p-5 border border-background-200/70 overflow-auto whitespace-pre-wrap leading-relaxed">
        {prompt}
      </pre>
      <div className="mt-4 p-4 rounded-lg bg-emerald-50 border border-emerald-200">
        <p className="text-xs text-emerald-800 font-body">
          <strong>Edge Function déployée :</strong> kos-rag-billing-router — Actions disponibles : check_quota, create_checkout, route_rag, upgrade_user. 
          Intégration Stripe prête (configurer price_id via Connect Stripe).
        </p>
      </div>
    </div>
  );
}

const TABS: { id: Tab; label: string; icon: string }[] = [
  { id: 'orchestrateur', label: 'RAG Orchestrateur', icon: 'ri-brain-line' },
  { id: 'tiers', label: 'Tiers Standard/Premium', icon: 'ri-vip-crown-line' },
  { id: 'monetisation', label: 'Monétisation & MRR', icon: 'ri-funds-line' },
  { id: 'master_prompt', label: 'Master Prompt P1', icon: 'ri-code-box-line' },
  { id: 'kpi', label: 'KPIs Temps Réel', icon: 'ri-dashboard-line' },
];

export default function KosRagOrchestratorPage() {
  const [kosData, setKosData] = useState<any>(null);
  useEffect(() => {
    fetch('/mocks/kos-blog.json').then(r => r.json()).then(setKosData);
  }, []);
  if (!kosData) return null;

  const [activeTab, setActiveTab] = useState<Tab>('orchestrateur');

  return (
    <KOSHubLayout hubId={121}>
      <div>
        {/* Hero */}
        <div className="bg-background-100 border-b border-background-200/70 px-4 md:px-6 py-8">
          <div className="max-w-5xl mx-auto">
            <div className="flex items-start gap-4 mb-4">
              <div className="w-14 h-14 flex items-center justify-center rounded-xl bg-primary-100 flex-shrink-0">
                <i className="ri-robot-2-line text-2xl text-primary-600"></i>
              </div>
              <div>
                <div className="flex items-center gap-2 flex-wrap mb-1">
                  <span className="px-2.5 py-1 rounded-full text-xs font-semibold bg-primary-100 text-primary-700 font-body">P1 — Master Prompt</span>
                  <span className="px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-700 font-body animate-pulse">
                    <i className="ri-wireless-charging-line mr-1"></i>Edge Function LIVE
                  </span>
                  <span className="px-2.5 py-1 rounded-full text-xs font-semibold bg-accent-100 text-accent-700 font-body">Gap P3+P6 — FERMÉ</span>
                </div>
                <h1 className="text-2xl md:text-3xl font-bold text-foreground-950 font-heading">
                  KOS RAG Orchestrateur™ — Bi-Niveau Standard/Premium
                </h1>
                <p className="text-sm text-foreground-600 font-body mt-1 max-w-2xl">
                  Machine à cash RAG. Standard (gratuit, 300 mots, 3 sources) → Premium (75 000 FCFA/mois, rapport 5 pages HBR, 20 sources). 
                  KPI cible: 15% conversion Standard→Premium J+60. Edge Function + Stripe Checkout intégré.
                </p>
              </div>
            </div>

            {/* Stats bar */}
            <div className="flex items-center gap-6 flex-wrap mt-4 pt-4 border-t border-background-200/70">
              {[
                { label: 'Users', value: RAG_BILLING_KPI.total_users.toLocaleString() },
                { label: 'Taux Conv.', value: `${RAG_BILLING_KPI.conversion_rate_pct}%` },
                { label: 'MRR (FCFA)', value: `${(RAG_BILLING_KPI.mrr_fcfa/1000000).toFixed(1)}M` },
                { label: 'Confiance', value: `${Math.round(RAG_BILLING_KPI.avg_confidence * 100)}%` },
                { label: 'Hallucinations', value: `${RAG_BILLING_KPI.hallucination_rate_pct}%` },
              ].map(s => (
                <div key={s.label} className="text-center">
                  <div className="text-lg font-bold text-foreground-950 font-heading">{s.value}</div>
                  <div className="text-[10px] text-foreground-500 font-body">{s.label}</div>
                </div>
              ))}
            </div>
          </div>
        </div>

        {/* Tabs */}
        <div className="border-b border-background-200/70 bg-background-50 px-4 md:px-6">
          <div className="max-w-5xl mx-auto overflow-x-auto">
            <div className="flex gap-1 py-2 min-w-max">
              {TABS.map(tab => (
                <button
                  key={tab.id}
                  onClick={() => setActiveTab(tab.id)}
                  className={`flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-body transition-all cursor-pointer whitespace-nowrap ${
                    activeTab === tab.id
                      ? 'bg-primary-100 text-primary-700 font-semibold'
                      : 'text-foreground-500 hover:text-foreground-700 hover:bg-background-200'
                  }`}
                >
                  <i className={`${tab.icon} text-sm`}></i>
                  {tab.label}
                </button>
              ))}
            </div>
          </div>
        </div>

        {/* kosData.Content */}
        <div className="max-w-5xl mx-auto px-4 md:px-6 py-8">
          {activeTab === 'orchestrateur' && <RAGQueryPanel />}
          {activeTab === 'tiers' && (
            <div className="grid grid-cols-1 sm:grid-cols-3 gap-6">
              {(['anonymous', 'standard', 'premium'] as RagTier[]).map(t => (
                <TierCard key={t} tier={t} config={RAG_TIERS[t]} isActive={t === 'standard'} onSelect={() => {}} />
              ))}
            </div>
          )}
          {activeTab === 'monetisation' && <MonetisationPanel />}
          {activeTab === 'master_prompt' && <MasterPromptPanel />}
          {activeTab === 'kpi' && (
            <div className="grid grid-cols-2 md:grid-cols-3 gap-4">
              {[
                { label: 'Queries Aujourd\'hui', value: RAG_BILLING_KPI.queries_today, icon: 'ri-question-line', color: 'primary' },
                { label: 'Cache Hit Rate', value: `${RAG_BILLING_KPI.cache_hit_rate_pct}%`, icon: 'ri-speed-line', color: 'accent' },
                { label: 'Taux Conversion', value: `${RAG_BILLING_KPI.conversion_rate_pct}%`, icon: 'ri-arrow-up-line', color: 'primary' },
                { label: 'Standard Users', value: RAG_BILLING_KPI.standard_users, icon: 'ri-user-line', color: 'secondary' },
                { label: 'Premium Users', value: RAG_BILLING_KPI.premium_users, icon: 'ri-vip-crown-line', color: 'primary' },
                { label: 'MRR FCFA', value: `${(RAG_BILLING_KPI.mrr_fcfa/1000000).toFixed(2)}M`, icon: 'ri-money-dollar-circle-line', color: 'accent' },
              ].map(kpi => (
                <div key={kpi.label} className="bg-background-50 rounded-lg border border-background-200/70 p-5">
                  <div className={`w-10 h-10 flex items-center justify-center rounded-lg mb-3 bg-${kpi.color}-100 text-${kpi.color}-700`}>
                    <i className={`${kpi.icon} text-lg`}></i>
                  </div>
                  <div className="text-2xl font-bold text-foreground-950 font-heading">{kpi.value}</div>
                  <div className="text-xs text-foreground-500 font-body">{kpi.label}</div>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>
    </KOSHubLayout>
  );
}
