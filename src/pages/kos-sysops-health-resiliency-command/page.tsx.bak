import { useState, useMemo } from 'react';
import KOSHubLayout from '@/components/feature/KOSHubLayout';
import {
  microservicesHealth,
  latencyHeatmap,
  memoryLeakDetection,
  cveScanResults,
  sandboxEnvironments,
  generatedPatches,
  integrationTests,
  regressionTests,
  canaryDeployments,
  rollbackHistory,
  sysopsEventLog,
  sysopsKPIs,
} from '@/mocks/kosSysOpsHealthResiliency';

function getStatusColor(status: string) {
  switch (status) {
    case 'healthy': return 'bg-emerald-100 text-emerald-700';
    case 'degraded': return 'bg-amber-100 text-amber-700';
    case 'critical': return 'bg-red-100 text-red-700';
    case 'active': return 'bg-emerald-100 text-emerald-700';
    case 'testing': return 'bg-amber-100 text-amber-700';
    case 'deploying': return 'bg-secondary-100 text-secondary-700';
    case 'completed': return 'bg-emerald-100 text-emerald-700';
    case 'monitoring': return 'bg-amber-100 text-amber-700';
    case 'rollback': return 'bg-red-100 text-red-700';
    case 'rolled_back': return 'bg-red-100 text-red-700';
    case 'success': return 'bg-emerald-100 text-emerald-700';
    case 'in_progress': return 'bg-amber-100 text-amber-700';
    case 'passed': return 'bg-emerald-100 text-emerald-700';
    case 'failed': return 'bg-red-100 text-red-700';
    case 'pending': return 'bg-secondary-100 text-secondary-700';
    case 'running': return 'bg-amber-100 text-amber-700';
    case 'failed_repro': return 'bg-amber-100 text-amber-700';
    case 'warning': return 'bg-amber-100 text-amber-700';
    case 'deferred': return 'bg-background-100 text-foreground-500';
    default: return 'bg-background-100 text-foreground-600';
  }
}

function getStatusLabel(status: string) {
  const map: Record<string, string> = {
    healthy: 'OK', degraded: 'Dégradé', critical: 'Critique',
    active: 'Actif', testing: 'En Test', deploying: 'Déploiement',
    completed: 'Terminé', monitoring: 'Monitoring', rollback: 'Rollback',
    rolled_back: 'Rollback', success: 'Succès', in_progress: 'En Cours',
    passed: 'OK', failed: 'Échec', pending: 'En Attente',
    running: 'En Cours', failed_repro: 'Non Repro.', warning: 'Attention',
    scheduled: 'Planifié', deferred: 'Différé',
  };
  return map[status] || status;
}

function getSeverityBadge(severity: string) {
  const map: Record<string, string> = {
    critical: 'bg-red-600 text-white',
    high: 'bg-red-100 text-red-700',
    medium: 'bg-amber-100 text-amber-700',
    low: 'bg-secondary-100 text-secondary-700',
  };
  return map[severity] || 'bg-background-100 text-foreground-600';
}

function getSeverityLabel(severity: string) {
  const map: Record<string, string> = { critical: 'CRIT.', high: 'Haute', medium: 'Moyenne', low: 'Basse' };
  return map[severity] || severity;
}

export default function KOSSysOpsHealthResiliencyCommandPage() {
  const [kosData, setKosData] = useState<any>(null);
  useEffect(() => {
    fetch('/mocks/kos-blog.json').then(r => r.json()).then(setKosData);
  }, []);
  if (!kosData) return null;

  const [activeTab, setActiveTab] = useState<'observability' | 'sandbox' | 'testing' | 'deployment'>('observability');
  const [expandedService, setExpandedService] = useState<string | null>(null);
  const [expandedSandbox, setExpandedSandbox] = useState<string | null>(null);
  const [expandedCanary, setExpandedCanary] = useState<string | null>(null);
  const [eventLogFilter, setEventLogFilter] = useState<string>('all');

  const tabs = [
    { id: 'observability' as const, label: 'Observabilité Continue', icon: 'ri-radar-line', badge: `${sysopsKPIs.services_total}` },
    { id: 'sandbox' as const, label: 'Sandbox & Patches', icon: 'ri-surround-sound-line', badge: `${sysopsKPIs.sandboxes_active}` },
    { id: 'testing' as const, label: 'Tests d\'Isolation', icon: 'ri-test-tube-line', badge: `${regressionTests.total_tests}` },
    { id: 'deployment' as const, label: 'Déploiement & Rollback', icon: 'ri-rocket-2-line', badge: `${sysopsKPIs.rollbacks_30d}` },
  ];

  const filteredEventLog = useMemo(() => {
    if (eventLogFilter === 'all') return sysopsEventLog;
    if (eventLogFilter === 'deployed') return sysopsEventLog.filter(e => e.deployment_result.includes('success'));
    if (eventLogFilter === 'rolled_back') return sysopsEventLog.filter(e => e.deployment_result.includes('rolled_back'));
    if (eventLogFilter === 'failed') return sysopsEventLog.filter(e => e.sandbox_test_status === 'failed' || e.deployment_result.includes('rolled_back'));
    if (eventLogFilter === 'pending') return sysopsEventLog.filter(e => e.deployment_result.includes('pending') || e.deployment_result.includes('monitoring') || e.deployment_result.includes('scheduled'));
    return sysopsEventLog;
  }, [eventLogFilter]);

  const totalMemoryMB = microservicesHealth.reduce((sum, s) => sum + s.memory_mb, 0);
  const avgLatency = Math.round(microservicesHealth.reduce((sum, s) => sum + s.latency_ms, 0) / microservicesHealth.length);

  const getLatencyColor = (ms: number) => {
    if (ms < 50) return 'text-emerald-600';
    if (ms < 150) return 'text-amber-600';
    return 'text-red-500';
  };

  const getLatencyBg = (ms: number) => {
    if (ms < 50) return 'bg-emerald-50';
    if (ms < 150) return 'bg-amber-50';
    return 'bg-red-50';
  };

  const getHeatmapColor = (value: number) => {
    if (value < 20) return 'bg-emerald-200 text-emerald-800';
    if (value < 50) return 'bg-emerald-100 text-emerald-700';
    if (value < 100) return 'bg-amber-100 text-amber-700';
    if (value < 150) return 'bg-amber-200 text-amber-800';
    return 'bg-red-200 text-red-800';
  };

  return (
    <KOSHubLayout hubId={74}>
      {/* Hero */}
      <section className="relative pt-32 pb-16 sm:pt-40 sm:pb-20 overflow-hidden bg-foreground-950">
        <div className="absolute inset-0">
          <img
            src="https://readdy.ai/api/search-image?query=abstract%20sophisticated%20dark%20technological%20server%20infrastructure%20visualization%20with%20interconnected%20resilient%20microservices%20nodes%20and%20automated%20healing%20pathways%2C%20warm%20emerald%20green%20and%20deep%20crimson%20accent%20lights%20on%20dark%20carbon%20background%2C%20enterprise%20SRE%20site%20reliability%20engineering%20aesthetic%20with%20circuit%20board%20patterns%20and%20observability%20dashboards%20forming%20neural%20network%20topology%2C%20glowing%20green%20health%20indicators%20alongside%20amber%20anomaly%20markers%2C%20zero%20downtime%20deployment%20visualization%20showing%20blue%20green%20canary%20release%20patterns%2C%20no%20text%20no%20human%20figures%2C%20clean%20geometric%20DevOps%20composition%20with%20layered%20infrastructure%20architecture&width=1920&height=600&seq=kos-sysops-hero&orientation=landscape"
            alt=""
            className="w-full h-full object-cover object-center opacity-15"
            width="1920"
            height="600"
          />
        </div>
        <div className="absolute inset-0 bg-gradient-to-b from-foreground-950/70 via-foreground-950/85 to-foreground-950" />

        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
          <div className="text-center max-w-4xl mx-auto">
            <div className="flex flex-wrap justify-center gap-3 mb-6">
              <div className="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/20 border border-emerald-400/30 backdrop-blur-sm">
                <i className="ri-pulse-line text-emerald-400 text-sm" />
                <span className="text-sm font-semibold text-emerald-300 uppercase tracking-wider">
                  KOS SysOps Health & Resiliency™
                </span>
              </div>
              <div className="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-amber-500/20 border border-amber-400/30 backdrop-blur-sm">
                <span className="w-2 h-2 rounded-full bg-amber-400 animate-pulse" />
                <span className="text-sm font-semibold text-amber-300 uppercase tracking-wider">
                  SRE Big Four — Live
                </span>
              </div>
            </div>
            <h1 className="font-[family-name:var(--font-heading)] text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
              Zero-Downtime Auto-Healing.
              <span className="block text-emerald-400 mt-2">Observabilité · Sandbox · Canary · Rollback.</span>
            </h1>
            <p className="text-lg sm:text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
              <strong className="text-white">{sysopsKPIs.services_total} microservices</strong> surveillés en continu.{' '}
              <strong className="text-white">{sysopsKPIs.cvss_critical_open + sysopsKPIs.cvss_high_open} CVE actives</strong> en cours de patching.{' '}
              Score de santé <strong className="text-emerald-400">{sysopsKPIs.overall_health_score}/100</strong>.{' '}
              Uptime 30j : <strong className="text-white">{sysopsKPIs.uptime_30d_pct}%</strong>.
            </p>
            <div className="flex flex-wrap justify-center gap-3">
              <div className="flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/20 border border-emerald-400/30 backdrop-blur-sm">
                <span className="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" />
                <span className="text-sm text-emerald-300 font-semibold">{sysopsKPIs.services_healthy}/{sysopsKPIs.services_total} Healthy</span>
              </div>
              <div className="flex items-center gap-2 px-4 py-2 rounded-full bg-amber-500/20 border border-amber-400/30 backdrop-blur-sm">
                <span className="w-2 h-2 rounded-full bg-amber-500" />
                <span className="text-sm text-amber-300 font-semibold">{sysopsKPIs.services_degraded} Dégradé</span>
              </div>
              <div className="flex items-center gap-2 px-4 py-2 rounded-full bg-red-500/20 border border-red-400/30 backdrop-blur-sm">
                <i className="ri-shield-flash-line text-red-400" />
                <span className="text-sm text-red-300 font-semibold">{sysopsKPIs.active_cves_total} CVE</span>
              </div>
              <div className="flex items-center gap-2 px-4 py-2 rounded-full bg-teal-500/20 border border-teal-400/30 backdrop-blur-sm">
                <span className="text-sm text-teal-300 font-semibold">{sysopsKPIs.zero_downtime_rate_pct}% Zero-Downtime</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* KPIs Bar */}
      <section className="py-4 bg-foreground-950 border-b border-white/10">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-8 gap-3">
            {[
              { label: 'Score Santé', value: `${sysopsKPIs.overall_health_score}/100`, icon: 'ri-heart-pulse-line', color: 'text-emerald-400' },
              { label: 'Latence Avg', value: `${sysopsKPIs.avg_latency_ms}ms`, icon: 'ri-speed-line', color: 'text-teal-400' },
              { label: 'Uptime 30j', value: `${sysopsKPIs.uptime_30d_pct}%`, icon: 'ri-check-double-line', color: 'text-emerald-400' },
              { label: 'MTTR', value: `${sysopsKPIs.mttr_minutes}min`, icon: 'ri-timer-flash-line', color: 'text-amber-400' },
              { label: 'CVE Open', value: String(sysopsKPIs.active_cves_total), icon: 'ri-bug-line', color: 'text-red-400' },
              { label: 'Sandboxes', value: String(sysopsKPIs.sandboxes_active), icon: 'ri-stack-line', color: 'text-teal-400' },
              { label: 'Rollbacks', value: String(sysopsKPIs.rollbacks_30d), icon: 'ri-arrow-go-back-line', color: 'text-amber-400' },
              { label: 'Zéro-DT', value: `${sysopsKPIs.zero_downtime_rate_pct}%`, icon: 'ri-contrast-drop-line', color: 'text-emerald-400' },
            ].map((kpi, i) => (
              <div key={i} className="text-center py-2 rounded-lg bg-white/5 border border-white/5">
                <i className={`${kpi.icon} text-sm mb-1 block ${kpi.color}`} />
                <span className="block text-lg font-bold text-white font-[family-name:var(--font-heading)]">{kpi.value}</span>
                <span className="text-[10px] text-gray-400">{kpi.label}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* Tabs */}
      <section className="sticky top-20 z-30 bg-white border-b border-background-200">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
          <div className="flex items-center gap-1 overflow-x-auto bg-background-100 rounded-full p-1">
            {tabs.map(tab => (
              <button
                key={tab.id}
                onClick={() => setActiveTab(tab.id)}
                className={`whitespace-nowrap px-5 py-2.5 rounded-full text-sm font-medium transition-all flex items-center gap-2 cursor-pointer ${
                  activeTab === tab.id ? 'bg-white text-foreground-950 shadow-sm' : 'text-foreground-500 hover:text-foreground-700'
                }`}
              >
                <i className={tab.icon}></i>
                {tab.label}
                {tab.badge && (
                  <span className={`ml-1 px-1.5 py-0.5 rounded-full text-xs font-semibold ${
                    activeTab === tab.id ? 'bg-primary-100 text-primary-700' : 'bg-background-200/70 text-foreground-500'
                  }`}>{tab.badge}</span>
                )}
              </button>
            ))}
          </div>
        </div>
      </section>

      {/* MAIN kosData.CONTENT */}
      <div className="max-w-[1400px] mx-auto px-4 md:px-6 py-8">

        {/* ==================== OBSERVABILITY ==================== */}
        {activeTab === 'observability' && (
          <div className="space-y-6">
            {/* Service Health Grid */}
            <div className="bg-white border border-background-200/70 rounded-lg p-6">
              <div className="flex items-center justify-between mb-4">
                <h2 className="text-lg font-semibold text-foreground-950 font-[family-name:var(--font-heading)]">
                  <i className="ri-server-line text-emerald-500 mr-2"></i>
                  Microservices Health — {sysopsKPIs.services_healthy}/{sysopsKPIs.services_total} Healthy
                </h2>
                <div className="flex items-center gap-4 text-xs text-foreground-500">
                  <span>Avg Latency: <strong className="text-foreground-900">{avgLatency}ms</strong></span>
                  <span>Total Memory: <strong className="text-foreground-900">{(totalMemoryMB / 1024).toFixed(1)}GB</strong></span>
                </div>
              </div>
              <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-3">
                {microservicesHealth.map(svc => {
                  const isExpanded = expandedService === svc.id;
                  return (
                    <div key={svc.id} className={`rounded-lg border transition-all ${
                      isExpanded ? 'border-foreground-300 shadow-sm' : 'border-background-200/70 hover:border-background-300/60'
                    }`}>
                      <button
                        onClick={() => setExpandedService(isExpanded ? null : svc.id)}
                        className="w-full p-4 text-left cursor-pointer"
                      >
                        <div className="flex items-start justify-between gap-2">
                          <div className="flex items-center gap-2 min-w-0">
                            <span className={`w-2 h-2 rounded-full flex-shrink-0 ${
                              svc.status === 'healthy' ? 'bg-emerald-500 animate-pulse' :
                              svc.status === 'degraded' ? 'bg-amber-500' : 'bg-red-500'
                            }`}></span>
                            <span className="text-sm font-medium text-foreground-900 truncate">{svc.name}</span>
                          </div>
                          <span className={`px-2 py-0.5 rounded-full text-xs font-medium flex-shrink-0 ${getStatusColor(svc.status)}`}>
                            {getStatusLabel(svc.status)}
                          </span>
                        </div>
                        <div className="flex items-center justify-between mt-2 text-xs text-foreground-500">
                          <span className={getLatencyColor(svc.latency_ms)}>
                            <i className="ri-speed-line mr-0.5"></i>{svc.latency_ms}ms
                          </span>
                          <span>{svc.memory_mb}MB</span>
                          <span>{svc.cpu_pct}% CPU</span>
                        </div>
                      </button>
                      {isExpanded && (
                        <div className="px-4 pb-4 border-t border-background-100 pt-3 space-y-2 text-xs">
                          <div className="flex justify-between">
                            <span className="text-foreground-500">Endpoint</span>
                            <span className="font-mono text-foreground-700">{svc.endpoint}</span>
                          </div>
                          <div className="flex justify-between">
                            <span className="text-foreground-500">Version</span>
                            <span className="font-mono">{svc.version}</span>
                          </div>
                          <div className="flex justify-between">
                            <span className="text-foreground-500">Protocol</span>
                            <span>{svc.protocol}</span>
                          </div>
                          <div className="flex justify-between">
                            <span className="text-foreground-500">Uptime</span>
                            <span className={svc.uptime_pct >= 99.99 ? 'text-emerald-600 font-semibold' : 'text-foreground-700'}>{svc.uptime_pct}%</span>
                          </div>
                          <div className="flex justify-between">
                            <span className="text-foreground-500">Restarts 24h</span>
                            <span className={svc.restarts_24h > 0 ? 'text-amber-600 font-semibold' : 'text-emerald-600'}>{svc.restarts_24h}</span>
                          </div>
                        </div>
                      )}
                    </div>
                  );
                })}
              </div>
            </div>

            {/* Latency Heatmap */}
            <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
              <div className="bg-white border border-background-200/70 rounded-lg p-6">
                <h2 className="text-lg font-semibold text-foreground-950 font-[family-name:var(--font-heading)] mb-4">
                  <i className="ri-temp-hot-line text-amber-500 mr-2"></i>
                  Latency Heatmap (ms)
                </h2>
                <div className="overflow-x-auto">
                  <table className="w-full text-xs">
                    <thead>
                      <tr>
                        <th className="text-left py-2 px-2 font-medium text-foreground-500">Service</th>
                        {latencyHeatmap.time_slots.map(slot => (
                          <th key={slot} className="text-center py-2 px-2 font-medium text-foreground-500">{slot}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {latencyHeatmap.services.map((svc, i) => (
                        <tr key={svc} className="border-t border-background-100">
                          <td className="py-2 px-2 text-foreground-700 font-medium whitespace-nowrap">{svc}</td>
                          {latencyHeatmap.matrix[i].map((val, j) => (
                            <td key={j} className="py-2 px-1 text-center">
                              <span className={`px-1.5 py-0.5 rounded text-[11px] font-bold ${getHeatmapColor(val)}`}>
                                {val}
                              </span>
                            </td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                <div className="mt-3 text-xs text-foreground-500 flex items-center gap-2">
                  <span>Seuil critique : <strong className="text-red-600">&gt;{latencyHeatmap.threshold_ms}ms</strong></span>
                  <span>·</span>
                  <span>Alertes déclenchées : <strong className="text-amber-600">{latencyHeatmap.alerts_triggered}</strong></span>
                </div>
              </div>

              {/* Memory Leaks */}
              <div className="bg-white border border-background-200/70 rounded-lg p-6">
                <h2 className="text-lg font-semibold text-foreground-950 font-[family-name:var(--font-heading)] mb-4">
                  <i className="ri-contrast-drop-2-line text-red-500 mr-2"></i>
                  Memory Leak Detection
                </h2>
                <div className="space-y-3">
                  {memoryLeakDetection.map(leak => (
                    <div key={leak.id} className={`rounded-lg p-4 ${getLatencyBg(leak.severity === 'high' ? 200 : leak.severity === 'medium' ? 100 : 30)}`}>
                      <div className="flex items-center justify-between mb-2">
                        <span className="text-sm font-medium text-foreground-900">{leak.service}</span>
                        <span className={`px-2 py-0.5 rounded-full text-xs font-medium ${getSeverityBadge(leak.severity)}`}>
                          {getSeverityLabel(leak.severity)}
                        </span>
                      </div>
                      <div className="text-xs text-foreground-600 mb-2">{leak.suspected_culprit}</div>
                      <div className="grid grid-cols-3 gap-2 text-xs">
                        <div>
                          <span className="text-foreground-400">Baseline</span>
                          <div className="font-bold text-foreground-900">{leak.baseline_mb}MB</div>
                        </div>
                        <div>
                          <span className="text-foreground-400">Current</span>
                          <div className="font-bold text-red-600">{leak.current_mb}MB</div>
                        </div>
                        <div>
                          <span className="text-foreground-400">Growth Rate</span>
                          <div className="font-bold text-amber-600">+{leak.growth_rate_mb_h}MB/h</div>
                        </div>
                      </div>
                      <div className="flex items-center gap-4 mt-2 text-xs text-foreground-500">
                        <span><i className={`${leak.sandbox_reproduced ? 'ri-checkbox-circle-line text-emerald-500' : 'ri-close-circle-line text-red-500'} mr-1`}></i>Sandbox Repro: {leak.sandbox_reproduced ? 'Oui' : 'Non'}</span>
                        <span>{new Date(leak.detected_at).toLocaleString('fr-FR', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })}</span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            {/* CVE Scan */}
            <div className="bg-white border border-background-200/70 rounded-lg p-6">
              <div className="flex items-center justify-between mb-4">
                <h2 className="text-lg font-semibold text-foreground-950 font-[family-name:var(--font-heading)]">
                  <i className="ri-shield-flash-line text-red-500 mr-2"></i>
                  CVE Scan — {sysopsKPIs.active_cves_total} Vulnérabilités Actives
                </h2>
                <span className="text-xs text-foreground-500">
                  SLA breach risk: <strong className="text-amber-600">{sysopsKPIs.cve_sla_breach_risk}</strong>
                </span>
              </div>
              <div className="overflow-x-auto">
                <table className="w-full text-sm">
                  <thead>
                    <tr className="border-b border-background-200/70 bg-background-50">
                      <th className="text-left py-3 px-3 font-medium text-foreground-700">CVE</th>
                      <th className="text-left py-3 px-3 font-medium text-foreground-700">Package</th>
                      <th className="text-center py-3 px-3 font-medium text-foreground-700">CVSS</th>
                      <th className="text-center py-3 px-3 font-medium text-foreground-700">Sévérité</th>
                      <th className="text-left py-3 px-3 font-medium text-foreground-700">Services Affectés</th>
                      <th className="text-center py-3 px-3 font-medium text-foreground-700">SLA</th>
                      <th className="text-center py-3 px-3 font-medium text-foreground-700">Patch</th>
                      <th className="text-center py-3 px-3 font-medium text-foreground-700">Exploit Public</th>
                    </tr>
                  </thead>
                  <tbody>
                    {cveScanResults.map(cve => (
                      <tr key={cve.id} className="border-b border-background-100/70 hover:bg-background-50/50">
                        <td className="py-3 px-3 font-mono text-xs font-bold text-foreground-900">{cve.id}</td>
                        <td className="py-3 px-3 text-xs">
                          <span className="text-foreground-700">{cve.package_name}</span>
                          <div className="text-foreground-400">{cve.current_version} → {cve.fixed_version}</div>
                        </td>
                        <td className="py-3 px-3 text-center">
                          <span className={`font-bold ${cve.cvss_score >= 9 ? 'text-red-600' : cve.cvss_score >= 7 ? 'text-amber-600' : cve.cvss_score >= 5 ? 'text-secondary-600' : 'text-foreground-500'}`}>
                            {cve.cvss_score}
                          </span>
                        </td>
                        <td className="py-3 px-3 text-center">
                          <span className={`px-2 py-0.5 rounded-full text-xs font-medium ${getSeverityBadge(cve.severity)}`}>
                            {getSeverityLabel(cve.severity)}
                          </span>
                        </td>
                        <td className="py-3 px-3">
                          <div className="flex flex-wrap gap-1">
                            {cve.affected_services.map(s => (
                              <span key={s} className="text-[10px] px-1.5 py-0.5 rounded bg-background-100 text-foreground-600">{s}</span>
                            ))}
                          </div>
                        </td>
                        <td className="py-3 px-3 text-center">
                          <span className={`text-xs font-medium ${cve.sla_hours <= 8 ? 'text-red-600' : cve.sla_hours <= 24 ? 'text-amber-600' : 'text-foreground-500'}`}>
                            {cve.sla_hours}h
                          </span>
                          <div className="text-[10px] text-foreground-400">{cve.cve_age_days}j</div>
                        </td>
                        <td className="py-3 px-3 text-center">
                          {cve.patch_available ? (
                            <span className="text-emerald-600 text-xs font-medium"><i className="ri-check-line mr-1"></i>Dispo</span>
                          ) : (
                            <span className="text-red-500 text-xs font-medium"><i className="ri-close-line mr-1"></i>Non</span>
                          )}
                        </td>
                        <td className="py-3 px-3 text-center">
                          {cve.exploit_public ? (
                            <span className="text-red-600 text-xs font-bold"><i className="ri-error-warning-line mr-1"></i>Oui</span>
                          ) : (
                            <span className="text-foreground-400 text-xs">Non</span>
                          )}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        )}

        {/* ==================== SANDBOX & PATCHES ==================== */}
        {activeTab === 'sandbox' && (
          <div className="space-y-6">
            {/* Sandbox Environments */}
            <div className="bg-white border border-background-200/70 rounded-lg p-6">
              <h2 className="text-lg font-semibold text-foreground-950 font-[family-name:var(--font-heading)] mb-4">
                <i className="ri-stack-line text-teal-500 mr-2"></i>
                Sandboxes Actives — {sysopsKPIs.sandboxes_active} Environnements Isolés
              </h2>
              <div className="grid grid-cols-1 lg:grid-cols-3 gap-4">
                {sandboxEnvironments.map(sbx => {
                  const isExpanded = expandedSandbox === sbx.id;
                  return (
                    <div key={sbx.id} className={`rounded-lg border transition-all ${
                      isExpanded ? 'border-foreground-300 shadow-sm' : 'border-background-200/70'
                    }`}>
                      <button
                        onClick={() => setExpandedSandbox(isExpanded ? null : sbx.id)}
                        className="w-full p-5 text-left cursor-pointer"
                      >
                        <div className="flex items-center justify-between mb-3">
                          <span className="text-sm font-bold text-foreground-900 font-mono">{sbx.name}</span>
                          <span className={`px-2 py-0.5 rounded-full text-xs font-medium ${getStatusColor(sbx.status)}`}>
                            {getStatusLabel(sbx.status)}
                          </span>
                        </div>
                        <div className="space-y-2 text-xs">
                          <div className="flex justify-between">
                            <span className="text-foreground-500">Base Image</span>
                            <span className="font-mono text-foreground-700 truncate ml-2">{sbx.base_image}</span>
                          </div>
                          <div className="flex justify-between">
                            <span className="text-foreground-500">Patches</span>
                            <span className="font-bold text-foreground-900">{sbx.patch_count}</span>
                          </div>
                          <div className="flex justify-between">
                            <span className="text-foreground-500">Services Clonés</span>
                            <span className="text-foreground-700">{sbx.services_cloned.length}</span>
                          </div>
                          <div className="flex justify-between">
                            <span className="text-foreground-500">Isolation</span>
                            <span className="text-emerald-600 font-medium">{sbx.isolation_level.replace(/_/g, ' ')}</span>
                          </div>
                          <div className="flex justify-between">
                            <span className="text-foreground-500">TTL</span>
                            <span className="text-amber-600">{sbx.ttl_hours}h</span>
                          </div>
                        </div>
                      </button>
                      {isExpanded && (
                        <div className="px-5 pb-5 border-t border-background-100 pt-4">
                          <h4 className="text-xs font-bold text-foreground-400 uppercase tracking-wider mb-2">Services Clonés</h4>
                          <div className="flex flex-wrap gap-1.5 mb-3">
                            {sbx.services_cloned.map(s => (
                              <span key={s} className="text-[10px] px-2 py-1 rounded-full bg-background-100 text-foreground-600 border border-background-200">{s}</span>
                            ))}
                          </div>
                          <div className="flex justify-between text-xs text-foreground-500">
                            <span>Resource: {sbx.resource_profile}</span>
                            <span>{new Date(sbx.created_at).toLocaleString('fr-FR', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })}</span>
                          </div>
                        </div>
                      )}
                    </div>
                  );
                })}
              </div>
            </div>

            {/* Generated Patches */}
            <div className="bg-white border border-background-200/70 rounded-lg p-6">
              <h2 className="text-lg font-semibold text-foreground-950 font-[family-name:var(--font-heading)] mb-4">
                <i className="ri-tools-line text-amber-500 mr-2"></i>
                Patches Générés — {sysopsKPIs.patches_generated_30d} en 30j
              </h2>
              <div className="space-y-3">
                {generatedPatches.map(patch => (
                  <div key={patch.id} className="bg-background-50 rounded-lg p-4 border border-background-200/60">
                    <div className="flex flex-col sm:flex-row sm:items-center gap-2 mb-2">
                      <span className="text-xs font-bold font-mono text-foreground-900">{patch.id}</span>
                      <span className={`px-2 py-0.5 rounded-full text-xs font-medium ${
                        patch.type === 'security_patch' ? 'bg-red-100 text-red-700' : 'bg-teal-100 text-teal-700'
                      }`}>
                        {patch.type === 'security_patch' ? 'Sécurité' : 'Memory Fix'}
                      </span>
                      <span className="text-xs text-foreground-500">Sandbox: {patch.sandbox_id}</span>
                      <span className="text-xs text-foreground-600 font-medium ml-auto">{patch.component}</span>
                    </div>
                    <div className="text-xs text-foreground-600 mb-2">{patch.diff_summary}</div>
                    <div className="flex flex-wrap items-center gap-3 text-xs text-foreground-500">
                      <span className="flex items-center gap-1">
                        <i className="ri-file-code-line"></i>
                        {patch.files_changed} files · +{patch.lines_added}/-{patch.lines_removed}
                      </span>
                      <span className="flex items-center gap-1">
                        <i className="ri-flask-line"></i>
                        Coverage: <strong className="text-emerald-600">{patch.test_coverage_pct}%</strong>
                      </span>
                      <span className="flex items-center gap-1">
                        <i className="ri-code-s-slash-line"></i>
                        {patch.language}
                      </span>
                      <span className="flex items-center gap-1 text-foreground-400">
                        <i className="ri-user-3-line"></i>
                        {patch.generated_by}
                      </span>
                      <span className="flex items-center gap-1 text-foreground-400 ml-auto">
                        {new Date(patch.generated_at).toLocaleString('fr-FR', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })}
                      </span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}

        {/* ==================== TESTING ==================== */}
        {activeTab === 'testing' && (
          <div className="space-y-6">
            {/* Integration Tests */}
            <div className="bg-white border border-background-200/70 rounded-lg p-6">
              <div className="flex items-center justify-between mb-4">
                <h2 className="text-lg font-semibold text-foreground-950 font-[family-name:var(--font-heading)]">
                  <i className="ri-flask-line text-teal-500 mr-2"></i>
                  {integrationTests.suite_name} — {integrationTests.pass_rate_pct}% Pass Rate
                </h2>
                <span className="text-xs text-foreground-500">
                  {integrationTests.duration_seconds}s · {new Date(integrationTests.ran_at).toLocaleString('fr-FR', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })}
                </span>
              </div>

              <div className="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
                <div className="bg-emerald-50 rounded-lg p-4 text-center">
                  <div className="text-2xl font-bold text-emerald-600 font-[family-name:var(--font-heading)]">{integrationTests.passed}</div>
                  <div className="text-xs text-emerald-700">Passés</div>
                </div>
                <div className="bg-red-50 rounded-lg p-4 text-center">
                  <div className="text-2xl font-bold text-red-600 font-[family-name:var(--font-heading)]">{integrationTests.failed}</div>
                  <div className="text-xs text-red-700">Échoués</div>
                </div>
                <div className="bg-background-50 rounded-lg p-4 text-center">
                  <div className="text-2xl font-bold text-foreground-500 font-[family-name:var(--font-heading)]">{integrationTests.skipped}</div>
                  <div className="text-xs text-foreground-500">Skippés</div>
                </div>
                <div className="bg-teal-50 rounded-lg p-4 text-center">
                  <div className="text-2xl font-bold text-teal-600 font-[family-name:var(--font-heading)]">{integrationTests.total_tests}</div>
                  <div className="text-xs text-teal-700">Total</div>
                </div>
              </div>

              {/* Categories */}
              <h4 className="text-sm font-bold text-foreground-700 mb-3">Par Catégorie</h4>
              <div className="space-y-2 mb-6">
                {integrationTests.categories.map(cat => (
                  <div key={cat.name} className="flex items-center gap-3 p-3 bg-background-50 rounded-lg">
                    <span className="text-sm font-medium text-foreground-900 flex-1">{cat.name}</span>
                    <span className="text-xs text-foreground-500">{cat.passed}/{cat.total}</span>
                    <div className="w-32 bg-background-200/70 rounded-full h-2 overflow-hidden">
                      <div className={`h-full rounded-full transition-all ${cat.pass_rate === 100 ? 'bg-emerald-500' : 'bg-amber-500'}`}
                        style={{ width: `${cat.pass_rate}%` }}></div>
                    </div>
                    <span className={`text-xs font-bold w-12 text-right ${cat.pass_rate === 100 ? 'text-emerald-600' : 'text-amber-600'}`}>
                      {cat.pass_rate}%
                    </span>
                  </div>
                ))}
              </div>

              {/* Failures */}
              {integrationTests.failures.length > 0 && (
                <>
                  <h4 className="text-sm font-bold text-red-700 mb-3 flex items-center gap-1">
                    <i className="ri-error-warning-line"></i>
                    {integrationTests.failures.length} Échecs
                  </h4>
                  <div className="space-y-2">
                    {integrationTests.failures.map(f => (
                      <div key={f.test_id} className="bg-red-50 border border-red-200 rounded-lg p-3">
                        <div className="flex items-center gap-2 mb-1">
                          <span className="text-xs font-bold font-mono text-red-700">{f.test_id}</span>
                          <span className="text-xs text-red-600">{f.category}</span>
                          <span className="text-xs text-foreground-500 ml-auto">{f.service}</span>
                        </div>
                        <div className="text-xs text-foreground-700">{f.failure}</div>
                        <div className="flex items-center gap-4 mt-1 text-xs">
                          <span className="text-foreground-500">Expected: <strong className="text-emerald-600">{f.expected}</strong></span>
                          <span className="text-foreground-500">Actual: <strong className="text-red-600">{f.actual}</strong></span>
                          {f.fix_patch && <span className="text-teal-600 font-medium">Fix: {f.fix_patch}</span>}
                          {!f.fix_patch && <span className="text-amber-600 font-medium">Pas de patch</span>}
                        </div>
                      </div>
                    ))}
                  </div>
                </>
              )}
            </div>

            {/* Regression Tests */}
            <div className="bg-white border border-background-200/70 rounded-lg p-6">
              <div className="flex items-center justify-between mb-4">
                <h2 className="text-lg font-semibold text-foreground-950 font-[family-name:var(--font-heading)]">
                  <i className="ri-check-double-line text-primary-500 mr-2"></i>
                  {regressionTests.suite_name} — {regressionTests.pass_rate_pct}%
                </h2>
                <span className="text-xs text-foreground-500">
                  {regressionTests.duration_seconds}s · {new Date(regressionTests.ran_at).toLocaleString('fr-FR', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })}
                </span>
              </div>

              <div className="grid grid-cols-3 gap-3 mb-6">
                <div className="bg-emerald-50 rounded-lg p-3 text-center">
                  <div className="text-xl font-bold text-emerald-600">{regressionTests.passed}</div>
                  <div className="text-xs text-emerald-700">Passés</div>
                </div>
                <div className="bg-red-50 rounded-lg p-3 text-center">
                  <div className="text-xl font-bold text-red-600">{regressionTests.failed}</div>
                  <div className="text-xs text-red-700">Échoués</div>
                </div>
                <div className="bg-background-50 rounded-lg p-3 text-center">
                  <div className="text-xl font-bold text-foreground-500">{regressionTests.total_tests}</div>
                  <div className="text-xs text-foreground-500">Total</div>
                </div>
              </div>

              <h4 className="text-sm font-bold text-foreground-700 mb-3">Critical Paths</h4>
              <div className="space-y-2">
                {regressionTests.critical_paths.map(cp => (
                  <div key={cp.path} className={`flex items-center gap-3 p-3 rounded-lg ${
                    cp.status === 'pass' ? 'bg-emerald-50' : 'bg-amber-50'
                  }`}>
                    <span className={`w-6 h-6 rounded-full flex items-center justify-center flex-shrink-0 ${
                      cp.status === 'pass' ? 'bg-emerald-100 text-emerald-600' : 'bg-amber-100 text-amber-600'
                    }`}>
                      <i className={`text-xs ${cp.status === 'pass' ? 'ri-check-line' : 'ri-error-warning-line'}`}></i>
                    </span>
                    <span className="flex-1 text-sm font-medium text-foreground-900">{cp.path}</span>
                    <span className="text-xs text-foreground-500">{cp.tests} tests</span>
                    <span className={`text-xs font-bold ${cp.status === 'pass' ? 'text-emerald-600' : 'text-amber-600'}`}>
                      {cp.passed}/{cp.tests}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}

        {/* ==================== DEPLOYMENT & ROLLBACK ==================== */}
        {activeTab === 'deployment' && (
          <div className="space-y-6">
            {/* Canary Deployments */}
            <div className="bg-white border border-background-200/70 rounded-lg p-6">
              <h2 className="text-lg font-semibold text-foreground-950 font-[family-name:var(--font-heading)] mb-4">
                <i className="ri-rocket-2-line text-teal-500 mr-2"></i>
                Canary Deployments — {canaryDeployments.filter(c => c.status !== 'completed' && c.status !== 'rollback').length} Actifs
              </h2>
              <div className="space-y-4">
                {canaryDeployments.map(canary => {
                  const isExpanded = expandedCanary === canary.id;
                  return (
                    <div key={canary.id} className={`rounded-lg border transition-all ${
                      isExpanded ? 'border-foreground-300 shadow-sm' : 'border-background-200/70'
                    }`}>
                      <button
                        onClick={() => setExpandedCanary(isExpanded ? null : canary.id)}
                        className="w-full p-5 text-left cursor-pointer"
                      >
                        <div className="flex flex-col sm:flex-row sm:items-center gap-2 mb-3">
                          <span className="text-xs font-bold font-mono text-foreground-900">{canary.id}</span>
                          <span className="text-sm font-semibold text-foreground-900 flex-1">{canary.name}</span>
                          <span className={`px-2 py-0.5 rounded-full text-xs font-medium ${getStatusColor(canary.result)}`}>
                            {getStatusLabel(canary.result)}
                          </span>
                        </div>

                        <div className="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs mb-3">
                          <div>
                            <span className="text-foreground-400">Stratégie</span>
                            <div className="font-bold text-foreground-900 font-mono">{canary.strategy}</div>
                          </div>
                          <div>
                            <span className="text-foreground-400">Canary %</span>
                            <div className="font-bold text-teal-600">{canary.canary_pct}% → {canary.rollout_pct}%</div>
                          </div>
                          <div>
                            <span className="text-foreground-400">Auto-Rollback</span>
                            <div className={`font-bold ${canary.auto_rollback ? 'text-red-600' : 'text-emerald-600'}`}>
                              {canary.auto_rollback ? 'DÉCLENCHÉ' : 'Non'}
                            </div>
                          </div>
                          <div>
                            <span className="text-foreground-400">Déviation</span>
                            <div className={`font-bold ${canary.metric_deviation_pct > 5 ? 'text-red-600' : 'text-emerald-600'}`}>
                              {canary.metric_deviation_pct > 0 ? '+' : ''}{canary.metric_deviation_pct}%
                            </div>
                          </div>
                        </div>

                        {/* Pre/Post comparison sparkline */}
                        <div className="flex items-center gap-4 p-3 bg-background-50 rounded-lg">
                          <div className="flex-1">
                            <div className="text-[10px] text-foreground-400 uppercase">Pre-Deploy</div>
                            <div className="text-xs font-mono text-foreground-700">
                              {canary.pre_metrics.avg_latency_ms}ms · {canary.pre_metrics.error_rate_pct}% err · {canary.pre_metrics.memory_mb}MB
                            </div>
                          </div>
                          <i className="ri-arrow-right-line text-foreground-400"></i>
                          <div className="flex-1">
                            <div className="text-[10px] text-foreground-400 uppercase">Post-Deploy</div>
                            <div className={`text-xs font-mono ${canary.result === 'rolled_back' ? 'text-red-600' : 'text-emerald-600'}`}>
                              {canary.post_metrics.avg_latency_ms}ms · {canary.post_metrics.error_rate_pct}% err · {canary.post_metrics.memory_mb}MB
                            </div>
                          </div>
                        </div>

                        <div className="flex items-center gap-4 mt-2 text-xs text-foreground-500">
                          <span><i className="ri-time-line mr-1"></i>{new Date(canary.started_at).toLocaleString('fr-FR', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })}</span>
                          {canary.completed_at && <span>→ {new Date(canary.completed_at).toLocaleString('fr-FR', { hour: '2-digit', minute: '2-digit' })}</span>}
                        </div>
                      </button>

                      {isExpanded && (
                        <div className="px-5 pb-5 border-t border-background-100 pt-4">
                          <h4 className="text-xs font-bold text-foreground-400 uppercase tracking-wider mb-2">Services Ciblés</h4>
                          <div className="flex flex-wrap gap-1.5 mb-3">
                            {canary.target_services.map(s => (
                              <span key={s} className="text-[10px] px-2 py-1 rounded-full bg-background-100 text-foreground-600 border border-background-200">{s}</span>
                            ))}
                          </div>
                          <div className="text-xs text-foreground-500">
                            Sandbox: {canary.sandbox_id}
                          </div>
                        </div>
                      )}
                    </div>
                  );
                })}
              </div>
            </div>

            {/* Rollback History */}
            <div className="bg-white border border-background-200/70 rounded-lg p-6">
              <h2 className="text-lg font-semibold text-foreground-950 font-[family-name:var(--font-heading)] mb-4">
                <i className="ri-arrow-go-back-line text-red-500 mr-2"></i>
                Rollback History — {sysopsKPIs.rollbacks_30d} en 30j · 100% Zero-Downtime
              </h2>
              <div className="space-y-3">
                {rollbackHistory.map(rb => (
                  <div key={rb.id} className="bg-background-50 rounded-lg p-4 border border-background-200/60">
                    <div className="flex flex-col sm:flex-row sm:items-center gap-2 mb-2">
                      <span className="text-xs font-bold font-mono text-foreground-900">{rb.id}</span>
                      {rb.canary_id ? (
                        <span className="text-xs text-foreground-500">Canary: {rb.canary_id}</span>
                      ) : (
                        <span className="text-xs text-foreground-500">Manual Trigger</span>
                      )}
                      <span className={`px-2 py-0.5 rounded-full text-xs font-medium ml-auto ${
                        rb.downtime_seconds === 0 ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700'
                      }`}>
                        {rb.downtime_seconds}s downtime
                      </span>
                    </div>
                    <div className="text-xs text-foreground-600 mb-2">{rb.trigger}</div>
                    <div className="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs">
                      <div>
                        <span className="text-foreground-400">Stratégie</span>
                        <div className="font-bold text-foreground-900">{rb.strategy.replace(/_/g, ' ')}</div>
                      </div>
                      <div>
                        <span className="text-foreground-400">Layers</span>
                        <div className="font-bold text-foreground-900">{rb.layers_reverted}</div>
                      </div>
                      <div>
                        <span className="text-foreground-400">Post-Rollback Latency</span>
                        <div className="font-bold text-emerald-600">{rb.post_rollback_latency_ms}ms</div>
                      </div>
                      <div>
                        <span className="text-foreground-400">Post-Rollback Error</span>
                        <div className="font-bold text-emerald-600">{rb.post_rollback_error_pct}%</div>
                      </div>
                    </div>
                    <div className="flex items-center gap-2 mt-2 text-xs text-foreground-500">
                      <span><i className="ri-timer-line mr-1"></i>Duration: {rb.rollback_completed ? (
                        `${Math.round((new Date(rb.rollback_completed).getTime() - new Date(rb.rollback_started).getTime()) / 1000)}s`
                      ) : 'N/A'}</span>
                      {rb.data_integrity_verified && (
                        <span className="text-emerald-600"><i className="ri-checkbox-circle-line mr-1"></i>kosData.Data Integrity Verified</span>
                      )}
                    </div>
                  </div>
                ))}
              </div>
            </div>

            {/* Event Log — JSON Format */}
            <div className="bg-white border border-background-200/70 rounded-lg p-6">
              <div className="flex items-center justify-between mb-4">
                <h2 className="text-lg font-semibold text-foreground-950 font-[family-name:var(--font-heading)]">
                  <i className="ri-file-list-3-line mr-2"></i>
                  SysOps Event Log — JSON Strict
                </h2>
                <div className="flex items-center gap-1 bg-background-100 rounded-full p-1">
                  {(['all', 'deployed', 'rolled_back', 'failed', 'pending'] as const).map(f => (
                    <button
                      key={f}
                      onClick={() => setEventLogFilter(f)}
                      className={`whitespace-nowrap px-3 py-1 rounded-full text-xs font-medium cursor-pointer transition-all ${
                        eventLogFilter === f ? 'bg-white text-foreground-950 shadow-sm' : 'text-foreground-500 hover:text-foreground-700'
                      }`}
                    >
                      {f === 'all' ? 'Tous' : f === 'deployed' ? 'Succès' : f === 'rolled_back' ? 'Rollback' : f === 'failed' ? 'Échecs' : 'En Cours'}
                    </button>
                  ))}
                </div>
              </div>
              <div className="overflow-x-auto">
                <table className="w-full text-xs">
                  <thead>
                    <tr className="border-b border-background-200/70 bg-background-50">
                      <th className="text-left py-2 px-2 font-medium text-foreground-700">Timestamp</th>
                      <th className="text-left py-2 px-2 font-medium text-foreground-700">Component</th>
                      <th className="text-left py-2 px-2 font-medium text-foreground-700">Detected Issue</th>
                      <th className="text-left py-2 px-2 font-medium text-foreground-700">Resolution Strategy</th>
                      <th className="text-center py-2 px-2 font-medium text-foreground-700">Sandbox Test</th>
                      <th className="text-center py-2 px-2 font-medium text-foreground-700">Deployment Result</th>
                    </tr>
                  </thead>
                  <tbody>
                    {filteredEventLog.map((event, i) => (
                      <tr key={i} className="border-b border-background-100/70 hover:bg-background-50/50">
                        <td className="py-2 px-2 font-mono text-foreground-500 whitespace-nowrap">{new Date(event.timestamp).toLocaleString('fr-FR', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })}</td>
                        <td className="py-2 px-2 font-mono text-foreground-900 whitespace-nowrap text-[11px]">{event.component}</td>
                        <td className="py-2 px-2 text-foreground-700 max-w-[280px]">{event.detected_issue}</td>
                        <td className="py-2 px-2 text-foreground-600 max-w-[280px]">{event.resolution_strategy}</td>
                        <td className="py-2 px-2 text-center">
                          <span className={`px-2 py-0.5 rounded-full text-[10px] font-medium ${getStatusColor(event.sandbox_test_status)}`}>
                            {getStatusLabel(event.sandbox_test_status)}
                          </span>
                        </td>
                        <td className="py-2 px-2 text-center">
                          <span className={`px-2 py-0.5 rounded-full text-[10px] font-medium ${
                            event.deployment_result.includes('success') ? 'bg-emerald-100 text-emerald-700' :
                            event.deployment_result.includes('rolled_back') ? 'bg-red-100 text-red-700' :
                            event.deployment_result.includes('monitoring') || event.deployment_result.includes('pending') ? 'bg-amber-100 text-amber-700' :
                            'bg-background-100 text-foreground-500'
                          }`}>
                            {event.deployment_result}
                          </span>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
              <div className="mt-3 text-xs text-foreground-500 flex items-center gap-2">
                <i className="ri-information-line"></i>
                Format: [timestamp, component, detected_issue, resolution_strategy, sandbox_test_status, deployment_result]
                <span className="text-foreground-300">·</span>
                {filteredEventLog.length} / {sysopsEventLog.length} événements
              </div>
            </div>
          </div>
        )}

        {/* Cross-link Ecosystem */}
        <div className="mt-12 bg-white border border-background-200/70 rounded-lg p-6">
          <h2 className="text-lg font-semibold text-foreground-950 font-[family-name:var(--font-heading)] mb-4 text-center">
            Écosystème KOS — Site Reliability Engineering
          </h2>
          <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
            {[
              { label: 'SysOps Health', path: '/kos-sysops-health-resiliency-command', icon: 'ri-pulse-line', color: 'text-emerald-500', current: true },
              { label: 'Security Command', path: '/kos-security-command', icon: 'ri-shield-check-line', color: 'text-teal-500' },
              { label: 'Web Ops Automates', path: '/kos-web-ops-automates', icon: 'ri-server-line', color: 'text-amber-500' },
              { label: 'Fullstack Dev', path: '/kos-fullstack-dev-automates', icon: 'ri-terminal-box-line', color: 'text-primary-500' },
              { label: 'Correction Engine', path: '/kos-correction-engine', icon: 'ri-tools-line', color: 'text-red-500' },
              { label: 'Enterprise Brain', path: '/kos-enterprise-brain-os', icon: 'ri-brain-line', color: 'text-secondary-500' },
              { label: 'Digital Perf.', path: '/kos-digital-performance-command', icon: 'ri-speed-line', color: 'text-teal-500' },
              { label: 'KOS Runtime', path: '/kos-runtime', icon: 'ri-cpu-line', color: 'text-primary-500' },
              { label: 'Resource Cmd', path: '/kos-resource-command-center', icon: 'ri-database-2-line', color: 'text-amber-500' },
              { label: 'Phase 6 Innovation', path: '/kos-phase6-innovation', icon: 'ri-lightbulb-flash-line', color: 'text-secondary-500' },
              { label: 'CDO Engineering', path: '/kos-cdo-engineering-command', icon: 'ri-line-chart-line', color: 'text-teal-500' },
              { label: 'Auto Quality', path: '/kos-autonomous-quality-system', icon: 'ri-check-double-line', color: 'text-emerald-500' },
            ].map(link => (
              <a key={link.path} href={link.path} className={`rounded-lg border p-3 text-center hover:shadow-sm transition-all cursor-pointer block ${
                link.current ? 'border-emerald-300 bg-emerald-50/40 ring-1 ring-emerald-200' : 'border-background-200/70 bg-background-50 hover:border-foreground-200'
              }`}>
                <i className={`${link.icon} text-lg mb-1 block ${link.color}`}></i>
                <span className="text-xs font-bold text-foreground-800">{link.label}</span>
                {link.current && <span className="block text-[10px] text-emerald-600 font-bold mt-0.5">Actif</span>}
              </a>
            ))}
          </div>
        </div>
      </div>
    </KOSHubLayout>
  );
}
