import { useState } from 'react';
import KOSHubLayout from '@/components/feature/KOSHubLayout';

type Tab = 'transformation' | 'public-sector' | 'financial';

export default function KOSTransformationAdvisoryCommandPage() {
  const [kosData, setKosData] = useState<any>(null);
  useEffect(() => {
    fetch('/mocks/kos-blog.json').then(r => r.json()).then(setKosData);
  }, []);
  if (!kosData) return null;

  const [activeTab, setActiveTab] = useState<Tab>('transformation');
  const [selectedProgram, setSelectedProgram] = useState(transformationProgramsMock[0]);
  const [selectedProject, setSelectedProject] = useState(publicSectorAdvisoriesMock[0]);
  const [selectedAdvisory, setSelectedAdvisory] = useState(financialAdvisoryMock[0]);

  const getPhaseColor = (phase: string) => {
    const map: Record<string, string> = { planning: 'bg-secondary-100 text-secondary-900', execution: 'bg-accent-100 text-accent-900', monitoring: 'bg-green-100 text-green-700', completed: 'bg-gray-100 text-gray-700' };
    return map[phase] || 'bg-gray-100 text-gray-700';
  };

  const formatCurrency = (v: number) => v >= 1e9 ? `${(v / 1e9).toFixed(1)}B FCFA` : `${(v / 1e6).toFixed(0)}M FCFA`;

  const tabs = [
    { id: 'transformation' as Tab, label: 'Transformation Office', icon: 'ri-rocket-line', count: transformationProgramsMock.length },
    { id: 'public-sector' as Tab, label: 'Public Sector', icon: 'ri-government-line', count: publicSectorAdvisoriesMock.length },
    { id: 'financial' as Tab, label: 'Financial Advisory', icon: 'ri-funds-line', count: financialAdvisoryMock.length },
  ];

  return (
    <KOSHubLayout hubId={18}>
      <section className="relative bg-background-100 border-b border-background-200/70">
        <div className="max-w-7xl mx-auto px-4 md:px-6 py-10 md:py-14">
          <div className="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
            <div>
              <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent-100 text-accent-700 text-xs font-semibold mb-4">
                <i className="ri-building-4-line"></i>
                KOS Enterprise+ — Transformation & Advisory
              </div>
              <h1 className="text-2xl md:text-4xl font-heading font-bold text-foreground-950 tracking-tight">
                Transformation & Advisory Command
              </h1>
              <p className="text-sm md:text-base text-foreground-600 mt-3 max-w-2xl">
                Pilotage des transformations, conseil au secteur public, ingénierie financière — l'excellence du conseil augmenté par IA.
              </p>
            </div>
            <div className="flex items-center gap-4">
              <div className="text-center px-4 py-3 bg-background-50 rounded-lg border border-background-200/70">
                <div className="text-2xl font-bold text-foreground-950">3</div>
                <div className="text-xs text-foreground-500">BLOCS actifs</div>
              </div>
              <div className="text-center px-4 py-3 bg-background-50 rounded-lg border border-background-200/70">
                <div className="text-2xl font-bold text-accent-500">90%</div>
                <div className="text-xs text-foreground-500">Maturité cible</div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <div className="sticky top-0 z-30 bg-background-50 border-b border-background-200/70">
        <div className="max-w-7xl mx-auto px-4 md:px-6">
          <div className="flex gap-1 py-3 overflow-x-auto">
            {tabs.map((tab) => (
              <button key={tab.id} onClick={() => setActiveTab(tab.id)} className={`whitespace-nowrap px-4 py-2 rounded-full text-sm font-medium flex items-center gap-2 transition-colors cursor-pointer ${activeTab === tab.id ? 'bg-foreground-950 text-background-50' : 'text-foreground-600 hover:bg-background-100'}`}>
                <i className={`${tab.icon} text-sm`}></i>{tab.label}
                <span className="text-xs opacity-60">{tab.count}</span>
              </button>
            ))}
          </div>
        </div>
      </div>

      <div className="max-w-7xl mx-auto px-4 md:px-6 py-8">
        {/* BLOC 18 — Transformation Office */}
        {activeTab === 'transformation' && (
          <div className="space-y-6">
            <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
              {transformationProgramsMock.map((prog) => (
                <div key={prog.id} onClick={() => setSelectedProgram(prog)} className={`p-5 rounded-lg border cursor-pointer transition-colors ${selectedProgram.id === prog.id ? 'border-accent-300 bg-accent-50/50' : 'border-background-200/70 bg-background-50 hover:border-background-300/60'}`}>
                  <div className="flex items-center justify-between mb-3">
                    <span className={`text-xs px-2 py-0.5 rounded-full ${getPhaseColor(prog.phase)}`}>{prog.phase}</span>
                    <span className="text-xs text-foreground-400">{prog.status}</span>
                  </div>
                  <h3 className="text-sm font-bold text-foreground-950 mb-2">{prog.program_name}</h3>
                  <div className="mb-3">
                    <div className="flex items-center justify-between text-xs mb-1">
                      <span className="text-foreground-500">Progression</span>
                      <span className="font-bold text-foreground-950">{prog.progress_pct}%</span>
                    </div>
                    <div className="h-2 bg-background-200/70 rounded-full overflow-hidden">
                      <div className="h-full bg-accent-500 rounded-full transition-all" style={{ width: `${prog.progress_pct}%` }}></div>
                    </div>
                  </div>
                  <div className="flex items-center justify-between text-xs text-foreground-500">
                    <span>Budget: {formatCurrency(prog.budget_actual)} / {formatCurrency(prog.budget_planned)}</span>
                    <span>CM: {prog.change_management_score}/100</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* BLOC 19 — Public Sector Advisor */}
        {activeTab === 'public-sector' && (
          <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
            {publicSectorAdvisoriesMock.map((proj) => (
              <div key={proj.id} onClick={() => setSelectedProject(proj)} className={`p-5 rounded-lg border cursor-pointer transition-colors ${selectedProject.id === proj.id ? 'border-primary-300 bg-primary-50/50' : 'border-background-200/70 bg-background-50 hover:border-background-300/60'}`}>
                <div className="flex items-center justify-between mb-2">
                  <span className="text-xs px-2 py-0.5 rounded-full bg-secondary-100 text-secondary-700">{proj.domain}</span>
                  <span className={`text-xs px-2 py-0.5 rounded-full ${proj.status === 'in_progress' ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-700'}`}>{proj.status}</span>
                </div>
                <h3 className="text-sm font-bold text-foreground-950 mb-1">{proj.project_name}</h3>
                <p className="text-xs text-foreground-500 mb-2">{proj.institution}</p>
                <div className="flex items-center justify-between text-xs mb-3">
                  <span className="text-foreground-500">{proj.country}</span>
                  <span className="text-foreground-500">{proj.timeline_months} mois</span>
                </div>
                <p className="text-xs font-semibold text-foreground-950">{proj.budget_range}</p>
              </div>
            ))}
          </div>
        )}

        {/* BLOC 20 — Financial Advisory */}
        {activeTab === 'financial' && (
          <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
            {financialAdvisoryMock.map((adv) => (
              <div key={adv.id} onClick={() => setSelectedAdvisory(adv)} className={`p-5 rounded-lg border cursor-pointer transition-colors ${selectedAdvisory.id === adv.id ? 'border-primary-300 bg-primary-50/50' : 'border-background-200/70 bg-background-50 hover:border-background-300/60'}`}>
                <div className="flex items-center justify-between mb-2">
                  <span className="text-xs px-2 py-0.5 rounded-full bg-secondary-100 text-secondary-700 uppercase">{adv.advisory_type}</span>
                  <span className={`text-xs px-2 py-0.5 rounded-full ${adv.status === 'completed' ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-700'}`}>{adv.status}</span>
                </div>
                <h3 className="text-sm font-bold text-foreground-950 mb-1">{adv.project_name}</h3>
                <p className="text-xs text-foreground-500 mb-3">{adv.company_name} · {adv.sector}</p>
                <div className="grid grid-cols-3 gap-3 mb-3">
                  <div className="p-2 bg-background-100 rounded text-center">
                    <div className="text-lg font-bold text-foreground-950">{adv.irr_pct}%</div>
                    <div className="text-[10px] text-foreground-500">IRR</div>
                  </div>
                  <div className="p-2 bg-background-100 rounded text-center">
                    <div className="text-lg font-bold text-foreground-950">{adv.revenue_growth_pct}%</div>
                    <div className="text-[10px] text-foreground-500">Croissance</div>
                  </div>
                  <div className="p-2 bg-background-100 rounded text-center">
                    <div className="text-lg font-bold text-foreground-950">{adv.projection_period}Y</div>
                    <div className="text-[10px] text-foreground-500">Projection</div>
                  </div>
                </div>
                {adv.npv > 0 && <p className="text-xs font-semibold text-green-600">NPV: {formatCurrency(adv.npv)}</p>}
                {adv.valuation_amount > 0 && <p className="text-xs font-semibold text-primary-600">Valorisation: {formatCurrency(adv.valuation_amount)}</p>}
                <p className="text-xs text-foreground-600 mt-2 line-clamp-2">{adv.summary}</p>
              </div>
            ))}
          </div>
        )}
      </div>
    </KOSHubLayout>
  );
}
