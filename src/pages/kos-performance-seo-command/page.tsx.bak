import { useState, useCallback } from 'react';
import SeoHead from '@/components/feature/SeoHead';
import KOSHubLayout from '@/components/feature/KOSHubLayout';
import { usePerformanceSEOCommand } from '@/hooks/usePerformanceSEOCommand';
import { usePerformanceMonitor } from '@/hooks/usePerformanceMonitor';
import CockpitOverview from './components/CockpitOverview';
import PerformanceTab from './components/PerformanceTab';
import SeoGscTab from './components/SeoGscTab';
import CoreWebVitalsTab from './components/CoreWebVitalsTab';
import SecurityTab from './components/SecurityTab';
import AssetsTab from './components/AssetsTab';
import AccessibilityTab from './components/AccessibilityTab';
import ReportsTab from './components/ReportsTab';
import CorrectivePlanUrgence from './components/CorrectivePlanUrgence';

const TABS = [
  { key: 'cockpit', label: 'Cockpit', icon: 'ri-dashboard-3-line' },
  { key: 'correctif', label: 'CORRECTIF URGENCE', icon: 'ri-alert-fill' },
  { key: 'performance', label: 'Performance', icon: 'ri-speed-up-line' },
  { key: 'seo', label: 'SEO & GSC', icon: 'ri-google-line' },
  { key: 'webvitals', label: 'Core Web Vitals', icon: 'ri-pulse-line' },
  { key: 'security', label: 'Sécurité', icon: 'ri-shield-check-line' },
  { key: 'assets', label: 'Assets', icon: 'ri-stack-line' },
  { key: 'accessibility', label: 'Accessibilité', icon: 'ri-wheelchair-line' },
  { key: 'reports', label: 'Rapports', icon: 'ri-file-chart-line' },
] as const;

type TabKey = typeof TABS[number]['key'];

export default function KOSPerformanceSEOCommandPage() {
  const [kosData, setKosData] = useState<any>(null);
  useEffect(() => {
    fetch('/mocks/kos-blog.json').then(r => r.json()).then(setKosData);
  }, []);
  if (!kosData) return null;

  const [activeTab, setActiveTab] = useState<TabKey>('cockpit');
  const [scanStatus, setScanStatus] = useState<'idle' | 'scanning' | 'done' | 'error'>('idle');
  const [scanMessage, setScanMessage] = useState('');

  const {
    cockpit,
    agents,
    scoreHistory,
    cwvTrend,
    gsc,
    seoAudit,
    securityHeaders,
    accessibility,
    report,
    loading,
    isLive,
  } = usePerformanceSEOCommand();

  const { runMonitor } = usePerformanceMonitor();

  const handleScanLive = useCallback(async () => {
    setScanStatus('scanning');
    setScanMessage('Scan en cours — PageSpeed Insights API + Lighthouse...');
    try {
      await runMonitor('full');
      setScanStatus('done');
      setScanMessage('Scan terminé — Dashboard mis à jour avec les dernières métriques');
      setTimeout(() => {
        setScanStatus('idle');
        setScanMessage('');
      }, 5000);
    } catch {
      setScanStatus('error');
      setScanMessage('Erreur scan — Supabase indisponible, données mock affichées');
      setTimeout(() => {
        setScanStatus('idle');
        setScanMessage('');
      }, 5000);
    }
  }, [runMonitor]);

  return (
    <>
      <SeoHead
        title="KOS Performance & SEO Command — Diagnostic Urgence 17 Juin 2026 — KHEPRA EXPERTS"
        description="Diagnostic Lighthouse réel du 17 juin 2026. Performance 56/100, LCP 33.1s, 9 Mo. 9 agents KOS mobilisés, 10 actions correctives P0/P1/P2. Plan de relevement à 95%."
        canonicalPath="/kos-performance-seo-command"
        noIndex={true}
      />
      <KOSHubLayout hubId={50} activeTab="Command Center" tabLabel="Performance & SEO Command">
        <div className="bg-background-50 min-h-screen">
          {/* Hero Header */}
          <section className="bg-background-100 border-b border-background-200/70">
            <div className="max-w-7xl mx-auto px-4 md:px-6 py-8">
              <div className="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
                <div className="flex items-start gap-4">
                  <div className="w-14 h-14 flex items-center justify-center rounded-xl bg-emerald-100 text-emerald-700 shrink-0">
                    <i className="ri-trophy-line text-2xl"></i>
                  </div>
                  <div>
                    <div className="flex items-center gap-3 mb-1.5 flex-wrap">
                      <span className="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-red-100 text-red-700 font-body tracking-wide">
                        KOS ENTERPRISE
                      </span>
                      <span className={`px-2.5 py-0.5 rounded-full text-[10px] font-semibold font-body tracking-wide animate-pulse ${isLive ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700'}`}>
                        {isLive ? 'DONNÉES LIVE — SUPABASE' : 'DIAGNOSTIC — 17 JUIN 2026'}
                      </span>
                      <span className="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-red-100 text-red-700 font-body tracking-wide">
                        {cockpit.certification}
                      </span>
                      <span className="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-red-100 text-red-700 font-body tracking-wide">
                        {cockpit.activeAgents}/{cockpit.activeAgents} AGENTS
                      </span>
                    </div>
                    <h1 className="text-2xl md:text-3xl font-bold text-foreground-950 font-heading">
                      Performance & SEO Command — Diagnostic Urgence 17 Juin
                    </h1>
                    <p className="text-sm text-foreground-600 mt-1.5 max-w-2xl font-body">
                      Rapport réel Lighthouse 13.4.0 — Moto G Power, 4G lente, Chromium 146.
                      Mobile {cockpit.lighthouseMobileScore}, Desktop {cockpit.lighthouseDesktopScore}, Accessibilité {cockpit.accessibilityScore}, SEO {cockpit.seoScore}.
                      <strong className="text-red-700"> LCP {cockpit.lcpAverage}s · Poids {cockpit.pagesTotalWeightMB} Mo · {cockpit.criticalAlerts} alertes critiques · {cockpit.warningsActive} warnings actifs · Gap {Math.round(95 - cockpit.globalHealthScore)} pts vs cible 95.</strong>
                    </p>
                  </div>
                </div>
                {/* Health Score + Scan Live */}
                <div className="flex items-center gap-5 shrink-0">
                  <div className="text-center">
                    <div className="relative w-20 h-20">
                      <svg width="80" height="80" viewBox="0 0 80 80" className="-rotate-90">
                        <circle cx="40" cy="40" r="34" fill="none" stroke="oklch(var(--background-200))" strokeWidth="5" />
                        <circle
                          cx="40" cy="40" r="34" fill="none" stroke={cockpit.globalHealthScore >= 95 ? '#10b981' : cockpit.globalHealthScore >= 85 ? '#f59e0b' : '#ef4444'}
                          strokeWidth="5" strokeLinecap="round"
                          strokeDasharray={`${2 * Math.PI * 34}`}
                          strokeDashoffset={2 * Math.PI * 34 * (1 - cockpit.globalHealthScore / 100)}
                          className="transition-all duration-1000 ease-out"
                        />
                      </svg>
                      <span className={`absolute inset-0 flex items-center justify-center text-lg font-bold font-heading ${cockpit.globalHealthScore >= 95 ? 'text-emerald-600' : cockpit.globalHealthScore >= 85 ? 'text-amber-600' : 'text-red-600'}`}>
                        {cockpit.globalHealthScore}
                      </span>
                    </div>
                    <span className="text-[10px] font-medium text-foreground-600 font-body">Santé Globale</span>
                  </div>
                  <div className="flex flex-col gap-2">
                    <div className="flex items-center gap-1.5 text-xs">
                      <span className={`w-2 h-2 rounded-full ${cockpit.lcpAverage <= 2.5 ? 'bg-emerald-500' : 'bg-amber-500'}`}></span>
                      <span className="text-foreground-600 font-body">LCP {cockpit.lcpAverage}s</span>
                    </div>
                    <div className="flex items-center gap-1.5 text-xs">
                      <span className="w-2 h-2 rounded-full bg-emerald-500"></span>
                      <span className="text-foreground-600 font-body">Mobile {cockpit.lighthouseMobileScore}</span>
                    </div>
                    <div className="flex items-center gap-1.5 text-xs">
                      <span className="w-2 h-2 rounded-full bg-emerald-500"></span>
                      <span className="text-foreground-600 font-body">Desktop {cockpit.lighthouseDesktopScore}</span>
                    </div>
                    <button
                      onClick={handleScanLive}
                      disabled={scanStatus === 'scanning'}
                      className={`mt-1 flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium cursor-pointer whitespace-nowrap transition-all ${
                        scanStatus === 'scanning'
                          ? 'bg-background-200 text-foreground-400'
                          : 'bg-primary-500 text-background-50 hover:bg-primary-600'
                      }`}
                      type="button"
                    >
                      <i className={`text-xs ${scanStatus === 'scanning' ? 'ri-loader-4-line animate-spin' : 'ri-radar-line'}`}></i>
                      {scanStatus === 'scanning' ? 'Scan en cours...' : 'Scan Live'}
                    </button>
                  </div>
                </div>
              </div>
              {/* Scan Status Banner */}
              {scanMessage && (
                <div className={`mt-4 px-4 py-2.5 rounded-lg text-xs font-medium font-body ${
                  scanStatus === 'scanning' ? 'bg-primary-50 text-primary-700 border border-primary-200 animate-pulse' :
                  scanStatus === 'done' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' :
                  'bg-red-50 text-red-700 border border-red-200'
                }`}>
                  <div className="flex items-center gap-2">
                    <i className={`text-sm ${
                      scanStatus === 'scanning' ? 'ri-loader-4-line animate-spin' :
                      scanStatus === 'done' ? 'ri-check-line' : 'ri-close-line'
                    }`}></i>
                    {scanMessage}
                  </div>
                </div>
              )}
            </div>
          </section>

          {/* Status Banner */}
          <div className={`border-b ${cockpit.globalHealthScore >= 95 ? 'bg-emerald-50 border-emerald-200' : 'bg-red-50 border-red-200'}`}>
            <div className="max-w-7xl mx-auto px-4 md:px-6 py-3">
              <div className="flex flex-wrap items-center gap-3 text-sm">
                <i className={`text-lg ${cockpit.globalHealthScore >= 95 ? 'ri-check-double-line text-emerald-600' : 'ri-alert-line text-red-600 animate-pulse'}`}></i>
                <span className={`font-semibold font-body ${cockpit.globalHealthScore >= 95 ? 'text-emerald-800' : 'text-red-800'}`}>
                  {cockpit.globalHealthScore >= 95 ? 'PERFORMANCE EXCELLENTE' : 'URGENCE CORRECTIVE — PERFORMANCE 56/100'}
                </span>
                <span className="text-foreground-600 font-body">
                  — Mobile {cockpit.lighthouseMobileScore} · Desktop {cockpit.lighthouseDesktopScore} · SEO {cockpit.seoScore} · Accessibility {cockpit.accessibilityScore} · {cockpit.warningsActive} warnings · <strong className="text-red-700">{cockpit.criticalAlerts} alertes critiques</strong>
                </span>
                <span className="ml-auto flex items-center gap-1 font-semibold font-body text-foreground-600">
                  <i className="ri-medal-line"></i>
                  AGENTS KOS — 12/12 EN ALERTE
                </span>
              </div>
            </div>
          </div>

          {/* Tab Switcher */}
          <div className="sticky top-0 z-30 bg-background-50 border-b border-background-200/70">
            <div className="max-w-7xl mx-auto px-4 md:px-6">
              <div className="flex items-center gap-1 py-2 overflow-x-auto scrollbar-none">
                {TABS.map(tab => (
                  <button
                    key={tab.key}
                    onClick={() => setActiveTab(tab.key)}
                    className={`flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-medium transition-colors cursor-pointer whitespace-nowrap ${
                      activeTab === tab.key
                        ? tab.key === 'correctif' ? 'bg-red-600 text-background-50' : 'bg-primary-500 text-background-50'
                        : tab.key === 'correctif' ? 'text-red-600 hover:text-red-700 hover:bg-red-50 border border-red-200' : 'text-foreground-600 hover:text-foreground-900 hover:bg-background-100'
                    }`}
                    type="button"
                  >
                    <i className={`${tab.icon} text-sm`}></i>
                    {tab.label}
                  </button>
                ))}
              </div>
            </div>
          </div>

          {/* Tab kosData.Content */}
          <div className="max-w-7xl mx-auto px-4 md:px-6 py-8">
            {activeTab === 'cockpit' && (
              <CockpitOverview
                cockpit={cockpit}
                agents={agents}
                scoreHistory={scoreHistory}
                isLive={isLive}
              />
            )}
            {activeTab === 'correctif' && <CorrectivePlanUrgence isLive={isLive} />}
            {activeTab === 'performance' && <PerformanceTab isLive={isLive} />}
            {activeTab === 'seo' && (
              <SeoGscTab gsc={gsc} seoAudit={seoAudit} isLive={isLive} />
            )}
            {activeTab === 'webvitals' && (
              <CoreWebVitalsTab
                cwvTrend={cwvTrend}
                byPage={coreWebVitalsByPage}
                distribution={cwvDistribution}
                isLive={isLive}
              />
            )}
            {activeTab === 'security' && (
              <SecurityTab securityHeaders={securityHeaders} isLive={isLive} />
            )}
            {activeTab === 'assets' && <AssetsTab isLive={isLive} />}
            {activeTab === 'accessibility' && (
              <AccessibilityTab accessibility={accessibility} isLive={isLive} />
            )}
            {activeTab === 'reports' && (
              <ReportsTab report={report} isLive={isLive} />
            )}
          </div>

          {/* Footer Info Bar */}
          <footer className="border-t border-background-200/70 bg-background-100 mt-8">
            <div className="max-w-7xl mx-auto px-4 md:px-6 py-4">
              <div className="flex flex-col sm:flex-row items-center justify-between gap-3">
                <div className="flex items-center gap-4 text-[10px] text-foreground-500 font-body">
                  <span className="flex items-center gap-1">
                    <span className={`w-1.5 h-1.5 rounded-full ${isLive ? 'bg-emerald-500' : 'bg-amber-500'}`}></span>
                    Dernier scan : {new Date(cockpit.lastFullScan).toLocaleString('fr-FR')}
                  </span>
                  <span className="flex items-center gap-1">
                    <span className={`w-1.5 h-1.5 rounded-full ${cockpit.uptimePercent >= 99.9 ? 'bg-emerald-500' : 'bg-amber-500'}`}></span>
                    Uptime : {cockpit.uptimePercent}%
                  </span>
                  <span className="flex items-center gap-1">
                    <span className="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    {cockpit.activeAgents} agents · {cockpit.warningsActive} warnings
                  </span>
                </div>
                <div className="flex items-center gap-2 text-[10px] text-foreground-400 font-body">
                  <i className={`text-xs ${isLive ? 'ri-database-2-line text-emerald-500' : 'ri-computer-line text-amber-500'}`}></i>
                  <span>{isLive ? 'Données Live — Supabase' : 'Données Mock — Démo'} · Auto-scan quotidien 06:00 GMT · Rapport hebdomadaire lundi 08:00 GMT</span>
                </div>
              </div>
            </div>
          </footer>
        </div>
      </KOSHubLayout>
    </>
  );
}
