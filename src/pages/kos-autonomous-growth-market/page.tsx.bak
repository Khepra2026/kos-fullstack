                    <div className="flex justify-center mb-1">{renderGaugeCircle(selectedAuthority.authority_score, 100, '', 56, selectedAuthority.authority_score >= 90 ? '#22c55e' : selectedAuthority.authority_score >= 80 ? '#06b6d4' : '#f59e0b')}</div>
