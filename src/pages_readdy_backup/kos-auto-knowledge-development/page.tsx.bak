import { useState } from 'react';
import KOSHubLayout from '@/components/feature/KOSHubLayout';
import { SeoHead } from '@/components/feature/SeoHead';
import ScrollReveal from '@/components/feature/ScrollReveal';
import { useKOSAutoKnowledgeDevelopment } from '@/hooks/useKOSAutoKnowledgeDevelopment';

type SystemTab = 'regtrooper' | 'client-brain' | 'predictive-gap';

const TAB_CONFIG: { id: SystemTab; label: string; icon: string }[] = [
  { id: 'regtrooper', label: 'Système A — REGTROOPER', icon: 'ri-radar-line' },
  { id: 'client-brain', label: 'Système B — Client Brain Mining', icon: 'ri-brain-line' },
  { id: 'predictive-gap', label: 'Système C — Predictive Gap Filler', icon: 'ri-crosshair-line' },
];

export default function KOSAutoKnowledgeDevelopmentPage() {
  const [kosData, setKosData] = useState<any>(null);
  useEffect(() => {
    fetch('/mocks/kos-blog.json').then(r => r.json()).then(setKosData);
  }, []);
  if (!kosData) return null;

  const [activeTab, setActiveTab] = useState<SystemTab>('regtrooper');
  const { stats, regtrooper, clientBrain, predictiveGap, loading, isLive, error } = useKOSAutoKnowledgeDevelopment();

  return (
    <KOSHubLayout hubId={121}>
      <SeoHead
        title="KOS Auto-Knowledge Development™ — Auto-Développement Base Connaissances | KHEPRA EXPERTS"
        description="3 systèmes autonomes de développement de la base de connaissances KOS : REGTROOPER (ingestion réglementaire auto), Client Brain Mining (capitalisation missions), Predictive Gap Filler (comblement proactif des lacunes)."
        keywords="KOS auto-knowledge, REGTROOPER, Client Brain Mining, Predictive Gap Filler, KHEPRA EXPERTS, ISO 30401"
        canonicalPath="/kos-auto-knowledge-development"
        ogType="website"
        ogLocale="fr_FR"
      />

      <section className="relative pt-32 pb-10 sm:pt-40 sm:pb-14 overflow-hidden bg-foreground-950">
        <div className="absolute inset-0">
          <img
            src="https://readdy.ai/api/search-image?query=Abstract%20visualization%20of%20an%20autonomous%20self-expanding%20knowledge%20network%20with%20glowing%20interconnected%20nodes%20multiplying%20and%20growing%20organically%2C%20emerald%20and%20amber%20energy%20streams%20flowing%20between%20data%20clusters%2C%20AI-powered%20knowledge%20graph%20expanding%2C%20dark%20technological%20background%2C%20cinematic%20render%2C%20no%20text&width=1920&height=700&seq=kos-auto-kb-dev-hero&orientation=landscape"
            alt=""
            className="w-full h-full object-cover object-center opacity-12"
            width="1920"
            height="700"
          />
        </div>
        <div className="absolute inset-0 bg-gradient-to-b from-foreground-950/30 via-foreground-950/60 to-foreground-950" />
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
          <div className="flex flex-wrap gap-2 mb-6">
            <div className="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/20 border border-emerald-400/30 backdrop-blur-sm">
              <span className="w-4 h-4 flex items-center justify-center"><i className="ri-seedling-line text-emerald-400 text-sm" /></span>
              <span className="text-sm font-semibold text-emerald-300 uppercase tracking-wider">3 SYSTÈMES AUTO-DÉVELOPPEMENT</span>
            </div>
            <div className="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-primary-500/20 border border-primary-400/30 backdrop-blur-sm">
              <span className="w-4 h-4 flex items-center justify-center"><i className="ri-git-branch-line text-primary-400 text-sm" /></span>
              <span className="text-sm font-semibold text-primary-300 uppercase tracking-wider">2 847 → 10 000 NŒUDS</span>
            </div>
            <div className="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-amber-500/20 border border-amber-400/30 backdrop-blur-sm">
              <span className="w-4 h-4 flex items-center justify-center"><i className="ri-timer-line text-amber-400 text-sm" /></span>
              <span className="text-sm font-semibold text-amber-300 uppercase tracking-wider">90 JOURS</span>
            </div>
            {isLive && (
              <div className="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/20 border border-emerald-400/30 backdrop-blur-sm">
                <span className="w-2 h-2 rounded-full bg-emerald-400 animate-pulse" />
                <span className="text-sm font-semibold text-emerald-300 uppercase tracking-wider">LIVE — SUPABASE</span>
              </div>
            )}
          </div>
          <h1 className="font-heading text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
            La base KOS s&apos;auto-développe.
            <span className="block text-emerald-400 mt-2">Ingestion Auto × Brain Mining × Gap Filler.</span>
          </h1>
          <p className="text-lg sm:text-xl text-gray-300 leading-relaxed mb-6 max-w-3xl">
            <strong className="text-white">3 systèmes autonomes</strong> travaillent en continu pour faire passer le Knowledge Graph de{' '}
            <strong className="text-emerald-400">{stats.currentNodes.toLocaleString()} nœuds</strong> à{' '}
            <strong className="text-emerald-400">{stats.targetNodes.toLocaleString()} nœuds</strong> en{' '}
            <strong className="text-amber-400">{stats.daysRemaining} jours</strong>. Zéro intervention humaine.{' '}
            <strong className="text-white">100% qualité Big Four.</strong>
          </p>
        </div>
      </section>

      <section className="py-3 bg-emerald-50 border-b border-emerald-200/50">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          {loading && (
            <div className="flex items-center justify-center gap-2 mb-2 text-xs text-foreground-400">
              <span className="w-4 h-4 flex items-center justify-center"><i className="ri-loader-4-line animate-spin" /></span>
              <span>Connexion Supabase...</span>
            </div>
          )}
          {error && (
            <div className="flex items-center justify-center gap-2 mb-2 text-xs text-red-500">
              <span className="w-4 h-4 flex items-center justify-center"><i className="ri-error-warning-line" /></span>
              <span>{error}</span>
            </div>
          )}
          <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-7 gap-2">
            {[
              { label: 'Nœuds Actuels', value: stats.currentNodes.toLocaleString(), icon: 'ri-node-tree', color: 'text-emerald-600' },
              { label: 'Nœuds Cible', value: stats.targetNodes.toLocaleString(), icon: 'ri-trophy-line', color: 'text-primary-600' },
              { label: 'Jours Restants', value: `${stats.daysRemaining}j`, icon: 'ri-timer-line', color: 'text-amber-600' },
              { label: 'Systèmes', value: `${stats.systems}`, icon: 'ri-settings-3-line', color: 'text-purple-600' },
              { label: 'Régulateurs', value: `${stats.regulatorsTotal}`, icon: 'ri-building-2-line', color: 'text-red-600' },
              { label: 'Assets/Mois', value: `${stats.assetsPerMonth}`, icon: 'ri-stack-line', color: 'text-cyan-600' },
              { label: 'H. Humaines', value: '0h', icon: 'ri-user-unfollow-line', color: 'text-rose-600' },
            ].map((s, i) => (
              <div key={i} className="text-center py-1.5 rounded-lg bg-white border border-emerald-100">
                <span className={`w-4 h-4 mx-auto mb-0.5 flex items-center justify-center ${s.color}`}><i className={`${s.icon} text-xs`} /></span>
                <span className="block text-base font-bold text-foreground-950 font-heading">{s.value}</span>
                <span className="text-[9px] text-foreground-500">{s.label}</span>
              </div>
            ))}
          </div>
        </div>
      </section>

      <div className="sticky top-20 z-30 bg-white border-b border-background-200">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="flex gap-1 py-2 overflow-x-auto">
            {TAB_CONFIG.map(tab => (
              <button
                key={tab.id}
                onClick={() => setActiveTab(tab.id)}
                className={`flex items-center gap-2 px-5 py-3 rounded-full text-sm font-bold cursor-pointer transition-all whitespace-nowrap ${
                  activeTab === tab.id
                    ? 'bg-foreground-950 text-white'
                    : 'bg-background-50 border border-background-200 text-foreground-600 hover:border-foreground-300'
                }`}
              >
                <span className="w-4 h-4 flex items-center justify-center"><i className={`${tab.icon} text-base`} /></span>
                {tab.label}
              </button>
            ))}
          </div>
        </div>
      </div>

      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        {activeTab === 'regtrooper' && <RegtrooperTab system={regtrooper} />}
        {activeTab === 'client-brain' && <ClientBrainTab system={clientBrain} />}
        {activeTab === 'predictive-gap' && <PredictiveGapTab system={predictiveGap} />}
      </div>

      <section className="py-12 bg-background-50 border-t border-background-200">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="text-center mb-6">
            <h2 className="font-heading text-xl font-bold text-foreground-950 mb-1">Écosystème Knowledge KOS</h2>
            <p className="text-sm text-foreground-500">Les 3 systèmes s&apos;appuient sur l&apos;infrastructure existante</p>
          </div>
          <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-7 gap-3">
            {[
              { label: 'Knowledge Graph', path: '/kos-knowledge-graph', icon: 'ri-node-tree', color: '#059669' },
              { label: 'Research Institute', path: '/kos-research-institute', icon: 'ri-microscope-line', color: '#4F46E5' },
              { label: 'Consulting Factory', path: '/kos-consulting-mission-factory', icon: 'ri-building-line', color: '#C2410C' },
              { label: 'Enterprise Brain', path: '/kos-enterprise-brain-os', icon: 'ri-brain-line', color: '#7C3AED' },
              { label: 'Blog Writing', path: '/kos-blog-writing-automates', icon: 'ri-article-line', color: '#0891B2' },
              { label: 'Tender Intelligence', path: '/kos-tender-intelligence', icon: 'ri-file-search-line', color: '#F59E0B' },
              { label: 'Quality Excellence', path: '/kos-quality-excellence-command', icon: 'ri-shield-check-line', color: '#DC2626' },
            ].map(link => (
              <a key={link.path} href={link.path} className="rounded-xl border border-background-200 bg-white p-4 text-center hover:shadow-md hover:border-foreground-200 transition-all cursor-pointer block">
                <div className="w-10 h-10 mx-auto mb-2 rounded-xl flex items-center justify-center" style={{ backgroundColor: `${link.color}15` }}>
                  <span className="w-4 h-4 flex items-center justify-center"><i className={link.icon} style={{ color: link.color }} /></span>
                </div>
                <span className="text-xs font-bold text-foreground-800">{link.label}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    </KOSHubLayout>
  );
}

function RegtrooperTab({ system }: { system: import('@/mocks/kosAutoKnowledgeDevelopment').RegtrooperSystem }) {
  const [expandedRegulator, setExpandedRegulator] = useState<string | null>(null);

  return (
    <div className="space-y-8">
      <ScrollReveal>
        <div className="bg-gradient-to-r from-emerald-50 to-background-50 border border-emerald-200/50 rounded-2xl p-6">
          <div className="flex items-start gap-3">
            <div className="w-12 h-12 rounded-xl bg-emerald-100 flex items-center justify-center flex-shrink-0">
              <span className="w-5 h-5 flex items-center justify-center"><i className="ri-radar-line text-emerald-600 text-xl" /></span>
            </div>
            <div>
              <h3 className="font-semibold text-foreground-950 text-sm">Principe</h3>
              <p className="text-sm text-foreground-600 mt-1 leading-relaxed">{system.principle}</p>
            </div>
          </div>
        </div>
      </ScrollReveal>

      <ScrollReveal>
        <div className="bg-white border border-background-200 rounded-2xl p-6">
          <h3 className="font-heading text-lg font-bold text-foreground-950 mb-1">Flux Automatique — 5 Étapes</h3>
          <p className="text-xs text-foreground-500 mb-5">Pipeline entièrement automatisé, déclenché par Cron N°17, zéro intervention humaine</p>
          <div>
            {system.flowSteps.map((step: RegtrooperFlowStep, idx: number) => (
              <div key={step.step} className="flex gap-4">
                <div className="flex flex-col items-center w-10">
                  <div className="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 border-2" style={{ borderColor: step.color, backgroundColor: `${step.color}15` }}>
                    <span className="w-4 h-4 flex items-center justify-center"><i className={step.icon} style={{ color: step.color }} /></span>
                  </div>
                  {idx < system.flowSteps.length - 1 && (
                    <div className="w-0.5 flex-1 min-h-[32px]" style={{ backgroundColor: `${step.color}40` }} />
                  )}
                </div>
                <div className={`flex-1 pb-6 ${idx < system.flowSteps.length - 1 ? 'border-b border-background-100' : ''}`}>
                  <div className="flex items-center gap-2 mb-1">
                    <span className="text-sm font-bold text-foreground-950">Étape {step.step} — {step.name}</span>
                    <span className="text-[9px] px-2 py-0.5 rounded-full bg-background-100 text-foreground-500 font-medium whitespace-nowrap">{step.duration}</span>
                  </div>
                  <p className="text-xs text-foreground-600 leading-relaxed">{step.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </ScrollReveal>

      <ScrollReveal>
        <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
          {system.kpis.map(kpi => (
            <div key={kpi.label} className="bg-white border border-background-200 rounded-xl p-4 text-center">
              <span className="w-5 h-5 mx-auto mb-1 flex items-center justify-center text-emerald-500"><i className={`${kpi.icon} text-lg`} /></span>
              <span className="block text-xl font-bold text-foreground-950 font-heading">{kpi.value}</span>
              <span className="text-[10px] text-foreground-500">{kpi.label}</span>
            </div>
          ))}
        </div>
      </ScrollReveal>

      <ScrollReveal>
        <div className="bg-gradient-to-r from-emerald-50/50 to-background-50 border border-emerald-200/40 rounded-2xl p-6">
          <h3 className="font-heading text-lg font-bold text-foreground-950 mb-4">
            <span className="w-4 h-4 inline-flex items-center justify-center mr-2"><i className="ri-scales-line text-emerald-600" /></span>
            KOS vs Big Four — REGTROOPER
          </h3>
          <div className="space-y-3">
            {system.comparison.map(comp => (
              <div key={comp.dimension} className="flex items-center gap-4 p-3 rounded-xl bg-white border border-background-100">
                <span className="w-4 h-4 flex items-center justify-center flex-shrink-0"><i className={`${comp.icon} text-foreground-400 text-sm`} /></span>
                <div className="flex-1 min-w-0">
                  <span className="text-xs font-semibold text-foreground-700">{comp.dimension}</span>
                </div>
                <span className="text-xs text-foreground-400 bg-background-100 px-3 py-1 rounded-full whitespace-nowrap">{comp.bigFour}</span>
                <span className="w-4 h-4 flex items-center justify-center"><i className="ri-arrow-right-line text-foreground-300" /></span>
                <span className="text-xs font-bold text-emerald-600 bg-emerald-50 px-3 py-1 rounded-full whitespace-nowrap">{comp.kos}</span>
              </div>
            ))}
          </div>
        </div>
      </ScrollReveal>

      <ScrollReveal>
        <div className="bg-white border border-background-200 rounded-2xl p-6">
          <h3 className="font-heading text-lg font-bold text-foreground-950 mb-4">
            <span className="w-4 h-4 inline-flex items-center justify-center mr-2"><i className="ri-building-2-line text-emerald-600" /></span>
            {system.totalRegulators} Régulateurs Scannés
          </h3>
          <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2">
            {system.regulators.map(reg => (
              <div
                key={reg.code}
                onClick={() => setExpandedRegulator(expandedRegulator === reg.code ? null : reg.code)}
                className="rounded-lg border border-background-200 bg-background-50 p-3 cursor-pointer hover:border-emerald-200 transition-all"
              >
                <div className="flex items-center justify-between mb-1">
                  <span className="text-xs font-bold text-foreground-800">{reg.name}</span>
                  <span className="text-[9px] text-foreground-400">{reg.code}</span>
                </div>
                <div className="flex items-center gap-2 text-[9px] text-foreground-500">
                  <span>{reg.docsPerMonth} docs/mois</span>
                  <span>·</span>
                  <span>{reg.category}</span>
                </div>
                {expandedRegulator === reg.code && (
                  <div className="mt-2 pt-2 border-t border-background-200 text-[10px] text-foreground-500">
                    <span className="text-emerald-600 font-bold">✓</span> Scanné automatiquement via Cron N°17
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      </ScrollReveal>
    </div>
  );
}

function ClientBrainTab({ system }: { system: import('@/mocks/kosAutoKnowledgeDevelopment').ClientBrainSystem }) {
  return (
    <div className="space-y-8">
      <ScrollReveal>
        <div className="bg-gradient-to-r from-primary-50 to-background-50 border border-primary-200/50 rounded-2xl p-6">
          <div className="flex items-start gap-3">
            <div className="w-12 h-12 rounded-xl bg-primary-100 flex items-center justify-center flex-shrink-0">
              <span className="w-5 h-5 flex items-center justify-center"><i className="ri-brain-line text-primary-600 text-xl" /></span>
            </div>
            <div>
              <h3 className="font-semibold text-foreground-950 text-sm">Principe</h3>
              <p className="text-sm text-foreground-600 mt-1 leading-relaxed">{system.principle}</p>
            </div>
          </div>
        </div>
      </ScrollReveal>

      <ScrollReveal>
        <div className="bg-white border border-background-200 rounded-2xl p-6">
          <h3 className="font-heading text-lg font-bold text-foreground-950 mb-1">Flux Automatique — 6 Étapes</h3>
          <p className="text-xs text-foreground-500 mb-5">Déclenché par mission_status=closed, pipeline entièrement automatisé</p>
          <div>
            {system.flowSteps.map((step: ClientBrainFlowStep, idx: number) => (
              <div key={step.step} className="flex gap-4">
                <div className="flex flex-col items-center w-10">
                  <div className="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 border-2" style={{ borderColor: step.color, backgroundColor: `${step.color}15` }}>
                    <span className="w-4 h-4 flex items-center justify-center"><i className={step.icon} style={{ color: step.color }} /></span>
                  </div>
                  {idx < system.flowSteps.length - 1 && (
                    <div className="w-0.5 flex-1 min-h-[32px]" style={{ backgroundColor: `${step.color}40` }} />
                  )}
                </div>
                <div className={`flex-1 pb-6 ${idx < system.flowSteps.length - 1 ? 'border-b border-background-100' : ''}`}>
                  <div className="flex items-center gap-2 mb-1">
                    <span className="text-sm font-bold text-foreground-950">Étape {step.step} — {step.name}</span>
                  </div>
                  <p className="text-xs text-foreground-600 leading-relaxed">{step.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </ScrollReveal>

      <ScrollReveal>
        <div className="bg-white border border-background-200 rounded-2xl p-6">
          <h3 className="font-heading text-lg font-bold text-foreground-950 mb-1">
            <span className="w-4 h-4 inline-flex items-center justify-center mr-2"><i className="ri-cpu-line text-primary-600" /></span>
            Les 10 Knowledge Atoms — Agent 42 &quot;KOS Extractor&quot;
          </h3>
          <p className="text-xs text-foreground-500 mb-5">Chaque mission clôturée génère automatiquement ces 10 atomes de connaissance</p>
          <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {system.atoms.map((atom: ClientBrainAtom) => (
              <div key={atom.type} className="flex items-start gap-3 p-4 rounded-xl border border-background-200 bg-background-50">
                <div className="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0" style={{ backgroundColor: `${atom.color}15` }}>
                  <span className="w-4 h-4 flex items-center justify-center"><i className={atom.icon} style={{ color: atom.color }} /></span>
                </div>
                <div className="min-w-0">
                  <span className="text-sm font-semibold text-foreground-800">{atom.type}</span>
                  <p className="text-xs text-foreground-500 mt-0.5">{atom.description}</p>
                  <span className="inline-block mt-1.5 text-[9px] px-2 py-0.5 rounded-full bg-primary-50 text-primary-700 font-medium">{atom.route}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </ScrollReveal>

      <ScrollReveal>
        <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
          {system.kpis.map(kpi => (
            <div key={kpi.label} className="bg-white border border-background-200 rounded-xl p-4 text-center">
              <span className="w-5 h-5 mx-auto mb-1 flex items-center justify-center text-primary-500"><i className={`${kpi.icon} text-lg`} /></span>
              <span className="block text-xl font-bold text-foreground-950 font-heading">{kpi.value}</span>
              <span className="text-[10px] text-foreground-500">{kpi.label}</span>
            </div>
          ))}
        </div>
      </ScrollReveal>

      <ScrollReveal>
        <div className="bg-gradient-to-r from-primary-50/50 to-background-50 border border-primary-200/40 rounded-2xl p-6">
          <h3 className="font-heading text-lg font-bold text-foreground-950 mb-4">
            <span className="w-4 h-4 inline-flex items-center justify-center mr-2"><i className="ri-scales-line text-primary-600" /></span>
            KOS vs Big Four — Client Brain Mining
          </h3>
          <div className="space-y-3">
            {system.comparison.map(comp => (
              <div key={comp.dimension} className="flex items-center gap-4 p-3 rounded-xl bg-white border border-background-100">
                <span className="w-4 h-4 flex items-center justify-center flex-shrink-0"><i className={`${comp.icon} text-foreground-400 text-sm`} /></span>
                <div className="flex-1 min-w-0">
                  <span className="text-xs font-semibold text-foreground-700">{comp.dimension}</span>
                </div>
                <span className="text-xs text-foreground-400 bg-background-100 px-3 py-1 rounded-full whitespace-nowrap">{comp.bigFour}</span>
                <span className="w-4 h-4 flex items-center justify-center"><i className="ri-arrow-right-line text-foreground-300" /></span>
                <span className="text-xs font-bold text-primary-600 bg-primary-50 px-3 py-1 rounded-full whitespace-nowrap">{comp.kos}</span>
              </div>
            ))}
          </div>
        </div>
      </ScrollReveal>
    </div>
  );
}

function PredictiveGapTab({ system }: { system: import('@/mocks/kosAutoKnowledgeDevelopment').PredictiveGapSystem }) {
  const [expandedGap, setExpandedGap] = useState<string | null>(null);

  return (
    <div className="space-y-8">
      <ScrollReveal>
        <div className="bg-gradient-to-r from-amber-50 to-background-50 border border-amber-200/50 rounded-2xl p-6">
          <div className="flex items-start gap-3">
            <div className="w-12 h-12 rounded-xl bg-amber-100 flex items-center justify-center flex-shrink-0">
              <span className="w-5 h-5 flex items-center justify-center"><i className="ri-crosshair-line text-amber-600 text-xl" /></span>
            </div>
            <div>
              <h3 className="font-semibold text-foreground-950 text-sm">Principe</h3>
              <p className="text-sm text-foreground-600 mt-1 leading-relaxed">{system.principle}</p>
            </div>
          </div>
        </div>
      </ScrollReveal>

      <ScrollReveal>
        <div className="bg-white border border-background-200 rounded-2xl p-6">
          <h3 className="font-heading text-lg font-bold text-foreground-950 mb-1">Progression Couverture — ISO 30401 §6.2</h3>
          <div className="flex items-end gap-6 mb-4">
            <div className="text-center">
              <span className="text-3xl font-bold text-foreground-950 font-heading">{system.coverageStart}%</span>
              <span className="block text-[10px] text-foreground-500">Aujourd&apos;hui</span>
            </div>
            <div className="flex-1 h-4 bg-background-200 rounded-full overflow-hidden">
              <div className="h-full bg-gradient-to-r from-amber-500 to-emerald-500 rounded-full transition-all" style={{ width: `${system.coverageStart}%` }} />
            </div>
            <div className="text-center">
              <span className="text-3xl font-bold text-emerald-600 font-heading">{system.coverageTarget}%</span>
              <span className="block text-[10px] text-foreground-500">Cible J+{system.daysToTarget}</span>
            </div>
          </div>
          <p className="text-xs text-foreground-500 text-center">
            Couverture du savoir critique réglementaire — de {system.coverageStart}% à {system.coverageTarget}% en {system.daysToTarget} jours
          </p>
        </div>
      </ScrollReveal>

      <ScrollReveal>
        <div className="bg-white border border-background-200 rounded-2xl p-6">
          <h3 className="font-heading text-lg font-bold text-foreground-950 mb-1">Flux Automatique — 5 Étapes</h3>
          <p className="text-xs text-foreground-500 mb-5">Scan hebdomadaire, priorisation croisée avec Tender Intelligence, Human-in-Loop 5 min</p>
          <div>
            {system.flowSteps.map((step: PredictiveGapStep, idx: number) => (
              <div key={step.step} className="flex gap-4">
                <div className="flex flex-col items-center w-10">
                  <div className="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 border-2" style={{ borderColor: step.color, backgroundColor: `${step.color}15` }}>
                    <span className="w-4 h-4 flex items-center justify-center"><i className={step.icon} style={{ color: step.color }} /></span>
                  </div>
                  {idx < system.flowSteps.length - 1 && (
                    <div className="w-0.5 flex-1 min-h-[32px]" style={{ backgroundColor: `${step.color}40` }} />
                  )}
                </div>
                <div className={`flex-1 pb-6 ${idx < system.flowSteps.length - 1 ? 'border-b border-background-100' : ''}`}>
                  <div className="flex items-center gap-2 mb-1">
                    <span className="text-sm font-bold text-foreground-950">Étape {step.step} — {step.name}</span>
                    <span className="text-[9px] px-2 py-0.5 rounded-full bg-background-100 text-foreground-500 font-medium whitespace-nowrap">{step.duration}</span>
                  </div>
                  <p className="text-xs text-foreground-600 leading-relaxed">{step.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </ScrollReveal>

      <ScrollReveal>
        <div className="bg-white border border-background-200 rounded-2xl p-6">
          <h3 className="font-heading text-lg font-bold text-foreground-950 mb-1">
            <span className="w-4 h-4 inline-flex items-center justify-center mr-2"><i className="ri-search-line text-amber-600" /></span>
            Entités Orphelines Détectées
          </h3>
          <p className="text-xs text-foreground-500 mb-5">{system.orphanEntities.length} entités sans couverture dans la base KOS</p>
          <div className="space-y-3">
            {system.orphanEntities.map((entity: PredictiveGapEntity) => (
              <div
                key={entity.name}
                onClick={() => setExpandedGap(expandedGap === entity.name ? null : entity.name)}
                className={`rounded-xl border p-4 cursor-pointer transition-all ${
                  entity.status === 'published' ? 'border-emerald-200 bg-emerald-50/30' :
                  entity.status === 'validated' || entity.status === 'drafting' ? 'border-amber-200 bg-amber-50/30' :
                  'border-background-200 bg-white'
                }`}
              >
                <div className="flex items-start justify-between gap-4">
                  <div className="flex-1 min-w-0">
                    <div className="flex items-center gap-2 mb-1 flex-wrap">
                      <h4 className="text-sm font-bold text-foreground-950">{entity.name}</h4>
                      <span className={`text-[9px] font-bold px-2 py-0.5 rounded-full whitespace-nowrap ${
                        entity.priority === 'P0' ? 'bg-red-100 text-red-700' :
                        entity.priority === 'P1' ? 'bg-amber-100 text-amber-700' :
                        'bg-background-100 text-foreground-500'
                      }`}>{entity.priority}</span>
                      <span className={`text-[9px] font-bold px-2 py-0.5 rounded-full whitespace-nowrap ${
                        entity.status === 'published' ? 'bg-emerald-100 text-emerald-700' :
                        entity.status === 'validated' ? 'bg-primary-100 text-primary-700' :
                        entity.status === 'drafting' ? 'bg-amber-100 text-amber-700' :
                        entity.status === 'briefed' ? 'bg-purple-100 text-purple-700' :
                        'bg-background-100 text-foreground-500'
                      }`}>
                        {entity.status === 'published' ? 'PUBLIÉ' : entity.status === 'validated' ? 'VALIDÉ' : entity.status === 'drafting' ? 'EN RÉDACTION' : entity.status === 'briefed' ? 'BRIEFÉ' : 'DÉTECTÉ'}
                      </span>
                    </div>
                    <p className="text-xs text-foreground-500 mb-1">{entity.gapDescription}</p>
                    <p className="text-[10px] text-foreground-400"><strong className="text-foreground-600">Déclencheur :</strong> {entity.trigger}</p>
                  </div>
                  {expandedGap === entity.name ? (
                    <span className="w-4 h-4 flex items-center justify-center flex-shrink-0"><i className="ri-arrow-up-s-line text-foreground-400" /></span>
                  ) : (
                    <span className="w-4 h-4 flex items-center justify-center flex-shrink-0"><i className="ri-arrow-down-s-line text-foreground-400" /></span>
                  )}
                </div>
                {expandedGap === entity.name && (
                  <div className="mt-3 pt-3 border-t border-background-200/70">
                    <div className="grid grid-cols-3 gap-2 text-center text-[10px]">
                      <div className="p-2 rounded-lg bg-background-50">
                        <span className="block font-bold text-foreground-800">{entity.domain}</span>
                        <span className="text-foreground-400">Domaine</span>
                      </div>
                      <div className="p-2 rounded-lg bg-background-50">
                        <span className={`block font-bold ${entity.priority === 'P0' ? 'text-red-600' : entity.priority === 'P1' ? 'text-amber-600' : 'text-foreground-500'}`}>{entity.priority}</span>
                        <span className="text-foreground-400">Priorité</span>
                      </div>
                      <div className="p-2 rounded-lg bg-background-50">
                        <span className={`block font-bold ${entity.status === 'published' ? 'text-emerald-600' : 'text-amber-600'}`}>{entity.status === 'published' ? 'Comblé' : entity.status === 'drafting' ? 'En cours' : 'À traiter'}</span>
                        <span className="text-foreground-400">Action</span>
                      </div>
                    </div>
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      </ScrollReveal>

      <ScrollReveal>
        <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
          {system.kpis.map(kpi => (
            <div key={kpi.label} className="bg-white border border-background-200 rounded-xl p-4 text-center">
              <span className="w-5 h-5 mx-auto mb-1 flex items-center justify-center text-amber-500"><i className={`${kpi.icon} text-lg`} /></span>
              <span className="block text-xl font-bold text-foreground-950 font-heading">{kpi.value}</span>
              <span className="text-[10px] text-foreground-500">{kpi.label}</span>
            </div>
          ))}
        </div>
      </ScrollReveal>
    </div>
  );
}
