import { useState } from 'react';
import KOSHubLayout from '@/components/feature/KOSHubLayout';
import ScrollReveal from '@/components/feature/ScrollReveal';
import { useKOSKnowledgeFactory } from '@/hooks/useKOSKnowledgeFactory';

type TabId = 'taxonomy' | 'glossary' | 'faq' | 'cases' | 'templates' | 'trainings' | 'kpis';

const TABS: { id: TabId; label: string; icon: string }[] = [
  { id: 'taxonomy', label: 'Taxonomie', icon: 'ri-node-tree' },
  { id: 'glossary', label: 'Glossaire', icon: 'ri-book-open-line' },
  { id: 'faq', label: 'FAQ Factory', icon: 'ri-question-answer-line' },
  { id: 'cases', label: 'Cas Pratiques', icon: 'ri-file-search-line' },
  { id: 'templates', label: 'Modèles', icon: 'ri-file-copy-line' },
  { id: 'trainings', label: 'Scripts Pédagogiques', icon: 'ri-presentation-line' },
  { id: 'kpis', label: 'KPIs & Couverture', icon: 'ri-line-chart-line' },
];

export default function KOSKnowledgeFactoryPage() {
  const [kosData, setKosData] = useState<any>(null);
  useEffect(() => {
    fetch('/mocks/kos-blog.json').then(r => r.json()).then(setKosData);
  }, []);
  if (!kosData) return null;

  const [activeTab, setActiveTab] = useState<TabId>('taxonomy');
  const engine = useKOSKnowledgeFactory();
  const stats = engine.getStats();

  return (
    <KOSHubLayout hubId={92} activeTab="Knowledge-Factory" tabLabel="KOS Knowledge Factory">
      <main>
        {/* Hero */}
        <section className="relative overflow-hidden bg-background-50 border-b border-background-200/70">
          <div className="max-w-7xl mx-auto px-4 md:px-6 py-10 md:py-14">
            <ScrollReveal>
              <div className="flex flex-col lg:flex-row items-start lg:items-center gap-6">
                <div className="flex-1">
                  <div className="flex items-center gap-3 mb-3 flex-wrap">
                    <span className="px-3 py-1 rounded-full text-xs font-semibold bg-primary-100 text-primary-700 font-body tracking-wide">
                      {stats.projectVersion}
                    </span>
                    <span className="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-accent-100 text-accent-700 font-body">
                      <i className="ri-check-double-line text-xs"></i>
                      {stats.domainsCompleted}/{stats.totalDomains} domaines
                    </span>
                    <span className="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-700 font-body">
                      <i className="ri-shield-check-line text-xs"></i>
                      Standard Big Four
                    </span>
                  </div>
                  <h1 className="text-2xl md:text-3xl font-bold text-foreground-950 mb-2 font-heading">
                    KOS Knowledge Factory
                  </h1>
                  <p className="text-sm text-foreground-600 max-w-2xl font-body">
                    Usine permanente de production de connaissances réglementaires, bancaires, financières, audit, conformité et gouvernance. Taxonomies, glossaires, FAQs, cas pratiques, modèles et scripts pédagogiques — standard Big Four. Consortium Deloitte · PwC · EY · KPMG.
                  </p>
                </div>
                <div className="grid grid-cols-4 gap-3 flex-shrink-0">
                  {[
                    { label: 'Domaines', value: stats.totalDomains, icon: 'ri-stack-line', color: 'text-primary-500' },
                    { label: 'Connaissances', value: stats.totalKnowledgeItems, icon: 'ri-book-open-line', color: 'text-accent-500' },
                    { label: 'Couverture', value: `${stats.coverageRate}%`, icon: 'ri-radar-line', color: 'text-secondary-500' },
                    { label: 'Maturité', value: `${stats.maturityScore}%`, icon: 'ri-medal-line', color: 'text-emerald-500' },
                  ].map(s => (
                    <div key={s.label} className="bg-background-50 border border-background-200/70 rounded-xl p-3 text-center min-w-[80px]">
                      <i className={`${s.icon} ${s.color} text-lg`}></i>
                      <p className="text-lg font-bold text-foreground-950 mt-1">{s.value}</p>
                      <p className="text-xs text-foreground-500">{s.label}</p>
                    </div>
                  ))}
                </div>
              </div>
            </ScrollReveal>
          </div>
        </section>

        {/* Tabs */}
        <div className="sticky top-0 z-40 bg-background-50/95 backdrop-blur-md border-b border-background-200/70">
          <div className="max-w-7xl mx-auto px-4 md:px-6">
            <div className="flex items-center gap-1 overflow-x-auto py-2">
              {TABS.map(tab => (
                <button
                  key={tab.id}
                  onClick={() => setActiveTab(tab.id)}
                  className={`flex items-center gap-2 px-4 py-2.5 rounded-full text-sm font-medium whitespace-nowrap transition-colors cursor-pointer ${
                    activeTab === tab.id
                      ? 'bg-primary-500 text-white'
                      : 'text-foreground-600 hover:bg-background-100'
                  }`}
                >
                  <i className={`${tab.icon} text-sm`}></i>
                  {tab.label}
                </button>
              ))}
            </div>
          </div>
        </div>

        {/* Tab kosData.Content */}
        <div className="max-w-7xl mx-auto px-4 md:px-6 py-10">
          {activeTab === 'taxonomy' && <TaxonomyTab engine={engine} />}
          {activeTab === 'glossary' && <GlossaryTab engine={engine} />}
          {activeTab === 'faq' && <FAQTab engine={engine} />}
          {activeTab === 'cases' && <CasesTab engine={engine} />}
          {activeTab === 'templates' && <TemplatesTab engine={engine} />}
          {activeTab === 'trainings' && <TrainingsTab engine={engine} />}
          {activeTab === 'kpis' && <KPIsTab engine={engine} />}
        </div>
      </main>
    </KOSHubLayout>
  );
}

// ============================================================================
// TAB 1: TAXONOMY
// ============================================================================
function TaxonomyTab({ engine }: { engine: ReturnType<typeof useKOSKnowledgeFactory> }) {
  const [searchQ, setSearchQ] = useState('');
  const domains = searchQ ? engine.getDomainsBySearch(searchQ) : engine.domains;

  return (
    <div className="space-y-6">
      <ScrollReveal>
        <div className="bg-primary-50 border border-primary-200/60 rounded-xl p-5">
          <div className="flex items-start gap-3">
            <div className="w-10 h-10 rounded-full bg-primary-500 flex items-center justify-center flex-shrink-0">
              <i className="ri-node-tree text-white text-lg"></i>
            </div>
            <div>
              <h3 className="font-semibold text-foreground-950 text-sm">Taxonomie KHEPRA — 12 Domaines</h3>
              <p className="text-sm text-foreground-600 mt-1">
                <strong className="text-foreground-800">Consortium Deloitte · PwC · EY · KPMG.</strong> Chaque domaine inclut sous-thèmes, mots-clés, glossaire, FAQ, cas pratiques, modèles et scripts pédagogiques. Couverture 100%, zéro duplication, standard Big Four.
              </p>
            </div>
          </div>
        </div>
      </ScrollReveal>

      {/* Search */}
      <div className="relative max-w-md">
        <i className="ri-search-line absolute left-3.5 top-1/2 -translate-y-1/2 text-foreground-400 text-sm"></i>
        <input
          type="text" value={searchQ} onChange={e => setSearchQ(e.target.value)}
          placeholder="Rechercher un domaine, sous-thème..."
          className="w-full pl-10 pr-4 py-2.5 text-sm bg-background-100 border border-background-200/70 rounded-lg text-foreground-950 placeholder:text-foreground-400 focus:outline-none focus:border-primary-300"
        />
      </div>

      {/* Stats bar */}
      <div className="grid grid-cols-2 sm:grid-cols-5 gap-3">
        {[
          { label: 'Domaines', value: engine.domains.length, icon: 'ri-folder-line', color: 'text-primary-500' },
          { label: 'Sous-Thèmes', value: engine.domains.reduce((s, d) => s + d.subThemes.length, 0), icon: 'ri-list-check', color: 'text-accent-500' },
          { label: 'Keywords', value: engine.domains.reduce((s, d) => s + d.keywords.length, 0), icon: 'ri-hashtag', color: 'text-secondary-500' },
          { label: 'Maturité Moy.', value: `${Math.round(engine.domains.reduce((s, d) => s + d.maturity, 0) / engine.domains.length)}%`, icon: 'ri-medal-line', color: 'text-emerald-500' },
          { label: 'Couverture', value: `${engine.getStats().coverageRate}%`, icon: 'ri-radar-line', color: 'text-foreground-500' },
        ].map(s => (
          <div key={s.label} className="bg-background-50 border border-background-200/70 rounded-lg p-3 text-center">
            <i className={`${s.icon} ${s.color} text-lg`}></i>
            <p className="text-lg font-bold text-foreground-950 mt-1">{s.value}</p>
            <p className="text-xs text-foreground-500">{s.label}</p>
          </div>
        ))}
      </div>

      {/* Domain Grid */}
      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
        {engine.domainSummary.map(domain => (
          <ScrollReveal key={domain.id}>
            <div className="bg-background-50 border border-background-200/70 rounded-xl p-5 h-full">
              <div className="flex items-start gap-3 mb-3">
                <div className={`w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0 ${
                  domain.color === 'primary' ? 'bg-primary-100 text-primary-700' :
                  domain.color === 'accent' ? 'bg-accent-100 text-accent-700' : 'bg-secondary-100 text-secondary-700'
                }`}>
                  <i className={`${domain.icon} text-lg`}></i>
                </div>
                <div className="flex-1 min-w-0">
                  <h3 className="text-sm font-semibold text-foreground-950">{domain.name}</h3>
                  <p className="text-xs text-foreground-500 mt-0.5 line-clamp-2">{domain.description}</p>
                </div>
              </div>
              {/* Sub-themes */}
              <div className="flex flex-wrap gap-1 mb-3">
                {domain.subThemes.slice(0, 5).map(st => (
                  <span key={st} className="text-xs px-2 py-0.5 rounded-full bg-background-100 text-foreground-600">{st}</span>
                ))}
                {domain.subThemes.length > 5 && (
                  <span className="text-xs px-2 py-0.5 rounded-full bg-background-100 text-foreground-400">+{domain.subThemes.length - 5}</span>
                )}
              </div>
              {/* kosData.Content counts */}
              <div className="flex flex-wrap items-center gap-2 text-xs text-foreground-500 mb-3">
                <span className="flex items-center gap-1"><i className="ri-book-open-line"></i>{domain.glossaryCount} gloss.</span>
                <span className="flex items-center gap-1"><i className="ri-question-answer-line"></i>{domain.faqCount} FAQs</span>
                <span className="flex items-center gap-1"><i className="ri-file-search-line"></i>{domain.caseCount} cas</span>
                <span className="flex items-center gap-1"><i className="ri-file-copy-line"></i>{domain.templateCount} modèles</span>
              </div>
              {/* Maturity + Coverage */}
              <div className="grid grid-cols-2 gap-3 pt-3 border-t border-background-200/40">
                <div>
                  <div className="flex items-center justify-between text-xs mb-1">
                    <span className="text-foreground-500">Maturité</span>
                    <span className="text-foreground-700 font-semibold">{domain.maturity}%</span>
                  </div>
                  <div className="w-full h-1.5 bg-background-200 rounded-full overflow-hidden">
                    <div className={`h-full rounded-full ${domain.maturity >= 90 ? 'bg-emerald-500' : domain.maturity >= 80 ? 'bg-accent-500' : 'bg-secondary-500'}`} style={{ width: `${domain.maturity}%` }}></div>
                  </div>
                </div>
                <div>
                  <div className="flex items-center justify-between text-xs mb-1">
                    <span className="text-foreground-500">Couverture</span>
                    <span className="text-foreground-700 font-semibold">{domain.coverageRate}%</span>
                  </div>
                  <div className="w-full h-1.5 bg-background-200 rounded-full overflow-hidden">
                    <div className="h-full bg-primary-500 rounded-full" style={{ width: `${domain.coverageRate}%` }}></div>
                  </div>
                </div>
              </div>
            </div>
          </ScrollReveal>
        ))}
      </div>
    </div>
  );
}

// ============================================================================
// TAB 2: GLOSSARY
// ============================================================================
function GlossaryTab({ engine }: { engine: ReturnType<typeof useKOSKnowledgeFactory> }) {
  const [searchQ, setSearchQ] = useState('');
  const [domainF, setDomainF] = useState('all');
  const filtered = searchQ ? engine.searchGlossary(searchQ) : engine.getGlossaryByDomain(domainF);

  return (
    <div className="space-y-6">
      <div className="flex flex-col sm:flex-row gap-3">
        <div className="relative flex-1 max-w-md">
          <i className="ri-search-line absolute left-3.5 top-1/2 -translate-y-1/2 text-foreground-400 text-sm"></i>
          <input type="text" value={searchQ} onChange={e => setSearchQ(e.target.value)} placeholder="Rechercher un terme..."
            className="w-full pl-10 pr-4 py-2.5 text-sm bg-background-100 border border-background-200/70 rounded-lg text-foreground-950 focus:outline-none focus:border-primary-300" />
        </div>
        <select value={domainF} onChange={e => { setDomainF(e.target.value); setSearchQ(''); }}
          className="px-3 py-2.5 text-sm bg-background-100 border border-background-200/70 rounded-lg text-foreground-950 cursor-pointer">
          <option value="all">Tous les domaines</option>
          {engine.domains.map(d => <option key={d.id} value={d.id}>{d.name}</option>)}
        </select>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
        {filtered.map(entry => {
          const domain = engine.getDomainById(entry.domainId);
          return (
            <ScrollReveal key={entry.id}>
              <div className="bg-background-50 border border-background-200/70 rounded-xl p-5">
                <div className="flex items-start gap-3 mb-2">
                  <div className={`w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0 ${
                    domain?.color === 'primary' ? 'bg-primary-100 text-primary-700' :
                    domain?.color === 'accent' ? 'bg-accent-100 text-accent-700' : 'bg-secondary-100 text-secondary-700'
                  }`}>
                    <i className={`${domain?.icon || 'ri-book-open-line'} text-sm`}></i>
                  </div>
                  <div>
                    <h3 className="text-sm font-semibold text-foreground-950">{entry.term}</h3>
                    <span className="text-xs text-foreground-400">{domain?.name || entry.domainId} · {entry.sourceReference}</span>
                  </div>
                </div>
                <p className="text-xs text-foreground-700 leading-relaxed mb-2">{entry.definition}</p>
                <p className="text-xs text-foreground-500 italic mb-2">Contexte : {entry.context}</p>
                <div className="flex flex-wrap gap-1">
                  {entry.relatedTerms.map(rt => (
                    <span key={rt} className="text-xs px-2 py-0.5 rounded-full bg-background-100 text-foreground-500">{rt}</span>
                  ))}
                </div>
              </div>
            </ScrollReveal>
          );
        })}
      </div>
    </div>
  );
}

// ============================================================================
// TAB 3: FAQ
// ============================================================================
function FAQTab({ engine }: { engine: ReturnType<typeof useKOSKnowledgeFactory> }) {
  const [searchQ, setSearchQ] = useState('');
  const [domainF, setDomainF] = useState('all');
  const [diffF, setDiffF] = useState('all');
  const filtered = searchQ ? engine.searchFAQ(searchQ) : (diffF !== 'all' ? engine.getFAQByDifficulty(diffF) : engine.getFAQByDomain(domainF));

  return (
    <div className="space-y-6">
      <div className="flex flex-col sm:flex-row gap-3">
        <div className="relative flex-1 max-w-md">
          <i className="ri-search-line absolute left-3.5 top-1/2 -translate-y-1/2 text-foreground-400 text-sm"></i>
          <input type="text" value={searchQ} onChange={e => setSearchQ(e.target.value)} placeholder="Rechercher une question..."
            className="w-full pl-10 pr-4 py-2.5 text-sm bg-background-100 border border-background-200/70 rounded-lg text-foreground-950 focus:outline-none focus:border-primary-300" />
        </div>
        <select value={domainF} onChange={e => { setDomainF(e.target.value); setSearchQ(''); }}
          className="px-3 py-2.5 text-sm bg-background-100 border border-background-200/70 rounded-lg text-foreground-950 cursor-pointer">
          <option value="all">Tous les domaines</option>
          {engine.domains.map(d => <option key={d.id} value={d.id}>{d.name}</option>)}
        </select>
        <select value={diffF} onChange={e => { setDiffF(e.target.value); setSearchQ(''); }}
          className="px-3 py-2.5 text-sm bg-background-100 border border-background-200/70 rounded-lg text-foreground-950 cursor-pointer">
          <option value="all">Tous niveaux</option>
          <option value="débutant">Débutant</option>
          <option value="intermédiaire">Intermédiaire</option>
          <option value="expert">Expert</option>
        </select>
      </div>

      <div className="space-y-3">
        {filtered.map(faq => {
          const domain = engine.getDomainById(faq.domainId);
          return (
            <ScrollReveal key={faq.id}>
              <details className="bg-background-50 border border-background-200/70 rounded-xl overflow-hidden group">
                <summary className="p-5 cursor-pointer list-none flex items-start gap-3">
                  <div className={`w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5 ${
                    domain?.color === 'primary' ? 'bg-primary-100 text-primary-700' :
                    domain?.color === 'accent' ? 'bg-accent-100 text-accent-700' : 'bg-secondary-100 text-secondary-700'
                  }`}>
                    <i className="ri-question-answer-line text-sm"></i>
                  </div>
                  <div className="flex-1 min-w-0">
                    <div className="flex items-center gap-2 mb-1 flex-wrap">
                      <h3 className="text-sm font-semibold text-foreground-950">{faq.question}</h3>
                      <span className={`text-xs px-2 py-0.5 rounded-full ${
                        faq.difficulty === 'débutant' ? 'bg-emerald-100 text-emerald-700' :
                        faq.difficulty === 'intermédiaire' ? 'bg-amber-100 text-amber-700' : 'bg-red-100 text-red-700'
                      }`}>{faq.difficulty}</span>
                      <span className="text-xs text-foreground-400">{domain?.name}</span>
                    </div>
                    <div className="flex flex-wrap gap-1 mt-1">
                      {faq.tags.map(t => (
                        <span key={t} className="text-xs px-2 py-0.5 rounded-full bg-background-100 text-foreground-500">{t}</span>
                      ))}
                    </div>
                  </div>
                  <i className="ri-arrow-down-s-line text-foreground-400 mt-1 group-open:rotate-180 transition-transform"></i>
                </summary>
                <div className="px-5 pb-5 border-t border-background-200/40 ml-14">
                  <p className="text-sm text-foreground-700 leading-relaxed">{faq.answer}</p>
                  <p className="text-xs text-foreground-400 mt-2">Dernière mise à jour : {faq.lastUpdated}</p>
                </div>
              </details>
            </ScrollReveal>
          );
        })}
      </div>
    </div>
  );
}

// ============================================================================
// TAB 4: CASES
// ============================================================================
function CasesTab({ engine }: { engine: ReturnType<typeof useKOSKnowledgeFactory> }) {
  const [searchQ, setSearchQ] = useState('');
  const [domainF, setDomainF] = useState('all');
  const filtered = searchQ ? engine.searchCaseStudies(searchQ) : engine.getCaseStudiesByDomain(domainF);

  return (
    <div className="space-y-6">
      <div className="flex flex-col sm:flex-row gap-3">
        <div className="relative flex-1 max-w-md">
          <i className="ri-search-line absolute left-3.5 top-1/2 -translate-y-1/2 text-foreground-400 text-sm"></i>
          <input type="text" value={searchQ} onChange={e => setSearchQ(e.target.value)} placeholder="Rechercher un cas..."
            className="w-full pl-10 pr-4 py-2.5 text-sm bg-background-100 border border-background-200/70 rounded-lg text-foreground-950 focus:outline-none focus:border-primary-300" />
        </div>
        <select value={domainF} onChange={e => { setDomainF(e.target.value); setSearchQ(''); }}
          className="px-3 py-2.5 text-sm bg-background-100 border border-background-200/70 rounded-lg text-foreground-950 cursor-pointer">
          <option value="all">Tous les domaines</option>
          {engine.domains.map(d => <option key={d.id} value={d.id}>{d.name}</option>)}
        </select>
      </div>

      <div className="grid grid-cols-1 gap-4">
        {filtered.map(cs => {
          const domain = engine.getDomainById(cs.domainId);
          return (
            <ScrollReveal key={cs.id}>
              <div className="bg-background-50 border border-background-200/70 rounded-xl overflow-hidden">
                <div className="p-5 border-b border-background-200/40">
                  <div className="flex items-start justify-between gap-4">
                    <div className="flex-1 min-w-0">
                      <div className="flex items-center gap-2 mb-1 flex-wrap">
                        <span className={`text-xs px-2 py-0.5 rounded-full ${
                          domain?.color === 'primary' ? 'bg-primary-100 text-primary-700' :
                          domain?.color === 'accent' ? 'bg-accent-100 text-accent-700' : 'bg-secondary-100 text-secondary-700'
                        }`}>{domain?.name}</span>
                        <span className="text-xs text-foreground-400">{cs.sector}</span>
                        <span className={`text-xs px-2 py-0.5 rounded-full ${
                          cs.complexity === 'simple' ? 'bg-emerald-100 text-emerald-700' :
                          cs.complexity === 'moyen' ? 'bg-amber-100 text-amber-700' : 'bg-red-100 text-red-700'
                        }`}>{cs.complexity}</span>
                      </div>
                      <h3 className="text-sm font-semibold text-foreground-950">{cs.title}</h3>
                    </div>
                  </div>
                </div>
                <div className="p-5 grid grid-cols-1 lg:grid-cols-2 gap-5">
                  <div>
                    <h4 className="text-xs font-semibold text-primary-600 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                      <i className="ri-information-line"></i>Contexte & Problème
                    </h4>
                    <p className="text-xs text-foreground-600 mb-2"><strong>Contexte :</strong> {cs.context}</p>
                    <p className="text-xs text-foreground-600"><strong>Problème :</strong> {cs.problem}</p>
                  </div>
                  <div>
                    <h4 className="text-xs font-semibold text-emerald-600 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                      <i className="ri-check-line"></i>Solution & Résultats
                    </h4>
                    <p className="text-xs text-foreground-600 mb-2"><strong>Solution :</strong> {cs.solution}</p>
                    <p className="text-xs text-foreground-600"><strong>Résultats :</strong> {cs.results}</p>
                  </div>
                </div>
                <div className="px-5 pb-5">
                  <h4 className="text-xs font-semibold text-amber-600 uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
                    <i className="ri-lightbulb-line"></i>Key Learnings
                  </h4>
                  <ul className="space-y-1">
                    {cs.keyLearnings.map((kl, i) => (
                      <li key={i} className="text-xs text-foreground-600 flex items-start gap-1.5">
                        <span className="text-amber-500 mt-0.5">•</span>{kl}
                      </li>
                    ))}
                  </ul>
                  <div className="flex flex-wrap gap-1 mt-3">
                    {cs.tags.map(t => (
                      <span key={t} className="text-xs px-2 py-0.5 rounded-full bg-background-100 text-foreground-500">{t}</span>
                    ))}
                  </div>
                </div>
              </div>
            </ScrollReveal>
          );
        })}
      </div>
    </div>
  );
}

// ============================================================================
// TAB 5: TEMPLATES
// ============================================================================
function TemplatesTab({ engine }: { engine: ReturnType<typeof useKOSKnowledgeFactory> }) {
  const [searchQ, setSearchQ] = useState('');
  const [domainF, setDomainF] = useState('all');
  const [typeF, setTypeF] = useState('all');
  const filtered = searchQ ? engine.searchTemplates(searchQ) : (typeF !== 'all' ? engine.getTemplatesByType(typeF) : engine.getTemplatesByDomain(domainF));

  const typeLabels: Record<string, string> = { politique: 'Politique', procédure: 'Procédure', charte: 'Charte', rapport: 'Rapport', matrice: 'Matrice', plan: 'Plan', manuel: 'Manuel', formulaire: 'Formulaire' };

  return (
    <div className="space-y-6">
      <div className="flex flex-col sm:flex-row gap-3">
        <div className="relative flex-1 max-w-md">
          <i className="ri-search-line absolute left-3.5 top-1/2 -translate-y-1/2 text-foreground-400 text-sm"></i>
          <input type="text" value={searchQ} onChange={e => setSearchQ(e.target.value)} placeholder="Rechercher un modèle..."
            className="w-full pl-10 pr-4 py-2.5 text-sm bg-background-100 border border-background-200/70 rounded-lg text-foreground-950 focus:outline-none focus:border-primary-300" />
        </div>
        <select value={domainF} onChange={e => { setDomainF(e.target.value); setSearchQ(''); }}
          className="px-3 py-2.5 text-sm bg-background-100 border border-background-200/70 rounded-lg text-foreground-950 cursor-pointer">
          <option value="all">Tous les domaines</option>
          {engine.domains.map(d => <option key={d.id} value={d.id}>{d.name}</option>)}
        </select>
        <select value={typeF} onChange={e => { setTypeF(e.target.value); setSearchQ(''); }}
          className="px-3 py-2.5 text-sm bg-background-100 border border-background-200/70 rounded-lg text-foreground-950 cursor-pointer">
          <option value="all">Tous types</option>
          {Object.entries(typeLabels).map(([k, v]) => <option key={k} value={k}>{v}</option>)}
        </select>
      </div>

      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {filtered.map(tpl => {
          const domain = engine.getDomainById(tpl.domainId);
          return (
            <ScrollReveal key={tpl.id}>
              <div className="bg-background-50 border border-background-200/70 rounded-xl p-5 h-full flex flex-col">
                <div className="flex items-center gap-2 mb-2">
                  <div className={`w-8 h-8 rounded-lg flex items-center justify-center flex-shrink-0 ${
                    domain?.color === 'primary' ? 'bg-primary-100 text-primary-700' :
                    domain?.color === 'accent' ? 'bg-accent-100 text-accent-700' : 'bg-secondary-100 text-secondary-700'
                  }`}>
                    <i className="ri-file-copy-line text-sm"></i>
                  </div>
                  <span className={`text-xs px-2 py-0.5 rounded-full ${
                    domain?.color === 'primary' ? 'bg-primary-100 text-primary-700' :
                    domain?.color === 'accent' ? 'bg-accent-100 text-accent-700' : 'bg-secondary-100 text-secondary-700'
                  }`}>{typeLabels[tpl.type] || tpl.type}</span>
                  <span className="text-xs text-foreground-400 ml-auto">{tpl.format}</span>
                </div>
                <h3 className="text-sm font-semibold text-foreground-950 mb-2">{tpl.title}</h3>
                <p className="text-xs text-foreground-500 line-clamp-2 mb-3">{tpl.description}</p>
                <div className="flex flex-wrap gap-1 mb-3">
                  {tpl.sections.slice(0, 3).map(s => (
                    <span key={s} className="text-xs px-2 py-0.5 rounded-full bg-background-100 text-foreground-500">{s}</span>
                  ))}
                </div>
                <div className="mt-auto pt-3 border-t border-background-200/40 flex items-center justify-between text-xs text-foreground-500">
                  <span><i className="ri-pages-line mr-1"></i>{tpl.pages} pages</span>
                  <span><i className="ri-download-line mr-1"></i>{tpl.usageCount}</span>
                </div>
              </div>
            </ScrollReveal>
          );
        })}
      </div>
    </div>
  );
}

// ============================================================================
// TAB 6: TRAININGS
// ============================================================================
function TrainingsTab({ engine }: { engine: ReturnType<typeof useKOSKnowledgeFactory> }) {
  const [searchQ, setSearchQ] = useState('');
  const [domainF, setDomainF] = useState('all');
  const filtered = searchQ ? engine.searchTrainings(searchQ) : engine.getTrainingsByDomain(domainF);
  const formatLabels: Record<string, string> = { présentation: 'Présentation', atelier: 'Atelier', 'e-learning': 'E-Learning', webinar: 'Webinar' };

  return (
    <div className="space-y-6">
      <div className="flex flex-col sm:flex-row gap-3">
        <div className="relative flex-1 max-w-md">
          <i className="ri-search-line absolute left-3.5 top-1/2 -translate-y-1/2 text-foreground-400 text-sm"></i>
          <input type="text" value={searchQ} onChange={e => setSearchQ(e.target.value)} placeholder="Rechercher un script..."
            className="w-full pl-10 pr-4 py-2.5 text-sm bg-background-100 border border-background-200/70 rounded-lg text-foreground-950 focus:outline-none focus:border-primary-300" />
        </div>
        <select value={domainF} onChange={e => { setDomainF(e.target.value); setSearchQ(''); }}
          className="px-3 py-2.5 text-sm bg-background-100 border border-background-200/70 rounded-lg text-foreground-950 cursor-pointer">
          <option value="all">Tous les domaines</option>
          {engine.domains.map(d => <option key={d.id} value={d.id}>{d.name}</option>)}
        </select>
      </div>

      <div className="grid grid-cols-1 gap-4">
        {filtered.map(tr => {
          const domain = engine.getDomainById(tr.domainId);
          return (
            <ScrollReveal key={tr.id}>
              <details className="bg-background-50 border border-background-200/70 rounded-xl overflow-hidden group">
                <summary className="p-5 cursor-pointer list-none flex items-start gap-3">
                  <div className={`w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0 ${
                    domain?.color === 'primary' ? 'bg-primary-100 text-primary-700' :
                    domain?.color === 'accent' ? 'bg-accent-100 text-accent-700' : 'bg-secondary-100 text-secondary-700'
                  }`}>
                    <i className="ri-presentation-line text-lg"></i>
                  </div>
                  <div className="flex-1 min-w-0">
                    <div className="flex items-center gap-2 mb-1 flex-wrap">
                      <h3 className="text-sm font-semibold text-foreground-950">{tr.title}</h3>
                      <span className="text-xs px-2 py-0.5 rounded-full bg-background-100 text-foreground-500">{formatLabels[tr.format] || tr.format}</span>
                      <span className="text-xs text-foreground-400">{tr.duration}</span>
                    </div>
                    <p className="text-xs text-foreground-500">{tr.audience}</p>
                  </div>
                  <i className="ri-arrow-down-s-line text-foreground-400 mt-1 group-open:rotate-180 transition-transform"></i>
                </summary>
                <div className="px-5 pb-5 border-t border-background-200/40 ml-14 space-y-4">
                  <div>
                    <h4 className="text-xs font-semibold text-foreground-950 mb-2">Objectifs Pédagogiques</h4>
                    <ul className="space-y-1">
                      {tr.learningObjectives.map((obj, i) => (
                        <li key={i} className="text-xs text-foreground-600 flex items-start gap-1.5">
                          <i className="ri-check-line text-emerald-500 mt-0.5"></i>{obj}
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div>
                    <h4 className="text-xs font-semibold text-foreground-950 mb-2">Modules ({tr.modules.length})</h4>
                    <div className="space-y-2">
                      {tr.modules.map((mod, i) => (
                        <div key={i} className="bg-background-100 rounded-lg p-3">
                          <div className="flex items-center justify-between mb-1">
                            <span className="text-xs font-semibold text-foreground-950">{mod.title}</span>
                            <span className="text-xs text-foreground-400">{mod.duration}</span>
                          </div>
                          <p className="text-xs text-foreground-600">{mod.kosData.content}</p>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </details>
            </ScrollReveal>
          );
        })}
      </div>
    </div>
  );
}

// ============================================================================
// TAB 7: KPIs
// ============================================================================
function KPIsTab({ engine }: { engine: ReturnType<typeof useKOSKnowledgeFactory> }) {
  const kpis = engine.getKPIs();

  return (
    <div className="space-y-6">
      {/* Maturity Score */}
      <ScrollReveal>
        <div className="grid grid-cols-1 sm:grid-cols-4 gap-4">
          <div className="bg-background-50 border border-background-200/70 rounded-xl p-5 text-center">
            <p className="text-xs text-foreground-500 uppercase tracking-wider mb-2">Score Maturité</p>
            <p className="text-5xl font-bold text-primary-500 font-heading">{engine.getStats().maturityScore}</p>
            <p className="text-xs text-foreground-400 mt-1">/100 — Cible {engine.getStats().targetMaturity}</p>
            <div className="w-full h-2 bg-background-200 rounded-full mt-3 overflow-hidden">
              <div className="h-full bg-primary-500 rounded-full" style={{ width: `${engine.getStats().maturityScore}%` }}></div>
            </div>
          </div>
          <div className="bg-background-50 border border-background-200/70 rounded-xl p-5 text-center">
            <p className="text-xs text-foreground-500 uppercase tracking-wider mb-2">Couverture</p>
            <p className="text-5xl font-bold text-accent-500 font-heading">{engine.getStats().coverageRate}</p>
            <p className="text-xs text-foreground-400 mt-1">% réglementaire</p>
          </div>
          <div className="bg-background-50 border border-background-200/70 rounded-xl p-5 text-center">
            <p className="text-xs text-foreground-500 uppercase tracking-wider mb-2">Connaissances</p>
            <p className="text-5xl font-bold text-secondary-500 font-heading">{engine.getStats().totalKnowledgeItems}</p>
            <p className="text-xs text-foreground-400 mt-1">items produits</p>
          </div>
          <div className="bg-background-50 border border-background-200/70 rounded-xl p-5 text-center">
            <p className="text-xs text-foreground-500 uppercase tracking-wider mb-2">Duplication</p>
            <p className="text-5xl font-bold text-emerald-500 font-heading">0</p>
            <p className="text-xs text-foreground-400 mt-1">zéro duplication</p>
          </div>
        </div>
      </ScrollReveal>

      {/* KPI Detail Cards */}
      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
        {kpis.map(kpi => (
          <ScrollReveal key={kpi.id}>
            <div className="bg-background-50 border border-background-200/70 rounded-xl p-5">
              <div className="flex items-center justify-between mb-3">
                <div className="flex items-center gap-2">
                  <div className={`w-8 h-8 rounded-lg flex items-center justify-center ${
                    kpi.color === 'primary' ? 'bg-primary-100 text-primary-700' :
                    kpi.color === 'accent' ? 'bg-accent-100 text-accent-700' : 'bg-secondary-100 text-secondary-700'
                  }`}>
                    <i className={`${kpi.icon} text-sm`}></i>
                  </div>
                  <span className="text-sm font-semibold text-foreground-950">{kpi.name}</span>
                </div>
                <span className="text-lg font-bold text-foreground-950">{kpi.current}{kpi.unit}</span>
              </div>
              <div className="flex items-end gap-1 h-16 mb-2">
                {kpi.history.map((h, i) => {
                  const maxVal = Math.max(...kpi.history.map(hh => hh.value), kpi.target);
                  const heightPct = maxVal > 0 ? (h.value / maxVal) * 100 : 0;
                  return (
                    <div key={i} className="flex-1 flex flex-col items-center gap-0.5">
                      <div className="w-full relative" style={{ height: '48px' }}>
                        <div className="absolute bottom-0 w-full rounded-sm bg-primary-400 transition-all" style={{ height: `${heightPct}%` }}></div>
                      </div>
                      <span className="text-[9px] text-foreground-400">{h.month}</span>
                    </div>
                  );
                })}
              </div>
              <div className="flex items-center justify-between text-xs text-foreground-500">
                <span>Cible: {kpi.target}{kpi.unit}</span>
                <span className="text-accent-600 font-medium">Standard Big Four</span>
              </div>
            </div>
          </ScrollReveal>
        ))}
      </div>

      {/* Summary Footer */}
      <ScrollReveal>
        <div className="bg-accent-50 border border-accent-200/60 rounded-xl p-5">
          <h3 className="font-semibold text-foreground-950 text-sm mb-2">KOS Knowledge Factory — Standards Big Four</h3>
          <div className="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs text-foreground-600">
            <span><i className="ri-check-line text-emerald-500 mr-1"></i>Couverture 100% des domaines</span>
            <span><i className="ri-check-line text-emerald-500 mr-1"></i>Zéro duplication entre domaines</span>
            <span><i className="ri-check-line text-emerald-500 mr-1"></i>Standard Deloitte · PwC · EY · KPMG</span>
            <span><i className="ri-check-line text-emerald-500 mr-1"></i>Audité le {engine.getStats().lastAuditDate}</span>
          </div>
        </div>
      </ScrollReveal>
    </div>
  );
}
