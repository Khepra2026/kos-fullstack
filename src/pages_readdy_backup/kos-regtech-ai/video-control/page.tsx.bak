import { useState, useEffect, useCallback, useMemo } from 'react';
import { supabase } from '@/lib/supabase';
import { useKosDispatch } from '@/hooks/useKosDispatch';
import KOSHubLayout from '@/components/feature/KOSHubLayout';
import { SeoHead } from '@/components/feature/SeoHead';
import { Link } from 'react-router-dom';
import {
  MOCK_VIDEOS, MOCK_JOBS, MOCK_COMMENTS, MOCK_YT_COMMENTS, MOCK_VIDEO_IDEAS,
  AGENT_NAMES, COUNTRIES,
  type AgentJob, type VideoRecord, type YouTubeComment, type YTComment, type VideoIdea,
} from '@/mocks/kosVideoControlCenter';

function formatInTimeZone(date: Date, tz: string, fmt: string): string {
  try {
    const options: Intl.DateTimeFormatOptions = {
      timeZone: tz,
      year: 'numeric', month: '2-digit', day: '2-digit',
      hour: '2-digit', minute: '2-digit',
      hour12: false,
    };
    if (fmt.includes('zzz')) {
      options.timeZoneName = 'short';
    }
    const parts = new Intl.DateTimeFormat('fr-FR', options).formatToParts(date);
    const map: Record<string, string> = {};
    parts.forEach(p => { map[p.type] = p.value; });
    let result = fmt
      .replace('dd', map.day || '')
      .replace('MM', map.month || '')
      .replace('yyyy', map.year || '')
      .replace('HH', map.hour || '')
      .replace('mm', map.minute || '')
      .replace('zzz', map.timeZoneName || '');
    return result;
  } catch {
    return date.toISOString();
  }
}

function zonedTimeToUtc(dateTimeStr: string, tz: string): Date {
  const localDate = new Date(dateTimeStr);
  const utcStr = localDate.toLocaleString('en-US', { timeZone: 'UTC', hour12: false });
  const tzStr = localDate.toLocaleString('en-US', { timeZone: tz, hour12: false });
  const offset = new Date(utcStr).getTime() - new Date(tzStr).getTime();
  return new Date(localDate.getTime() + offset);
}

const STATUS_STYLES: Record<string, { bg: string; text: string; dot: string }> = {
  pending: { bg: 'bg-background-100', text: 'text-foreground-500', dot: 'bg-gray-400' },
  running: { bg: 'bg-amber-50', text: 'text-amber-700', dot: 'bg-amber-500' },
  success: { bg: 'bg-emerald-50', text: 'text-emerald-700', dot: 'bg-emerald-500' },
  error: { bg: 'bg-red-50', text: 'text-red-700', dot: 'bg-red-500' },
  human_review: { bg: 'bg-violet-50', text: 'text-violet-700', dot: 'bg-violet-500' },
};

const CLASSIFICATION_STYLES: Record<string, { border: string; bg: string; text: string; label: string }> = {
  LEAD: { border: 'border-emerald-500', bg: 'bg-emerald-50', text: 'text-emerald-700', label: 'LEAD' },
  QUESTION: { border: 'border-amber-500', bg: 'bg-amber-50', text: 'text-amber-700', label: 'Question' },
  COMPLIMENT: { border: 'border-blue-400', bg: 'bg-blue-50', text: 'text-blue-700', label: 'Compliment' },
  SPAM: { border: 'border-red-400', bg: 'bg-red-50', text: 'text-red-700', label: 'SPAM' },
};

function useVideoControlCenter() {
  const [videos, setVideos] = useState<VideoRecord[]>([]);
  const [jobs, setJobs] = useState<AgentJob[]>([]);
  const [comments, setComments] = useState<YouTubeComment[]>([]);
  const [ytComments, setYtComments] = useState<YTComment[]>([]);
  const [videoIdeas, setVideoIdeas] = useState<VideoIdea[]>([]);
  const [loading, setLoading] = useState(true);
  const [selectedVideoId, setSelectedVideoId] = useState<string>('v-001');

  const loadFromSupabase = useCallback(async () => {
    try {
      const { data: vData } = await supabase.from('videos').select('*').order('created_at', { ascending: false }).limit(20);
      if (vData && vData.length > 0) {
        setVideos(vData as unknown as VideoRecord[]);
        setSelectedVideoId((vData[0] as Record<string, unknown>).id as string);
      } else {
        setVideos(MOCK_VIDEOS);
      }

      const { data: jData } = await supabase.from('jobs_execution').select('*').order('created_at', { ascending: false }).limit(100);
      if (jData && jData.length > 0) {
        setJobs(jData as unknown as AgentJob[]);
      } else {
        setJobs(MOCK_JOBS);
      }

      const { data: cData } = await supabase.from('youtube_comments').select('*').order('created_at', { ascending: false }).limit(50);
      if (cData && cData.length > 0) {
        setComments(cData as unknown as YouTubeComment[]);
      } else {
        setComments(MOCK_COMMENTS);
      }

      const { data: ytData } = await supabase.from('yt_comments').select('*').order('created_at', { ascending: false }).limit(50);
      if (ytData && ytData.length > 0) {
        setYtComments(ytData as unknown as YTComment[]);
      } else {
        setYtComments(MOCK_YT_COMMENTS);
      }

      const { data: viData } = await supabase.from('video_ideas').select('*').order('created_at', { ascending: false }).limit(50);
      if (viData && viData.length > 0) {
        setVideoIdeas(viData as unknown as VideoIdea[]);
      } else {
        setVideoIdeas(MOCK_VIDEO_IDEAS);
      }
    } catch {
      setVideos(MOCK_VIDEOS);
      setJobs(MOCK_JOBS);
      setComments(MOCK_COMMENTS);
      setYtComments(MOCK_YT_COMMENTS);
      setVideoIdeas(MOCK_VIDEO_IDEAS);
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    loadFromSupabase();
  }, [loadFromSupabase]);

  // Realtime subscriptions
  useEffect(() => {
    const jobChannel = supabase
      .channel('video-control-jobs')
      .on('postgres_changes', { event: '*', schema: 'public', table: 'jobs_execution' }, () => {
        loadFromSupabase();
      })
      .subscribe();

    const commentChannel = supabase
      .channel('video-control-comments')
      .on('postgres_changes', { event: 'INSERT', schema: 'public', table: 'youtube_comments' }, () => {
        loadFromSupabase();
      })
      .subscribe();

    // Realtime: detect new leads from yt_comments
    const ytLeadsChannel = supabase
      .channel('video-control-yt-leads')
      .on('postgres_changes', {
        event: 'INSERT', schema: 'public', table: 'yt_comments',
        filter: 'agent_status=eq.lead_detected',
      }, (payload) => {
        const newLead = payload.new as YTComment;
        setYtComments(prev => [newLead, ...prev]);
      })
      .on('postgres_changes', {
        event: 'UPDATE', schema: 'public', table: 'yt_comments',
        filter: 'agent_status=eq.lead_detected',
      }, (payload) => {
        const updatedLead = payload.new as YTComment;
        setYtComments(prev => {
          const idx = prev.findIndex(c => c.id === updatedLead.id);
          if (idx >= 0) {
            const next = [...prev];
            next[idx] = updatedLead;
            return next;
          }
          return [updatedLead, ...prev];
        });
      })
      .subscribe();

    return () => {
      supabase.removeChannel(jobChannel);
      supabase.removeChannel(commentChannel);
      supabase.removeChannel(ytLeadsChannel);
    };
  }, [loadFromSupabase]);

  const selectedVideo = videos.find(v => v.id === selectedVideoId) || videos[0];
  const videoJobs = jobs.filter(j => j.video_id === selectedVideoId);
  const videoComments = comments.filter(c => c.video_id === selectedVideoId);
  const videoYtComments = ytComments.filter(c => c.video_id === selectedVideoId);
  const leadsFromYt = ytComments.filter(c => c.agent_status === 'lead_detected');

  const stats = useMemo(() => {
    const total = videos.length;
    const published = videos.filter(v => v.status === 'published').length;
    const processing = videos.filter(v => v.status === 'processing').length;
    const drafts = videos.filter(v => v.status === 'draft').length;
    const leadComments = leadsFromYt.length;
    const totalJobs = jobs.length;
    const successRate = totalJobs > 0 ? Math.round((jobs.filter(j => j.status === 'success').length / totalJobs) * 100) : 0;
    return { total, published, processing, drafts, leadComments, totalJobs, successRate };
  }, [videos, comments, jobs, leadsFromYt]);

  return {
    videos, jobs: videoJobs, comments: videoComments, ytComments: videoYtComments, videoIdeas, leadsFromYt, loading,
    selectedVideoId, setSelectedVideoId, selectedVideo,
    allVideos: videos, allJobs: jobs, allComments: comments, allYtComments: ytComments,
    stats, refresh: loadFromSupabase,
  };
}

export default function KOSVideoControlCenterPage() {
  const [kosData, setKosData] = useState<any>(null);
  useEffect(() => {
    fetch('/mocks/kos-blog.json').then(r => r.json()).then(setKosData);
  }, []);
  if (!kosData) return null;

  const {
    videos, jobs, comments, ytComments, videoIdeas, leadsFromYt, loading,
    selectedVideoId, setSelectedVideoId, selectedVideo,
    allJobs, allComments, stats, refresh,
  } = useVideoControlCenter();

  const [activeTab, setActiveTab] = useState<'execution' | 'planification' | 'community' | 'analytics' | 'diffusion'>('execution');
  const [scheduleDate, setScheduleDate] = useState('2026-07-15');
  const [scheduleTime, setScheduleTime] = useState('19:00');
  const [selectedCountry, setSelectedCountry] = useState(COUNTRIES[0]);
  const [scheduleFeedback, setScheduleFeedback] = useState<string | null>(null);

  const { runVideoPipeline: dispatchVideo } = useKosDispatch();

  // Local toast system for lead notifications
  const [toasts, setToasts] = useState<Array<{ id: string; lead: YTComment }>>([]);
  useEffect(() => {
    if (leadsFromYt.length === 0) return;
    // Show toast for the most recent undisplayed lead
    const latestLead = leadsFromYt[0];
    const alreadyShown = toasts.find(t => t.lead.id === latestLead.id);
    if (!alreadyShown) {
      const newToast = { id: crypto.randomUUID(), lead: latestLead };
      setToasts(prev => [...prev, newToast]);
      setTimeout(() => {
        setToasts(prev => prev.filter(t => t.id !== newToast.id));
      }, 8000);
    }
  }, [leadsFromYt]);

  const handleSchedule = async () => {
    if (!selectedVideo) return;
    try {
      const localDateTime = scheduleDate + 'T' + scheduleTime + ':00';
      const utcDateTime = zonedTimeToUtc(localDateTime, selectedCountry.tz);

      await supabase.from('videos').update({
        scheduled_at: utcDateTime.toISOString(),
        target_timezone: selectedCountry.tz,
        target_country: selectedCountry.code,
        status: 'scheduled',
      }).eq('id', selectedVideo.id);

      const confirm = formatInTimeZone(utcDateTime, selectedCountry.tz, 'HH:mm zzz');
      setScheduleFeedback(`Planifié pour ${confirm} — ${selectedCountry.flag} ${selectedCountry.name}`);
      setTimeout(() => setScheduleFeedback(null), 5000);
      refresh();
    } catch {
      setScheduleFeedback('Erreur de planification');
      setTimeout(() => setScheduleFeedback(null), 5000);
    }
  };

  const handleDispatchPipeline = async () => {
    if (!selectedVideo) return;
    try {
      await supabase.from('videos').update({ status: 'processing' }).eq('id', selectedVideo.id);

      const result = await dispatchVideo({
        query: selectedVideo.titre || 'Régulation',
        regulateur: selectedVideo.regulateur || 'BCEAO',
        titre: selectedVideo.titre,
      });

      if (result.ok) {
        refresh();
      }
    } catch {
      // silent
    }
  };

  const activePipelineVideo = useMemo(() => {
    return videos.find(v => v.status === 'processing');
  }, [videos]);

  if (loading) {
    return (
      <KOSHubLayout hubId={128}>
        <div className="flex items-center justify-center min-h-[60vh]">
          <div className="text-center">
            <div className="w-12 h-12 rounded-full border-4 border-accent-500 border-t-transparent animate-spin mx-auto mb-4" />
            <p className="text-foreground-600 text-sm">Chargement du Video Control Center...</p>
          </div>
        </div>
      </KOSHubLayout>
    );
  }

  return (
    <KOSHubLayout hubId={128}>
      <SeoHead
        title="KOS Video Control Center™ — Orchestration Pipeline Vidéo Réglementaire | KHEPRA EXPERTS"
        description="Cockpit central de pilotage du pipeline vidéo KOS : exécution agentique temps réel, planification multi-fuseaux, community management YouTube, analytics et diffusion multicanal."
        keywords="KOS Video Control Center, pipeline vidéo, orchestration agentique, YouTube, planification multi-pays, KHEPRA EXPERTS"
        canonicalPath="/kos-regtech-ai/video-control"
        ogType="website"
      />

      {/* Hero */}
      <section className="relative bg-background-100 border-b border-background-200/70">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
          <div className="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
            <div className="max-w-3xl">
              <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-100 text-red-700 text-xs font-semibold mb-4">
                <i className="ri-film-line"></i>KOS Video Control Center™
              </div>
              <h1 className="font-heading text-2xl md:text-3xl font-bold text-foreground-950 tracking-tight">
                Pipeline Vidéo — Orchestration Agentique
              </h1>
              <p className="text-sm md:text-base text-foreground-600 mt-3 max-w-2xl">
                Pilotez l'intégralité du cycle de vie vidéo : veille réglementaire → RAG → fact-check → script → rendu Remotion → SEO → publication YouTube → diffusion multicanal.
              </p>
              <div className="flex flex-wrap gap-2 mt-4">
                <Link to="/kos-regtech-ai/video-pipeline/" className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-accent-500 text-white text-xs font-bold hover:bg-accent-600 transition-colors cursor-pointer whitespace-nowrap">
                  <i className="ri-play-circle-line" />Video Pipeline
                </Link>
                <Link to="/kos-regtech-ai/video-preview/" className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-background-200 text-foreground-700 text-xs font-bold hover:bg-background-300 transition-colors cursor-pointer whitespace-nowrap">
                  <i className="ri-eye-line" />Preview
                </Link>
                <Link to="/kos-social-media-board/" className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-foreground-950 text-background-50 text-xs font-bold hover:bg-foreground-800 transition-colors cursor-pointer whitespace-nowrap">
                  <i className="ri-dashboard-line" />Social Media Board
                </Link>
              </div>
            </div>
            <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
              {[
                { label: 'Vidéos', value: String(stats.total), icon: 'ri-film-line', color: '#FF0000' },
                { label: 'Publiées', value: String(stats.published), icon: 'ri-check-double-line', color: '#059669' },
                { label: 'Succès Jobs', value: stats.successRate + '%', icon: 'ri-pie-chart-line', color: '#7C3AED' },
                { label: 'Leads YT', value: String(stats.leadComments), icon: 'ri-user-star-line', color: '#0A66C2' },
              ].map(card => (
                <div key={card.label} className="rounded-xl bg-white border border-background-200 p-3 text-center">
                  <div className="flex items-center justify-center w-8 h-8 rounded-lg mx-auto mb-1.5" style={{ backgroundColor: card.color + '15' }}>
                    <i className={card.icon + ' text-sm'} style={{ color: card.color }} />
                  </div>
                  <span className="block text-lg font-bold font-heading text-foreground-950">{card.value}</span>
                  <span className="text-[10px] text-foreground-400">{card.label}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      {/* Video Selector Bar */}
      <section className="py-3 bg-background-50 border-b border-background-200/70">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
          <div className="flex items-center gap-2 flex-wrap">
            <span className="text-xs font-bold text-foreground-400 uppercase tracking-wider whitespace-nowrap">
              <i className="ri-movie-line mr-1" />Vidéo :
            </span>
            <select
              value={selectedVideoId}
              onChange={(e) => setSelectedVideoId(e.target.value)}
              className="px-3 py-2 rounded-xl text-sm font-bold border border-background-200 bg-white text-foreground-950 cursor-pointer outline-none"
            >
              {videos.map(v => (
                <option key={v.id} value={v.id}>
                  {v.titre?.substring(0, 60) || 'Sans titre'} — {v.regulateur}
                </option>
              ))}
            </select>
            {selectedVideo && (
              <span className={`inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold ${
                selectedVideo.status === 'published' ? 'bg-emerald-50 text-emerald-700' :
                selectedVideo.status === 'processing' ? 'bg-amber-50 text-amber-700' :
                selectedVideo.status === 'scheduled' ? 'bg-blue-50 text-blue-700' :
                'bg-background-100 text-foreground-500'
              }`}>
                <span className={`w-1.5 h-1.5 rounded-full ${
                  selectedVideo.status === 'published' ? 'bg-emerald-500' :
                  selectedVideo.status === 'processing' ? 'bg-amber-500 animate-pulse' :
                  selectedVideo.status === 'scheduled' ? 'bg-blue-500' : 'bg-gray-400'
                }`} />
                {selectedVideo.status === 'published' ? 'Publié' :
                 selectedVideo.status === 'processing' ? 'En cours' :
                 selectedVideo.status === 'scheduled' ? 'Planifié' : 'Brouillon'}
              </span>
            )}
          </div>
          <div className="flex items-center gap-2">
            <button onClick={refresh} className="flex items-center gap-2 px-4 py-2 rounded-full bg-background-100 text-foreground-700 text-sm font-bold hover:bg-background-200 transition-colors cursor-pointer whitespace-nowrap">
              <i className="ri-refresh-line" />Rafraîchir
            </button>
            <button
              onClick={handleDispatchPipeline}
              disabled={!selectedVideo || selectedVideo.status === 'processing'}
              className="flex items-center gap-2 px-4 py-2 rounded-full bg-accent-500 text-white text-sm font-bold hover:bg-accent-600 transition-colors cursor-pointer whitespace-nowrap disabled:opacity-50 disabled:cursor-not-allowed"
            >
              <i className="ri-play-circle-line" />Dispatcher Pipeline
            </button>
          </div>
        </div>
      </section>

      {/* Tab Navigation */}
      <section className="sticky top-0 z-30 bg-background-50 border-b border-background-200/70">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="flex gap-1 overflow-x-auto py-3">
            {[
              { id: 'execution', label: 'Exécution', icon: 'ri-play-circle-line', count: jobs.length },
              { id: 'planification', label: 'Planification', icon: 'ri-calendar-todo-line', count: videos.filter(v => v.scheduled_at).length },
              { id: 'community', label: 'Community', icon: 'ri-chat-3-line', count: comments.length },
              { id: 'analytics', label: 'Analytics', icon: 'ri-bar-chart-line', count: 'LIVE' },
              { id: 'diffusion', label: 'Diffusion', icon: 'ri-share-line', count: '5 pays' },
            ].map(tab => (
              <button
                key={tab.id}
                onClick={() => setActiveTab(tab.id as typeof activeTab)}
                className={`flex items-center gap-2 px-4 py-2.5 rounded-full text-sm font-bold cursor-pointer whitespace-nowrap transition-all ${
                  activeTab === tab.id
                    ? 'bg-foreground-950 text-background-50'
                    : 'text-foreground-600 hover:bg-background-100 hover:text-foreground-900'
                }`}
              >
                <i className={tab.icon + ' text-base'} />
                {tab.label}
                <span className={`text-[10px] px-1.5 py-0.5 rounded-full ${activeTab === tab.id ? 'bg-white/20' : 'bg-background-200'}`}>
                  {tab.count}
                </span>
              </button>
            ))}
          </div>
        </div>
      </section>

      {/* ═══════════ TAB: EXÉCUTION ═══════════ */}
      {activeTab === 'execution' && (
        <>
          {activePipelineVideo && (
            <section className="py-4 bg-amber-50 border-b border-amber-200">
              <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div className="flex items-center gap-3 p-4 rounded-xl bg-amber-100/50">
                  <span className="w-3 h-3 rounded-full bg-amber-500 animate-pulse flex-shrink-0" />
                  <div className="flex-1">
                    <p className="text-sm font-bold text-amber-900">Pipeline actif : {activePipelineVideo.titre}</p>
                    <p className="text-xs text-amber-700">{jobs.filter(j => j.status === 'running').length} agents en cours · {AGENT_NAMES.find(a => a.key === jobs.find(j => j.status === 'running')?.agent_name)?.label || '...'}</p>
                  </div>
                </div>
              </div>
            </section>
          )}

          <section className="py-8">
            <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
              <div className="mb-6">
                <h2 className="font-heading text-xl font-bold text-foreground-950 flex items-center gap-2">
                  <i className="ri-git-branch-line text-accent-500" />
                  Jobs d'Exécution — {selectedVideo?.titre?.substring(0, 50) || 'Vidéo'}
                </h2>
                <p className="text-sm text-foreground-500 mt-1">
                  Suivi temps réel via Realtime. Chaque agent du pipeline génère un job avec progression et statut.
                </p>
              </div>

              <div className="space-y-2">
                {AGENT_NAMES.map(agent => {
                  const job = jobs.find(j => j.agent_name === agent.key);
                  const status = job?.status || 'pending';
                  const statusStyle = STATUS_STYLES[status];
                  const isRunning = status === 'running';

                  return (
                    <div key={agent.key} className={`rounded-xl border overflow-hidden transition-all ${
                      isRunning ? 'border-amber-300 shadow-sm' : 'border-background-200'
                    }`} style={{ backgroundColor: isRunning ? '#FFFBEB' : '#FFFFFF' }}>
                      <div className="flex items-center gap-4 p-4">
                        <div className={`w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 ${
                          isRunning ? 'animate-pulse' : ''
                        }`} style={{ backgroundColor: agent.color + '15' }}>
                          <i className={agent.icon + ' text-lg'} style={{ color: agent.color }} />
                        </div>

                        <div className="flex-1 min-w-0">
                          <div className="flex items-center gap-2 flex-wrap">
                            <p className="text-sm font-bold text-foreground-950 capitalize">{agent.label}</p>
                            <span className={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold ${statusStyle.bg} ${statusStyle.text}`}>
                              <span className={`w-1.5 h-1.5 rounded-full ${statusStyle.dot} ${isRunning ? 'animate-pulse' : ''}`} />
                              {status === 'success' ? 'OK' : status === 'running' ? 'En cours' : status === 'error' ? 'Échec' : status === 'human_review' ? 'Review' : 'En attente'}
                            </span>
                            {job?.started_at && (
                              <span className="text-[10px] text-foreground-400">
                                {new Date(job.started_at).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit', second: '2-digit' })}
                              </span>
                            )}
                          </div>
                          <p className="text-xs text-foreground-500 mt-0.5">{job?.message || 'En attente de dispatch'}</p>

                          {/* Progress bar */}
                          <div className="w-full h-1.5 rounded-full bg-background-200 mt-2 overflow-hidden">
                            <div
                              className={`h-full rounded-full transition-all duration-700 ${isRunning ? 'animate-pulse' : ''}`}
                              style={{
                                width: `${job?.progress_pct || 0}%`,
                                backgroundColor: status === 'success' ? '#059669' : status === 'error' ? '#DC2626' : isRunning ? '#F59E0B' : '#9CA3AF',
                              }}
                            />
                          </div>
                        </div>

                        <div className="text-right flex-shrink-0 min-w-[60px]">
                          <span className={`text-lg font-bold font-heading ${
                            status === 'success' ? 'text-emerald-600' : status === 'error' ? 'text-red-600' : isRunning ? 'text-amber-600' : 'text-foreground-300'
                          }`}>
                            {job?.progress_pct || 0}%
                          </span>
                          {job?.ended_at && (
                            <p className="text-[10px] text-foreground-400">
                              {((new Date(job.ended_at).getTime() - new Date(job.started_at!).getTime()) / 1000).toFixed(1)}s
                            </p>
                          )}
                        </div>
                      </div>
                    </div>
                  );
                })}
              </div>

              {jobs.length === 0 && (
                <div className="rounded-2xl bg-white border border-background-200 p-12 text-center">
                  <div className="w-16 h-16 rounded-2xl bg-background-100 flex items-center justify-center mx-auto mb-4">
                    <i className="ri-inbox-line text-2xl text-foreground-300" />
                  </div>
                  <h3 className="font-heading text-lg font-bold text-foreground-950 mb-2">Aucun job d'exécution</h3>
                  <p className="text-sm text-foreground-500 mb-4">Cliquez sur "Dispatcher Pipeline" pour lancer le pipeline vidéo.</p>
                </div>
              )}
            </div>
          </section>
        </>
      )}

      {/* ═══════════ TAB: PLANIFICATION ═══════════ */}
      {activeTab === 'planification' && (
        <section className="py-8">
          <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div className="grid grid-cols-1 lg:grid-cols-3 gap-8">
              {/* Schedule Form */}
              <div className="lg:col-span-1">
                <div className="rounded-2xl bg-white border border-background-200 p-6 sticky top-24">
                  <h2 className="font-heading text-lg font-bold text-foreground-950 mb-4 flex items-center gap-2">
                    <i className="ri-calendar-todo-line text-accent-500" />
                    Planifier la Publication
                  </h2>
                  <p className="text-sm text-foreground-500 mb-6">
                    Choisissez le pays cible, la date et l'heure locale pour maximiser l'audience.
                  </p>

                  {/* Country selector */}
                  <label className="text-xs font-bold text-foreground-400 uppercase tracking-wider mb-2 block">
                    Audience cible
                  </label>
                  <div className="grid grid-cols-2 gap-2 mb-4">
                    {COUNTRIES.map(c => (
                      <button
                        key={c.code}
                        onClick={() => setSelectedCountry(c)}
                        className={`flex items-center gap-2 p-3 rounded-xl text-sm font-bold cursor-pointer transition-all whitespace-nowrap ${
                          selectedCountry.code === c.code
                            ? 'bg-accent-500 text-white'
                            : 'bg-background-100 text-foreground-700 hover:bg-background-200'
                        }`}
                      >
                        <span className="text-lg">{c.flag}</span>
                        <span className="text-xs">{c.name}</span>
                      </button>
                    ))}
                  </div>

                  {/* Date picker */}
                  <label className="text-xs font-bold text-foreground-400 uppercase tracking-wider mb-2 block">
                    Date (locale)
                  </label>
                  <input
                    type="date"
                    value={scheduleDate}
                    onChange={(e) => setScheduleDate(e.target.value)}
                    className="w-full px-4 py-2.5 rounded-xl text-sm border border-background-200 bg-white text-foreground-950 outline-none mb-4 cursor-pointer"
                  />

                  {/* Time picker */}
                  <label className="text-xs font-bold text-foreground-400 uppercase tracking-wider mb-2 block">
                    Heure ({selectedCountry.tz})
                  </label>
                  <input
                    type="time"
                    value={scheduleTime}
                    onChange={(e) => setScheduleTime(e.target.value)}
                    className="w-full px-4 py-2.5 rounded-xl text-sm border border-background-200 bg-white text-foreground-950 outline-none mb-4 cursor-pointer"
                  />

                  {/* Confirmation */}
                  <div className="rounded-xl bg-background-100 p-3 mb-4">
                    <p className="text-xs text-foreground-500">
                      Heure sélectionnée : <span className="font-bold text-foreground-950">{scheduleTime}</span> ({selectedCountry.tz})
                    </p>
                    <p className="text-xs text-foreground-400 mt-0.5">
                      {selectedCountry.flag} {selectedCountry.name} — GMT{selectedCountry.tz.includes('Paris') || selectedCountry.tz.includes('Toronto') ? '+0/+2' : '+0'}
                    </p>
                  </div>

                  <button
                    onClick={handleSchedule}
                    disabled={!selectedVideo}
                    className="w-full flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-accent-500 text-white text-sm font-bold hover:bg-accent-600 transition-colors cursor-pointer whitespace-nowrap disabled:opacity-50 disabled:cursor-not-allowed"
                  >
                    <i className="ri-send-plane-line" />
                    Planifier la Publication
                  </button>

                  {scheduleFeedback && (
                    <div className="mt-3 p-3 rounded-xl bg-emerald-50 border border-emerald-200">
                      <p className="text-xs text-emerald-700 flex items-center gap-1.5">
                        <i className="ri-check-line" />{scheduleFeedback}
                      </p>
                    </div>
                  )}
                </div>
              </div>

              {/* Slots reference */}
              <div className="lg:col-span-2">
                <h2 className="font-heading text-xl font-bold text-foreground-950 mb-4 flex items-center gap-2">
                  <i className="ri-time-line text-primary-500" />
                  Créneaux de Publication Recommandés
                </h2>
                <p className="text-sm text-foreground-500 mb-6">
                  Basés sur les audiences LinkedIn et YouTube de KHEPRA EXPERTS dans chaque fuseau horaire.
                </p>
                <div className="space-y-3">
                  {COUNTRIES.map(country => (
                    <div key={country.code} className="rounded-xl bg-white border border-background-200 overflow-hidden">
                      <div className="p-4 flex items-center gap-4" style={{ backgroundColor: country.color + '08' }}>
                        <div className="w-12 h-12 rounded-xl flex items-center justify-center text-2xl" style={{ backgroundColor: country.color + '15' }}>
                          {country.flag}
                        </div>
                        <div className="flex-1">
                          <h3 className="font-bold text-foreground-950">{country.name}</h3>
                          <p className="text-xs text-foreground-400">{country.tz}</p>
                        </div>
                        <div className="text-right">
                          <span className="inline-flex items-center gap-1 px-3 py-1.5 rounded-full bg-emerald-50 text-emerald-700 text-xs font-bold">
                            <i className="ri-check-line" />
                            {country.code === 'SN' ? '19:00 — Prime Time' :
                             country.code === 'CI' ? '12:30 — Pause Déj' :
                             country.code === 'CM' ? '20:00 — Prime CEMAC' :
                             country.code === 'FR' ? '08:00 — Matinée' : '14:00 — Après-midi'}
                          </span>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>

                {/* Scheduled videos */}
                <h2 className="font-heading text-xl font-bold text-foreground-950 mt-8 mb-4 flex items-center gap-2">
                  <i className="ri-timer-flash-line text-accent-500" />
                  Vidéos Planifiées
                </h2>
                {videos.filter(v => v.scheduled_at).length === 0 ? (
                  <div className="rounded-xl bg-white border border-background-200 p-8 text-center">
                    <i className="ri-calendar-line text-3xl text-foreground-300 mb-2 block" />
                    <p className="text-sm text-foreground-500">Aucune vidéo planifiée</p>
                  </div>
                ) : (
                  <div className="space-y-2">
                    {videos.filter(v => v.scheduled_at).map(v => {
                      const country = COUNTRIES.find(c => c.code === v.target_country);
                      let localTime = '';
                      try {
                        localTime = v.scheduled_at && v.target_timezone
                          ? formatInTimeZone(new Date(v.scheduled_at), v.target_timezone, 'dd/MM/yyyy HH:mm zzz')
                          : '';
                      } catch { localTime = v.scheduled_at || ''; }
                      return (
                        <div key={v.id} className="flex items-center gap-4 p-4 rounded-xl bg-white border border-background-200">
                          <div className="w-10 h-10 rounded-xl bg-blue-100 flex items-center justify-center flex-shrink-0">
                            <i className="ri-calendar-check-line text-blue-600" />
                          </div>
                          <div className="flex-1 min-w-0">
                            <p className="text-sm font-bold text-foreground-950 truncate">{v.titre}</p>
                            <p className="text-xs text-foreground-400">{localTime} {country ? country.flag : ''}</p>
                          </div>
                          <span className="px-2.5 py-1 rounded-full text-[10px] font-bold bg-blue-50 text-blue-700">
                            Planifié
                          </span>
                        </div>
                      );
                    })}
                  </div>
                )}
              </div>
            </div>
          </div>
        </section>
      )}

      {/* ═══════════ TAB: COMMUNITY ═══════════ */}
      {activeTab === 'community' && (
        <section className="py-8">
          <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div className="flex items-center justify-between mb-6">
              <div>
                <h2 className="font-heading text-xl font-bold text-foreground-950 flex items-center gap-2">
                  <i className="ri-chat-3-line text-blue-500" />
                  Community Management YouTube
                </h2>
                <p className="text-sm text-foreground-500 mt-1">
                  Commentaires classifiés par IA (LEAD / QUESTION / COMPLIMENT / SPAM). Réponses automatiques pour les questions, création contacts HubSpot pour les leads.
                </p>
              </div>
              <div className="flex items-center gap-3">
                <span className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-emerald-50 text-emerald-700 text-xs font-bold">
                  <span className="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse" />
                  Realtime actif
                </span>
              </div>
            </div>

            {/* Leads Panel — YT Community Agent */}
            {leadsFromYt.length > 0 && (
              <div className="mb-6 rounded-2xl bg-gradient-to-r from-emerald-50 to-emerald-100/50 border border-emerald-200 overflow-hidden">
                <div className="p-5">
                  <div className="flex items-center gap-3 mb-4">
                    <div className="w-10 h-10 rounded-xl bg-emerald-500 flex items-center justify-center">
                      <i className="ri-user-star-line text-white text-lg" />
                    </div>
                    <div>
                      <h3 className="font-heading text-lg font-bold text-emerald-900">
                        Leads Générés par l'Agent Community
                      </h3>
                      <p className="text-sm text-emerald-700">
                        {leadsFromYt.length} lead{leadsFromYt.length > 1 ? 's' : ''} détecté{leadsFromYt.length > 1 ? 's' : ''} et créé{leadsFromYt.length > 1 ? 's' : ''} dans HubSpot
                      </p>
                    </div>
                    <span className="ml-auto px-3 py-1.5 rounded-full bg-emerald-500 text-white text-xs font-bold">
                      {leadsFromYt.length} 🔥
                    </span>
                  </div>
                  <div className="space-y-2 max-h-80 overflow-y-auto">
                    {leadsFromYt.map(lead => (
                      <div key={lead.id} className="flex items-start gap-3 p-3 rounded-xl bg-white/80 border border-emerald-200/50">
                        <div className="w-9 h-9 rounded-full bg-emerald-500 flex items-center justify-center flex-shrink-0 mt-0.5">
                          <span className="text-white text-xs font-bold">
                            {lead.author_display_name?.charAt(0).toUpperCase() || '?'}
                          </span>
                        </div>
                        <div className="flex-1 min-w-0">
                          <div className="flex items-center gap-2 flex-wrap mb-1">
                            <span className="font-bold text-sm text-foreground-950">{lead.author_display_name}</span>
                            <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-700 text-[10px] font-bold">
                              <i className="ri-user-star-line" />LEAD
                            </span>
                          </div>
                          <p className="text-xs text-foreground-600 line-clamp-2">{lead.text_original}</p>
                          {lead.agent_reply && (
                            <p className="text-xs text-emerald-600 mt-1 italic line-clamp-1">{lead.agent_reply}</p>
                          )}
                          {lead.hubspot_lead_id && (
                            <span className="inline-flex items-center gap-1 mt-1.5 text-[10px] text-emerald-500 font-mono">
                              <i className="ri-link" />HubSpot: {lead.hubspot_lead_id}
                            </span>
                          )}
                        </div>
                        <span className="text-[10px] text-foreground-400 flex-shrink-0 whitespace-nowrap">
                          {new Date(lead.published_at).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })}
                        </span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            )}

            {/* YT Community Agent — Comments from yt_comments table */}
            {ytComments.length > 0 && (
              <div className="mb-6">
                <h3 className="font-heading text-base font-bold text-foreground-950 mb-3 flex items-center gap-2">
                  <i className="ri-robot-line text-blue-500" />
                  Agent Community — Derniers commentaires traités
                </h3>
                <div className="space-y-2">
                  {ytComments.map(c => {
                    const isLead = c.agent_status === 'lead_detected';
                    const isReplied = c.agent_status === 'replied';
                    const isIgnored = c.agent_status === 'ignored';
                    return (
                      <div key={c.id} className={`rounded-xl bg-white border-l-4 overflow-hidden ${
                        isLead ? 'border-emerald-500' : isReplied ? 'border-blue-400' : isIgnored ? 'border-red-400' : 'border-background-300'
                      }`}>
                        <div className="p-4">
                          <div className="flex items-start justify-between gap-4">
                            <div className="flex-1 min-w-0">
                              <div className="flex items-center gap-2 flex-wrap mb-2">
                                <div className={`w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold text-white ${
                                  isLead ? 'bg-emerald-500' : isIgnored ? 'bg-red-500' : 'bg-blue-500'
                                }`}>
                                  {c.author_display_name?.charAt(0).toUpperCase() || '?'}
                                </div>
                                <span className="font-bold text-sm text-foreground-950">{c.author_display_name}</span>
                                <span className={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold ${
                                  isLead ? 'bg-emerald-50 text-emerald-700' :
                                  isReplied ? 'bg-blue-50 text-blue-700' :
                                  isIgnored ? 'bg-red-50 text-red-700' : 'bg-background-100 text-foreground-500'
                                }`}>
                                  <span className={`w-1.5 h-1.5 rounded-full ${
                                    isLead ? 'bg-emerald-500' : isReplied ? 'bg-blue-500' : isIgnored ? 'bg-red-500' : 'bg-gray-400'
                                  }`} />
                                  {isLead ? 'Lead détecté' : isReplied ? 'Répondu' : isIgnored ? 'Ignoré' : 'En attente'}
                                </span>
                              </div>
                              <p className="text-sm text-foreground-800 leading-relaxed">{c.text_original}</p>
                              {c.agent_reply && (
                                <div className="mt-2 p-3 rounded-lg bg-blue-50 border border-blue-100">
                                  <p className="text-xs text-blue-600 font-medium mb-1 flex items-center gap-1">
                                    <i className="ri-robot-line" />Réponse Agent Community
                                  </p>
                                  <p className="text-sm text-blue-800">{c.agent_reply}</p>
                                </div>
                              )}
                              {c.hubspot_lead_id && (
                                <span className="inline-flex items-center gap-1 mt-2 text-[10px] text-emerald-600 font-mono">
                                  <i className="ri-link" />HubSpot: {c.hubspot_lead_id}
                                </span>
                              )}
                            </div>
                          </div>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            )}

            {/* Video Ideas from recurrent questions */}
            {videoIdeas.length > 0 && (
              <div className="mb-6">
                <h3 className="font-heading text-base font-bold text-foreground-950 mb-3 flex items-center gap-2">
                  <i className="ri-lightbulb-line text-amber-500" />
                  Idées de Vidéos (Questions Récurrentes)
                </h3>
                <div className="space-y-2">
                  {videoIdeas.map(idea => (
                    <div key={idea.id} className="flex items-center gap-3 p-3 rounded-xl bg-amber-50 border border-amber-200">
                      <div className="w-9 h-9 rounded-lg bg-amber-200 flex items-center justify-center flex-shrink-0">
                        <i className="ri-lightbulb-line text-amber-600" />
                      </div>
                      <div className="flex-1 min-w-0">
                        <p className="text-sm font-medium text-foreground-900">{idea.question}</p>
                        <p className="text-xs text-foreground-400">Source: {idea.source === 'youtube_comment' ? 'Commentaire YouTube' : idea.source}</p>
                      </div>
                      <span className={`inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-bold ${
                        idea.status === 'planned' ? 'bg-blue-50 text-blue-700' :
                        idea.status === 'done' ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700'
                      }`}>
                        {idea.status === 'planned' ? 'Planifiée' : idea.status === 'done' ? 'Réalisée' : 'Backlog'}
                      </span>
                      {idea.priority === 'high' && (
                        <span className="px-1.5 py-0.5 rounded text-[10px] font-bold bg-red-50 text-red-600">Prioritaire</span>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* Classic YouTube comments section */}
            <h3 className="font-heading text-base font-bold text-foreground-950 mb-3 flex items-center gap-2">
              <i className="ri-youtube-fill text-red-500" />
              Commentaires YouTube Classifiés
            </h3>
            {comments.length === 0 ? (
              <div className="rounded-2xl bg-white border border-background-200 p-12 text-center">
                <div className="w-16 h-16 rounded-2xl bg-background-100 flex items-center justify-center mx-auto mb-4">
                  <i className="ri-chat-off-line text-2xl text-foreground-300" />
                </div>
                <h3 className="font-heading text-lg font-bold text-foreground-950 mb-2">Aucun commentaire</h3>
                <p className="text-sm text-foreground-500">Les commentaires YouTube apparaîtront ici en temps réel après publication.</p>
              </div>
            ) : (
              <div className="space-y-3">
                {comments.map(c => {
                  const classStyle = c.classification ? CLASSIFICATION_STYLES[c.classification] : CLASSIFICATION_STYLES.QUESTION;
                  return (
                    <div key={c.id} className={`rounded-xl bg-white border-l-4 overflow-hidden ${classStyle.border}`}>
                      <div className="p-4">
                        <div className="flex items-start justify-between gap-4">
                          <div className="flex-1 min-w-0">
                            <div className="flex items-center gap-2 flex-wrap mb-2">
                              <div className="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold text-white" style={{ backgroundColor: c.classification === 'LEAD' ? '#059669' : c.classification === 'SPAM' ? '#DC2626' : '#3B82F6' }}>
                                {c.author_display_name?.charAt(0).toUpperCase() || '?'}
                              </div>
                              <span className="font-bold text-sm text-foreground-950">{c.author_display_name}</span>
                              {c.classification && (
                                <span className={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold ${classStyle.bg} ${classStyle.text}`}>
                                  {classStyle.label}
                                </span>
                              )}
                              <span className="text-[10px] text-foreground-400">
                                {new Date(c.published_at).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })}
                              </span>
                            </div>

                            <p className="text-sm text-foreground-800 leading-relaxed whitespace-pre-wrap">{c.text_original}</p>

                            {c.llm_reply && (
                              <div className="mt-3 p-3 rounded-lg bg-blue-50 border border-blue-100">
                                <p className="text-xs text-blue-600 font-medium mb-1 flex items-center gap-1">
                                  <i className="ri-robot-line" />Réponse IA
                                </p>
                                <p className="text-sm text-blue-800">{c.llm_reply}</p>
                                {c.reply_posted && (
                                  <span className="inline-flex items-center gap-1 mt-2 text-[10px] text-emerald-600 font-bold">
                                    <i className="ri-check-line" />Réponse postée sur YouTube
                                  </span>
                                )}
                              </div>
                            )}

                            {c.hubspot_contact_id && (
                              <div className="mt-3 p-3 rounded-lg bg-emerald-50 border border-emerald-100">
                                <p className="text-xs text-emerald-600 font-medium flex items-center gap-1">
                                  <i className="ri-user-star-line" />Lead créé dans HubSpot
                                </p>
                                <p className="text-[10px] text-emerald-500 font-mono mt-0.5">{c.hubspot_contact_id}</p>
                              </div>
                            )}
                          </div>

                          <div className="flex items-center gap-1 text-foreground-400 flex-shrink-0">
                            <i className="ri-heart-line text-xs" />
                            <span className="text-xs">{c.like_count}</span>
                          </div>
                        </div>
                      </div>
                    </div>
                  );
                })}
              </div>
            )}
          </div>
        </section>
      )}

      {/* ═══════════ TAB: ANALYTICS ═══════════ */}
      {activeTab === 'analytics' && (
        <section className="py-8">
          <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 className="font-heading text-xl font-bold text-foreground-950 mb-6 flex items-center gap-2">
              <i className="ri-bar-chart-line text-accent-500" />
              Analytics — Pipeline Vidéo
            </h2>

            {/* Global stats */}
            <div className="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
              {[
                { label: 'Total Vidéos', value: stats.total, sub: 'production', icon: 'ri-film-line', color: '#FF0000' },
                { label: 'Taux Succès Jobs', value: stats.successRate + '%', sub: stats.totalJobs + ' jobs', icon: 'ri-check-double-line', color: '#059669' },
                { label: 'Leads Générés', value: stats.leadComments, sub: 'depuis YouTube', icon: 'ri-user-star-line', color: '#0A66C2' },
                { label: 'En Production', value: stats.processing, sub: 'vidéos actives', icon: 'ri-loader-4-line', color: '#D97706' },
              ].map(stat => (
                <div key={stat.label} className="rounded-xl bg-white border border-background-200 p-5">
                  <div className="flex items-center gap-2 mb-3">
                    <div className="w-10 h-10 rounded-xl flex items-center justify-center" style={{ backgroundColor: stat.color + '15' }}>
                      <i className={stat.icon + ' text-lg'} style={{ color: stat.color }} />
                    </div>
                  </div>
                  <span className="text-3xl font-bold font-heading text-foreground-950">{stat.value}</span>
                  <p className="text-sm font-bold text-foreground-700 mt-1">{stat.label}</p>
                  <p className="text-xs text-foreground-400">{stat.sub}</p>
                </div>
              ))}
            </div>

            {/* Agent Performance */}
            <div className="rounded-2xl bg-white border border-background-200 p-6 mb-6">
              <h3 className="font-heading text-lg font-bold text-foreground-950 mb-4">Performance par Agent</h3>
              <div className="space-y-3">
                {AGENT_NAMES.map(agent => {
                  const agentJobs = allJobs.filter(j => j.agent_name === agent.key);
                  const successCount = agentJobs.filter(j => j.status === 'success').length;
                  const rate = agentJobs.length > 0 ? Math.round((successCount / agentJobs.length) * 100) : 0;
                  const avgDuration = agentJobs.filter(j => j.ended_at && j.started_at).reduce((sum, j) => {
                    return sum + (new Date(j.ended_at!).getTime() - new Date(j.started_at!).getTime());
                  }, 0) / (agentJobs.filter(j => j.ended_at && j.started_at).length || 1);

                  return (
                    <div key={agent.key} className="flex items-center gap-4 p-3 rounded-xl bg-background-50">
                      <div className="w-9 h-9 rounded-lg flex items-center justify-center flex-shrink-0" style={{ backgroundColor: agent.color + '15' }}>
                        <i className={agent.icon + ' text-sm'} style={{ color: agent.color }} />
                      </div>
                      <div className="flex-1 min-w-0">
                        <p className="text-sm font-bold text-foreground-950">{agent.label}</p>
                        <p className="text-xs text-foreground-400">{agentJobs.length} exécutions</p>
                      </div>
                      <div className="w-32 h-2 rounded-full bg-background-200 overflow-hidden flex-shrink-0">
                        <div className="h-full rounded-full transition-all" style={{ width: rate + '%', backgroundColor: agent.color }} />
                      </div>
                      <span className="text-sm font-bold text-foreground-950 min-w-[45px] text-right">{rate}%</span>
                      <span className="text-xs text-foreground-400 min-w-[70px] text-right">{(avgDuration / 1000).toFixed(1)}s moy</span>
                    </div>
                  );
                })}
              </div>
            </div>

            {/* Video Pipeline Funnel */}
            <div className="rounded-2xl bg-white border border-background-200 p-6">
              <h3 className="font-heading text-lg font-bold text-foreground-950 mb-4">Funnel Pipeline Vidéo</h3>
              <div className="flex items-end gap-2 h-64">
                {[
                  { label: 'Brouillons', value: stats.drafts, color: '#9CA3AF' },
                  { label: 'En cours', value: stats.processing, color: '#F59E0B' },
                  { label: 'Planifiées', value: videos.filter(v => v.status === 'scheduled').length, color: '#3B82F6' },
                  { label: 'Publiées', value: stats.published, color: '#059669' },
                ].map((step, i) => {
                  const maxVal = Math.max(stats.drafts, stats.processing, videos.filter(v => v.status === 'scheduled').length, stats.published, 1);
                  const height = maxVal > 0 ? (step.value / maxVal) * 200 : 0;
                  return (
                    <div key={step.label} className="flex-1 flex flex-col items-center gap-2">
                      <span className="text-2xl font-bold font-heading text-foreground-950">{step.value}</span>
                      <div className="w-full rounded-t-xl transition-all" style={{ height: Math.max(height, 8) + 'px', backgroundColor: step.color + '30', borderTop: '3px solid ' + step.color }} />
                      <span className="text-[10px] font-bold text-foreground-400 uppercase">{step.label}</span>
                    </div>
                  );
                })}
              </div>
            </div>
          </div>
        </section>
      )}

      {/* ═══════════ TAB: DIFFUSION ═══════════ */}
      {activeTab === 'diffusion' && (
        <section className="py-8">
          <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 className="font-heading text-xl font-bold text-foreground-950 mb-4 flex items-center gap-2">
              <i className="ri-share-line text-accent-500" />
              Diffusion Multicanal
            </h2>
            <p className="text-sm text-foreground-500 mb-8">
              Une fois la vidéo publiée sur YouTube, elle est automatiquement diffusée sur les réseaux configurés.
            </p>

            <div className="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
              {[
                { name: 'YouTube', icon: 'ri-youtube-fill', color: '#FF0000', desc: 'Publication principale + SEO + Thumbnail', status: 'primary' },
                { name: 'LinkedIn', icon: 'ri-linkedin-fill', color: '#0A66C2', desc: 'Post avec extrait + lien vidéo + hashtags', status: 'auto' },
                { name: 'X / Twitter', icon: 'ri-twitter-x-fill', color: '#1A1A1A', desc: 'Thread 3 tweets + clip 30s + lien', status: 'auto' },
                { name: 'Facebook', icon: 'ri-facebook-fill', color: '#1877F2', desc: 'Post page KHEPRA EXPERTS + lien', status: 'auto' },
                { name: 'Instagram', icon: 'ri-instagram-line', color: '#E4405F', desc: 'Reel 30s + Story + lien bio', status: 'manual' },
                { name: 'YouTube Community', icon: 'ri-chat-smile-2-line', color: '#FF0000', desc: 'Post communauté avec sondage', status: 'auto' },
              ].map(channel => (
                <div key={channel.name} className="rounded-2xl bg-white border border-background-200 p-5 hover:border-background-300 transition-all">
                  <div className="flex items-center gap-3 mb-3">
                    <div className="w-11 h-11 rounded-xl flex items-center justify-center" style={{ backgroundColor: channel.color + '15' }}>
                      <i className={channel.icon + ' text-xl'} style={{ color: channel.color }} />
                    </div>
                    <div>
                      <h3 className="font-bold text-foreground-950">{channel.name}</h3>
                      <span className={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold ${
                        channel.status === 'primary' ? 'bg-red-50 text-red-700' :
                        channel.status === 'auto' ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700'
                      }`}>
                        {channel.status === 'primary' ? 'Principal' : channel.status === 'auto' ? 'Auto' : 'Manuel'}
                      </span>
                    </div>
                  </div>
                  <p className="text-xs text-foreground-500">{channel.desc}</p>
                </div>
              ))}
            </div>

            {/* Dispatched videos */}
            <div className="rounded-2xl bg-white border border-background-200 p-6">
              <h3 className="font-heading text-lg font-bold text-foreground-950 mb-4">Vidéos Publiées & Diffusées</h3>
              {videos.filter(v => v.status === 'published').length === 0 ? (
                <p className="text-sm text-foreground-500 text-center py-8">Aucune vidéo publiée pour le moment</p>
              ) : (
                <div className="space-y-2">
                  {videos.filter(v => v.status === 'published').map(v => (
                    <div key={v.id} className="flex items-center gap-4 p-4 rounded-xl bg-background-50">
                      <div className="w-10 h-10 rounded-xl bg-red-100 flex items-center justify-center flex-shrink-0">
                        <i className="ri-check-double-line text-red-600" />
                      </div>
                      <div className="flex-1 min-w-0">
                        <p className="text-sm font-bold text-foreground-950 truncate">{v.titre}</p>
                        <p className="text-xs text-foreground-400">
                          Publié le {v.published_at ? new Date(v.published_at).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) : '—'}
                          {v.target_country && COUNTRIES.find(c => c.code === v.target_country) ? ` · ${COUNTRIES.find(c => c.code === v.target_country)?.flag} ${COUNTRIES.find(c => c.code === v.target_country)?.name}` : ''}
                        </p>
                      </div>
                      {v.video_url && (
                        <a href={v.video_url} target="_blank" rel="noopener noreferrer" className="text-xs underline text-foreground-500 hover:text-foreground-950 flex-shrink-0 whitespace-nowrap">
                          <i className="ri-external-link-line mr-1" />Voir
                        </a>
                      )}
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        </section>
      )}

      {/* Lead Notification Toasts */}
      <div className="fixed bottom-6 right-6 z-50 flex flex-col gap-3 max-w-sm">
        {toasts.map(toast => (
          <div key={toast.id} className="flex items-start gap-3 px-4 py-3 rounded-xl shadow-lg border bg-white animate-slide-up">
            <div className="w-10 h-10 rounded-full bg-emerald-500 flex items-center justify-center flex-shrink-0">
              <span className="text-white text-sm font-bold">
                {toast.lead.author_display_name?.charAt(0).toUpperCase() || '?'}
              </span>
            </div>
            <div className="flex-1 min-w-0">
              <p className="text-sm font-bold text-foreground-950 flex items-center gap-2">
                <i className="ri-user-star-line text-emerald-500" />
                Nouveau Lead YouTube !
              </p>
              <p className="text-xs font-semibold text-foreground-700 mt-0.5">{toast.lead.author_display_name}</p>
              <p className="text-xs text-foreground-500 mt-0.5 line-clamp-2">{toast.lead.text_original}</p>
              {toast.lead.hubspot_lead_id && (
                <span className="inline-flex items-center gap-1 mt-1.5 text-[10px] text-emerald-600 font-mono">
                  <i className="ri-link" />Créé dans HubSpot
                </span>
              )}
            </div>
            <button
              onClick={() => setToasts(prev => prev.filter(t => t.id !== toast.id))}
              className="w-5 h-5 flex items-center justify-center flex-shrink-0 rounded hover:bg-background-100 transition-colors cursor-pointer"
            >
              <i className="ri-close-line text-foreground-400 text-sm" />
            </button>
          </div>
        ))}
      </div>

      {/* Footer CTA */}
      <section className="py-12 sm:py-16 bg-foreground-950 relative overflow-hidden">
        <div className="absolute inset-0 bg-gradient-to-r from-foreground-950/90 to-foreground-950/70" />
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
          <div className="flex flex-col lg:flex-row items-center justify-between gap-8">
            <div className="max-w-xl">
              <div className="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-red-500/20 border border-red-400/30 backdrop-blur-sm mb-4">
                <i className="ri-film-line text-red-400 text-sm" />
                <span className="text-sm font-semibold text-red-300 uppercase tracking-wider">KOS Video Control Center — Mode Full Auto</span>
              </div>
              <h2 className="font-heading text-3xl sm:text-4xl font-bold text-white mb-4">
                Pilotez votre pipeline vidéo de bout en bout
              </h2>
              <p className="text-gray-300 leading-relaxed mb-6">
                De la veille réglementaire jusqu'à la diffusion sur 5 pays, en passant par le community management automatisé. Un seul cockpit, 9 agents, 0 friction.
              </p>
              <div className="flex flex-wrap gap-2">
                {['9 agents', '8 étapes', '6 pays', 'Realtime', 'Multi-langues'].map(tag => (
                  <span key={tag} className="inline-flex items-center gap-1 px-3 py-1.5 rounded-full bg-white/10 border border-white/20 text-white text-xs">
                    <i className="ri-check-line text-emerald-400" />{tag}
                  </span>
                ))}
              </div>
            </div>
            <Link to="/kos-regtech-ai/video-pipeline/" className="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-accent-500 text-white font-bold text-sm hover:bg-accent-400 transition-all cursor-pointer whitespace-nowrap">
              <i className="ri-send-plane-line" />Lancer un Pipeline
            </Link>
          </div>
        </div>
      </section>
    </KOSHubLayout>
  );
}
