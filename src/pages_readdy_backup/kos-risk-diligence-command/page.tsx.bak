import { useState, useMemo } from 'react';
import KOSHubLayout from '@/components/feature/KOSHubLayout';
import {
  dueDiligenceReportsMock,
  riskRegistersMock,
  internalControlsMock,
  enterpriseRiskAnalyticsMock,
} from '@/mocks/kosRiskDiligence';

type Tab = 'due-diligence' | 'risk-engine' | 'internal-control' | 'enterprise-analytics';

export default function KOSRiskDiligenceCommandPage() {
  const [kosData, setKosData] = useState<any>(null);
  useEffect(() => {
    fetch('/mocks/kos-blog.json').then(r => r.json()).then(setKosData);
  }, []);
  if (!kosData) return null;

  const [activeTab, setActiveTab] = useState<Tab>('due-diligence');
  const [selectedDD, setSelectedDD] = useState(dueDiligenceReportsMock[0]);
  const [selectedRisk, setSelectedRisk] = useState(riskRegistersMock[0]);
  const [selectedControl, setSelectedControl] = useState(internalControlsMock[0]);
  const [heatmapHovered, setHeatmapHovered] = useState<string | null>(null);

  const getRatingColor = (rating: string) => {
    if (rating.startsWith('A')) return { bg: 'bg-emerald-100', text: 'text-emerald-700', border: 'border-emerald-200' };
    if (rating.startsWith('B')) return { bg: 'bg-amber-100', text: 'text-amber-700', border: 'border-amber-200' };
    if (rating.startsWith('C')) return { bg: 'bg-orange-100', text: 'text-orange-700', border: 'border-orange-200' };
    return { bg: 'bg-red-100', text: 'text-red-700', border: 'border-red-200' };
  };

  const getScoreColorClass = (score: number) => {
    if (score >= 75) return 'text-emerald-600';
    if (score >= 60) return 'text-amber-600';
    if (score >= 40) return 'text-orange-600';
    return 'text-red-600';
  };

  const getScoreBgClass = (score: number) => {
    if (score >= 75) return 'bg-emerald-500';
    if (score >= 60) return 'bg-amber-500';
    if (score >= 40) return 'bg-orange-500';
    return 'bg-red-500';
  };

  const getRecoBadge = (rec: string) => {
    const map: Record<string, { bg: string; text: string; label: string }> = {
      recommended: { bg: 'bg-emerald-100', text: 'text-emerald-700', label: 'Recommandé' },
      conditional_approval: { bg: 'bg-amber-100', text: 'text-amber-700', label: 'Approbation conditionnelle' },
      not_recommended: { bg: 'bg-red-100', text: 'text-red-700', label: 'Non recommandé' },
    };
    return map[rec] || { bg: 'bg-background-100', text: 'text-foreground-600', label: rec };
  };

  const getEffectivenessStyles = (level: string) => {
    const map: Record<string, { bg: string; text: string; bar: string }> = {
      'Efficace': { bg: 'bg-emerald-100', text: 'text-emerald-700', bar: 'bg-emerald-500' },
      'Adéquat': { bg: 'bg-accent-100', text: 'text-accent-700', bar: 'bg-accent-500' },
      'Partiellement efficace': { bg: 'bg-amber-100', text: 'text-amber-700', bar: 'bg-amber-500' },
      'Inadéquat': { bg: 'bg-red-100', text: 'text-red-700', bar: 'bg-red-500' },
    };
    return map[level] || { bg: 'bg-background-100', text: 'text-foreground-600', bar: 'bg-background-400' };
  };

  const getTestResultStyles = (result: string) => {
    const map: Record<string, string> = {
      'Succès': 'bg-emerald-100 text-emerald-700',
      'Partiel': 'bg-amber-100 text-amber-700',
      'Échec': 'bg-red-100 text-red-700',
    };
    return map[result] || 'bg-background-100 text-foreground-600';
  };

  const getHeatmapColor = (prob: number, imp: number) => {
    const score = (prob * imp) / 100;
    if (score >= 64) return 'bg-red-500/80';
    if (score >= 36) return 'bg-orange-500/70';
    if (score >= 16) return 'bg-amber-400/60';
    return 'bg-emerald-400/50';
  };

  const getDDRingColor = (score: number) => {
    if (score >= 75) return 'stroke-emerald-500';
    if (score >= 60) return 'stroke-amber-500';
    if (score >= 40) return 'stroke-orange-500';
    return 'stroke-red-500';
  };

  const avgCriticality = useMemo(() => {
    if (riskRegistersMock.length === 0) return 0;
    return Math.round(riskRegistersMock.reduce((s, r) => s + r.criticality_score, 0) / riskRegistersMock.length);
  }, []);

  const openRisks = useMemo(() => riskRegistersMock.filter(r => r.status === 'Actif').length, []);
  const failedControls = useMemo(() => internalControlsMock.filter(c => c.test_result === 'Échec').length, []);

  const tabs: { id: Tab; label: string; icon: string; count: number; accent: string }[] = [
    { id: 'due-diligence', label: 'Due Diligence', icon: 'ri-search-eye-line', count: dueDiligenceReportsMock.length, accent: 'bg-amber-500' },
    { id: 'risk-engine', label: 'Risk Engine', icon: 'ri-shield-flash-line', count: riskRegistersMock.length, accent: 'bg-red-500' },
    { id: 'internal-control', label: 'Contrôle Interne', icon: 'ri-lock-line', count: internalControlsMock.length, accent: 'bg-accent-500' },
    { id: 'enterprise-analytics', label: 'Risk Analytics', icon: 'ri-pie-chart-2-line', count: 0, accent: 'bg-emerald-500' },
  ];

  const dimensions = ['governance', 'financial', 'compliance', 'operational', 'market'] as const;
  const ddMaxScores = { governance: 100, financial: 100, compliance: 100, operational: 100, market: 100 };

  return (
    <KOSHubLayout hubId={3}>
      {/* Header */}
      <section className="relative bg-gradient-to-b from-background-100 to-background-50 border-b border-background-200/70">
        <div className="max-w-7xl mx-auto px-4 md:px-6 py-10 md:py-14">
          <div className="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
            <div>
              <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-100/80 text-red-700 text-xs font-semibold mb-4">
                <i className="ri-radar-line"></i>
                KOS Enterprise+ — Risk & Due Diligence Command
              </div>
              <h1 className="text-2xl md:text-4xl font-heading font-bold text-foreground-950 tracking-tight">
                Risk & Due Diligence Command
              </h1>
              <p className="text-sm md:text-base text-foreground-600 mt-3 max-w-2xl">
                Due diligences, cartographie des risques, contrôle interne, analytics consolidés — pilotage du risque au standard Big Four.
              </p>
            </div>
            <div className="flex items-center gap-3">
              <div className="text-center px-5 py-3 bg-background-50 rounded-xl border border-background-200/70">
                <div className="text-2xl font-bold text-foreground-950">{dueDiligenceReportsMock.length + internalControlsMock.length + 1}</div>
                <div className="text-xs text-foreground-500">BLOCS actifs</div>
              </div>
              <div className="text-center px-5 py-3 bg-background-50 rounded-xl border border-background-200/70">
                <div className="text-2xl font-bold text-accent-500">{openRisks}</div>
                <div className="text-xs text-foreground-500">Risques actifs</div>
              </div>
              <div className="text-center px-5 py-3 bg-background-50 rounded-xl border border-background-200/70">
                <div className="text-2xl font-bold text-red-500">{failedControls}</div>
                <div className="text-xs text-foreground-500">Contrôles à risque</div>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* Sticky tabs */}
      <div className="sticky top-0 z-30 bg-background-50/95 backdrop-blur-sm border-b border-background-200/70">
        <div className="max-w-7xl mx-auto px-4 md:px-6">
          <div className="flex gap-1 py-3 overflow-x-auto">
            {tabs.map((tab) => (
              <button
                key={tab.id}
                onClick={() => setActiveTab(tab.id)}
                className={`relative whitespace-nowrap px-4 py-2.5 rounded-full text-sm font-medium flex items-center gap-2 transition-all cursor-pointer ${
                  activeTab === tab.id ? 'bg-foreground-950 text-background-50 shadow-sm' : 'text-foreground-600 hover:bg-background-100'
                }`}
              >
                <i className={`${tab.icon} text-sm`}></i>
                {tab.label}
                {tab.count > 0 && <span className="text-xs opacity-60">{tab.count}</span>}
              </button>
            ))}
          </div>
        </div>
      </div>

      {/* kosData.Content */}
      <div className="max-w-7xl mx-auto px-4 md:px-6 py-8 space-y-8">
        {/* ===== TAB 1 — DUE DILIGENCE ===== */}
        {activeTab === 'due-diligence' && (
          <>
            {/* Section KPIs */}
            <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
              {dueDiligenceReportsMock.map((dd) => (
                <div
                  key={dd.id}
                  onClick={() => setSelectedDD(dd)}
                  className={`p-4 rounded-xl border cursor-pointer transition-all text-center ${
                    selectedDD.id === dd.id
                      ? 'border-amber-300 bg-amber-50/50 ring-1 ring-amber-200 scale-[1.02]'
                      : 'border-background-200/70 bg-background-50 hover:border-background-300/60 hover:scale-[1.01]'
                  }`}
                >
                  <div className="relative w-14 h-14 mx-auto mb-2">
                    <svg className="w-14 h-14 -rotate-90" viewBox="0 0 52 52">
                      <circle cx="26" cy="26" r="22" fill="none" stroke="currentColor" className="text-background-200/70" strokeWidth="4" />
                      <circle cx="26" cy="26" r="22" fill="none" stroke="currentColor" strokeWidth="4" strokeDasharray={`${(dd.overall_score / 100) * 138.23} 138.23`} strokeLinecap="round" className={getDDRingColor(dd.overall_score)} />
                    </svg>
                    <span className={`absolute inset-0 flex items-center justify-center text-sm font-bold ${getScoreColorClass(dd.overall_score)}`}>{dd.overall_score}</span>
                  </div>
                  <div className={`text-xs font-bold px-2 py-0.5 rounded-full inline-block ${getRatingColor(dd.overall_rating).bg} ${getRatingColor(dd.overall_rating).text}`}>{dd.overall_rating}</div>
                  <div className="text-xs font-semibold text-foreground-950 mt-1.5 line-clamp-1">{dd.company_name}</div>
                  <div className="text-[10px] text-foreground-400">{dd.country}</div>
                </div>
              ))}
              <div className="p-4 rounded-xl border border-dashed border-background-300/60 bg-background-50/50 flex flex-col items-center justify-center text-center cursor-pointer hover:border-amber-300 hover:bg-amber-50/30 transition-colors">
                <div className="w-10 h-10 flex items-center justify-center rounded-full bg-amber-100 text-amber-600 mb-2">
                  <i className="ri-add-line text-lg"></i>
                </div>
                <span className="text-xs font-medium text-foreground-500">Nouvelle Due Diligence</span>
              </div>
            </div>

            {/* Detail panel */}
            {selectedDD && (
              <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
                {/* Left — Info */}
                <div className="lg:col-span-2 bg-background-50 rounded-xl border border-background-200/70 p-6">
                  <div className="flex flex-wrap items-center gap-3 mb-4">
                    <span className={`text-xs px-2.5 py-1 rounded-full font-bold ${getRatingColor(selectedDD.overall_rating).bg} ${getRatingColor(selectedDD.overall_rating).text}`}>
                      {selectedDD.overall_rating} — Score {selectedDD.overall_score}/100
                    </span>
                    <span className={`text-xs px-2.5 py-1 rounded-full font-medium ${getRecoBadge(selectedDD.recommendation).bg} ${getRecoBadge(selectedDD.recommendation).text}`}>
                      {getRecoBadge(selectedDD.recommendation).label}
                    </span>
                    <span className="text-xs px-2.5 py-1 rounded-full bg-secondary-100 text-secondary-700 font-medium">{selectedDD.sector}</span>
                    <span className="text-xs text-foreground-400 ml-auto">{selectedDD.timeline}</span>
                  </div>
                  <h2 className="text-xl font-bold text-foreground-950 mb-1">{selectedDD.company_name}</h2>
                  <p className="text-xs text-foreground-500 mb-5">{selectedDD.country} · {selectedDD.deal_value}</p>

                  {/* Score bars */}
                  <div className="space-y-3 mb-6">
                    {dimensions.map((dim) => (
                      <div key={dim} className="flex items-center gap-3">
                        <span className="text-xs font-medium text-foreground-600 w-24 capitalize">{dim === 'governance' ? 'Gouvernance' : dim === 'financial' ? 'Financier' : dim === 'compliance' ? 'Conformité' : dim === 'operational' ? 'Opérationnel' : 'Marché'}</span>
                        <div className="flex-1 h-2.5 bg-background-100 rounded-full overflow-hidden">
                          <div className={`h-full rounded-full transition-all ${getScoreBgClass(selectedDD[`${dim}_score`])}`} style={{ width: `${selectedDD[`${dim}_score`]}%` }}></div>
                        </div>
                        <span className={`text-xs font-bold w-8 text-right ${getScoreColorClass(selectedDD[`${dim}_score`])}`}>{selectedDD[`${dim}_score`]}</span>
                      </div>
                    ))}
                  </div>

                  <p className="text-sm text-foreground-600 leading-relaxed mb-4">{selectedDD.summary}</p>

                  <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div className="p-4 bg-emerald-50/60 rounded-lg border border-emerald-100">
                      <h4 className="text-xs font-bold text-emerald-700 mb-2 flex items-center gap-1.5"><i className="ri-check-line"></i>Forces</h4>
                      <ul className="space-y-1.5">
                        {selectedDD.strengths.map((s: string, i: number) => (
                          <li key={i} className="text-xs text-foreground-600 flex items-start gap-1.5"><span className="text-emerald-500 mt-0.5">•</span>{s}</li>
                        ))}
                      </ul>
                    </div>
                    <div className="p-4 bg-red-50/60 rounded-lg border border-red-100">
                      <h4 className="text-xs font-bold text-red-700 mb-2 flex items-center gap-1.5"><i className="ri-flag-line"></i>Red Flags ({selectedDD.red_flags.length})</h4>
                      <ul className="space-y-1.5">
                        {selectedDD.red_flags.length > 0 ? selectedDD.red_flags.map((s: string, i: number) => (
                          <li key={i} className="text-xs text-foreground-600 flex items-start gap-1.5"><span className="text-red-500 mt-0.5">•</span>{s}</li>
                        )) : <li className="text-xs text-emerald-600">Aucun red flag détecté</li>}
                      </ul>
                    </div>
                  </div>
                </div>

                {/* Right — Team & Meta */}
                <div className="space-y-4">
                  <div className="bg-background-50 rounded-xl border border-background-200/70 p-5">
                    <h4 className="text-xs font-bold text-foreground-950 mb-3">Équipe d'engagement</h4>
                    <p className="text-xs text-foreground-600 leading-relaxed">{selectedDD.engagement_team}</p>
                  </div>
                  <div className="bg-background-50 rounded-xl border border-background-200/70 p-5">
                    <h4 className="text-xs font-bold text-foreground-950 mb-3">Issues</h4>
                    <div className="space-y-2">
                      <div className="flex justify-between text-xs"><span className="text-red-600">Critiques</span><span className="font-bold">{selectedDD.findings.key_issues}</span></div>
                      <div className="flex justify-between text-xs"><span className="text-amber-600">Modérées</span><span className="font-bold">{selectedDD.findings.moderate_issues}</span></div>
                      <div className="flex justify-between text-xs"><span className="text-foreground-500">Mineures</span><span className="font-bold">{selectedDD.findings.minor_issues}</span></div>
                    </div>
                  </div>
                  <div className="bg-background-50 rounded-xl border border-background-200/70 p-5">
                    <h4 className="text-xs font-bold text-foreground-950 mb-3">Comparaison sectorielle</h4>
                    <div className="space-y-2">
                      <div className="flex items-center gap-2">
                        <div className="flex-1 text-xs text-foreground-500">Moyenne secteur {selectedDD.sector}</div>
                        <div className={`text-xs font-bold ${getScoreColorClass(62)}`}>62</div>
                      </div>
                      <div className="flex items-center gap-2">
                        <div className="flex-1 text-xs text-foreground-500">{selectedDD.company_name}</div>
                        <div className={`text-xs font-bold ${getScoreColorClass(selectedDD.overall_score)}`}>{selectedDD.overall_score}</div>
                      </div>
                      <div className="h-1.5 bg-background-100 rounded-full overflow-hidden mt-1">
                        <div className="h-full bg-foreground-300 rounded-full" style={{ width: '62%' }}></div>
                      </div>
                      <div className="h-1.5 bg-background-100 rounded-full overflow-hidden">
                        <div className={`h-full rounded-full ${getScoreBgClass(selectedDD.overall_score)}`} style={{ width: `${selectedDD.overall_score}%` }}></div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            )}
          </>
        )}

        {/* ===== TAB 2 — ENTERPRISE RISK ENGINE ===== */}
        {activeTab === 'risk-engine' && (
          <div className="space-y-6">
            {/* Top stats row */}
            <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
              <div className="bg-background-50 rounded-xl border border-background-200/70 p-4">
                <div className="text-xs text-foreground-500 mb-1">Risques totaux</div>
                <div className="text-2xl font-bold text-foreground-950">{riskRegistersMock.length}</div>
              </div>
              <div className="bg-background-50 rounded-xl border border-background-200/70 p-4">
                <div className="text-xs text-foreground-500 mb-1">Criticité moyenne</div>
                <div className="text-2xl font-bold text-red-500">{avgCriticality}</div>
              </div>
              <div className="bg-background-50 rounded-xl border border-background-200/70 p-4">
                <div className="text-xs text-foreground-500 mb-1">Risques actifs</div>
                <div className="text-2xl font-bold text-amber-500">{openRisks}</div>
              </div>
              <div className="bg-background-50 rounded-xl border border-background-200/70 p-4">
                <div className="text-xs text-foreground-500 mb-1">Résiduel moyen</div>
                <div className="text-2xl font-bold text-emerald-500">
                  {Math.round(riskRegistersMock.reduce((s, r) => s + r.residual_score, 0) / riskRegistersMock.length)}
                </div>
              </div>
            </div>

            <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
              {/* Heatmap Matrix */}
              <div className="lg:col-span-1 bg-background-50 rounded-xl border border-background-200/70 p-5">
                <h3 className="text-sm font-bold text-foreground-950 mb-4 flex items-center gap-2">
                  <i className="ri-grid-line text-red-500"></i>Matrice de criticité
                </h3>
                {/* Y axis label */}
                <div className="flex items-start gap-1">
                  <div className="flex flex-col justify-between h-[280px] pr-2">
                    <span className="text-[10px] text-foreground-400">Critique</span>
                    <span className="text-[10px] text-foreground-400">Élevé</span>
                    <span className="text-[10px] text-foreground-400">Modéré</span>
                    <span className="text-[10px] text-foreground-400">Faible</span>
                    <span className="text-[10px] text-foreground-400">Très faible</span>
                  </div>
                  <div className="flex-1">
                    <div className="grid grid-cols-5 gap-0.5 h-[280px]">
                      {[100, 80, 60, 40, 20].map((impact) =>
                        [20, 40, 60, 80, 100].map((prob) => {
                          const cellColor = ((impact * prob) / 100 >= 64) ? 'bg-red-400/70' : ((impact * prob) / 100 >= 36) ? 'bg-orange-400/60' : ((impact * prob) / 100 >= 16) ? 'bg-amber-300/50' : 'bg-emerald-300/40';
                          const nearby = enterpriseRiskAnalyticsMock.heatmap_data.filter(
                            d => {
                              const pBucket = Math.round(d.x / 20) * 20;
                              const iBucket = Math.round(d.y / 20) * 20;
                              return pBucket === prob && iBucket === impact;
                            }
                          );
                          const hasRisk = nearby.length > 0;
                          return (
                            <div
                              key={`${impact}-${prob}`}
                              className={`relative rounded-sm cursor-pointer transition-all hover:scale-110 hover:z-10 ${cellColor} ${hasRisk ? 'ring-1 ring-foreground-300' : ''}`}
                              onMouseEnter={() => hasRisk && setHeatmapHovered(nearby[0].id)}
                              onMouseLeave={() => setHeatmapHovered(null)}
                            >
                              {hasRisk && <div className="absolute inset-0 flex items-center justify-center"><div className="w-1.5 h-1.5 rounded-full bg-foreground-800"></div></div>}
                            </div>
                          );
                        })
                      )}
                    </div>
                    {/* X axis label */}
                    <div className="flex justify-between mt-1">
                      <span className="text-[10px] text-foreground-400">Très faible</span>
                      <span className="text-[10px] text-foreground-400">Faible</span>
                      <span className="text-[10px] text-foreground-400">Moyenne</span>
                      <span className="text-[10px] text-foreground-400">Élevée</span>
                      <span className="text-[10px] text-foreground-400">Très élevée</span>
                    </div>
                    <div className="text-center text-[10px] text-foreground-400 mt-0.5">Probabilité →</div>
                  </div>
                </div>
                {heatmapHovered && (
                  <div className="mt-3 p-2 bg-foreground-950 text-background-50 text-xs rounded-lg">
                    {enterpriseRiskAnalyticsMock.heatmap_data.find(d => d.id === heatmapHovered)?.label}
                  </div>
                )}
                <div className="flex items-center gap-3 mt-3 justify-center">
                  <div className="flex items-center gap-1"><div className="w-3 h-3 rounded-sm bg-red-400/70"></div><span className="text-[10px] text-foreground-500">Critique</span></div>
                  <div className="flex items-center gap-1"><div className="w-3 h-3 rounded-sm bg-orange-400/60"></div><span className="text-[10px] text-foreground-500">Élevé</span></div>
                  <div className="flex items-center gap-1"><div className="w-3 h-3 rounded-sm bg-amber-300/50"></div><span className="text-[10px] text-foreground-500">Modéré</span></div>
                  <div className="flex items-center gap-1"><div className="w-3 h-3 rounded-sm bg-emerald-300/40"></div><span className="text-[10px] text-foreground-500">Faible</span></div>
                </div>
              </div>

              {/* Risk table */}
              <div className="lg:col-span-2 bg-background-50 rounded-xl border border-background-200/70 overflow-hidden">
                <div className="overflow-x-auto">
                  <table className="w-full text-sm">
                    <thead>
                      <tr className="bg-background-100/50">
                        <th className="text-left py-3 px-4 text-xs font-semibold text-foreground-500">Risque</th>
                        <th className="text-left py-3 px-4 text-xs font-semibold text-foreground-500">Catégorie</th>
                        <th className="text-center py-3 px-4 text-xs font-semibold text-foreground-500">Probabilité</th>
                        <th className="text-center py-3 px-4 text-xs font-semibold text-foreground-500">Impact</th>
                        <th className="text-center py-3 px-4 text-xs font-semibold text-foreground-500">Criticité</th>
                        <th className="text-center py-3 px-4 text-xs font-semibold text-foreground-500">Résiduel</th>
                        <th className="text-center py-3 px-4 text-xs font-semibold text-foreground-500">Tendance</th>
                      </tr>
                    </thead>
                    <tbody>
                      {riskRegistersMock.map((risk) => (
                        <tr
                          key={risk.id}
                          onClick={() => setSelectedRisk(risk)}
                          className={`border-b border-background-100 cursor-pointer transition-colors ${
                            selectedRisk.id === risk.id ? 'bg-red-50/40' : 'hover:bg-background-100/50'
                          }`}
                        >
                          <td className="py-3 px-4">
                            <div className="font-medium text-foreground-950 text-sm">{risk.risk_name}</div>
                            <div className="text-xs text-foreground-400">{risk.owner}</div>
                          </td>
                          <td className="py-3 px-4">
                            <span className="text-xs px-2 py-0.5 rounded-full bg-secondary-100 text-secondary-700 whitespace-nowrap">{risk.risk_category}</span>
                          </td>
                          <td className="py-3 px-4 text-center">
                            <span className={`text-xs font-medium ${risk.probability_score >= 60 ? 'text-red-600' : risk.probability_score >= 40 ? 'text-amber-600' : 'text-emerald-600'}`}>{risk.probability}</span>
                          </td>
                          <td className="py-3 px-4 text-center">
                            <span className={`text-xs font-medium ${risk.impact_score >= 80 ? 'text-red-600' : risk.impact_score >= 60 ? 'text-amber-600' : 'text-emerald-600'}`}>{risk.impact}</span>
                          </td>
                          <td className="py-3 px-4">
                            <div className="flex items-center gap-2 justify-center">
                              <div className="h-1.5 w-16 bg-background-200/70 rounded-full overflow-hidden flex-shrink-0">
                                <div className={`h-full rounded-full ${risk.criticality_score >= 70 ? 'bg-red-500' : risk.criticality_score >= 50 ? 'bg-amber-500' : 'bg-emerald-500'}`} style={{ width: `${risk.criticality_score}%` }}></div>
                              </div>
                              <span className="text-xs font-bold text-foreground-950 w-6">{risk.criticality_score}</span>
                            </div>
                          </td>
                          <td className="py-3 px-4 text-center">
                            <span className={`text-xs font-bold ${risk.residual_score >= 50 ? 'text-amber-600' : 'text-emerald-600'}`}>{risk.residual_score}</span>
                          </td>
                          <td className="py-3 px-4 text-center">
                            {risk.trend === 'up' && <i className="ri-arrow-up-line text-red-500 text-xs"></i>}
                            {risk.trend === 'down' && <i className="ri-arrow-down-line text-emerald-500 text-xs"></i>}
                            {risk.trend === 'stable' && <i className="ri-subtract-line text-foreground-400 text-xs"></i>}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            </div>

            {/* Selected risk detail */}
            {selectedRisk && (
              <div className="bg-background-50 rounded-xl border border-background-200/70 p-6">
                <div className="flex flex-wrap items-center gap-3 mb-4">
                  <span className={`text-xs px-2.5 py-1 rounded-full font-bold ${selectedRisk.criticality_score >= 70 ? 'bg-red-100 text-red-700' : selectedRisk.criticality_score >= 50 ? 'bg-amber-100 text-amber-700' : 'bg-emerald-100 text-emerald-700'}`}>
                    Criticité {selectedRisk.criticality_score}/100
                  </span>
                  <span className="text-xs px-2.5 py-1 rounded-full bg-secondary-100 text-secondary-700 font-medium">{selectedRisk.risk_category}</span>
                  <span className={`text-xs px-2.5 py-1 rounded-full font-medium ${selectedRisk.status === 'Actif' ? 'bg-red-100 text-red-700' : 'bg-emerald-100 text-emerald-700'}`}>{selectedRisk.status}</span>
                  <span className="text-xs text-foreground-400 ml-auto">Revue: {selectedRisk.review_date}</span>
                </div>
                <h2 className="text-lg font-bold text-foreground-950 mb-3">{selectedRisk.risk_name}</h2>
                <div className="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-4">
                  <div className="p-3 bg-background-100 rounded-lg text-center">
                    <div className="text-lg font-bold text-foreground-950">{selectedRisk.probability}</div>
                    <div className="text-xs text-foreground-500">Probabilité ({selectedRisk.probability_score})</div>
                  </div>
                  <div className="p-3 bg-background-100 rounded-lg text-center">
                    <div className="text-lg font-bold text-foreground-950">{selectedRisk.impact}</div>
                    <div className="text-xs text-foreground-500">Impact ({selectedRisk.impact_score})</div>
                  </div>
                  <div className="p-3 bg-background-100 rounded-lg text-center">
                    <div className="text-lg font-bold text-foreground-950">{selectedRisk.residual_risk}</div>
                    <div className="text-xs text-foreground-500">Résiduel ({selectedRisk.residual_score})</div>
                  </div>
                  <div className="p-3 bg-background-100 rounded-lg text-center">
                    <div className="text-lg font-bold text-foreground-950">{selectedRisk.owner.split(' ').pop()}</div>
                    <div className="text-xs text-foreground-500">Owner</div>
                  </div>
                </div>
                <div className="p-4 bg-orange-50/60 rounded-lg border border-orange-100">
                  <h4 className="text-xs font-bold text-orange-700 mb-2">Plan de mitigation</h4>
                  <p className="text-sm text-foreground-600 leading-relaxed">{selectedRisk.mitigation_plan}</p>
                </div>
                <div className="flex flex-wrap gap-2 mt-4">
                  {selectedRisk.tags.map((tag: string, i: number) => (
                    <span key={i} className="text-xs px-2 py-0.5 rounded-full bg-background-100 text-foreground-500 border border-background-200/70">{tag}</span>
                  ))}
                </div>
              </div>
            )}
          </div>
        )}

        {/* ===== TAB 3 — INTERNAL CONTROL ===== */}
        {activeTab === 'internal-control' && (
          <div className="space-y-6">
            {/* Summary cards */}
            <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
              <div className="bg-background-50 rounded-xl border border-background-200/70 p-4">
                <div className="text-xs text-foreground-500 mb-1">Contrôles</div>
                <div className="text-2xl font-bold text-foreground-950">{internalControlsMock.length}</div>
              </div>
              <div className="bg-background-50 rounded-xl border border-background-200/70 p-4">
                <div className="text-xs text-foreground-500 mb-1">Efficaces</div>
                <div className="text-2xl font-bold text-emerald-500">{internalControlsMock.filter(c => c.effectiveness === 'Efficace').length}</div>
              </div>
              <div className="bg-background-50 rounded-xl border border-background-200/70 p-4">
                <div className="text-xs text-foreground-500 mb-1">À améliorer</div>
                <div className="text-2xl font-bold text-amber-500">{internalControlsMock.filter(c => c.test_result === 'Échec' || c.test_result === 'Partiel').length}</div>
              </div>
              <div className="bg-background-50 rounded-xl border border-background-200/70 p-4">
                <div className="text-xs text-foreground-500 mb-1">Automatisés</div>
                <div className="text-2xl font-bold text-accent-500">{internalControlsMock.filter(c => c.automation_level === 'Automatisé').length}</div>
              </div>
            </div>

            <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
              {/* Framework Maturity */}
              <div className="lg:col-span-1 bg-background-50 rounded-xl border border-background-200/70 p-5">
                <h3 className="text-sm font-bold text-foreground-950 mb-4 flex items-center gap-2">
                  <i className="ri-bar-chart-2-line text-accent-500"></i>Maturité par référentiel
                </h3>
                <div className="space-y-4">
                  {enterpriseRiskAnalyticsMock.framework_maturity.map((fw) => (
                    <div key={fw.framework}>
                      <div className="flex items-center justify-between mb-1.5">
                        <span className="text-xs font-semibold text-foreground-950">{fw.framework}</span>
                        <span className="text-xs font-bold text-accent-600">{fw.score}%</span>
                      </div>
                      <div className="h-2 bg-background-100 rounded-full overflow-hidden mb-1">
                        <div className="h-full bg-accent-500 rounded-full" style={{ width: `${fw.score}%` }}></div>
                      </div>
                      <div className="h-0.5 bg-background-100 rounded-full overflow-hidden">
                        <div className="h-full bg-foreground-300 rounded-full" style={{ width: `${fw.target}%` }}></div>
                      </div>
                      <div className="flex justify-between mt-0.5">
                        <span className="text-[10px] text-foreground-400">Cible: {fw.target}%</span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>

              {/* Control Cards */}
              <div className="lg:col-span-2 grid grid-cols-1 sm:grid-cols-2 gap-4">
                {internalControlsMock.map((ctrl) => {
                  const eff = getEffectivenessStyles(ctrl.effectiveness);
                  return (
                    <div
                      key={ctrl.id}
                      onClick={() => setSelectedControl(ctrl)}
                      className={`p-5 rounded-xl border cursor-pointer transition-all ${
                        selectedControl.id === ctrl.id ? 'border-accent-300 bg-accent-50/50 ring-1 ring-accent-200' : 'border-background-200/70 bg-background-50 hover:border-background-300/60'
                      }`}
                    >
                      <div className="flex items-center justify-between mb-2">
                        <span className="text-xs px-2 py-0.5 rounded-full bg-secondary-100 text-secondary-700 font-medium">{ctrl.framework}</span>
                        <span className={`text-xs px-2 py-0.5 rounded-full font-medium ${eff.bg} ${eff.text}`}>{ctrl.effectiveness}</span>
                      </div>
                      <h4 className="text-sm font-bold text-foreground-950 mb-1">{ctrl.control_name}</h4>
                      <div className="flex items-center gap-3 text-xs text-foreground-400 mb-3">
                        <span>{ctrl.department}</span>
                        <span>·</span>
                        <span>{ctrl.frequency}</span>
                        <span>·</span>
                        <span className={getTestResultStyles(ctrl.test_result)}>{ctrl.test_result}</span>
                      </div>
                      <div className="h-1.5 bg-background-100 rounded-full overflow-hidden mb-2">
                        <div className={`h-full rounded-full ${eff.bar}`} style={{ width: `${ctrl.effectiveness_score}%` }}></div>
                      </div>
                      <div className="flex items-center justify-between">
                        <span className="text-xs text-foreground-500">{ctrl.automation_level}</span>
                        <span className="text-xs font-bold text-foreground-950">{ctrl.effectiveness_score}%</span>
                      </div>
                      {ctrl.gap_description && (
                        <div className="mt-3 p-2.5 bg-orange-50/60 rounded-lg border border-orange-100">
                          <p className="text-xs text-orange-700 leading-relaxed">{ctrl.gap_description}</p>
                        </div>
                      )}
                    </div>
                  );
                })}
              </div>
            </div>
          </div>
        )}

        {/* ===== TAB 4 — ENTERPRISE RISK ANALYTICS ===== */}
        {activeTab === 'enterprise-analytics' && (
          <div className="space-y-6">
            {/* Gauge: Risk Appetite */}
            <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
              {/* Risk Appetite Gauge */}
              <div className="bg-background-50 rounded-xl border border-background-200/70 p-6 text-center">
                <h3 className="text-sm font-bold text-foreground-950 mb-4">Appétit au Risque</h3>
                <div className="relative w-36 h-36 mx-auto mb-3">
                  <svg className="w-36 h-36 -rotate-90" viewBox="0 0 144 144">
                    <circle cx="72" cy="72" r="60" fill="none" className="text-background-200/70" strokeWidth="10" stroke="currentColor" />
                    {/* Tolerance zone */}
                    <circle cx="72" cy="72" r="60" fill="none" stroke="currentColor" strokeWidth="10" strokeDasharray={`${(enterpriseRiskAnalyticsMock.risk_appetite.ceiling / 100) * 376.99} 376.99`} strokeLinecap="butt" className="text-amber-200" />
                    {/* Actual */}
                    <circle cx="72" cy="72" r="60" fill="none" stroke="currentColor" strokeWidth="10" strokeDasharray={`${(enterpriseRiskAnalyticsMock.risk_appetite.current / 100) * 376.99} 376.99`} strokeLinecap="round" className={enterpriseRiskAnalyticsMock.risk_appetite.current <= enterpriseRiskAnalyticsMock.risk_appetite.target ? 'text-emerald-500' : 'text-amber-500'} />
                  </svg>
                  <div className="absolute inset-0 flex flex-col items-center justify-center">
                    <span className="text-3xl font-bold text-foreground-950">{enterpriseRiskAnalyticsMock.risk_appetite.current}%</span>
                    <span className="text-xs text-foreground-500">Inhérent actuel</span>
                  </div>
                </div>
                <div className="flex justify-center gap-6 text-xs">
                  <div><span className="font-bold text-emerald-600">{enterpriseRiskAnalyticsMock.risk_appetite.target}%</span><br /><span className="text-foreground-400">Cible</span></div>
                  <div><span className="font-bold text-amber-600">{enterpriseRiskAnalyticsMock.risk_appetite.ceiling}%</span><br /><span className="text-foreground-400">Plafond</span></div>
                  <div><span className="font-bold text-foreground-950">{enterpriseRiskAnalyticsMock.risk_appetite.last_quarter}%</span><br /><span className="text-foreground-400">Trim. préc.</span></div>
                </div>
                <div className="mt-3 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-700 text-xs font-medium">
                  <i className="ri-check-line"></i>Dans la tolérance
                </div>
              </div>

              {/* Risk by Category */}
              <div className="lg:col-span-2 bg-background-50 rounded-xl border border-background-200/70 p-6">
                <h3 className="text-sm font-bold text-foreground-950 mb-4">Risques par Catégorie</h3>
                <div className="space-y-3">
                  {enterpriseRiskAnalyticsMock.risk_by_category.map((cat) => (
                    <div key={cat.category} className="flex items-center gap-3">
                      <span className="text-xs font-medium text-foreground-600 w-28">{cat.category}</span>
                      <div className="flex-1 h-3 bg-background-100 rounded-full overflow-hidden">
                        <div
                          className={`h-full rounded-full ${cat.avg_criticality >= 70 ? 'bg-red-500' : cat.avg_criticality >= 50 ? 'bg-amber-500' : 'bg-emerald-500'}`}
                          style={{ width: `${cat.avg_criticality}%` }}
                        ></div>
                      </div>
                      <span className="text-xs font-bold text-foreground-950 w-8 text-right">{cat.avg_criticality}</span>
                      <span className="text-xs text-foreground-400 w-8 text-center">{cat.count} risque{cat.count > 1 ? 's' : ''}</span>
                      <span className="w-5 text-center">
                        {cat.trend === 'up' && <i className="ri-arrow-up-line text-red-500 text-xs"></i>}
                        {cat.trend === 'down' && <i className="ri-arrow-down-line text-emerald-500 text-xs"></i>}
                        {cat.trend === 'stable' && <i className="ri-subtract-line text-foreground-400 text-xs"></i>}
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            {/* Residual Tracking & Framework Components */}
            <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
              {/* Residual Tracking */}
              <div className="bg-background-50 rounded-xl border border-background-200/70 p-6">
                <h3 className="text-sm font-bold text-foreground-950 mb-4">Tracking Résiduel — 6 mois</h3>
                <div className="space-y-2">
                  {enterpriseRiskAnalyticsMock.residual_tracking.map((m) => (
                    <div key={m.month} className="flex items-center gap-3">
                      <span className="text-xs font-medium text-foreground-500 w-8">{m.month}</span>
                      <div className="flex-1 flex items-center gap-1">
                        <div className="h-2.5 bg-background-100 rounded-full overflow-hidden flex-1 relative">
                          <div className="h-full bg-amber-300/60 rounded-full absolute" style={{ width: `${m.inherent}%` }}></div>
                          <div className="h-full bg-emerald-500 rounded-full absolute" style={{ width: `${m.residual}%` }}></div>
                        </div>
                      </div>
                      <span className="text-xs font-bold text-emerald-600 w-8 text-right">{m.residual}</span>
                    </div>
                  ))}
                </div>
                <div className="flex items-center gap-4 mt-4 text-xs">
                  <div className="flex items-center gap-1.5"><div className="w-3 h-3 rounded bg-amber-300/60"></div><span className="text-foreground-500">Inhérent</span></div>
                  <div className="flex items-center gap-1.5"><div className="w-3 h-3 rounded bg-emerald-500"></div><span className="text-foreground-500">Résiduel</span></div>
                </div>
              </div>

              {/* Correlation Matrix */}
              <div className="bg-background-50 rounded-xl border border-background-200/70 p-6">
                <h3 className="text-sm font-bold text-foreground-950 mb-4">Matrice de Corrélation</h3>
                <div className="space-y-2">
                  {enterpriseRiskAnalyticsMock.correlation_matrix.map((corr, i) => (
                    <div key={i} className="flex items-center gap-2">
                      <span className="text-xs text-foreground-600 w-28 truncate">{corr.source.split(' ').slice(0, 2).join(' ')}</span>
                      <div className="flex-1 h-2 bg-background-100 rounded-full overflow-hidden">
                        <div
                          className={`h-full rounded-full ${corr.strength >= 0.7 ? 'bg-red-500' : corr.strength >= 0.5 ? 'bg-amber-500' : 'bg-emerald-500'}`}
                          style={{ width: `${corr.strength * 100}%` }}
                        ></div>
                      </div>
                      <span className="text-xs text-foreground-600 w-24 truncate text-right">{corr.target.split(' ').slice(0, 2).join(' ')}</span>
                      <span className="text-xs font-bold text-foreground-950 w-8 text-right">{(corr.strength * 100).toFixed(0)}%</span>
                    </div>
                  ))}
                </div>
                <div className="flex items-center gap-3 mt-4 text-xs text-foreground-400">
                  <div className="flex items-center gap-1"><div className="w-2 h-2 rounded-full bg-red-500"></div> Forte (≥70%)</div>
                  <div className="flex items-center gap-1"><div className="w-2 h-2 rounded-full bg-amber-500"></div> Moyenne (50-69%)</div>
                  <div className="flex items-center gap-1"><div className="w-2 h-2 rounded-full bg-emerald-500"></div> Faible (&lt;50%)</div>
                </div>
              </div>
            </div>

            {/* Framework Component Detail */}
            <div className="bg-background-50 rounded-xl border border-background-200/70 p-6">
              <h3 className="text-sm font-bold text-foreground-950 mb-4">Détail COSO — Les 5 Composantes</h3>
              <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
                {Object.entries(enterpriseRiskAnalyticsMock.framework_maturity.find(f => f.framework === 'COSO')?.components || {}).map(([key, val]) => (
                  <div key={key} className="p-4 bg-background-100 rounded-lg text-center">
                    <div className="relative w-16 h-16 mx-auto mb-2">
                      <svg className="w-16 h-16 -rotate-90" viewBox="0 0 64 64">
                        <circle cx="32" cy="32" r="26" fill="none" stroke="currentColor" className="text-background-200/70" strokeWidth="5" />
                        <circle cx="32" cy="32" r="26" fill="none" stroke="currentColor" strokeWidth="5" strokeDasharray={`${(val / 100) * 163.36} 163.36`} strokeLinecap="round" className={val >= 80 ? 'stroke-emerald-500' : val >= 60 ? 'stroke-sky-500' : 'stroke-amber-500'} />
                      </svg>
                      <span className="absolute inset-0 flex items-center justify-center text-sm font-bold text-foreground-950">{val}</span>
                    </div>
                    <div className="text-xs font-medium text-foreground-600 capitalize">{key === 'environment' ? 'Environnement' : key === 'assessment' ? 'Évaluation' : key === 'activities' ? 'Activités' : key === 'information' ? 'Information' : 'Monitoring'}</div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}
      </div>

      {/* Bottom KPI bar */}
      <section className="border-t border-background-200/70 bg-background-100">
        <div className="max-w-7xl mx-auto px-4 md:px-6 py-8">
          <h4 className="text-sm font-bold text-foreground-950 mb-6">Performance Risk & Due Diligence</h4>
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div className="p-4 bg-background-50 rounded-xl border border-background-200/70">
              <div className="flex items-center justify-between mb-2">
                <span className="text-xs text-foreground-500">DD complétées (2026)</span>
                <span className="text-xs font-bold text-foreground-950">5/12</span>
              </div>
              <div className="h-2 bg-background-200/70 rounded-full overflow-hidden">
                <div className="h-full bg-amber-500 rounded-full" style={{ width: '42%' }}></div>
              </div>
            </div>
            <div className="p-4 bg-background-50 rounded-xl border border-background-200/70">
              <div className="flex items-center justify-between mb-2">
                <span className="text-xs text-foreground-500">Risques maîtrisés</span>
                <span className="text-xs font-bold text-foreground-950">{riskRegistersMock.filter(r => r.status === 'Surveillé').length}/{riskRegistersMock.length}</span>
              </div>
              <div className="h-2 bg-background-200/70 rounded-full overflow-hidden">
                <div className="h-full bg-emerald-500 rounded-full" style={{ width: `${(riskRegistersMock.filter(r => r.status === 'Surveillé').length / riskRegistersMock.length) * 100}%` }}></div>
              </div>
            </div>
            <div className="p-4 bg-background-50 rounded-xl border border-background-200/70">
              <div className="flex items-center justify-between mb-2">
                <span className="text-xs text-foreground-500">Contrôles conformes</span>
                <span className="text-xs font-bold text-foreground-950">{internalControlsMock.filter(c => c.test_result === 'Succès').length}/{internalControlsMock.length}</span>
              </div>
              <div className="h-2 bg-background-200/70 rounded-full overflow-hidden">
                <div className="h-full bg-accent-500 rounded-full" style={{ width: `${(internalControlsMock.filter(c => c.test_result === 'Succès').length / internalControlsMock.length) * 100}%` }}></div>
              </div>
            </div>
            <div className="p-4 bg-background-50 rounded-xl border border-background-200/70">
              <div className="flex items-center justify-between mb-2">
                <span className="text-xs text-foreground-500">Score résiduel moyen</span>
                <span className="text-xs font-bold text-emerald-600">{Math.round(riskRegistersMock.reduce((s, r) => s + r.residual_score, 0) / riskRegistersMock.length)}</span>
              </div>
              <div className="h-2 bg-background-200/70 rounded-full overflow-hidden">
                <div className="h-full bg-emerald-500 rounded-full" style={{ width: `${Math.round(riskRegistersMock.reduce((s, r) => s + r.residual_score, 0) / riskRegistersMock.length)}%` }}></div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </KOSHubLayout>
  );
}
