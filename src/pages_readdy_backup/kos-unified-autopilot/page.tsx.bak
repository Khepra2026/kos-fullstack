import { useState, useMemo } from 'react';
import { useTranslation } from 'react-i18next';
import KOSHubLayout from '@/components/feature/KOSHubLayout';
import { SeoHead } from '@/components/feature/SeoHead';
import { useUnifiedAutopilot } from '@/hooks/useUnifiedAutopilot';

function getSeverityBadge(severity: string) {
  switch (severity) {
    case 'critical': return { bg: 'bg-red-50', border: 'border-red-200', text: 'text-red-700', label: 'CRITIQUE', dot: 'bg-red-500' };
    case 'major': return { bg: 'bg-amber-50', border: 'border-amber-200', text: 'text-amber-700', label: 'MAJEUR', dot: 'bg-amber-500' };
    case 'minor': return { bg: 'bg-slate-50', border: 'border-slate-200', text: 'text-slate-600', label: 'MINEUR', dot: 'bg-slate-400' };
    default: return { bg: 'bg-gray-50', border: 'border-gray-200', text: 'text-gray-700', label: 'N/A', dot: 'bg-gray-500' };
  }
}

function getStatusBadge(status: string) {
  switch (status) {
    case 'active': return { bg: 'bg-emerald-50', border: 'border-emerald-200', text: 'text-emerald-700', label: 'Activé', dot: 'bg-emerald-500' };
    case 'partial': return { bg: 'bg-amber-50', border: 'border-amber-200', text: 'text-amber-700', label: 'Partiel', dot: 'bg-amber-500' };
    case 'gap': return { bg: 'bg-red-50', border: 'border-red-200', text: 'text-red-700', label: 'GAP', dot: 'bg-red-500' };
    default: return { bg: 'bg-gray-50', border: 'border-gray-200', text: 'text-gray-700', label: 'N/A', dot: 'bg-gray-500' };
  }
}

function getDetectionStatusBadge(status: string) {
  switch (status) {
    case 'open': return { bg: 'bg-red-50', border: 'border-red-200', text: 'text-red-700', label: 'Ouvert', dot: 'bg-red-500' };
    case 'in_progress': return { bg: 'bg-amber-50', border: 'border-amber-200', text: 'text-amber-700', label: 'En cours', dot: 'bg-amber-500' };
    case 'fixed': return { bg: 'bg-emerald-50', border: 'border-emerald-200', text: 'text-emerald-700', label: 'Corrigé', dot: 'bg-emerald-500' };
    default: return { bg: 'bg-gray-50', border: 'border-gray-200', text: 'text-gray-700', label: 'N/A', dot: 'bg-gray-500' };
  }
}

function getActionStatusBadge(status: string) {
  switch (status) {
    case 'pending': return { bg: 'bg-slate-50', border: 'border-slate-200', text: 'text-slate-600', label: 'En attente', dot: 'bg-slate-400' };
    case 'in_progress': return { bg: 'bg-amber-50', border: 'border-amber-200', text: 'text-amber-700', label: 'En cours', dot: 'bg-amber-500' };
    case 'done': return { bg: 'bg-emerald-50', border: 'border-emerald-200', text: 'text-emerald-700', label: 'Terminé', dot: 'bg-emerald-500' };
    default: return { bg: 'bg-gray-50', border: 'border-gray-200', text: 'text-gray-700', label: 'N/A', dot: 'bg-gray-500' };
  }
}

type TabId = 'dashboard' | 'soc' | 'seo-geo' | 'kosData.content' | 'workflow' | 'kpis' | 'roadmap' | 'reports' | 'rag' | 'golive';

export default function KOSUnifiedAutopilotPage() {
  const [kosData, setKosData] = useState<any>(null);
  useEffect(() => {
    fetch('/mocks/kos-blog.json').then(r => r.json()).then(setKosData);
  }, []);
  if (!kosData) return null;

  const { i18n } = useTranslation();
  const lang = i18n.language.startsWith('en') ? 'en' : 'fr';
  const [activeTab, setActiveTab] = useState<TabId>('dashboard');
  const [expandedAgent, setExpandedAgent] = useState<string | null>(null);
  const [selectedLayer, setSelectedLayer] = useState<'all' | 'soc' | 'seo-geo-aeo' | 'kosData.content-ai'>('all');

  const {
    globalState: state,
    agents,
    workflowPhases,
    kpis,
    reports,
    roadmap,
    stats,
    loading,
    error,
    dataSource,
    refresh,
  } = useUnifiedAutopilot();

  const layerIds = ['soc', 'seo-geo-aeo', 'kosData.content-ai'] as const;

  const agentsByLayer = useMemo(() => {
    const grouped: Record<string, UnifiedAgent[]> = {};
    layerIds.forEach((lid) => {
      grouped[lid] = agents.filter((a) => a.layer === lid);
    });
    return grouped;
  }, [agents]);

  const allDetections = useMemo(() => {
    const detections: (UnifiedAgentDetection & { agentName: string; agentColor: string; layer: string })[] = [];
    agents.forEach((agent) => {
      agent.detections.forEach((det) => {
        detections.push({ ...det, agentName: agent.name, agentColor: agent.color, layer: agent.layer });
      });
    });
    return detections.sort((a, b) => {
      const sevOrder = { critical: 0, major: 1, minor: 2 };
      return sevOrder[a.severity] - sevOrder[b.severity];
    });
  }, [agents]);

  const filteredDetections = useMemo(() => {
    if (selectedLayer === 'all') return allDetections;
    return allDetections.filter((d) => d.layer === selectedLayer);
  }, [allDetections, selectedLayer]);

  const allActions = useMemo(() => {
    const actions: (UnifiedCorrectiveAction & { agentName: string; agentColor: string; layer: string })[] = [];
    agents.forEach((agent) => {
      agent.actions.forEach((act) => {
        actions.push({ ...act, agentName: agent.name, agentColor: agent.color, layer: agent.layer });
      });
    });
    return actions.sort((a, b) => {
      const priOrder = { critical: 0, major: 1, minor: 2 };
      return priOrder[a.priority] - priOrder[b.priority];
    });
  }, [agents]);

  const filteredActions = useMemo(() => {
    if (selectedLayer === 'all') return allActions;
    return allActions.filter((a) => a.layer === selectedLayer);
  }, [allActions, selectedLayer]);

  const tabs: { id: TabId; label: string; icon: string; count: string }[] = [
    { id: 'dashboard', label: 'Tableau de Bord', icon: 'ri-dashboard-line', count: '3' },
    { id: 'soc', label: 'SOC', icon: 'ri-shield-check-line', count: '3' },
    { id: 'seo-geo', label: 'SEO/GEO/AEO', icon: 'ri-search-line', count: '3' },
    { id: 'kosData.content', label: 'kosData.Content AI', icon: 'ri-quill-pen-line', count: '3' },
    { id: 'workflow', label: 'Workflow', icon: 'ri-git-branch-line', count: '5' },
    { id: 'kpis', label: 'KPIs', icon: 'ri-bar-chart-line', count: '12' },
    { id: 'roadmap', label: 'Roadmap', icon: 'ri-road-map-line', count: '90J' },
    { id: 'reports', label: 'Rapports', icon: 'ri-file-chart-line', count: '6' },
    { id: 'rag', label: 'Autopilot RAG', icon: 'ri-database-2-line', count: '3M' },
    { id: 'golive', label: 'Go-Live J+1', icon: 'ri-rocket-2-line', count: 'NEW' },
  ];

  const getLayerColor = (layer: string): string => {
    if (layer === 'soc') return '#C2410C';
    if (layer === 'seo-geo-aeo') return '#0D7B5F';
    return '#4A7A1E';
  };

  const getLayerBgClass = (layer: string): string => {
    if (layer === 'soc') return 'bg-red-50/40 border-red-200';
    if (layer === 'seo-geo-aeo') return 'bg-emerald-50/40 border-emerald-200';
    return 'bg-amber-50/40 border-amber-200';
  };

  return (
    <KOSHubLayout hubId={38}>
      <SeoHead
        title="KOS Unified SOC + SEO + kosData.Content AI Autopilot System™ | KHEPRA EXPERTS"
        description="Système unifié autonome 9 agents IA : SOC (sécurité OWASP), SEO/GEO/AEO (visibilité Google + moteurs IA), kosData.Content AI Factory (stratégie, production, conversion). Dashboard KPI temps réel, roadmap 90 jours."
        keywords="KOS Unified Autopilot, SOC security, SEO optimization, GEO visibility, AEO answer engine, kosData.Content AI Factory, kosData.content strategy, OWASP compliance, KHEPRA EXPERTS"
        canonicalPath="/kos-unified-autopilot"
        ogType="website"
        ogLocale={lang === 'fr' ? 'fr_FR' : 'en_US'}
      />

        {/* Hero */}
        <section className="relative pt-32 pb-16 sm:pt-40 sm:pb-20 overflow-hidden bg-foreground-950">
          <div className="absolute inset-0">
            <img
              src="https://readdy.ai/api/search-image?query=abstract%20sophisticated%20dark%20command%20center%20with%20three%20distinct%20interconnected%20layers%20of%20glowing%20nodes%20representing%20cybersecurity%20operations%20center%20with%20red%20orange%20pulse%20lines%20SEO%20intelligence%20with%20emerald%20green%20data%20streams%20and%20content%20AI%20factory%20with%20warm%20amber%20creative%20patterns%20all%20unified%20into%20one%20cohesive%20autonomous%20orchestration%20dashboard%20premium%20corporate%20technology%20atmosphere%20with%20algorithmic%20precision%20and%20layered%20complexity%20no%20text%20no%20human%20figures&width=1920&height=600&seq=kos-unified-hero-bg&orientation=landscape"
              alt=""
              className="w-full h-full object-cover object-center opacity-18"
              width="1920"
              height="600"
            />
          </div>
          <div className="absolute inset-0 bg-gradient-to-b from-foreground-950/60 via-foreground-950/80 to-foreground-950" />

          <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div className="text-center max-w-4xl mx-auto">
              <div className="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/20 border border-emerald-400/30 backdrop-blur-sm mb-6">
                <i className="ri-cpu-line text-emerald-400 text-sm" />
                <span className="text-sm font-semibold text-emerald-300 uppercase tracking-wider">
                  KOS Unified SOC + SEO + kosData.Content AI Autopilot System™
                </span>
              </div>
              <div className="flex justify-center mb-6">
                {loading ? (
                  <div className="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-slate-500/20 border border-slate-400/30 backdrop-blur-sm">
                    <i className="ri-loader-4-line animate-spin text-slate-300" />
                    <span className="text-xs font-bold text-slate-300 uppercase tracking-wider">Chargement des données...</span>
                  </div>
                ) : dataSource === 'supabase' ? (
                  <div className="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/20 border border-emerald-400/30 backdrop-blur-sm">
                    <span className="relative flex h-2.5 w-2.5">
                      <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                      <span className="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
                    </span>
                    <span className="text-xs font-bold text-emerald-300 uppercase tracking-wider">Données Live — Supabase</span>
                  </div>
                ) : (
                  <div className="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-amber-500/20 border border-amber-400/30 backdrop-blur-sm">
                    <span className="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
                    <span className="text-xs font-bold text-amber-300 uppercase tracking-wider">Données Mock — Démo</span>
                  </div>
                )}
                <button
                  onClick={() => refresh()}
                  disabled={loading}
                  className="ml-3 inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-white/10 border border-white/20 backdrop-blur-sm cursor-pointer hover:bg-white/20 transition-all disabled:opacity-50 disabled:cursor-not-allowed whitespace-nowrap"
                  title="Rafraîchir les données depuis Supabase"
                >
                  <i className={`ri-refresh-line text-white text-sm ${loading ? 'animate-spin' : ''}`} />
                  <span className="text-xs font-bold text-white uppercase tracking-wider">
                    {loading ? 'Rafraîchissement...' : 'Rafraîchir'}
                  </span>
                </button>
              </div>
              <h1 className="font-heading text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
                Sécuriser. Optimiser.
                <span className="block text-emerald-400 mt-2">Produire. En Autopilote.</span>
              </h1>
              <p className="text-lg sm:text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
                9 agents autonomes répartis sur 3 couches intégrées.{' '}
                <strong className="text-white">SOC (sécurité OWASP) · SEO/GEO/AEO (visibilité Google + IA) · kosData.Content AI Factory (stratégie, production, conversion).</strong>
              </p>
              <div className="flex flex-wrap justify-center gap-3">
                <div className="flex items-center gap-2 px-4 py-2 rounded-full bg-red-500/20 border border-red-400/30 backdrop-blur-sm">
                  <span className="w-2 h-2 rounded-full bg-red-500" />
                  <span className="text-sm text-red-300 font-semibold">{stats.criticalDetections} Critiques</span>
                </div>
                <div className="flex items-center gap-2 px-4 py-2 rounded-full bg-amber-500/20 border border-amber-400/30 backdrop-blur-sm">
                  <span className="w-2 h-2 rounded-full bg-amber-500" />
                  <span className="text-sm text-amber-300 font-semibold">{stats.majorDetections} Majeures</span>
                </div>
                <div className="flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/20 border border-emerald-400/30 backdrop-blur-sm">
                  <span className="w-2 h-2 rounded-full bg-emerald-500" />
                  <span className="text-sm text-emerald-300 font-semibold">Score {state.globalScore}/10</span>
                </div>
              </div>
            </div>
          </div>
        </section>

        {/* Error Banner */}
        {error && (
          <section className="bg-red-50 border-b border-red-200">
            <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
              <div className="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
                <div className="flex items-center gap-3">
                  <div className="w-10 h-10 rounded-xl bg-red-100 flex items-center justify-center flex-shrink-0">
                    <i className="ri-error-warning-line text-red-600 text-lg" />
                  </div>
                  <div>
                    <h3 className="text-sm font-bold text-red-800">Erreur de chargement Supabase</h3>
                    <p className="text-xs text-red-600 mt-0.5">{error}</p>
                    <p className="text-xs text-red-500 mt-1">Les données mock sont affichées en fallback.</p>
                  </div>
                </div>
                <button
                  onClick={() => refresh()}
                  disabled={loading}
                  className="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-red-600 text-white text-sm font-bold cursor-pointer hover:bg-red-700 transition-all disabled:opacity-50 disabled:cursor-not-allowed whitespace-nowrap"
                >
                  <i className={`ri-refresh-line ${loading ? 'animate-spin' : ''}`} />
                  Réessayer
                </button>
              </div>
            </div>
          </section>
        )}

        {/* Tab Navigation */}
        <section className="sticky top-20 z-30 bg-white border-b border-background-200">
          <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div className="flex gap-1 overflow-x-auto py-3">
              {tabs.map((tab) => (
                <button
                  key={tab.id}
                  onClick={() => setActiveTab(tab.id)}
                  className={`flex items-center gap-2 px-4 py-2.5 rounded-full text-sm font-bold cursor-pointer transition-all whitespace-nowrap ${
                    activeTab === tab.id
                      ? 'bg-foreground-950 text-white'
                      : 'text-foreground-600 hover:bg-background-100 hover:text-foreground-900'
                  }`}
                >
                  <i className={`${tab.icon} text-base`} />
                  {tab.label}
                  <span className={`text-[10px] px-1.5 py-0.5 rounded-full ${activeTab === tab.id ? 'bg-white/20' : 'bg-background-200'}`}>
                    {tab.count}
                  </span>
                </button>
              ))}
            </div>
          </div>
        </section>

        {/* === TAB: DASHBOARD === */}
        {activeTab === 'dashboard' && (
          <>
            {/* 3 Layers Overview */}
            <section className="py-10 sm:py-14">
              <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                {/* Global Score + Core Web Vitals */}
                <div className="grid grid-cols-1 lg:grid-cols-4 gap-5 mb-8">
                  <div className="rounded-3xl bg-white border border-background-200 p-6 sm:p-7 text-center lg:col-span-1">
                    <div className="w-20 h-20 mx-auto mb-4 rounded-full bg-background-100 flex items-center justify-center relative">
                      <svg className="w-20 h-20 transform -rotate-90" viewBox="0 0 80 80">
                        <circle cx="40" cy="40" r="34" fill="none" stroke="currentColor" className="text-background-200" strokeWidth="6" />
                        <circle cx="40" cy="40" r="34" fill="none" stroke="currentColor" className="text-emerald-500" strokeWidth="6"
                          strokeDasharray={`${(state.globalScore / 10) * 2 * Math.PI * 34} ${2 * Math.PI * 34}`}
                          strokeLinecap="round"
                        />
                      </svg>
                      <span className="absolute text-2xl font-bold text-foreground-950 font-heading">{(Number(state.globalScore) || 0).toFixed(1)}</span>
                    </div>
                    <h3 className="font-heading text-lg font-bold text-foreground-950 mb-1">Score Global Unifié</h3>
                    <p className="text-sm text-foreground-500 mb-4">/10 — Standard Big Four</p>
                    <div className="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-50 border border-amber-200">
                      <span className="w-2 h-2 rounded-full bg-amber-500" />
                      <span className="text-xs font-bold text-amber-700">OPTIMISATION EN COURS</span>
                    </div>
                    <p className="text-[10px] text-foreground-400 mt-2">Cible : {state.targetScore}/10</p>
                  </div>

                  <div className="rounded-3xl bg-white border border-background-200 p-6 sm:p-7 lg:col-span-3">
                    <h3 className="font-heading text-base font-bold text-foreground-950 mb-5 flex items-center gap-2">
                      <i className="ri-stack-line text-foreground-600" />
                      3 Couches Intégrées — Scores & Statut
                    </h3>
                    <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                      {layerIds.map((lid) => {
                        const layer = LAYER_CONFIG[lid];
                        const layerData = state.layers[lid] ?? { score: 0, status: 'critical' as const, agents: 0 };
                        const scoreColor = layerData.score >= 8 ? '#86BC25' : layerData.score >= 6 ? '#e8c547' : '#c2410c';
                        return (
                          <div key={lid} className={`rounded-2xl border p-5 ${layer.bgClass}`}>
                            <div className="flex items-center gap-3 mb-4">
                              <div className="w-10 h-10 rounded-xl flex items-center justify-center" style={{ backgroundColor: `${layer.color}15` }}>
                                <i className={`${layer.icon} text-lg`} style={{ color: layer.color }} />
                              </div>
                              <div className="flex-1 min-w-0">
                                <h4 className="text-sm font-bold text-foreground-950 font-heading">{layer.name.split('—')[0].trim()}</h4>
                                <p className="text-[10px] text-foreground-400">{layer.subtitle}</p>
                              </div>
                            </div>
                            <div className="flex items-center justify-between mb-2">
                              <span className="text-xs text-foreground-500">Score</span>
                              <span className="text-lg font-bold font-heading" style={{ color: scoreColor }}>{(Number(layerData.score) || 0).toFixed(1)}/10</span>
                            </div>
                            <div className="w-full h-2 rounded-full bg-background-200 overflow-hidden mb-3">
                              <div
                                className="h-full rounded-full transition-all duration-700"
                                style={{ width: `${(layerData.score / 10) * 100}%`, backgroundColor: scoreColor }}
                              />
                            </div>
                            <div className="flex items-center justify-between text-xs">
                              <span className="text-foreground-500">{layerData.agents} agents</span>
                              <span className={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold ${
                                layerData.status === 'active' ? 'bg-emerald-50 border border-emerald-200 text-emerald-700' :
                                layerData.status === 'warning' ? 'bg-amber-50 border border-amber-200 text-amber-700' :
                                'bg-red-50 border border-red-200 text-red-700'
                              }`}>
                                <span className={`w-1.5 h-1.5 rounded-full ${
                                  layerData.status === 'active' ? 'bg-emerald-500' : layerData.status === 'warning' ? 'bg-amber-500' : 'bg-red-500'
                                }`} />
                                {layerData.status === 'active' ? 'OK' : layerData.status === 'warning' ? 'Attention' : 'Critique'}
                              </span>
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  </div>
                </div>

                {/* Stats Cards */}
                <div className="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-8 gap-3 mb-10">
                  {[
                    { label: 'Agents Actifs', value: `${stats.activeAgents}/${stats.totalAgents}`, icon: 'ri-robot-line', color: '#86BC25' },
                    { label: 'Détections', value: String(stats.totalDetections), icon: 'ri-error-warning-line', color: '#C2410C' },
                    { label: 'Corrigées', value: String(stats.fixedDetections), icon: 'ri-check-double-line', color: '#0D7B5F' },
                    { label: 'Actions planifiées', value: String(stats.totalActions), icon: 'ri-tools-line', color: '#9B7B2C' },
                    { label: 'Terminées', value: String(stats.doneActions), icon: 'ri-check-line', color: '#2D7A3A' },
                    { label: 'En cours', value: String(stats.inProgressActions), icon: 'ri-loader-4-line', color: '#E8C547' },
                    { label: 'Auto-appliquées', value: String(stats.autoApplied), icon: 'ri-flashlight-line', color: '#6B4A3A' },
                    { label: 'Uptime 30j', value: '99.97%', icon: 'ri-server-line', color: '#4A7A1E' },
                  ].map((stat, i) => (
                    <div key={i} className="rounded-xl bg-white border border-background-200 p-4 text-center">
                      <div className="w-8 h-8 mx-auto mb-2 rounded-lg flex items-center justify-center" style={{ backgroundColor: `${stat.color}15` }}>
                        <i className={`${stat.icon} text-sm`} style={{ color: stat.color }} />
                      </div>
                      <span className="block text-lg font-bold text-foreground-950 font-heading">{stat.value}</span>
                      <span className="text-[10px] text-foreground-400">{stat.label}</span>
                    </div>
                  ))}
                </div>

                {/* Architecture Overview */}
                <div className="rounded-3xl bg-foreground-950 p-6 sm:p-8 text-white text-center mb-10">
                  <div className="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/20 border border-emerald-400/30 mb-4">
                    <i className="ri-git-branch-line text-emerald-400 text-sm" />
                    <span className="text-sm font-semibold text-emerald-300 uppercase tracking-wider">Architecture Cible — Pipeline Unifié</span>
                  </div>
                  <div className="flex flex-col md:flex-row items-center justify-center gap-3 md:gap-0 flex-wrap">
                    {[
                      { label: 'SOC Layer', icon: 'ri-shield-check-line', color: '#C2410C' },
                      { label: 'SEO Intelligence', icon: 'ri-search-line', color: '#0D7B5F' },
                      { label: 'kosData.Content AI Factory', icon: 'ri-quill-pen-line', color: '#4A7A1E' },
                      { label: 'Lead Generation', icon: 'ri-user-add-line', color: '#E8C547' },
                      { label: 'CRM / Conversion', icon: 'ri-hand-heart-line', color: '#9B7B2C' },
                      { label: 'Feedback Loop', icon: 'ri-loop-left-line', color: '#86BC25' },
                    ].map((item, i) => (
                      <div key={i} className="flex items-center">
                        <div className="rounded-2xl px-5 py-4 text-center" style={{ backgroundColor: `${item.color}20`, border: `1px solid ${item.color}40` }}>
                          <div className="w-8 h-8 mx-auto mb-1 rounded-lg flex items-center justify-center" style={{ backgroundColor: `${item.color}30` }}>
                            <i className={`${item.icon} text-sm`} style={{ color: item.color }} />
                          </div>
                          <span className="text-xs font-bold text-white whitespace-nowrap">{item.label}</span>
                        </div>
                        {i < 5 && (
                          <div className="text-gray-500 mx-1 flex-shrink-0 hidden md:block">
                            <i className="ri-arrow-right-line text-lg" />
                          </div>
                        )}
                        {i < 5 && (
                          <div className="text-gray-500 my-1 flex-shrink-0 md:hidden">
                            <i className="ri-arrow-down-line text-lg" />
                          </div>
                        )}
                      </div>
                    ))}
                  </div>
                </div>

                {/* Agents Résumé par Layer */}
                <div className="text-center mb-8">
                  <h2 className="font-heading text-3xl sm:text-4xl font-bold text-foreground-950 mb-2">
                    9 Agents Autonomes — 3 Couches
                  </h2>
                  <p className="text-foreground-600 max-w-2xl mx-auto">
                    SOC sécurise · SEO/GEO/AEO rend visible · kosData.Content AI Factory produit et convertit.
                  </p>
                </div>

                {layerIds.map((lid) => {
                  const layer = LAYER_CONFIG[lid];
                  const agents = agentsByLayer[lid];
                  return (
                    <div key={lid} className="mb-8">
                      <div className={`flex items-center gap-3 mb-4 px-4 py-3 rounded-2xl border ${layer.headerBg} ${layer.headerBorder}`}>
                        <div className="w-10 h-10 rounded-xl flex items-center justify-center" style={{ backgroundColor: `${layer.color}15` }}>
                          <i className={`${layer.icon} text-lg`} style={{ color: layer.color }} />
                        </div>
                        <div>
                          <h3 className="font-heading text-base font-bold text-foreground-950">{layer.name}</h3>
                          <p className="text-xs text-foreground-500">{layer.description}</p>
                        </div>
                      </div>
                      <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                        {agents.map((agent) => {
                          const badge = getStatusBadge(agent.status);
                          const scoreColor = agent.score >= 8 ? '#86BC25' : agent.score >= 6 ? '#e8c547' : '#c2410c';
                          return (
                            <div
                              key={agent.id}
                              className="rounded-2xl bg-white border border-background-200 p-5 hover:shadow-md transition-all cursor-pointer"
                              onClick={() => {
                                setExpandedAgent(expandedAgent === agent.id ? null : agent.id);
                                if (agent.layer === 'soc') setActiveTab('soc');
                                else if (agent.layer === 'seo-geo-aeo') setActiveTab('seo-geo');
                                else setActiveTab('kosData.content');
                              }}
                            >
                              <div className="flex items-center gap-2.5 mb-2">
                                <div className="w-9 h-9 rounded-lg flex items-center justify-center flex-shrink-0" style={{ backgroundColor: `${agent.color}15` }}>
                                  <i className={`${agent.icon} text-sm`} style={{ color: agent.color }} />
                                </div>
                                <div className="flex-1 min-w-0">
                                  <h4 className="text-sm font-bold text-foreground-950 truncate">{agent.name}</h4>
                                </div>
                                <span className={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold flex-shrink-0 ${badge.bg} ${badge.border} ${badge.text}`}>
                                  <span className={`w-1.5 h-1.5 rounded-full ${badge.dot}`} />
                                  {badge.label}
                                </span>
                              </div>
                              <p className="text-xs text-foreground-500 line-clamp-2 mb-3">{agent.mission}</p>
                              <div className="flex items-center justify-between text-xs">
                                <span className="flex items-center gap-1">
                                  <span className="font-bold font-heading text-base" style={{ color: scoreColor }}>{(Number(agent.score) || 0).toFixed(1)}</span>
                                  <span className="text-foreground-400">/10</span>
                                </span>
                                <span className="text-foreground-400">
                                  <i className="ri-error-warning-line mr-1" />{agent.detections.length} détections
                                </span>
                              </div>
                            </div>
                          );
                        })}
                      </div>
                    </div>
                  );
                })}
              </div>
            </section>
          </>
        )}

        {/* === TAB: SOC === */}
        {activeTab === 'soc' && (
          <LayerDetailSection
            layerId="soc"
            agents={agentsByLayer.soc}
            expandedAgent={expandedAgent}
            setExpandedAgent={setExpandedAgent}
          />
        )}

        {/* === TAB: SEO/GEO/AEO === */}
        {activeTab === 'seo-geo' && (
          <LayerDetailSection
            layerId="seo-geo-aeo"
            agents={agentsByLayer['seo-geo-aeo']}
            expandedAgent={expandedAgent}
            setExpandedAgent={setExpandedAgent}
          />
        )}

        {/* === TAB: kosData.CONTENT AI === */}
        {activeTab === 'kosData.content' && (
          <LayerDetailSection
            layerId="kosData.content-ai"
            agents={agentsByLayer['kosData.content-ai']}
            expandedAgent={expandedAgent}
            setExpandedAgent={setExpandedAgent}
          />
        )}

        {/* === TAB: WORKFLOW === */}
        {activeTab === 'workflow' && (
          <section className="py-10 sm:py-14">
            <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
              <div className="text-center mb-10">
                <h2 className="font-heading text-3xl sm:text-4xl font-bold text-foreground-950 mb-4">
                  Boucle Autonome — 5 Phases
                </h2>
                <p className="text-foreground-600 max-w-2xl mx-auto">
                  Scan Global → Diagnostic Intelligent → Correction Automatique → Optimisation Continue → Feedback Loop.
                </p>
              </div>

              <div className="space-y-4">
                {workflowPhases.map((phase, i) => (
                  <div key={i} className="relative">
                    {i < workflowPhases.length - 1 && (
                      <div className="absolute left-8 top-20 bottom-0 w-0.5 bg-background-200 hidden md:block" />
                    )}
                    <div className="rounded-2xl bg-white border border-background-200 overflow-hidden">
                      <div className="p-5 sm:p-6 flex flex-col md:flex-row items-start gap-5">
                        <div className="flex flex-col items-center flex-shrink-0">
                          <div className="w-14 h-14 rounded-2xl flex items-center justify-center" style={{ backgroundColor: `${phase.color}15` }}>
                            <i className={`${phase.icon} text-2xl`} style={{ color: phase.color }} />
                          </div>
                          <span className="text-3xl font-bold font-heading mt-2" style={{ color: phase.color }}>{phase.phase}</span>
                        </div>
                        <div className="flex-1 min-w-0">
                          <div className="flex items-center gap-3 mb-2">
                            <h3 className="font-heading text-lg font-bold text-foreground-950">{phase.name}</h3>
                            <span className={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold ${
                              phase.status === 'completed' ? 'bg-emerald-50 border border-emerald-200 text-emerald-700' :
                              phase.status === 'in_progress' ? 'bg-amber-50 border border-amber-200 text-amber-700' :
                              'bg-slate-50 border border-slate-200 text-slate-500'
                            }`}>
                              <i className={phase.status === 'completed' ? 'ri-checkbox-circle-fill text-emerald-500' : phase.status === 'in_progress' ? 'ri-loader-4-line text-amber-500 animate-spin' : 'ri-time-line text-slate-300'} />
                              {phase.status === 'completed' ? 'Terminé' : phase.status === 'in_progress' ? 'En cours' : 'Planifié'}
                            </span>
                          </div>
                          <p className="text-sm text-foreground-600 leading-relaxed">{phase.description}</p>
                          <span className="inline-flex items-center gap-1 mt-3 text-xs text-foreground-400">
                            <i className="ri-time-line" />
                            Durée : {phase.duration}
                          </span>
                        </div>
                      </div>
                    </div>
                  </div>
                ))}
              </div>

              <div className="mt-10 rounded-2xl bg-foreground-950 p-6 sm:p-8 text-white text-center">
                <div className="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/20 border border-emerald-400/30 mb-4">
                  <i className="ri-refresh-line text-emerald-400 text-sm" />
                  <span className="text-sm font-semibold text-emerald-300 uppercase tracking-wider">Boucle Continue — Scan toutes les 24h</span>
                </div>
                <p className="text-gray-300 max-w-xl mx-auto text-sm">
                  Prochain scan complet programmé le {new Date(Date.now() + 86400000).toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long' })} à 03:00 UTC. Durée estimée : 18 minutes (SOC + SEO + kosData.Content).
                </p>
              </div>
            </div>
          </section>
        )}

        {/* === TAB: KPIs UNIFIÉS === */}
        {activeTab === 'kpis' && (
          <section className="py-10 sm:py-14">
            <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
              <div className="text-center mb-10">
                <h2 className="font-heading text-3xl sm:text-4xl font-bold text-foreground-950 mb-4">
                  KPIs Unifiés — 12 Indicateurs
                </h2>
                <p className="text-foreground-600 max-w-2xl mx-auto">
                  SOC · SEO · kosData.Content — mesurés et optimisés en continu. 10/12 en tendance haussière.
                </p>
              </div>

              {(['soc', 'seo', 'kosData.content'] as const).map((cat) => {
                const catKPIs = kpis.filter((k) => k.category === cat);
                const catLabel = cat === 'soc' ? '🔐 SOC KPIs' : cat === 'seo' ? '📈 SEO KPIs' : '🧠 kosData.CONTENT KPIs';
                const catColor = cat === 'soc' ? '#C2410C' : cat === 'seo' ? '#0D7B5F' : '#4A7A1E';
                return (
                  <div key={cat} className="mb-10">
                    <h3 className="font-heading text-lg font-bold text-foreground-950 mb-4 flex items-center gap-2">
                      <div className="w-2 h-6 rounded-full" style={{ backgroundColor: catColor }} />
                      {catLabel}
                    </h3>
                    <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                      {catKPIs.map((kpi) => (
                        <div key={kpi.id} className="rounded-2xl bg-white border border-background-200 p-5 hover:shadow-md transition-all">
                          <div className="flex items-center gap-2 mb-3">
                            <div className="w-8 h-8 rounded-lg flex items-center justify-center" style={{ backgroundColor: `${catColor}15` }}>
                              <i className={`${kpi.icon} text-sm`} style={{ color: catColor }} />
                            </div>
                            <span className="text-[10px] text-foreground-400 uppercase tracking-wider">{kpi.label}</span>
                          </div>
                          <div className="flex items-baseline gap-2">
                            <span className="text-3xl font-bold text-foreground-950 font-heading">{kpi.current}</span>
                            <span className="text-xs text-foreground-400">/ {kpi.target} {kpi.unit}</span>
                          </div>
                          <span className={`inline-flex items-center gap-1 mt-2 text-xs font-bold ${kpi.trend === 'up' ? 'text-emerald-600' : kpi.trend === 'down' ? 'text-red-600' : 'text-foreground-400'}`}>
                            <i className={`${kpi.trend === 'up' ? 'ri-arrow-up-line' : kpi.trend === 'down' ? 'ri-arrow-down-line' : 'ri-arrow-right-line'} text-xs`} />
                            {kpi.trend === 'up' ? 'En hausse' : kpi.trend === 'down' ? 'En baisse' : 'Stable'}
                          </span>
                        </div>
                      ))}
                    </div>
                  </div>
                );
              })}
            </div>
          </section>
        )}

        {/* === TAB: ROADMAP === */}
        {activeTab === 'roadmap' && (
          <section className="py-10 sm:py-14">
            <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
              <div className="text-center mb-10">
                <h2 className="font-heading text-3xl sm:text-4xl font-bold text-foreground-950 mb-4">
                  Roadmap 7 / 30 / 90 Jours
                </h2>
                <p className="text-foreground-600 max-w-2xl mx-auto">
                  Plan d'amélioration continue avec jalons mesurables et livrables vérifiables.
                </p>
              </div>

              <div className="space-y-6">
                {roadmap.map((item) => (
                  <div key={item.id} className="rounded-2xl bg-white border border-background-200 overflow-hidden">
                    <div className="flex flex-col lg:flex-row">
                      <div className="lg:w-80 flex-shrink-0 p-6 flex flex-col items-center justify-center text-center" style={{ backgroundColor: `${item.color}08` }}>
                        <div className="text-6xl font-bold font-heading mb-2" style={{ color: item.color }}>{item.timeline}</div>
                        <span className="text-xs text-foreground-500">Progression</span>
                        <div className="w-full max-w-[160px] h-2 rounded-full bg-background-200 overflow-hidden mt-2">
                          <div
                            className="h-full rounded-full transition-all duration-700"
                            style={{ width: `${item.progress}%`, backgroundColor: item.color }}
                          />
                        </div>
                        <span className="text-xs font-bold mt-1" style={{ color: item.color }}>{item.progress}%</span>
                      </div>
                      <div className="flex-1 p-6">
                        <div className="flex items-center gap-3 mb-3">
                          <div className="w-10 h-10 rounded-xl flex items-center justify-center" style={{ backgroundColor: `${item.color}15` }}>
                            <i className={`${item.icon} text-lg`} style={{ color: item.color }} />
                          </div>
                          <h3 className="font-heading text-lg font-bold text-foreground-950">{item.title}</h3>
                        </div>
                        <p className="text-sm text-foreground-600 leading-relaxed mb-4">{item.description}</p>
                        <div className="grid grid-cols-1 sm:grid-cols-2 gap-2">
                          {item.deliverables.map((del, j) => (
                            <div key={j} className="flex items-center gap-2 text-xs text-foreground-600">
                              <i className="ri-checkbox-circle-line text-emerald-500 text-sm flex-shrink-0" />
                              {del}
                            </div>
                          ))}
                        </div>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </section>
        )}

        {/* === TAB: REPORTS === */}
        {activeTab === 'reports' && (
          <section className="py-10 sm:py-14">
            <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
              <div className="text-center mb-10">
                <h2 className="font-heading text-3xl sm:text-4xl font-bold text-foreground-950 mb-4">
                  6 Rapports Autonomes
                </h2>
                <p className="text-foreground-600 max-w-2xl mx-auto">
                  Générés le {new Date(state.generatedAt).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit' })}.
                  Mise à jour automatique toutes les 24h.
                </p>
              </div>

              <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                {reports.map((section) => (
                  <div key={section.id} className="rounded-2xl bg-white border border-background-200 p-5 hover:shadow-md transition-all">
                    <div className="flex items-center gap-3 mb-3">
                      <div className="w-10 h-10 rounded-xl bg-foreground-950 flex items-center justify-center">
                        <i className={`${section.icon} text-white text-lg`} />
                      </div>
                      <h3 className="font-heading text-base font-bold text-foreground-950">{section.title}</h3>
                    </div>
                    <p className="text-sm text-foreground-600 leading-relaxed">{section.description}</p>
                  </div>
                ))}
              </div>

              <div className="mt-10 rounded-3xl bg-foreground-950 p-6 sm:p-8 text-white text-center">
                <div className="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/20 border border-emerald-400/30 mb-4">
                  <i className="ri-download-2-line text-emerald-400 text-sm" />
                  <span className="text-sm font-semibold text-emerald-300 uppercase tracking-wider">Rapport Exécutif — Génération Automatique</span>
                </div>
                <p className="text-gray-300 max-w-xl mx-auto text-sm mb-6">
                  Le rapport complet (PDF 18 pages) est généré automatiquement après chaque scan. Il inclut tous les KPIs, détections, actions correctives et roadmap.
                </p>
                <div className="flex flex-wrap justify-center gap-3">
                  {['SOC Global', 'SEO & Visibilité', 'Contenu & Autorité', 'Corrections Auto', 'Roadmap 90J', 'KPIs Unifiés'].map((label) => (
                    <span key={label} className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/10 border border-white/20 text-white text-xs">
                      <i className="ri-check-line text-emerald-400" />
                      {label}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </section>
        )}

        {/* === TAB: RAG === */}
        {activeTab === 'rag' && (
          <section className="py-10 sm:py-14">
            <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
              <div className="text-center mb-10">
                <div className="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/20 border border-emerald-400/30 backdrop-blur-sm mb-4">
                  <i className="ri-flashlight-line text-emerald-400 text-sm" />
                  <span className="text-sm font-semibold text-emerald-300 uppercase tracking-wider">
                    SWITCH 1 ACTIVÉ — AUTOPILOT RAG 10X
                  </span>
                </div>
                <h2 className="font-heading text-3xl sm:text-4xl font-bold text-foreground-950 mb-4">
                  Autopilot RAG — Embedding 3M
                </h2>
                <p className="text-foreground-600 max-w-2xl mx-auto">
                  Moteur RAG passé de <strong>1.1M à 3M embeddings</strong>. Auto-reembed activé sur nouveaux documents.
                  Time-to-find <strong>-50%</strong>. Google SGE rank <strong>+1</strong>.
                </p>
              </div>

              {/* Upgrade Banner */}
              <div className="rounded-3xl bg-foreground-950 p-6 sm:p-8 text-white mb-8">
                <div className="flex flex-col lg:flex-row items-center gap-6">
                  <div className="flex-1">
                    <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 border border-emerald-400/30 mb-3">
                      <span className="relative flex h-2 w-2">
                        <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                        <span className="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                      </span>
                      <span className="text-xs font-bold text-emerald-300">{autopilotRAG.status}</span>
                    </div>
                    <h3 className="font-heading text-2xl font-bold text-white mb-2">
                      Embedding Model : {autopilotRAG.embedding_model.previous} → {autopilotRAG.embedding_model.current}
                    </h3>
                    <p className="text-gray-400 text-sm leading-relaxed mb-4">
                      {autopilotRAG.embedding_model.model}
                    </p>
                  </div>
                  <div className="flex-shrink-0 text-center px-8 py-5 rounded-2xl bg-emerald-500/10 border border-emerald-400/20">
                    <div className="text-4xl font-bold text-emerald-400 font-heading">{autopilotRAG.performance_kpis.improvement_percent}%</div>
                    <div className="text-xs text-emerald-300 mt-1">Plus Rapide</div>
                  </div>
                </div>
              </div>

              {/* Stats Grid */}
              <div className="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
                {[
                  { label: 'Embeddings', value: '3M', icon: 'ri-database-2-line', color: '#86BC25', sub: `${autopilotRAG.embedding_model.vector_dimensions}d vectors` },
                  { label: 'Time-to-Find', value: `${autopilotRAG.performance_kpis.time_to_find_ms}ms`, icon: 'ri-timer-flash-line', color: '#0D7B5F', sub: `Avant: ${autopilotRAG.performance_kpis.time_to_find_before_ms}ms` },
                  { label: 'SGE Rank', value: `#${autopilotRAG.performance_kpis.google_sge_rank}`, icon: 'ri-google-line', color: '#E8C547', sub: `Avant: #${autopilotRAG.performance_kpis.google_sge_rank_before}` },
                  { label: 'Précision', value: `${autopilotRAG.performance_kpis.avg_precision}%`, icon: 'ri-focus-2-line', color: '#4A7A1E', sub: `${autopilotRAG.performance_kpis.queries_per_day.toLocaleString()} requêtes/j` },
                ].map((stat, i) => (
                  <div key={i} className="rounded-2xl bg-white border border-background-200 p-5 text-center">
                    <div className="w-10 h-10 mx-auto mb-3 rounded-xl flex items-center justify-center" style={{ backgroundColor: `${stat.color}15` }}>
                      <i className={`${stat.icon} text-lg`} style={{ color: stat.color }} />
                    </div>
                    <span className="block text-2xl font-bold text-foreground-950 font-heading">{stat.value}</span>
                    <span className="text-xs text-foreground-500">{stat.label}</span>
                    <span className="block text-[10px] text-foreground-400 mt-1">{stat.sub}</span>
                  </div>
                ))}
              </div>

              {/* Auto-Reembed Status */}
              <div className="rounded-2xl bg-white border border-background-200 p-6 mb-6">
                <h3 className="font-heading text-lg font-bold text-foreground-950 mb-4 flex items-center gap-2">
                  <div className="w-3 h-3 rounded-full bg-emerald-500 animate-pulse" />
                  Auto-Reembed — {autopilotRAG.embedding_model.auto_reembed.status}
                </h3>
                <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
                  <div className="rounded-xl bg-background-50 border border-background-100 p-4">
                    <span className="text-[10px] text-foreground-400 uppercase tracking-wider">Documents/jour</span>
                    <p className="text-lg font-bold text-foreground-950 mt-1">{autopilotRAG.embedding_model.auto_reembed.documents_processed_day}</p>
                  </div>
                  <div className="rounded-xl bg-background-50 border border-background-100 p-4">
                    <span className="text-[10px] text-foreground-400 uppercase tracking-wider">Latence Moy.</span>
                    <p className="text-lg font-bold text-foreground-950 mt-1">{autopilotRAG.embedding_model.auto_reembed.avg_latency_ms}ms</p>
                  </div>
                  <div className="rounded-xl bg-background-50 border border-background-100 p-4">
                    <span className="text-[10px] text-foreground-400 uppercase tracking-wider">File d'attente</span>
                    <p className="text-lg font-bold text-emerald-600 mt-1">{autopilotRAG.embedding_model.auto_reembed.queue_size}</p>
                  </div>
                </div>
                <p className="text-xs text-foreground-500 mt-4 p-3 rounded-lg bg-background-50 border border-background-100">
                  <i className="ri-information-line mr-1 text-emerald-500" />
                  Trigger : {autopilotRAG.embedding_model.auto_reembed.trigger}
                </p>
              </div>

              {/* Effet 90j + Edge Functions */}
              <div className="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
                <div className="rounded-2xl bg-white border border-background-200 p-6">
                  <h3 className="font-heading text-base font-bold text-foreground-950 mb-3 flex items-center gap-2">
                    <i className="ri-timer-line text-amber-500" />
                    Effet 90 Jours
                  </h3>
                  <div className="p-4 rounded-xl bg-amber-50/50 border border-amber-100">
                    <p className="text-sm text-foreground-700 leading-relaxed">{autopilotRAG.effect_90j}</p>
                    <div className="flex items-center gap-1 mt-2 text-xs text-amber-600">
                      <i className="ri-check-double-line" />
                      <span>Cache hit rate : {autopilotRAG.performance_kpis.cache_hit_rate}%</span>
