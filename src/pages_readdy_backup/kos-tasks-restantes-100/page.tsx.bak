// ===== GAP BLOC CARD =====
function GapBlocCard({ bloc, onClick }: { bloc: BlocTachesRestantes; onClick: () => void }) {
  const sc = getScoreColor(bloc.scoreActuel);
  const gc = getGapColor(bloc.gapResiduel);
  return (
    <div className="bg-background-50 border border-background-200/60 rounded-xl p-4 hover:border-background-300/80 transition-all cursor-pointer group" onClick={onClick}>
      <div className="flex items-start gap-4 flex-col sm:flex-row">
        <div className="flex items-center gap-3 shrink-0">
          <div className="w-10 h-10 rounded-lg flex items-center justify-center bg-primary-100 text-primary-700">
            <span className="text-lg font-bold font-mono">{bloc.numero}</span>
          </div>
        </div>
        <div className="flex-1 min-w-0">
          <div className="flex items-center gap-2 mb-1 flex-wrap">
            <h3 className="text-sm font-bold text-foreground-950">{bloc.nom}</h3>
            <Badge label={bloc.gapResiduel + ' pts gap'} variant={gc === 'red' ? 'critique' : gc === 'amber' ? 'P1' : 'maitrise'} />
          </div>
          <p className="text-xs text-foreground-500 mb-2">{bloc.acronyme} · {bloc.responsable}</p>
          {/* Score bar */}
          <div className="flex items-center gap-3 mb-2">
            <div className="flex items-center gap-1">
              <span className="text-[10px] text-foreground-500">{bloc.scoreActuel}</span>
              <div className="w-24 h-1.5 bg-background-200 rounded-full overflow-hidden">
                <div className="h-1.5 bg-amber-500 rounded-full" style={{ width: `${bloc.scoreCibleBloc}%` }}></div>
              </div>
              <span className="text-[10px] text-amber-600 font-medium">{bloc.scoreCibleBloc}</span>
            </div>
            <span className="text-[9px] text-foreground-400">→</span>
            <span className="text-[10px] text-emerald-600 font-bold">100</span>
          </div>
          <div className="flex items-center gap-3 flex-wrap text-[10px] text-foreground-500">
            <span><i className="ri-tools-line mr-0.5"></i>{bloc.taches.length} tâches</span>
            <span><i className="ri-money-dollar-circle-line mr-0.5"></i>{bloc.budgetTotal}</span>
            <span><i className="ri-medal-line mr-0.5"></i>{bloc.standards.length} standards</span>
            <div className="flex-1 hidden sm:block"></div>
            <span className="text-xs text-emerald-600 font-medium">{bloc.jalon100.split(' —')[0].substring(0, 40)}...</span>
          </div>
        </div>
        <div className="shrink-0 flex items-center gap-2">
          <CircularGauge value={bloc.scoreActuel} size={40} strokeWidth={3} color={sc} />
          <i className="ri-arrow-right-line text-xs text-foreground-400 group-hover:text-foreground-700 transition-colors"></i>
        </div>
      </div>
    </div>
  );
}

// ===== TACHE CARD =====
function TacheCard({ tache, showBloc = false }: { tache: TacheRestante & { bloc?: BlocTachesRestantes }; showBloc?: boolean }) {
  const [expanded, setExpanded] = useState(false);
  return (
    <div className="bg-background-50 border border-background-200/60 rounded-lg p-4 cursor-pointer hover:border-background-300/80 transition-colors" onClick={() => setExpanded(!expanded)}>
      <div className="flex items-start justify-between gap-3">
        <div className="flex items-center gap-2 shrink-0">
          <Badge label={tache.statut === 'non_demarre' ? 'À faire' : tache.statut === 'en_cours' ? 'En cours' : tache.statut === 'termine' ? 'Terminé' : 'Bloqué'} variant={tache.statut} />
        </div>
        <div className="flex-1 min-w-0">
          <div className="flex items-center gap-2 mb-0.5 flex-wrap">
            <span className="text-[10px] font-mono text-foreground-400">{tache.id}</span>
            {showBloc && tache.bloc && (
              <span className="text-[9px] px-1.5 py-0.5 rounded-full bg-primary-100 text-primary-700 whitespace-nowrap">{tache.bloc.numero} {tache.bloc.acronyme}</span>
            )}
            <span className="text-[10px] px-1.5 py-0.5 rounded-full bg-accent-100 text-accent-700 whitespace-nowrap">{tache.standardVise}</span>
          </div>
          <h4 className="text-sm font-semibold text-foreground-950 mb-1">{tache.action}</h4>
          <div className="flex items-center gap-3 text-[10px] text-foreground-500 flex-wrap">
            <span><i className="ri-money-dollar-circle-line mr-0.5"></i>{tache.budget}</span>
            <span><i className="ri-time-line mr-0.5"></i>{tache.effort}</span>
            <span><i className="ri-user-line mr-0.5"></i>{tache.responsable}</span>
            <span><i className="ri-calendar-line mr-0.5"></i>{tache.deadline}</span>
          </div>
        </div>
        <div className="shrink-0">
          {expanded ? <i className="ri-arrow-up-s-line text-xs text-foreground-400"></i> : <i className="ri-arrow-down-s-line text-xs text-foreground-400"></i>}
        </div>
      </div>
      {expanded && (
        <div className="mt-3 pt-3 border-t border-background-200/40 space-y-2">
          <p className="text-xs text-foreground-600 leading-relaxed">{tache.description}</p>
          <div className="bg-red-50 border border-red-100 rounded p-2">
            <p className="text-[10px] text-red-700 leading-relaxed"><strong>Pourquoi ce gap :</strong> {tache.pourquoiCeGap}</p>
          </div>
          <div className="flex items-center gap-3 text-[10px] flex-wrap">
            <span className="bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded-full"><i className="ri-flag-line mr-0.5"></i>KPI 100% : {tache.kpi100}</span>
            <span className="bg-background-100 text-foreground-600 px-2 py-0.5 rounded-full"><i className="ri-file-list-3-line mr-0.5"></i>Livrable : {tache.livrable}</span>
          </div>
        </div>
      )}
    </div>
  );
}

// ===== STANDARD GAP CARD =====
function StandardGapCard({ standard, showBloc = false }: { standard: GapStandard & { bloc?: BlocTachesRestantes }; showBloc?: boolean }) {
  return (
    <div className="bg-background-50 border border-background-200/60 rounded-lg p-3">
      <div className="flex items-center gap-2 mb-2 flex-wrap">
        {showBloc && standard.bloc && (
          <span className="text-[9px] px-1.5 py-0.5 rounded-full bg-primary-100 text-primary-700 whitespace-nowrap">{standard.bloc.numero} {standard.bloc.acronyme}</span>
        )}
        <span className="text-xs font-bold text-foreground-950">{standard.standard}</span>
        <Badge label={'Écart ' + standard.ecartResiduel + ' pts'} variant={standard.ecartResiduel >= 50 ? 'critique' : standard.ecartResiduel >= 25 ? 'P1' : 'maitrise'} />
      </div>
      <div className="flex items-center gap-2 mb-1.5">
        <span className="text-[10px] text-foreground-500">{standard.scoreActuel}%</span>
        <div className="flex-1 h-1.5 bg-background-200 rounded-full overflow-hidden">
          <div className="h-1.5 bg-amber-500/60 rounded-full" style={{ width: `${standard.scoreCibleBloc}%` }}></div>
        </div>
        <span className="text-[10px] text-amber-600 font-medium">{standard.scoreCibleBloc}%</span>
        <span className="text-[9px] text-foreground-400">→</span>
        <span className="text-[10px] text-emerald-600 font-bold">100%</span>
      </div>
      <ProgressBar value={standard.scoreCibleBloc} color="amber" />
      <div className="flex items-center gap-1 mt-1 text-[9px] text-foreground-500">
        <span>Actions :</span>
        {standard.actionsLiees.map(a => (
          <span key={a} className="px-1.5 py-0.5 bg-background-100 rounded-full font-mono">{a}</span>
        ))}
      </div>
    </div>
  );
}
