                  backgroundColor: kpi.progress < 5 ? '#EF4444' : kpi.progress < 20 ? '#F59E0B' : '#10B981',
                }} />
              </div>
            </div>
          ))}
        </div>

        {/* Velocity Chart */}
        <div className="rounded-2xl bg-white border border-background-200 p-6 mb-8">
          <h3 className="font-heading text-lg font-bold text-foreground-950 mb-4">Vélocité de Production</h3>
          <div className="grid grid-cols-2 sm:grid-cols-4 gap-4 text-center">
            <div>
              <span className="block text-3xl font-bold text-accent-500">{overview.production_velocity.daily}</span>
              <span className="text-xs text-foreground-500">Productions/Jour</span>
              <span className="block text-xs mt-1" style={{ color: overview.production_velocity.trend > 0 ? '#059669' : '#DC2626' }}>
                {overview.production_velocity.trend > 0 ? '▲' : '▼'} {Math.abs(overview.production_velocity.trend)}%
              </span>
            </div>
            <div>
              <span className="block text-3xl font-bold text-foreground-950">{overview.production_velocity.weekly}</span>
              <span className="text-xs text-foreground-500">Productions/Semaine</span>
            </div>
            <div>
              <span className="block text-3xl font-bold text-foreground-950">{overview.production_velocity.monthly}</span>
              <span className="text-xs text-foreground-500">Productions/Mois</span>
            </div>
            <div>
              <span className="block text-3xl font-bold" style={{ color: overview.quality_gate.current_avg >= 95 ? '#059669' : '#D97706' }}>
                {overview.quality_gate.current_avg}/100
              </span>
              <span className="text-xs text-foreground-500">Score Qualité</span>
            </div>
          </div>
        </div>

        {/* Quality Gate */}
        <div className="rounded-2xl bg-white border border-background-200 p-6">
          <h3 className="font-heading text-lg font-bold text-foreground-950 mb-4">Quality Gate — Seuil ≥ 95/100</h3>
          <div className="flex items-center gap-6">
            <div className="text-center">
              <span className="block text-4xl font-bold" style={{ color: overview.quality_gate.current_avg >= 95 ? '#059669' : '#D97706' }}>
                {overview.quality_gate.current_avg}
              </span>
              <span className="text-xs text-foreground-500">Score Moyen</span>
            </div>
            <div className="flex-1">
              <div className="flex items-center justify-between text-xs mb-1">
                <span className="text-foreground-500">Seuil 95/100</span>
                <span className="font-bold text-foreground-800">{overview.quality_gate.passed}/{overview.quality_gate.passed + overview.quality_gate.failed} passés</span>
              </div>
              <div className="w-full h-3 rounded-full bg-background-100 overflow-hidden">
                <div className="h-full rounded-full flex" style={{ width: `${overview.quality_gate.current_avg}%` }}>
                  <div className="h-full bg-green-500" style={{ width: `${Math.min(100, (overview.quality_gate.threshold / overview.quality_gate.current_avg) * 100)}%` }} />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  );

  const activeTabData = tabs.find(t => t.id === activeTab);

  return (
    <KOSHubLayout hubId={64} activeTab={activeTab} tabLabel={activeTabData?.label}>
      <SeoHead
        title="KOS kosData.Content Factory Command™ — Orchestration des 13 Blocs de Production | KHEPRA EXPERTS"
        description="Hub central d'orchestration de la production de contenu Big Four. 13 blocs interconnectés : veille stratégique, SEO/GEO, rédaction, lead magnets, études de cas, livres blancs, méthodologies, qualité. Pipeline automatisé."
        keywords="KOS kosData.Content Factory Command, production contenu Big Four, orchestration éditoriale, kosData.content marketing IA, SEO GEO, KHEPRA EXPERTS"
        canonicalPath="/kos-kosData.content-factory-command"
        ogType="website"
        ogLocale={lang === 'fr' ? 'fr_FR' : 'en_US'}
      />

      {/* Hero */}
      <section className="relative bg-background-100 border-b border-background-200/70">
        <div className="absolute inset-0">
          <img
            src="https://readdy.ai/api/search-image?query=Abstract%20editorial%20content%20factory%20orchestration%20visualization%20with%20warm%20amber%20and%20crimson%20tones%2C%20interconnected%20geometric%20nodes%20representing%20content%20production%20blocks%2C%20sophisticated%20publishing%20atmosphere%20with%20flowing%20data%20streams%2C%20premium%20editorial%20command%20center%20aesthetic%20with%20rich%20textures%2C%20no%20text%20no%20human%20figures&width=1920&height=600&seq=kos-cf-hero&orientation=landscape"
            alt=""
            className="w-full h-full object-cover object-center opacity-18"
            width="1920"
            height="600"
          />
        </div>
        <div className="absolute inset-0 bg-gradient-to-b from-foreground-950/60 via-foreground-950/80 to-foreground-950" />

        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
          <div className="text-center max-w-4xl mx-auto">
            <div className="flex flex-wrap justify-center gap-3 mb-6">
              <div className="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-accent-500/20 border border-accent-400/30 backdrop-blur-sm">
                <i className="ri-stack-line text-accent-400 text-sm" />
                <span className="text-sm font-semibold text-accent-300 uppercase tracking-wider">
                  KOS kosData.Content Factory Command™
                </span>
              </div>
              <div className={`inline-flex items-center gap-2 px-4 py-2 rounded-full backdrop-blur-sm ${
                source === 'live' ? 'bg-emerald-500/20 border border-emerald-400/30' : 'bg-amber-500/20 border border-amber-400/30'
              }`}>
                <span className={`w-2 h-2 rounded-full ${source === 'live' ? 'bg-emerald-400 animate-pulse' : 'bg-amber-400'}`} />
                <span className={`text-sm font-semibold uppercase tracking-wider ${source === 'live' ? 'text-emerald-300' : 'text-amber-300'}`}>
                  {source === 'live' ? 'DONNÉES LIVE — SUPABASE' : 'DONNÉES MOCK — DÉMO'}
                </span>
              </div>
              <div className="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-green-500/20 border border-green-400/30 backdrop-blur-sm">
                <i className="ri-robot-line text-green-400 text-sm" />
                <span className="text-sm font-semibold text-green-300 uppercase tracking-wider">
                  9 Agents AUTO
                </span>
              </div>
            </div>
            <h1 className="font-heading text-4xl sm:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
              L'usine à contenu autonome.
              <span className="block text-accent-400 mt-2">13 blocs orchestrés. Niveau Big Four.</span>
            </h1>
            <p className="text-lg sm:text-xl text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
              <strong className="text-white">{blocks.length} blocs</strong> interconnectés formant la chaîne de production éditoriale complète.{' '}
              De la veille réglementaire à la publication cross-canal.{' '}
              <strong className="text-white">{totalPipeline} contenus</strong> en pipeline.{' '}
              Score qualité cible : <strong className="text-white">≥ 95/100</strong>.
            </p>
            <div className="flex flex-wrap justify-center gap-3">
              <div className="flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-500/20 border border-emerald-400/30 backdrop-blur-sm">
                <span className="w-2 h-2 rounded-full bg-emerald-500 animate-pulse" />
                <span className="text-sm text-emerald-300 font-semibold">{activeCount} Blocs Actifs</span>
              </div>
              <div className="flex items-center gap-2 px-4 py-2 rounded-full bg-red-500/20 border border-red-400/30 backdrop-blur-sm">
                <i className="ri-error-warning-line text-red-400" />
                <span className="text-sm text-red-300 font-semibold">{criticalCount} Critiques</span>
              </div>
              <div className="flex items-center gap-2 px-4 py-2 rounded-full bg-accent-500/20 border border-accent-400/30 backdrop-blur-sm">
                <i className="ri-stack-line text-accent-400" />
                <span className="text-sm text-accent-300 font-semibold">{totalPipeline} Pipeline</span>
              </div>
              <div className="flex items-center gap-2 px-4 py-2 rounded-full bg-amber-500/20 border border-amber-400/30 backdrop-blur-sm">
                <i className="ri-timer-line text-amber-400" />
                <span className="text-sm text-amber-300 font-semibold">{overview.production_velocity.weekly}/sem.</span>
              </div>
              <div className="flex items-center gap-2 px-4 py-2 rounded-full bg-violet-500/20 border border-violet-400/30 backdrop-blur-sm">
                <i className="ri-robot-line text-violet-400" />
                <span className="text-sm text-violet-300 font-semibold">9 Agents AUTO</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* Tab bar */}
      <div className="sticky top-0 z-30 bg-background-50 border-b border-background-200/70">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2 flex gap-1 overflow-x-auto">
          {tabs.map(tab => (
            <button
              key={tab.id}
              onClick={() => { setActiveTab(tab.id); setExpandedBlockId(null); }}
              className={`whitespace-nowrap px-4 py-2 rounded-full text-xs font-bold cursor-pointer transition-all flex items-center gap-1.5 ${
                activeTab === tab.id ? 'bg-foreground-950 text-white' : 'bg-background-50 border border-background-200 text-foreground-600 hover:border-foreground-300'
              }`}
            >
              <i className={tab.icon} />
              {tab.label}
              {tab.count > 0 && (
                <span className={`text-[10px] px-1.5 py-0.5 rounded-full ${activeTab === tab.id ? 'bg-white/20 text-white' : 'bg-background-100 text-foreground-400'}`}>
                  {tab.count}
                </span>
              )}
            </button>
          ))}
          <div className="flex-1" />
          <button
            onClick={() => refreshMultipleBlocks([1, 2, 5, 10, 12, 13])}
