              pipelineState.mode === 'running'
                ? 'bg-amber-100 border border-amber-300 text-amber-600'
                : 'bg-background-50 border border-background-200 text-foreground-600 hover:border-accent-300 hover:text-accent-600'
            }`}
            title="Exécution séquentielle — lance les blocs 1→2→3... un par un avec pipeline visuel"
          >
            {pipelineState.mode === 'running' ? (
              <span className="w-3 h-3 rounded-full border-2 border-amber-300 border-t-amber-600 animate-spin" />
            ) : pipelineState.mode === 'completed' ? (
              <i className="ri-play-circle-line text-emerald-500" />
            ) : (
              <i className="ri-play-list-2-line" />
            )}
            Pipeline 1→13
          </button>
          <button
            onClick={refresh}
            disabled={loading}
            className="whitespace-nowrap px-4 py-2 rounded-full text-xs font-bold cursor-pointer transition-all flex items-center gap-1.5 ml-0 bg-accent-500 text-white hover:bg-accent-600 disabled:opacity-50 disabled:cursor-not-allowed"
          >
            {loading ? (
              <span className="w-3 h-3 rounded-full border-2 border-white/30 border-t-white animate-spin" />
            ) : (
              <i className="ri-refresh-line" />
            )}
            Rafraîchir tout
          </button>
        </div>
      </div>

      {/* Pipeline Visualizer — affiché uniquement quand le pipeline est actif */}
      <PipelineVisualizer pipelineState={pipelineState} />

      {/* Loading / Error States */}
      {loading && (
        <div className="py-20 text-center">
          <div className="w-12 h-12 mx-auto mb-4 rounded-full border-4 border-background-200 border-t-accent-500 animate-spin" />
          <p className="text-foreground-500">Chargement de la kosData.Content Factory...</p>
        </div>
      )}

      {error && (
        <div className="py-20 text-center max-w-md mx-auto">
          <div className="rounded-2xl bg-red-50 border border-red-200 p-6">
            <i className="ri-error-warning-line text-3xl text-red-500 mb-3 block" />
            <h3 className="font-heading text-lg font-bold text-red-700 mb-2">Erreur de chargement</h3>
            <p className="text-sm text-red-600 mb-4">{error}</p>
            <button onClick={refresh} className="px-4 py-2 rounded-full bg-red-600 text-white text-sm font-bold cursor-pointer hover:bg-red-700 transition-all">
              Réessayer
            </button>
          </div>
        </div>
      )}

      {/* Tab kosData.Content */}
      {!loading && !error && (
        <>
          {activeTab === 'overview' && renderOverviewTab()}
          {activeTab === 'veille' && renderBloCTab(
            tabBlocks.veille,
            'Veille & Opportunités — Blocs 1 à 3',
            'Intelligence réglementaire, SEO et GEO. Détection des opportunités de contenu.',
            <div className="flex justify-center gap-3 mt-2">
              <button
                onClick={() => refreshMultipleBlocks([1, 2, 3])}
                disabled={veilleBlocksLoading}
                className="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-bold cursor-pointer transition-all whitespace-nowrap bg-accent-500 text-white hover:bg-accent-600 disabled:opacity-50 disabled:cursor-not-allowed"
              >
                {veilleBlocksLoading ? (
                  <span className="w-4 h-4 rounded-full border-2 border-white/30 border-t-white animate-spin" />
                ) : (
                  <i className="ri-play-circle-line text-base" />
                )}
                Exécuter les 3 premiers blocs
              </button>
            </div>
          )}
          {activeTab === 'planning' && renderBloCTab(
            tabBlocks.planning,
            'Planification Automatique — Bloc 4',
            'Calendrier éditorial quotidien, hebdomadaire, mensuel, trimestriel, annuel.',
            <div className="flex justify-center gap-3 mt-2">
              <button
                onClick={() => refreshMultipleBlocks([4, 5, 6])}
                disabled={planifProdBlocksLoading}
                className="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-bold cursor-pointer transition-all whitespace-nowrap bg-accent-500 text-white hover:bg-accent-600 disabled:opacity-50 disabled:cursor-not-allowed"
              >
                {planifProdBlocksLoading ? (
                  <span className="w-4 h-4 rounded-full border-2 border-white/30 border-t-white animate-spin" />
                ) : (
                  <i className="ri-play-circle-line text-base" />
                )}
                Exécuter les blocs 4, 5, 6 — Planif + Rédaction + Leads
              </button>
            </div>
          )}
          {activeTab === 'production' && renderBloCTab(tabBlocks.production, 'Production Contenu — Blocs 5 à 8', 'kosData.Articles Big Four, Lead Magnets, Études de Cas, Livres Blancs.',
            <div className="flex justify-center gap-3 mt-2">
              <button
                onClick={() => refreshMultipleBlocks([7, 8, 9])}
                disabled={heavyContentBlocksLoading}
                className="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-bold cursor-pointer transition-all whitespace-nowrap bg-accent-500 text-white hover:bg-accent-600 disabled:opacity-50 disabled:cursor-not-allowed"
              >
                {heavyContentBlocksLoading ? (
                  <span className="w-4 h-4 rounded-full border-2 border-white/30 border-t-white animate-spin" />
                ) : (
                  <i className="ri-play-circle-line text-base" />
                )}
                Exécuter les blocs 7, 8, 9 — Études + Livres Blancs + Méthodologies
              </button>
            </div>
          )}
          {activeTab === 'methodologies' && renderBloCTab(tabBlocks.methodologies, 'Méthodologies KHEPRA — Bloc 9', 'Frameworks propriétaires KHEPRA RISK™, ESG™, GOVERNANCE™ et plus.')}
          {activeTab === 'optimisation' && renderBloCTab(tabBlocks.optimisation, 'SEO & GEO Avancé — Blocs 10 à 11', 'Optimisation pour Google et les moteurs IA. Positionnement Top 3. Citations IA.',
            <div className="flex justify-center gap-3 mt-2">
              <button
                onClick={() => refreshMultipleBlocks([10, 11, 12])}
                disabled={seoGeoQualBlocksLoading}
                className="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-bold cursor-pointer transition-all whitespace-nowrap bg-accent-500 text-white hover:bg-accent-600 disabled:opacity-50 disabled:cursor-not-allowed"
              >
                {seoGeoQualBlocksLoading ? (
                  <span className="w-4 h-4 rounded-full border-2 border-white/30 border-t-white animate-spin" />
                ) : (
                  <i className="ri-play-circle-line text-base" />
                )}
                Exécuter les blocs 10, 11, 12 — SEO+ + GEO+ + Qualité
              </button>
            </div>
          )}
          {activeTab === 'qualite' && renderBloCTab(tabBlocks.qualite, 'Qualité & Validation — Blocs 12 à 13', 'Contrôle qualité 8 points. Score ≥ 95/100. Auto-validation avec boucles correctives.',
            <div className="flex justify-center gap-3 mt-2">
              <button
                onClick={() => refreshMultipleBlocks([12, 13])}
                disabled={qualiteValidationBlocksLoading}
                className="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-bold cursor-pointer transition-all whitespace-nowrap bg-accent-500 text-white hover:bg-accent-600 disabled:opacity-50 disabled:cursor-not-allowed"
              >
                {qualiteValidationBlocksLoading ? (
                  <span className="w-4 h-4 rounded-full border-2 border-white/30 border-t-white animate-spin" />
                ) : (
                  <i className="ri-play-circle-line text-base" />
                )}
                Exécuter les blocs 12 & 13 — Qualité + Auto-Validation
              </button>
            </div>
          )}
          {activeTab === 'kpi' && renderKPITab()}
        </>
      )}

      {/* Cross-links */}
      {!loading && !error && (
        <section className="py-12 sm:py-16 bg-white border-t border-background-200">
          <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div className="text-center mb-8">
              <h2 className="font-heading text-2xl sm:text-3xl font-bold text-foreground-950 mb-2">
                Écosystème KOS — Hubs Spécialisés
              </h2>
              <p className="text-foreground-600">Chaque bloc dispose de son hub dédié pour une gestion approfondie.</p>
            </div>
            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
              {[
                { label: 'Blog Writing Automates', path: '/kos-blog-writing-automates', icon: 'ri-quill-pen-line', color: '#BE123C' },
                { label: 'Social Media Command', path: '/kos-social-media-command', icon: 'ri-share-forward-line', color: '#0A66C2' },
                { label: 'SEO & AEO Command', path: '/kos-seo-aeo-command', icon: 'ri-search-line', color: '#86BC25' },
                { label: 'AI Visibility Command', path: '/kos-ai-visibility-command', icon: 'ri-robot-line', color: '#EA580C' },
                { label: 'Quality Excellence', path: '/kos-quality-excellence-command', icon: 'ri-check-double-line', color: '#059669' },
                { label: 'Regulatory Compliance', path: '/kos-regulatory-compliance-automates', icon: 'ri-shield-line', color: '#DC2626' },
                { label: 'Research Institute', path: '/kos-research-institute', icon: 'ri-microscope-line', color: '#0D7B5F' },
                { label: 'Knowledge Graph', path: '/kos-knowledge-graph', icon: 'ri-git-branch-line', color: '#7C3AED' },
                { label: 'SEO Autopilot 2.0', path: '/kos-seo-autopilot', icon: 'ri-radar-line', color: '#059669' },
                { label: 'kosData.Content Correction Engine', path: '/kos-kosData.content-correction-engine', icon: 'ri-tools-line', color: '#D97706' },
                { label: 'Corrective Execution', path: '/kos-corrective-execution-engine', icon: 'ri-sparkling-line', color: '#2563EB' },
                { label: 'KOS Dashboard', path: '/kos-dashboard', icon: 'ri-dashboard-line', color: '#9B7B2C' },
              ].map(link => (
                <a key={link.path} href={link.path} className="rounded-xl border border-background-200 bg-background-50 p-4 text-center hover:shadow-md transition-all cursor-pointer block hover:border-foreground-200">
                  <div className="w-10 h-10 mx-auto mb-2 rounded-xl flex items-center justify-center" style={{ backgroundColor: `${link.color}15` }}>
                    <i className={`${link.icon} text-lg`} style={{ color: link.color }} />
                  </div>
                  <span className="text-sm font-bold text-foreground-800">{link.label}</span>
                </a>
              ))}
            </div>
          </div>
        </section>
      )}
    </KOSHubLayout>
  );
}
