                    <i className="ri-robot-line text-[10px]" />AUTO
                  </span>
                )}
              </div>
              <p className="text-xs text-foreground-500 line-clamp-2 mb-3">{block.description}</p>
              <div className="grid grid-cols-4 gap-2 mb-3">
                {block.kpis.map((kpi, i) => (
                  <div key={i} className="text-center py-1.5 rounded-lg bg-background-50 border border-background-100/70">
