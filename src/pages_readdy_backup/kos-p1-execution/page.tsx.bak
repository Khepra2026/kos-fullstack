              { tab: 'milestones' as const, icon: 'ri-flag-2-line', label: 'Jalons' },
              { tab: 'actions' as const, icon: 'ri-tools-line', label: 'Actions' },
            ]).map(item => (
              <button key={item.tab} onClick={() => setActiveTab(item.tab)} className={`flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium whitespace-nowrap cursor-pointer transition-colors border ${activeTab === item.tab ? 'bg-accent-500 text-background-50 border-accent-500' : 'bg-background-50 text-foreground-700 border-background-200 hover:bg-background-100'}`}>
                <i className={`${item.icon} text-sm`}></i><span>{item.label}</span>
              </button>
            ))}
            <span className="w-px bg-background-200 mx-1 hidden sm:block"></span>
            {P1_EXECUTION_BLOCKS.map(bloc => (
              <button key={bloc.id} onClick={() => navigateToBloc(bloc.id)} className={`flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-medium whitespace-nowrap cursor-pointer transition-colors border ${activeTab === 'bloc' && activeBloc?.id === bloc.id ? 'bg-accent-500 text-background-50 border-accent-500' : 'bg-background-50 text-foreground-700 border-background-200 hover:bg-background-100'}`}>
                <span className="text-[9px] font-mono font-bold">{bloc.numero}</span><span>{bloc.acronyme}</span>
              </button>
            ))}
          </div>
        </div>

        {/* ===== FOOTER ===== */}
        <div className="mt-6 p-5 bg-amber-50/50 border border-amber-200/40 rounded-lg">
          <div className="flex items-center gap-2 mb-3">
            <i className="ri-lightbulb-flash-line text-amber-600 text-lg"></i>
            <span className="text-sm font-semibold text-amber-800">KOS P1 Execution — {executiveSummary.blocsTotal} Blocs · {kpis.actions_total} Actions · Priorité : {executiveSummary.prioriteAbsolue}</span>
          </div>
          <div className="grid grid-cols-2 sm:grid-cols-4 gap-2 text-[11px] text-amber-700/70">
            <span><strong>{kpis.actions_non_demarre}</strong> actions à lancer</span>
            <span><strong>{executiveSummary.budget12m}</strong> budget 12 mois</span>
            <span><strong>{milestones.length}</strong> jalons</span>
            <span><strong>{executiveSummary.scoreMoyenCible}/100</strong> score cible</span>
          </div>
        </div>
      </div>
    </KOSHubLayout>
  );
}

// ===== SUB-COMPONENTS =====

function BlocExecutionCard({ bloc, expanded, onToggle, onNavigate }: { bloc: P1ExecutionBlock; expanded: boolean; onToggle: () => void; onNavigate: () => void }) {
  const sc = getScoreColor(bloc.scoreActuel);
  return (
    <div className="bg-background-50 border border-background-200/60 rounded-xl overflow-hidden transition-all">
      <div className="p-5 cursor-pointer group" onClick={onToggle}>
        <div className="flex items-start gap-3 flex-col sm:flex-row">
          <div className={`w-12 h-12 rounded-lg flex items-center justify-center shrink-0 ${bloc.couleur === 'accent' ? 'bg-accent-100 text-accent-700' : bloc.couleur === 'secondary' ? 'bg-secondary-100 text-secondary-700' : 'bg-primary-100 text-primary-700'}`}>
            <span className="text-xl font-bold font-mono">{bloc.numero}</span>
          </div>
          <div className="flex-1 min-w-0">
            <div className="flex items-center gap-2 mb-1 flex-wrap">
              <h3 className="text-sm font-bold text-foreground-950">{bloc.nom}</h3>
              <Badge label="P1" variant="P1" />
              <Badge label={bloc.statutGlobal === 'non_demarre' ? 'À lancer' : bloc.statutGlobal === 'en_cours' ? 'En cours' : 'Terminé'} variant={bloc.statutGlobal} />
            </div>
            <p className="text-xs text-foreground-600 mb-1">{bloc.acronyme} — Horizon {bloc.horizon} · {bloc.responsable}</p>
            <p className="text-xs text-foreground-500 leading-relaxed line-clamp-2 mb-3">{bloc.description}</p>
            <div className="flex items-center gap-3 flex-wrap">
              <div className="flex items-center gap-2">
                <CircularGauge value={bloc.scoreActuel} size={36} strokeWidth={3} color={sc} />
                <div>
                  <span className="text-[10px] text-foreground-500">Score</span>
                  <p className="text-xs font-bold text-foreground-950">{bloc.scoreActuel}→{bloc.scoreCible}</p>
                </div>
              </div>
              <div className="h-6 w-px bg-background-200 hidden sm:block"></div>
              <div className="text-[10px]">
                <span className="text-foreground-500">{bloc.actions.length} actions</span>
                <span className="text-foreground-400 mx-1">·</span>
                <span className="text-foreground-500">{bloc.budgetTotal}</span>
              </div>
              <div className="flex-1 hidden sm:block"></div>
              <div className="flex items-center gap-1.5">
                <ProgressBar value={bloc.progressionGlobale} color={getProgColor(bloc.progressionGlobale)} size="sm" />
                <span className="text-[10px] font-semibold text-foreground-600 w-8 text-right">{bloc.progressionGlobale}%</span>
              </div>
              {expanded ? <i className="ri-arrow-up-s-line text-xs text-foreground-400 group-hover:text-foreground-700 transition-colors"></i> : <i className="ri-arrow-down-s-line text-xs text-foreground-400 group-hover:text-foreground-700 transition-colors"></i>}
            </div>
          </div>
        </div>
      </div>
      {expanded && (
        <div className="px-5 pb-5 pt-0 border-t border-background-200/40">
          <div className="space-y-2 mt-3">
            {bloc.actions.map(action => (
              <div key={action.id} className="flex items-center gap-3 bg-background-100/50 rounded-lg px-3 py-2">
                <Badge label={action.statut === 'non_demarre' ? 'À faire' : action.statut === 'en_cours' ? 'En cours' : action.statut === 'termine' ? 'OK' : 'Bloqué'} variant={action.statut} />
                <span className="text-[10px] font-mono text-foreground-400">{action.id}</span>
                <span className="flex-1 text-xs text-foreground-800 min-w-0 truncate">{action.action}</span>
                <span className="text-[10px] text-foreground-500 whitespace-nowrap">{action.deadline}</span>
                <span className="text-[10px] font-semibold text-foreground-600 w-7 text-right">{action.progression}%</span>
              </div>
            ))}
          </div>
          <div className="mt-3 flex justify-end">
            <button onClick={(e) => { e.stopPropagation(); onNavigate(); }} className="text-xs px-3 py-1.5 rounded-full bg-accent-500 text-background-50 hover:bg-accent-600 cursor-pointer whitespace-nowrap transition-colors flex items-center gap-1">
              <i className="ri-focus-3-line"></i>Vue détaillée
            </button>
          </div>
        </div>
      )}
    </div>
  );
}

function ActionExecutionCard({ action, expanded, onToggle }: { action: P1ExecutionAction & { blocNom: string; blocId: string; blocNumero: string; blocCouleur: string; blocIcon: string }; expanded: boolean; onToggle: () => void }) {
  const bgClass = action.statut === 'bloque' ? 'border-red-200/60 bg-red-50/10' : action.statut === 'en_cours' ? 'border-amber-200/60 bg-amber-50/10' : action.statut === 'termine' ? 'border-emerald-200/60 bg-emerald-50/10' : 'border-background-200/60';
  return (
    <div className={`bg-background-50 border rounded-lg p-4 transition-colors cursor-pointer ${bgClass}`} onClick={onToggle}>
      <div className="flex items-start justify-between gap-3">
        <div className="flex items-center gap-2 shrink-0">
          <CircularGauge value={action.progression} size={32} strokeWidth={2.5} color={getProgColor(action.progression)} />
        </div>
        <div className="flex-1 min-w-0">
          <div className="flex items-center gap-2 mb-1 flex-wrap">
            <span className="text-[10px] font-mono text-foreground-400">{action.id}</span>
            <span className={`text-[9px] px-1.5 py-0.5 rounded-full ${action.blocCouleur === 'accent' ? 'bg-accent-100 text-accent-700' : action.blocCouleur === 'secondary' ? 'bg-secondary-100 text-secondary-700' : 'bg-primary-100 text-primary-700'}`}>
              {action.blocNumero} {action.blocNom}
            </span>
            <Badge label={action.statut === 'non_demarre' ? 'À faire' : action.statut === 'en_cours' ? 'En cours' : action.statut === 'termine' ? 'Terminé' : 'Bloqué'} variant={action.statut} />
            <Badge label={action.prioriteOrigine} variant={action.prioriteOrigine} />
          </div>
          <h4 className="text-sm font-semibold text-foreground-950 mb-1">{action.action}</h4>
          <div className="flex items-center gap-3 text-[10px] text-foreground-500 flex-wrap">
            <span><i className="ri-money-dollar-circle-line mr-0.5 text-foreground-400"></i>{action.budget}</span>
            <span><i className="ri-time-line mr-0.5 text-foreground-400"></i>{action.effort}</span>
            <span><i className="ri-user-line mr-0.5 text-foreground-400"></i>{action.responsable}</span>
            <span><i className="ri-flag-line mr-0.5 text-foreground-400"></i>{action.deadline}</span>
          </div>
        </div>
        <div className="shrink-0">{expanded ? <i className="ri-arrow-up-s-line text-xs text-foreground-400"></i> : <i className="ri-arrow-down-s-line text-xs text-foreground-400"></i>}</div>
      </div>
      {expanded && (
        <div className="mt-3 pt-3 border-t border-background-200/40 space-y-2">
          <p className="text-xs text-foreground-600 leading-relaxed">{action.description}</p>
          <div className="flex items-center gap-2 flex-wrap text-[10px]">
            <span className="bg-primary-50 text-primary-700 px-2 py-0.5 rounded-full"><i className="ri-bar-chart-line mr-0.5"></i>KPI : {action.kpi}</span>
            <span className="bg-accent-50 text-accent-700 px-2 py-0.5 rounded-full"><i className="ri-file-text-line mr-0.5"></i>Livrable : {action.livrable}</span>
          </div>
          {action.commentaire && (
            <div className="bg-background-100 rounded-lg p-2">
              <p className="text-[10px] text-foreground-500"><i className="ri-chat-3-line mr-1 text-foreground-400"></i>{action.commentaire}</p>
            </div>
          )}
          {action.dependanceDe && (
            <div className="flex items-center gap-1.5 text-[10px]">
              <i className="ri-git-branch-line text-amber-600"></i>
              <span className="text-foreground-500">Dépend de :</span>
              <span className="font-semibold text-amber-700">{action.dependanceDe}</span>
            </div>
          )}
          {action.bloquePar && (
            <div className="flex items-center gap-1.5 text-[10px]">
              <i className="ri-error-warning-line text-red-600"></i>
              <span className="text-foreground-500">Bloqué par :</span>
              <span className="font-semibold text-red-700">{action.bloquePar}</span>
            </div>
          )}
        </div>
      )}
    </div>
  );
}

function BlocDetail({ bloc, milestones, expandedActions, onToggleAction, onNavigateToBloc }: { bloc: P1ExecutionBlock; milestones: P1ExecutionMilestone[]; expandedActions: Set<string>; onToggleAction: (id: string) => void; onNavigateToBloc: (id: string) => void }) {
  return (
    <div className="space-y-6">
      <div className={`rounded-lg p-6 border ${bloc.couleur === 'accent' ? 'bg-accent-50/30 border-accent-200/40' : bloc.couleur === 'secondary' ? 'bg-secondary-50/30 border-secondary-200/40' : 'bg-primary-50/30 border-primary-200/40'}`}>
        <div className="flex items-start gap-3 mb-4">
          <div className={`w-14 h-14 rounded-lg flex items-center justify-center shrink-0 ${bloc.couleur === 'accent' ? 'bg-accent-100 text-accent-700' : bloc.couleur === 'secondary' ? 'bg-secondary-100 text-secondary-700' : 'bg-primary-100 text-primary-700'}`}>
            <span className="text-2xl font-bold font-mono">{bloc.numero}</span>
          </div>
          <div className="flex-1 min-w-0">
            <div className="flex items-center gap-2 mb-1 flex-wrap">
              <h2 className="text-xl font-bold text-foreground-950">{bloc.nom}</h2>
              <Badge label="P1" variant="P1" />
              <Badge label={bloc.statutGlobal === 'non_demarre' ? 'À lancer' : bloc.statutGlobal === 'en_cours' ? 'En cours' : 'Terminé'} variant={bloc.statutGlobal} />
            </div>
            <p className="text-sm text-foreground-600">{bloc.acronyme} — Horizon <strong>{bloc.horizon}</strong></p>
          </div>
        </div>
        <p className="text-sm text-foreground-700 leading-relaxed mb-4">{bloc.description}</p>
        <div className="grid grid-cols-2 sm:grid-cols-5 gap-3">
          <div className="rounded-lg p-3 text-center bg-background-50"><CircularGauge value={bloc.scoreActuel} size={48} strokeWidth={4} color={getScoreColor(bloc.scoreActuel)} /><p className="text-[10px] text-foreground-500 mt-1">Score Actuel</p></div>
          <div className="rounded-lg p-3 text-center bg-background-50"><CircularGauge value={bloc.scoreCible} size={48} strokeWidth={4} color="emerald" /><p className="text-[10px] text-foreground-500 mt-1">Score Cible</p></div>
          <div className="rounded-lg p-3 text-center bg-background-50 flex flex-col justify-center"><span className="text-2xl font-bold text-foreground-950">{bloc.actions.length}</span><p className="text-[10px] text-foreground-500 mt-1">Actions</p></div>
          <div className="rounded-lg p-3 text-center bg-background-50 flex flex-col justify-center"><span className="text-lg font-bold text-foreground-950">{bloc.responsable}</span><p className="text-[10px] text-foreground-500 mt-1">Responsable</p></div>
          <div className="rounded-lg p-3 text-center bg-background-50 flex flex-col justify-center"><span className="text-lg font-bold text-primary-700">{bloc.budgetTotal}</span><p className="text-[10px] text-foreground-500 mt-1">Budget</p></div>
        </div>
        <div className="mt-4 flex items-center gap-2">
          <span className="text-[10px] text-foreground-500">Progression :</span>
          <ProgressBar value={bloc.progressionGlobale} color={getProgColor(bloc.progressionGlobale)} size="md" />
          <span className="text-xs font-bold text-foreground-700">{bloc.progressionGlobale}%</span>
        </div>
      </div>

      <div>
        <h3 className="text-sm font-semibold text-foreground-950 mb-3 flex items-center gap-2"><i className="ri-tools-line"></i>Actions — {bloc.actions.length}</h3>
        <div className="space-y-2">
          {bloc.actions.map(action => (
            <ActionDetailCard key={action.id} action={action} expanded={expandedActions.has(action.id)} onToggle={() => onToggleAction(action.id)} />
          ))}
        </div>
      </div>

      {milestones.length > 0 && (
        <div>
          <h3 className="text-sm font-semibold text-foreground-950 mb-3 flex items-center gap-2"><i className="ri-flag-2-line"></i>Jalons — {milestones.length}</h3>
          <div className="space-y-2">
            {milestones.map(ms => (
              <div key={ms.id} className={`rounded-lg p-3 border ${ms.statut === 'atteint' ? 'bg-emerald-50/30 border-emerald-200/40' : ms.statut === 'retard' ? 'bg-red-50/30 border-red-200/40' : 'bg-background-50 border-background-200/60'}`}>
                <div className="flex items-center gap-2">
                  <Badge label={ms.statut === 'a_venir' ? 'À venir' : ms.statut === 'en_cours' ? 'En cours' : ms.statut === 'atteint' ? 'Atteint' : 'Retard'} variant={ms.statut} />
                  <span className="text-sm font-semibold text-foreground-950">{ms.nom}</span>
                  <span className="text-[10px] text-foreground-500 ml-auto">{ms.date}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  );
}

function ActionDetailCard({ action, expanded, onToggle }: { action: P1ExecutionAction; expanded: boolean; onToggle: () => void }) {
  const bgClass = action.statut === 'bloque' ? 'border-red-200/60 bg-red-50/5' : action.statut === 'en_cours' ? 'border-amber-200/60 bg-amber-50/5' : action.statut === 'termine' ? 'border-emerald-200/60 bg-emerald-50/5' : 'border-background-200/60';
  return (
    <div className={`bg-background-50 border rounded-lg p-4 transition-colors cursor-pointer ${bgClass}`} onClick={onToggle}>
      <div className="flex items-start justify-between gap-3">
        <div className="flex items-center gap-2 shrink-0">
          <CircularGauge value={action.progression} size={32} strokeWidth={2.5} color={getProgColor(action.progression)} />
        </div>
        <div className="flex-1 min-w-0">
          <div className="flex items-center gap-2 mb-1 flex-wrap">
            <span className="text-[10px] font-mono text-foreground-400">{action.id}</span>
            <Badge label={action.statut === 'non_demarre' ? 'À faire' : action.statut === 'en_cours' ? 'En cours' : action.statut === 'termine' ? 'Terminé' : 'Bloqué'} variant={action.statut} />
            <Badge label={action.prioriteOrigine} variant={action.prioriteOrigine} />
          </div>
          <h4 className="text-sm font-semibold text-foreground-950 mb-1">{action.action}</h4>
          <div className="flex items-center gap-3 text-[10px] text-foreground-500 flex-wrap">
            <span><i className="ri-money-dollar-circle-line mr-0.5 text-foreground-400"></i>{action.budget}</span>
            <span><i className="ri-time-line mr-0.5 text-foreground-400"></i>{action.effort}</span>
            <span><i className="ri-user-line mr-0.5 text-foreground-400"></i>{action.responsable}</span>
            <span><i className="ri-flag-line mr-0.5 text-foreground-400"></i>{action.deadline}</span>
          </div>
        </div>
        <div className="shrink-0">{expanded ? <i className="ri-arrow-up-s-line text-xs text-foreground-400"></i> : <i className="ri-arrow-down-s-line text-xs text-foreground-400"></i>}</div>
      </div>
      {expanded && (
        <div className="mt-3 pt-3 border-t border-background-200/40 space-y-2">
          <p className="text-xs text-foreground-600 leading-relaxed">{action.description}</p>
          <div className="flex items-center gap-2 flex-wrap text-[10px]">
            <span className="bg-primary-50 text-primary-700 px-2 py-0.5 rounded-full"><i className="ri-bar-chart-line mr-0.5"></i>KPI : {action.kpi}</span>
          </div>
          <div className="grid grid-cols-1 sm:grid-cols-2 gap-2 text-[10px]">
            <div className="bg-background-100 rounded p-2">
              <span className="text-foreground-400">Livrable :</span>
              <p className="text-foreground-700 font-medium mt-0.5">{action.livrable}</p>
            </div>
            <div className="bg-background-100 rounded p-2">
              <span className="text-foreground-400">Preuve :</span>
              <p className="text-foreground-700 font-medium mt-0.5">{action.preuve}</p>
            </div>
          </div>
          {action.commentaire && (
            <div className="bg-background-100 rounded-lg p-2">
              <p className="text-[10px] text-foreground-500"><i className="ri-chat-3-line mr-1 text-foreground-400"></i>{action.commentaire}</p>
            </div>
          )}
          {action.dependanceDe && (
            <div className="flex items-center gap-1.5 text-[10px]">
              <i className="ri-git-branch-line text-amber-600"></i>
              <span className="text-foreground-500">Dépend de :</span>
              <span className="font-semibold text-amber-700">{action.dependanceDe}</span>
            </div>
          )}
        </div>
      )}
    </div>
  );
}
