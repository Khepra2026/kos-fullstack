import { useState } from 'react';
import KOSHubLayout from '@/components/feature/KOSHubLayout';
import { useKOSP1Execution } from '@/hooks/useKOSP1Execution';

function CircularGauge({ value, size = 44, strokeWidth = 4, color = 'primary' }: { value: number; size?: number; strokeWidth?: number; color?: string }) {
  const radius = (size - strokeWidth) / 2;
  const circumference = radius * 2 * Math.PI;
  const offset = circumference - (Math.min(value, 100) / 100) * circumference;
  const strokeMap: Record<string, string> = {
    accent: 'stroke-accent-500', secondary: 'stroke-secondary-500', emerald: 'stroke-emerald-500',
    amber: 'stroke-amber-500', red: 'stroke-red-500', primary: 'stroke-primary-500',
  };
  const textMap: Record<string, string> = {
    accent: 'text-accent-700', secondary: 'text-secondary-700', emerald: 'text-emerald-700',
    amber: 'text-amber-700', red: 'text-red-700', primary: 'text-primary-700',
  };
  const strokeClass = strokeMap[color] || strokeMap.primary;
  const textClass = textMap[color] || textMap.primary;
  return (
    <div className="relative inline-flex items-center justify-center" style={{ width: size, height: size }}>
      <svg width={size} height={size} className="-rotate-90">
        <circle cx={size / 2} cy={size / 2} r={radius} fill="none" strokeWidth={strokeWidth} className="stroke-background-200" />
        <circle cx={size / 2} cy={size / 2} r={radius} fill="none" strokeWidth={strokeWidth} strokeLinecap="round" className={`${strokeClass} transition-all duration-700`} style={{ strokeDasharray: circumference, strokeDashoffset: offset }} />
      </svg>
      <span className={`absolute text-xs font-bold ${textClass}`}>{value}</span>
    </div>
  );
}

function ProgressBar({ value, color = 'primary', size = 'sm' }: { value: number; color?: string; size?: 'sm' | 'md' }) {
  const h = size === 'md' ? 'h-2.5' : 'h-2';
  const bgMap: Record<string, string> = {
    emerald: 'bg-emerald-500', amber: 'bg-amber-500', red: 'bg-red-500',
    accent: 'bg-accent-500', secondary: 'bg-secondary-500', primary: 'bg-primary-500',
  };
  return (
    <div className={`w-full ${h} bg-background-200 rounded-full overflow-hidden`}>
      <div className={`${h} ${bgMap[color] || bgMap.primary} rounded-full transition-all duration-500`} style={{ width: `${Math.min(value, 100)}%` }}></div>
    </div>
  );
}

function Badge({ label, variant = 'default' }: { label: string; variant?: string }) {
  const bgMap: Record<string, string> = {
    non_demarre: 'bg-background-200 text-foreground-500 border-background-200',
    en_cours: 'bg-amber-100 text-amber-700 border-amber-200',
    termine: 'bg-emerald-100 text-emerald-700 border-emerald-200',
    bloque: 'bg-red-100 text-red-700 border-red-200',
    a_venir: 'bg-background-200 text-foreground-500 border-background-200',
    atteint: 'bg-emerald-100 text-emerald-700 border-emerald-200',
    retard: 'bg-red-100 text-red-700 border-red-200',
    P0: 'bg-red-100 text-red-700 border-red-200',
    P1: 'bg-amber-100 text-amber-700 border-amber-200',
    P2: 'bg-background-200 text-foreground-500 border-background-200',
  };
  const classes = bgMap[variant] || 'bg-background-200 text-foreground-600 border-background-200';
  return <span className={`inline-flex text-[10px] px-2 py-0.5 rounded-full border whitespace-nowrap font-medium ${classes}`}>{label}</span>;
}

function getScoreColor(score: number): string {
  if (score >= 90) return 'emerald';
  if (score >= 75) return 'accent';
  if (score >= 55) return 'amber';
  return 'red';
}

function getProgColor(prog: number): string {
  if (prog >= 80) return 'emerald';
  if (prog >= 40) return 'amber';
  return 'red';
}

export default function KOSP1ExecutionPage() {
  const [kosData, setKosData] = useState<any>(null);
  useEffect(() => {
    fetch('/mocks/kos-blog.json').then(r => r.json()).then(setKosData);
  }, []);
  if (!kosData) return null;

  const {
    blocs, activeTab, setActiveTab, activeBloc, navigateToBloc,
    sortMode, setSortMode, expandedActions, toggleActionExpanded,
    expandedBlocs, toggleBlocExpanded, allActions,
    milestones, timeline, executiveSummary, kpis,
    loading, error, refetch,
  } = useKOSP1Execution();

  const [showOnlyBloque, setShowOnlyBloque] = useState(false);

  if (loading) {
    return (
      <KOSHubLayout hubId={84} activeTab="dashboard" tabLabel="Exécution P1">
        <div className="max-w-7xl mx-auto px-4 md:px-6 py-8">
          <div className="flex items-center justify-center py-20">
            <div className="flex items-center gap-3 text-foreground-500">
              <div className="w-5 h-5 rounded-full border-2 border-primary-500 border-t-transparent animate-spin"></div>
              <span className="text-sm">KOS exécute les blocs P1...</span>
            </div>
          </div>
        </div>
      </KOSHubLayout>
    );
  }

  if (error && blocs.length === 0) {
    return (
      <KOSHubLayout hubId={84} activeTab="dashboard" tabLabel="Exécution P1">
        <div className="max-w-7xl mx-auto px-4 md:px-6 py-8">
          <div className="flex flex-col items-center justify-center py-20 gap-4">
            <div className="w-12 h-12 rounded-full bg-red-100 flex items-center justify-center text-red-600"><i className="ri-error-warning-line text-xl"></i></div>
            <p className="text-sm text-red-700 font-medium">Erreur de chargement</p>
            <p className="text-xs text-foreground-500">{error}</p>
            <button onClick={refetch} className="px-4 py-2 rounded-full bg-primary-500 text-background-50 text-xs font-medium hover:bg-primary-600 cursor-pointer whitespace-nowrap"><i className="ri-refresh-line mr-1.5"></i>Réexécuter</button>
          </div>
        </div>
      </KOSHubLayout>
    );
  }

  return (
    <KOSHubLayout hubId={84} activeTab={activeTab} tabLabel="Exécution P1">
      <div className="max-w-7xl mx-auto px-4 md:px-6 py-8">
        {/* ===== ULTRA HEADER ===== */}
        <div className="mb-8">
          <div className="flex items-center gap-2 mb-3 flex-wrap">
            <span className="text-xs tracking-widest uppercase text-foreground-500 bg-background-100 px-3 py-1 rounded-full">
              {executiveSummary.auditId}
