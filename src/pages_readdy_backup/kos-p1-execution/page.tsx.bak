            <span className="text-xs bg-amber-100 text-amber-700 px-2 py-0.5 rounded-full font-medium flex items-center gap-1.5">
              <span className="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>P1 — EXÉCUTION INTÉGRALE
            </span>
            <span className="text-xs bg-primary-100 text-primary-700 px-2 py-0.5 rounded-full font-medium">{executiveSummary.blocsTotal} Blocs</span>
            <span className="text-xs bg-accent-100 text-accent-700 px-2 py-0.5 rounded-full font-medium">{executiveSummary.actionsTotal} Actions</span>
            <span className="text-xs bg-secondary-100 text-secondary-700 px-2 py-0.5 rounded-full font-medium">{executiveSummary.referentiels.split('·').length} Référentiels</span>
          </div>
          <h1 className="text-3xl md:text-4xl font-heading font-bold text-foreground-950">
            KOS P1 — Exécution Intégrale
          </h1>
          <p className="text-foreground-600 mt-2 max-w-4xl text-sm md:text-base leading-relaxed">
            <strong>5 blocs stratégiques P1</strong> en exécution — <strong>{kpis.actions_total} actions prioritaires</strong> · Budget <strong className="text-primary-700">{executiveSummary.budgetTotal}</strong> · Horizon <strong>{executiveSummary.horizon}</strong> · Score cible <strong className="text-emerald-700">{executiveSummary.scoreMoyenCible}/100</strong> · <strong>Seconde vague</strong> après les P0 critiques.
          </p>
        </div>

        {/* ===== GLOBAL KPI ROW ===== */}
        <div className="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-3 mb-8">
          <div className="bg-background-50 border border-background-200/60 rounded-lg p-3 text-center flex flex-col justify-center">
            <span className="text-2xl font-bold text-foreground-950">{kpis.blocs_total}</span>
            <p className="text-[10px] text-foreground-500">Blocs P1</p>
          </div>
          <div className="bg-background-50 border border-background-200/60 rounded-lg p-3 text-center flex flex-col justify-center">
            <span className="text-2xl font-bold text-foreground-950">{kpis.actions_total}</span>
