import { useState, useEffect } from 'react';
import SeoHead from '@/components/feature/SeoHead';
import KOSHubLayout from '@/components/feature/KOSHubLayout';
import { Breadcrumb } from '@/components/feature/Breadcrumb';
import ScrollReveal from '@/components/feature/ScrollReveal';
import { useGeoVisibility } from '@/hooks/useGeoVisibility';

type TabId = 'overview' | 'platforms' | 'crawlers' | 'schema' | 'operations' | 'live';

const tabs: { id: TabId; label: string; icon: string }[] = [
  { id: 'overview', label: 'Vue d\'Ensemble', icon: 'ri-eye-line' },
  { id: 'platforms', label: 'Plateformes AI', icon: 'ri-global-line' },
  { id: 'crawlers', label: 'AI Crawlers', icon: 'ri-spy-line' },
  { id: 'schema', label: 'Schema.org', icon: 'ri-code-s-slash-line' },
  { id: 'operations', label: 'Opérations', icon: 'ri-history-line' },
  { id: 'live', label: 'Scan Live', icon: 'ri-radar-line' },
];

export default function KosAIVisibilityCommandPage() {
  const [kosData, setKosData] = useState<any>(null);
  useEffect(() => {
    fetch('/mocks/kos-blog.json').then(r => r.json()).then(setKosData);
  }, []);
  if (!kosData) return null;

  const [activeTab, setActiveTab] = useState<TabId>('overview');
  const { data: geoData, loading, refetch } = useGeoVisibility();

  const displayData = geoData;

  return (
    <KOSHubLayout hubId={27}>
      <SeoHead
        title="KOS AI Visibility Command — Visibilité Agents IA | KHEPRA EXPERTS"
        description="Centre de commandement KOS pour la visibilité par les agents AI externes. Scoring GEO, monitoring des crawlers IA, Schema.org, llms.txt — optimisé pour ChatGPT, Gemini, Claude, Perplexity."
        canonical="/kos-ai-visibility-command"
      />

      {/* Hero */}
      <section className="relative overflow-hidden bg-background-50 border-b border-background-200">
        <div className="max-w-7xl mx-auto px-4 md:px-6 py-16 md:py-20">
          <ScrollReveal>
            <Breadcrumb
              items={[
                { label: 'Accueil', href: '/' },
                { label: 'KOS AI Visibility Command', href: '/kos-ai-visibility-command' },
              ]}
            />
            <div className="mt-6 flex flex-col lg:flex-row items-start gap-8">
              <div className="flex-1">
                <div className="flex items-center gap-3 mb-5 flex-wrap">
                  <span className={`inline-flex items-center gap-2 px-3 py-1.5 rounded-full ${displayData.isLive ? 'bg-accent-100' : 'bg-secondary-100'}`}>
                    <span className={`w-2 h-2 rounded-full animate-pulse ${displayData.isLive ? 'bg-accent-500' : 'bg-secondary-500'}`}></span>
                    <span className={`text-xs font-semibold ${displayData.isLive ? 'text-accent-700' : 'text-secondary-700'}`}>
                      {displayData.isLive ? 'LIVE — GEO READINESS : ' : 'MOCK — GEO READINESS : '}{displayData.geoReadiness.toUpperCase()}
                    </span>
                  </span>
                  {loading && (
                    <span className="inline-flex items-center gap-1.5 text-xs text-foreground-400">
                      <div className="w-3 h-3 border border-foreground-300 border-t-transparent rounded-full animate-spin"></div>
                      Rafraîchissement...
                    </span>
                  )}
                  {displayData.isLive && (
                    <button onClick={refetch} className="text-xs text-foreground-400 hover:text-accent-600 transition-colors cursor-pointer flex items-center gap-1">
                      <i className="ri-refresh-line"></i> Actualiser
                    </button>
                  )}
                </div>
                <h1 className="text-3xl md:text-5xl font-bold text-foreground-950 leading-tight">
                  KOS AI Visibility Command
                </h1>
                <p className="mt-4 text-lg text-foreground-600 max-w-2xl">
                  Centre de commandement unifié pour la visibilité par les agents IA externes.
                  <strong className="text-foreground-800"> 10 plateformes AI monitorées, 11 crawlers pilotés, Schema.org optimisé, llms.txt auto-régénéré.</strong>
                  Tout ce que ChatGPT, Gemini, Claude, Perplexity et les autres voient de KHEPRA EXPERTS — contrôlé par les automates KOS.
                </p>
              </div>
              <div className="grid grid-cols-3 gap-4 flex-shrink-0">
                <div className="bg-background-50 border border-background-200 rounded-xl p-4 text-center min-w-[110px]">
                  <p className="text-2xl font-bold text-accent-600">{displayData.overallScore}</p>
                  <p className="text-xs text-foreground-500 mt-1">Score GEO</p>
                </div>
                <div className="bg-background-50 border border-background-200 rounded-xl p-4 text-center min-w-[110px]">
                  <p className="text-2xl font-bold text-foreground-950">10</p>
                  <p className="text-xs text-foreground-500 mt-1">Plateformes</p>
                </div>
                <div className="bg-background-50 border border-background-200 rounded-xl p-4 text-center min-w-[110px]">
                  <p className="text-2xl font-bold text-foreground-950">{displayData.crawlerStatus.length}</p>
                  <p className="text-xs text-foreground-500 mt-1">Crawlers</p>
                </div>
              </div>
            </div>
          </ScrollReveal>
        </div>
      </section>

      {/* Tabs */}
      <div className="sticky top-0 z-40 bg-background-50/95 backdrop-blur-md border-b border-background-200">
        <div className="max-w-7xl mx-auto px-4 md:px-6">
          <div className="flex items-center gap-1 overflow-x-auto py-2">
            {tabs.map((tab) => (
              <button
                key={tab.id}
                onClick={() => setActiveTab(tab.id)}
                className={`flex items-center gap-2 px-4 py-2.5 rounded-full text-sm font-medium whitespace-nowrap transition-colors cursor-pointer ${
                  activeTab === tab.id
                    ? 'bg-primary-500 text-white'
                    : 'text-foreground-600 hover:bg-background-100'
                }`}
              >
                <i className={`${tab.icon} text-sm`}></i>
                {tab.label}
              </button>
            ))}
          </div>
        </div>
      </div>

      {/* kosData.Content */}
      <div className="max-w-7xl mx-auto px-4 md:px-6 py-10">
        {activeTab === 'overview' && <OverviewTab data={displayData} isLive={displayData.isLive} />}
        {activeTab === 'platforms' && <PlatformsTab />}
        {activeTab === 'crawlers' && <CrawlersTab data={displayData} />}
        {activeTab === 'schema' && <SchemaTab data={displayData} />}
        {activeTab === 'operations' && <OperationsTab data={displayData} />}
        {activeTab === 'live' && <LiveScanTab onScanComplete={refetch} />}
      </div>
    </KOSHubLayout>
  );
}

function OverviewTab({ kosData.data, isLive }: { data: ReturnType<typeof useGeoVisibility>['kosData.data']; isLive: boolean }) {
  return (
    <div className="space-y-10">
      {/* Alert Banner */}
      <ScrollReveal>
        <div className={`border rounded-xl p-5 flex items-start gap-4 ${isLive ? 'bg-accent-50 border-accent-200' : 'bg-secondary-50 border-secondary-200'}`}>
          <div className={`w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0 mt-1 ${isLive ? 'bg-accent-500' : 'bg-secondary-500'}`}>
            <i className="ri-radar-line text-white text-lg"></i>
          </div>
          <div>
            <h3 className="font-semibold text-foreground-950">
              {isLive ? 'Les automates KOS pilotent la visibilité AI en temps réel' : 'Données mock — Lancez un scan pour activer le mode Live'}
            </h3>
            <p className="text-sm text-foreground-600 mt-1">
              <code className="bg-background-100 px-1.5 py-0.5 rounded text-xs">kos-geo-visibility-engine</code> scanne le site toutes les 24h et vérifie : llms.txt, robots.txt (11 crawlers AI), Schema.org (10 pages clés), headers HTTP, et SEO on-page. 
              <code className="bg-background-100 px-1.5 py-0.5 rounded text-xs">kos-llms-generator</code> régénère automatiquement les fichiers llms.txt et llms-full.txt chaque jour à 03:00 UTC.
              Zéro intervention manuelle nécessaire pour maintenir une visibilité AI optimale.
            </p>
          </div>
        </div>
      </ScrollReveal>

      {/* Score Gauge */}
      <ScrollReveal>
        <div className="bg-background-50 border border-background-200 rounded-xl p-8 text-center">
          <h2 className="text-lg font-semibold text-foreground-950 mb-6">Score Global de Visibilité AI (GEO Score)</h2>
          <div className="relative w-40 h-40 mx-auto mb-4">
            <svg className="w-40 h-40 transform -rotate-90" viewBox="0 0 160 160">
              <circle cx="80" cy="80" r="68" fill="none" stroke="var(--background-200)" strokeWidth="12" />
              <circle
                cx="80" cy="80" r="68" fill="none"
                stroke="var(--accent-500)" strokeWidth="12" strokeLinecap="round"
                strokeDasharray={`${(kosData.data.overallScore / 100) * 427} 427`}
              />
            </svg>
            <div className="absolute inset-0 flex items-center justify-center flex-col">
              <span className="text-4xl font-bold text-foreground-950">{kosData.data.overallScore}</span>
              <span className="text-xs text-foreground-400">/100</span>
            </div>
          </div>
          <p className="text-sm text-foreground-500">
            Dernier scan : {new Date(kosData.data.lastScan).toLocaleString('fr-FR')}
            <span className="mx-2">·</span>
            Fréquence : Quotidien (24h)
          </p>
        </div>
      </ScrollReveal>

      {/* Key metrics */}
      <ScrollReveal>
        <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div className="bg-background-50 border border-background-200 rounded-xl p-5">
            <div className="flex items-center gap-2 mb-3">
              <div className="w-8 h-8 rounded-lg bg-accent-100 flex items-center justify-center">
                <i className="ri-file-text-line text-accent-600"></i>
              </div>
              <span className="text-xs text-foreground-500 font-medium">llms.txt</span>
            </div>
            <p className="text-2xl font-bold text-accent-600">{kosData.data.llmsStatus.llms_txt_size_kb} KB</p>
            <p className="text-xs text-foreground-400 mt-1">{kosData.data.llmsStatus.llms_txt_sections} sections</p>
          </div>
          <div className="bg-background-50 border border-background-200 rounded-xl p-5">
            <div className="flex items-center gap-2 mb-3">
              <div className="w-8 h-8 rounded-lg bg-accent-100 flex items-center justify-center">
                <i className="ri-robot-2-line text-accent-600"></i>
              </div>
              <span className="text-xs text-foreground-500 font-medium">AI Crawlers</span>
            </div>
            <p className="text-2xl font-bold text-accent-600">11/11</p>
            <p className="text-xs text-foreground-400 mt-1">Tous autorisés</p>
          </div>
          <div className="bg-background-50 border border-background-200 rounded-xl p-5">
            <div className="flex items-center gap-2 mb-3">
              <div className="w-8 h-8 rounded-lg bg-secondary-100 flex items-center justify-center">
                <i className="ri-code-s-slash-line text-secondary-600"></i>
              </div>
              <span className="text-xs text-foreground-500 font-medium">Schema.org</span>
            </div>
            <p className="text-2xl font-bold text-foreground-950">10/10</p>
            <p className="text-xs text-foreground-400 mt-1">Pages couvertes</p>
          </div>
          <div className="bg-background-50 border border-background-200 rounded-xl p-5">
            <div className="flex items-center gap-2 mb-3">
              <div className="w-8 h-8 rounded-lg bg-secondary-100 flex items-center justify-center">
                <i className="ri-refresh-line text-secondary-600"></i>
              </div>
              <span className="text-xs text-foreground-500 font-medium">Auto-Régénération</span>
            </div>
            <p className="text-2xl font-bold text-accent-600">ON</p>
            <p className="text-xs text-foreground-400 mt-1">03:00 UTC quotidien</p>
          </div>
        </div>
      </ScrollReveal>

      {/* LLMs Status */}
      <ScrollReveal>
        <h2 className="text-xl font-bold text-foreground-950 mb-5">État des Fichiers d'Ingestion IA</h2>
        <div className="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div className="bg-background-50 border border-background-200 rounded-xl p-6">
            <div className="flex items-center justify-between mb-4">
              <div>
                <h3 className="font-semibold text-foreground-950">llms.txt</h3>
                <p className="text-xs text-foreground-400">Résumé structuré pour ingestion rapide</p>
              </div>
              <span className="inline-flex items-center gap-1.5 text-xs font-medium px-2.5 py-1 rounded-full bg-accent-100 text-accent-700">
                <span className="w-1.5 h-1.5 rounded-full bg-accent-500"></span>
                Actif
              </span>
            </div>
            <div className="space-y-2 text-sm">
              <div className="flex justify-between">
                <span className="text-foreground-500">Taille</span>
                <span className="text-foreground-800 font-medium">{kosData.data.llmsStatus.llms_txt_size_kb} KB</span>
              </div>
              <div className="flex justify-between">
                <span className="text-foreground-500">Sections</span>
                <span className="text-foreground-800 font-medium">{kosData.data.llmsStatus.llms_txt_sections}</span>
              </div>
              <div className="flex justify-between">
                <span className="text-foreground-500">Fraîcheur</span>
                <span className="text-accent-600 font-medium">{kosData.data.llmsStatus.contentFreshness}%</span>
              </div>
            </div>
          </div>
          <div className="bg-background-50 border border-background-200 rounded-xl p-6">
            <div className="flex items-center justify-between mb-4">
              <div>
                <h3 className="font-semibold text-foreground-950">llms-full.txt</h3>
                <p className="text-xs text-foreground-400">Contexte complet pour ingestion profonde</p>
              </div>
              <span className="inline-flex items-center gap-1.5 text-xs font-medium px-2.5 py-1 rounded-full bg-accent-100 text-accent-700">
                <span className="w-1.5 h-1.5 rounded-full bg-accent-500"></span>
                Actif
              </span>
            </div>
            <div className="space-y-2 text-sm">
              <div className="flex justify-between">
                <span className="text-foreground-500">Taille</span>
                <span className="text-foreground-800 font-medium">{kosData.data.llmsStatus.llms_full_txt_size_kb} KB</span>
              </div>
              <div className="flex justify-between">
                <span className="text-foreground-500">Sections</span>
                <span className="text-foreground-800 font-medium">{kosData.data.llmsStatus.llms_full_txt_sections}</span>
              </div>
              <div className="flex justify-between">
                <span className="text-foreground-500">Régénération</span>
                <span className="text-accent-600 font-medium">{kosData.data.llmsStatus.regenerationSchedule}</span>
              </div>
            </div>
          </div>
        </div>
      </ScrollReveal>

      {/* GEO Optimizations Active */}
      <ScrollReveal>
        <h2 className="text-xl font-bold text-foreground-950 mb-5">Optimisations GEO Actives</h2>
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
          {kosData.data.geoOptimizations.map((opt) => (
            <div key={opt.name} className="bg-background-50 border border-background-200 rounded-xl p-4 flex items-start gap-3">
              <div className={`w-9 h-9 rounded-lg flex items-center justify-center flex-shrink-0 ${
                opt.impact === 'critical' ? 'bg-accent-100' : opt.impact === 'high' ? 'bg-secondary-100' : 'bg-background-100'
              }`}>
                <i className={`${
                  opt.impact === 'critical' ? 'ri-shield-flash-line text-accent-600' :
                  opt.impact === 'high' ? 'ri-check-double-line text-secondary-600' :
                  'ri-check-line text-foreground-500'
                }`}></i>
              </div>
              <div className="min-w-0">
                <div className="flex items-center gap-2 mb-1">
                  <h3 className="text-sm font-semibold text-foreground-950">{opt.name}</h3>
                  <span className={`text-[10px] px-1.5 py-0.5 rounded font-medium uppercase ${
                    opt.impact === 'critical' ? 'bg-accent-100 text-accent-700' :
                    opt.impact === 'high' ? 'bg-secondary-100 text-secondary-700' :
                    'bg-background-100 text-foreground-500'
                  }`}>{opt.impact}</span>
                </div>
                <p className="text-xs text-foreground-500">{opt.description}</p>
              </div>
            </div>
          ))}
        </div>
      </ScrollReveal>

      {/* Trend */}
      <ScrollReveal>
        <h2 className="text-xl font-bold text-foreground-950 mb-5">Évolution du Score GEO</h2>
        <div className="bg-background-50 border border-background-200 rounded-xl p-6">
          <div className="flex items-end gap-3 h-48">
            {kosData.data.scanHistory.slice().reverse().map((scan) => (
              <div key={scan.date} className="flex-1 flex flex-col items-center gap-2">
                <span className="text-xs font-bold text-foreground-800">{scan.score}</span>
                <div
                  className="w-full rounded-t-md transition-all duration-700"
                  style={{
                    height: `${(scan.score / 100) * 160}px`,
                    backgroundColor: scan.score >= 90 ? 'var(--accent-500)' : scan.score >= 75 ? 'var(--secondary-500)' : 'var(--foreground-300)',
                  }}
                ></div>
                <span className="text-[10px] text-foreground-400">{scan.date.split('-')[2]}/{scan.date.split('-')[1]}</span>
              </div>
            ))}
          </div>
          <div className="flex items-center gap-4 mt-4 pt-4 border-t border-background-200 text-xs text-foreground-500">
            <span className="flex items-center gap-1">
              <span className="w-3 h-3 rounded-sm bg-accent-500"></span>
              Excellent (&ge;90)
            </span>
            <span className="flex items-center gap-1">
              <span className="w-3 h-3 rounded-sm bg-secondary-500"></span>
              Bon (75-89)
            </span>
            <span className="flex items-center gap-1">
              <span className="w-3 h-3 rounded-sm bg-foreground-300"></span>
              À améliorer (&lt;75)
            </span>
          </div>
        </div>
      </ScrollReveal>
    </div>
  );
}

function PlatformsTab() {
  return (
    <div className="space-y-6">
      <ScrollReveal>
        <h2 className="text-xl font-bold text-foreground-950 mb-1">Visibilité par Plateforme AI</h2>
        <p className="text-sm text-foreground-500">Score d'optimisation pour chaque moteur d'IA générative majeur</p>
      </ScrollReveal>

      <div className="grid grid-cols-1 md:grid-cols-2 gap-5">
        {kosAIVisibilityCommand.platformScores.map((platform) => (
          <ScrollReveal key={platform.platform}>
            <div className="bg-background-50 border border-background-200 rounded-xl p-6">
              <div className="flex items-start justify-between mb-4">
                <div>
                  <h3 className="font-semibold text-foreground-950">{platform.platform}</h3>
                  <span className={`inline-flex items-center gap-1.5 text-xs font-medium px-2 py-0.5 rounded-full mt-1 ${
                    platform.status === 'optimized' ? 'bg-accent-100 text-accent-700' : 'bg-secondary-100 text-secondary-700'
                  }`}>
                    <span className={`w-1.5 h-1.5 rounded-full ${platform.status === 'optimized' ? 'bg-accent-500' : 'bg-secondary-500'}`}></span>
                    {platform.status === 'optimized' ? 'Optimisé' : 'Bon'}
                  </span>
                </div>
                <div className="text-right">
                  <span className={`text-2xl font-bold ${platform.score >= 90 ? 'text-accent-600' : 'text-foreground-800'}`}>
                    {platform.score}
                  </span>
                  <span className="text-xs text-foreground-400">/100</span>
                </div>
              </div>
              <div className="w-full h-2 bg-background-200 rounded-full overflow-hidden mb-2">
                <div
                  className={`h-full rounded-full transition-all duration-500 ${
                    platform.score >= 90 ? 'bg-accent-500' : 'bg-secondary-500'
                  }`}
                  style={{ width: `${platform.score}%` }}
                ></div>
              </div>
              <p className="text-xs text-foreground-500">{platform.details}</p>
            </div>
          </ScrollReveal>
        ))}
      </div>
    </div>
  );
}

function CrawlersTab({ kosData.data }: { data: ReturnType<typeof useGeoVisibility>['kosData.data'] }) {
  return (
    <div className="space-y-6">
      <ScrollReveal>
        <h2 className="text-xl font-bold text-foreground-950 mb-1">AI Crawlers — Monitoring</h2>
        <p className="text-sm text-foreground-500">Statut de chaque crawler IA, dernières activités, pages crawlées</p>
      </ScrollReveal>

      <ScrollReveal>
        <div className="bg-background-50 border border-background-200 rounded-xl overflow-hidden">
          <table className="w-full text-sm">
            <thead>
              <tr className="border-b border-background-200 bg-background-100">
                <th className="text-left p-4 text-xs font-semibold text-foreground-500 uppercase">Bot</th>
                <th className="text-left p-4 text-xs font-semibold text-foreground-500 uppercase">User-Agent</th>
                <th className="text-right p-4 text-xs font-semibold text-foreground-500 uppercase">Dernière Activité</th>
                <th className="text-right p-4 text-xs font-semibold text-foreground-500 uppercase">Pages Crawlées</th>
                <th className="text-center p-4 text-xs font-semibold text-foreground-500 uppercase">Accès</th>
                <th className="text-center p-4 text-xs font-semibold text-foreground-500 uppercase">Statut</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-background-200">
              {kosData.data.crawlerStatus.map((crawler) => (
                <tr key={crawler.bot} className="hover:bg-background-100 transition-colors">
                  <td className="p-4">
                    <span className="font-medium text-foreground-950">{crawler.bot}</span>
                  </td>
                  <td className="p-4">
                    <code className="text-xs bg-background-100 px-1.5 py-0.5 rounded text-foreground-500">{crawler.userAgent}</code>
                  </td>
                  <td className="p-4 text-right text-foreground-600">
                    {crawler.lastSeen ? new Date(crawler.lastSeen).toLocaleString('fr-FR', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit' }) : '—'}
                  </td>
                  <td className="p-4 text-right text-foreground-600">{crawler.pagesCrawled.toLocaleString()}</td>
                  <td className="p-4 text-center">
                    <span className={`inline-flex items-center gap-1 text-xs font-medium px-2 py-0.5 rounded-full ${
                      crawler.allowed ? 'bg-accent-100 text-accent-700' : 'bg-red-100 text-red-700'
                    }`}>
                      <span className={`w-1.5 h-1.5 rounded-full ${crawler.allowed ? 'bg-accent-500' : 'bg-red-500'}`}></span>
                      {crawler.allowed ? 'Allow' : 'Block'}
                    </span>
                  </td>
                  <td className="p-4 text-center">
                    <span className={`inline-flex items-center gap-1 text-xs font-medium px-2 py-0.5 rounded-full ${
                      crawler.status === 'active' ? 'bg-accent-100 text-accent-700' : 'bg-secondary-100 text-secondary-700'
                    }`}>
                      <span className={`w-1.5 h-1.5 rounded-full ${crawler.status === 'active' ? 'bg-accent-500' : 'bg-secondary-500'}`}></span>
                      {crawler.status === 'active' ? 'Actif' : 'Nouveau'}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </ScrollReveal>
    </div>
  );
}

function SchemaTab({ kosData.data }: { data: ReturnType<typeof useGeoVisibility>['kosData.data'] }) {
  return (
    <div className="space-y-6">
      <ScrollReveal>
        <h2 className="text-xl font-bold text-foreground-950 mb-1">Couverture Schema.org</h2>
        <p className="text-sm text-foreground-500">Données structurées LD+JSON sur les 10 pages clés du site</p>
      </ScrollReveal>

      <ScrollReveal>
        <div className="bg-background-50 border border-background-200 rounded-xl overflow-hidden">
          <table className="w-full text-sm">
            <thead>
              <tr className="border-b border-background-200 bg-background-100">
                <th className="text-left p-4 text-xs font-semibold text-foreground-500 uppercase">Page</th>
                <th className="text-left p-4 text-xs font-semibold text-foreground-500 uppercase">Types Schema.org</th>
                <th className="text-right p-4 text-xs font-semibold text-foreground-500 uppercase">Total</th>
                <th className="text-center p-4 text-xs font-semibold text-foreground-500 uppercase">Rich Results</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-background-200">
              {kosData.data.schemaCoverage.map((page) => (
                <tr key={page.pageUrl} className="hover:bg-background-100 transition-colors">
                  <td className="p-4">
                    <span className="font-medium text-foreground-950">{page.pageUrl}</span>
                  </td>
                  <td className="p-4">
                    <div className="flex flex-wrap gap-1.5">
                      {page.schemas.map((s) => (
                        <span key={s} className="text-[10px] px-2 py-0.5 rounded-full bg-secondary-100 text-secondary-700 font-medium">
                          {s}
                        </span>
                      ))}
                    </div>
                  </td>
                  <td className="p-4 text-right text-foreground-600 font-medium">{page.total}</td>
                  <td className="p-4 text-center">
                    <span className={`inline-flex items-center gap-1 text-xs font-medium px-2 py-0.5 rounded-full ${
                      page.richEligible ? 'bg-accent-100 text-accent-700' : 'bg-background-100 text-foreground-500'
                    }`}>
                      {page.richEligible ? (
                        <>
                          <span className="w-1.5 h-1.5 rounded-full bg-accent-500"></span>
                          Éligible
                        </>
                      ) : (
                        <>
                          <span className="w-1.5 h-1.5 rounded-full bg-foreground-400"></span>
                          Non
                        </>
                      )}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </ScrollReveal>
    </div>
  );
}

function OperationsTab({ kosData.data }: { data: ReturnType<typeof useGeoVisibility>['kosData.data'] }) {
  return (
    <div className="space-y-6">
      <ScrollReveal>
        <h2 className="text-xl font-bold text-foreground-950 mb-1">Opérations Récentes</h2>
        <p className="text-sm text-foreground-500">Historique des scans, régénérations et audits exécutés par les automates KOS</p>
      </ScrollReveal>

      <ScrollReveal>
        <div className="bg-background-50 border border-background-200 rounded-xl overflow-hidden">
          <table className="w-full text-sm">
            <thead>
              <tr className="border-b border-background-200 bg-background-100">
                <th className="text-left p-4 text-xs font-semibold text-foreground-500 uppercase">Date</th>
                <th className="text-left p-4 text-xs font-semibold text-foreground-500 uppercase">Type</th>
                <th className="text-left p-4 text-xs font-semibold text-foreground-500 uppercase">Cible</th>
                <th className="text-right p-4 text-xs font-semibold text-foreground-500 uppercase">Score</th>
                <th className="text-center p-4 text-xs font-semibold text-foreground-500 uppercase">Résultat</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-background-200">
              {kosData.data.recentOperations.map((op) => (
                <tr key={op.id} className="hover:bg-background-100 transition-colors">
                  <td className="p-4 text-foreground-600">
                    {new Date(op.timestamp).toLocaleString('fr-FR', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit' })}
                  </td>
                  <td className="p-4">
                    <span className="text-xs px-2 py-0.5 rounded bg-background-100 text-foreground-500 font-medium">
                      {op.type.replace(/_/g, ' ')}
                    </span>
                  </td>
                  <td className="p-4">
                    <span className="text-xs text-foreground-600">{op.target}</span>
                  </td>
                  <td className="p-4 text-right">
                    {op.score !== null ? (
                      <span className={`font-semibold text-sm ${op.score >= 90 ? 'text-accent-600' : 'text-foreground-800'}`}>
                        {op.score}/100
                      </span>
                    ) : (
                      <span className="text-xs text-foreground-400">—</span>
                    )}
                  </td>
                  <td className="p-4 text-center">
                    <span className={`inline-flex items-center gap-1 text-xs font-medium px-2 py-0.5 rounded-full ${
                      op.result === 'success' ? 'bg-accent-100 text-accent-700' : 'bg-red-100 text-red-700'
                    }`}>
                      <span className={`w-1.5 h-1.5 rounded-full ${op.result === 'success' ? 'bg-accent-500' : 'bg-red-500'}`}></span>
                      {op.result === 'success' ? 'OK' : 'FAIL'}
                    </span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </ScrollReveal>
    </div>
  );
}

function LiveScanTab({ onScanComplete }: { onScanComplete: () => void }) {
  const [scanning, setScanning] = useState(false);
  const [scanResult, setScanResult] = useState<Record<string, unknown> | null>(null);
  const [scanError, setScanError] = useState<string | null>(null);
  const [scanMode, setScanMode] = useState<string>('full');

  const runScan = async () => {
    setScanning(true);
    setScanError(null);
    setScanResult(null);

    try {
      const resp = await fetch('https://pgfwhahiwqvqeahpirjx.supabase.co/functions/v1/kos-geo-visibility-engine', {
        method: 'POST',
        headers: { 'kosData.Content-Type': 'application/json' },
        body: JSON.stringify({
          target_url: 'https://khepraexperts.com',
          mode: scanMode,
          store_results: true,
        }),
      });

      const data = await resp.json();
      setScanResult(kosData.data);
      onScanComplete();
    } catch (err) {
      setScanError(err instanceof Error ? err.message : 'Erreur de scan');
    } finally {
      setScanning(false);
    }
  };

  const testLlmsGenerator = async () => {
    setScanning(true);
    setScanError(null);
    setScanResult(null);

    try {
      const resp = await fetch('https://pgfwhahiwqvqeahpirjx.supabase.co/functions/v1/kos-llms-generator', {
        method: 'POST',
        headers: { 'kosData.Content-Type': 'application/json' },
        body: JSON.stringify({ mode: 'both', base_url: 'https://khepraexperts.com' }),
      });

      const data = await resp.json();
      setScanResult({ ...kosData.data, _note: 'Contenu généré (non sauvegardé automatiquement sur le disque)' });
    } catch (err) {
      setScanError(err instanceof Error ? err.message : 'Erreur de génération');
    } finally {
      setScanning(false);
    }
  };

  return (
    <div className="space-y-8">
      <ScrollReveal>
        <h2 className="text-xl font-bold text-foreground-950 mb-1">Scan Live — GEO Visibility Engine</h2>
        <p className="text-sm text-foreground-500">Déclenchez un scan en temps réel ou régénérez les fichiers llms.txt</p>
      </ScrollReveal>

      {/* Scan GEO */}
      <ScrollReveal>
        <div className="bg-background-50 border border-background-200 rounded-xl p-6">
          <h3 className="font-semibold text-foreground-950 mb-4">Scan GEO Complet</h3>
          <div className="flex flex-wrap gap-3 mb-5">
            {[
              { value: 'full', label: 'Scan Complet' },
              { value: 'quick', label: 'Scan Rapide' },
              { value: 'llms-only', label: 'llms.txt Uniquement' },
              { value: 'crawlers-only', label: 'AI Crawlers Uniquement' },
              { value: 'schema-only', label: 'Schema.org Uniquement' },
            ].map((mode) => (
              <button
                key={mode.value}
                onClick={() => setScanMode(mode.value)}
                className={`px-3 py-1.5 rounded-full text-xs font-medium transition-colors cursor-pointer whitespace-nowrap ${
                  scanMode === mode.value
                    ? 'bg-primary-500 text-white'
                    : 'bg-background-100 text-foreground-600 hover:bg-background-200'
                }`}
              >
                {mode.label}
              </button>
            ))}
          </div>

          <button
            onClick={runScan}
            disabled={scanning}
            className="flex items-center gap-2 px-5 py-2.5 bg-primary-500 text-white rounded-lg text-sm font-medium hover:bg-primary-600 transition-colors cursor-pointer disabled:opacity-50 mb-4"
          >
            {scanning ? (
              <>
                <div className="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                Scan en cours...
              </>
            ) : (
              <>
                <i className="ri-radar-line"></i>
                Lancer le Scan GEO
              </>
            )}
          </button>
        </div>
      </ScrollReveal>

      {/* LLMs Generator */}
      <ScrollReveal>
        <div className="bg-background-50 border border-background-200 rounded-xl p-6">
          <h3 className="font-semibold text-foreground-950 mb-4">Régénération llms.txt</h3>
          <p className="text-sm text-foreground-500 mb-4">
            Génère le contenu de llms.txt et llms-full.txt à partir de la structure actuelle du site.
            Le contenu est retourné dans la réponse — la sauvegarde sur le disque doit être faite manuellement ou via le pipeline CI/CD.
          </p>
          <button
            onClick={testLlmsGenerator}
            disabled={scanning}
            className="flex items-center gap-2 px-5 py-2.5 bg-secondary-500 text-white rounded-lg text-sm font-medium hover:bg-secondary-600 transition-colors cursor-pointer disabled:opacity-50"
          >
            {scanning ? (
              <>
                <div className="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                Génération...
              </>
            ) : (
              <>
                <i className="ri-file-text-line"></i>
                Régénérer llms.txt + llms-full.txt
              </>
            )}
          </button>
        </div>
      </ScrollReveal>

      {/* Results */}
      {scanError && (
        <div className="p-4 bg-red-50 border border-red-200 rounded-lg text-sm text-red-700">
          <strong>Erreur :</strong> {scanError}
        </div>
      )}

      {scanResult && !scanError && (
        <ScrollReveal>
          <div className="bg-background-50 border border-background-200 rounded-xl overflow-hidden">
            <div className="p-4 border-b border-background-200 bg-background-100 flex items-center justify-between">
              <h3 className="font-semibold text-foreground-950 text-sm">Résultat du Scan</h3>
              {scanResult.overall_score !== undefined && (
                <span className={`inline-flex items-center gap-1.5 text-xs font-medium px-2.5 py-1 rounded-full ${
                  scanResult.overall_score >= 90 ? 'bg-accent-100 text-accent-700' :
                  scanResult.overall_score >= 70 ? 'bg-secondary-100 text-secondary-700' :
                  'bg-red-100 text-red-700'
                }`}>
                  Score : {scanResult.overall_score}/100
                </span>
              )}
            </div>
            <pre className="p-4 text-xs text-foreground-700 overflow-x-auto max-h-[600px] overflow-y-auto whitespace-pre-wrap font-mono">
              {JSON.stringify(scanResult, null, 2)}
            </pre>
          </div>
        </ScrollReveal>
      )}
    </div>
  );
}
