import { useState } from 'react';
import KOSHubLayout from '@/components/feature/KOSHubLayout';
import { SeoHead } from '@/components/feature/SeoHead';
import { Link } from 'react-router-dom';
import {
  CHANNEL_OVERALL_KPI, VIDEO_PERFORMANCES, SUBSCRIBER_GROWTH,
  DAILY_VIEWS, AUDIENCE_INSIGHTS, GEO_DISTRIBUTION,
  MONETIZATION_MILESTONES, type VideoPerformance,
} from '@/mocks/kosYouTubeAnalytics';
import { useKOSYoutubeAnalyticsReal, type RealVideoItem } from '@/hooks/useKOSYoutubeAnalyticsReal';

function formatNumber(n: number): string {
  if (n >= 1000000) return `${(n / 1000000).toFixed(1)}M`;
  if (n >= 1000) return `${(n / 1000).toFixed(1)}K`;
  return String(n);
}

function formatWatchTime(seconds: number): string {
  const hours = Math.floor(seconds / 3600);
  return `${hours.toLocaleString()} h`;
}

export default function KOSYouTubeAnalyticsPage() {
  const [kosData, setKosData] = useState<any>(null);
  useEffect(() => {
    fetch('/mocks/kos-blog.json').then(r => r.json()).then(setKosData);
  }, []);
  if (!kosData) return null;

  const [activeTab, setActiveTab] = useState<'dashboard' | 'videos' | 'audience' | 'monetization'>('dashboard');
  const [selectedVideo, setSelectedVideo] = useState<VideoPerformance | null>(null);

  // Real analytics hook
  const realData = useKOSYoutubeAnalyticsReal();

  const mockTotalViews = realData.realData ? realData.channel.views : CHANNEL_OVERALL_KPI.totalViews;
  const mockSubs = realData.realData ? realData.channel.subscribers : CHANNEL_OVERALL_KPI.subscribers;
  const mockSubsGained = realData.realData ? realData.summary.subscribersGained30d : CHANNEL_OVERALL_KPI.subscribersGained30d;
  const mockWatchHours = realData.realData ? Math.round(realData.summary.watchTimeHours30d) : Math.round(CHANNEL_OVERALL_KPI.totalWatchTime / 3600);
  const mockVideos = realData.realData && realData.videos.length > 0 ? realData.videos.length : CHANNEL_OVERALL_KPI.totalVideos;

  const latestSubs = SUBSCRIBER_GROWTH[SUBSCRIBER_GROWTH.length - 1]?.subscribers || 0;
  const subs30dAgo = SUBSCRIBER_GROWTH[0]?.subscribers || 0;
  const subsGrowth = ((latestSubs - subs30dAgo) / subs30dAgo * 100).toFixed(1);

  const todayViews = DAILY_VIEWS[DAILY_VIEWS.length - 1]?.views || 0;
  const yesterdayViews = DAILY_VIEWS[DAILY_VIEWS.length - 2]?.views || 0;
  const viewsTrend = yesterdayViews > 0 ? ((todayViews - yesterdayViews) / yesterdayViews * 100).toFixed(1) : '0';

  const tabs = [
    { id: 'dashboard' as const, label: 'Vue d\'Ensemble', icon: 'ri-dashboard-line' },
    { id: 'videos' as const, label: 'Performances Vidéos', icon: 'ri-movie-line', count: `${realData.realData && realData.videos.length > 0 ? realData.videos.length : VIDEO_PERFORMANCES.length}` },
    { id: 'audience' as const, label: 'Audience', icon: 'ri-user-line' },
    { id: 'monetization' as const, label: 'Monétisation', icon: 'ri-money-dollar-circle-line' },
  ];

  return (
    <KOSHubLayout hubId={31}>
      <SeoHead
        title="KOS YouTube Analytics™ — KPI Réels, Watch Time, CTR, Leads | KHEPRA EXPERTS"
        description="Dashboard analytics YouTube niveau Big Four avec données réelles via YouTube Analytics API v2. KPI : vues, watch time, rétention, CTR, abonnés, leads générés. @KHEPRAEXPERTS."
        keywords="YouTube Analytics, KPI YouTube, watch time, CTR, rétention, leads YouTube, KHEPRA EXPERTS, analytics réel"
        canonicalPath="/kos-youtube-analytics"
        ogType="website"
        ogLocale="fr_FR"
      />

      {/* Hero */}
      <section className="relative bg-foreground-950 overflow-hidden">
        <div className="absolute inset-0 pointer-events-none">
          <div className="absolute top-0 right-0 w-[500px] h-[500px] rounded-full opacity-[0.06]" style={{ background: 'radial-gradient(circle, #FF0000 0%, transparent 70%)' }} />
          <div className="absolute bottom-0 left-0 w-[400px] h-[400px] rounded-full opacity-[0.05]" style={{ background: 'radial-gradient(circle, #059669 0%, transparent 70%)' }} />
        </div>
        <div className="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-14">
          <div className="max-w-3xl">
            <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-white/80 text-xs font-semibold mb-4 backdrop-blur-sm">
              <i className="ri-line-chart-line" />KOS YouTube Analytics™ — Agent 9
              {realData.realData && (
                <span className="flex items-center gap-1 text-emerald-400">
                  <span className="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse" />Données réelles
                </span>
              )}
            </div>
            <h1 className="font-heading text-2xl md:text-4xl font-bold text-white tracking-tight">
              Analytics YouTube — Performance & Croissance Réelle
            </h1>
            <p className="text-sm md:text-base text-gray-400 mt-3 max-w-2xl">
              @KHEPRAEXPERTS · {formatNumber(mockTotalViews)} vues · {formatWatchTime(mockWatchHours * 3600)} watch time · {formatNumber(mockSubs)} abonnés
            </p>
            <div className="flex items-center gap-3 mt-4">
              {realData.loading ? (
                <span className="flex items-center gap-1.5 text-xs text-amber-400">
                  <span className="w-3 h-3 border-2 border-amber-400/40 border-t-amber-400 rounded-full animate-spin" />
                  Connexion YouTube Analytics API...
                </span>
              ) : realData.realData ? (
                <span className="text-xs text-emerald-400 font-bold">
                  <i className="ri-check-double-line mr-1" />YouTube Analytics API v2 — Connecté
                </span>
              ) : (
                <span className="text-xs text-foreground-400">
                  <i className="ri-information-line mr-1" />Données mock — Connectez YouTube OAuth pour les analytics réels
                </span>
              )}
              {!realData.loading && (
                <button onClick={realData.refresh} className="text-xs text-white/60 hover:text-white cursor-pointer">
                  <i className="ri-refresh-line mr-1" />Rafraîchir
                </button>
              )}
            </div>
          </div>
        </div>
      </section>

      {/* Tab Navigation */}
      <section className="sticky top-20 z-30 bg-background-50 border-b border-background-200/70">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="flex gap-1 overflow-x-auto py-3">
            {tabs.map((tab) => (
              <button
                key={tab.id}
                onClick={() => setActiveTab(tab.id)}
                className={`flex items-center gap-2 px-4 py-2.5 rounded-full text-sm font-bold cursor-pointer transition-all whitespace-nowrap ${
                  activeTab === tab.id ? 'bg-foreground-950 text-background-50' : 'text-foreground-600 hover:bg-background-100 hover:text-foreground-900'
                }`}
              >
                <i className={`${tab.icon} text-base`} />{tab.label}
                {tab.count && <span className="text-[10px] px-1.5 py-0.5 rounded-full bg-background-200">{tab.count}</span>}
              </button>
            ))}
          </div>
        </div>
      </section>

      {/* ═══════════════ DASHBOARD ═══════════════ */}
      {activeTab === 'dashboard' && (
        <section className="py-8">
          <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            {/* Real kosData.Data Banner */}
            {realData.error && (
              <div className="rounded-xl p-4 mb-4 border border-amber-200 bg-amber-50">
                <div className="flex items-start gap-2">
                  <i className="ri-error-warning-line text-amber-600" />
                  <div className="text-xs text-amber-800">
                    <strong>Edge Function Analytics :</strong> {realData.error}. Affichage des données mock.
                  </div>
                </div>
              </div>
            )}

            {/* Top KPIs */}
            <div className="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-3 mb-8">
              {[
                { label: 'Vues Totales', value: formatNumber(mockTotalViews), icon: 'ri-eye-line', color: '#FF0000' },
                { label: 'Watch Time', value: `${formatWatchTime(mockWatchHours * 3600)}`, icon: 'ri-time-line', color: '#C2410C' },
                { label: 'Abonnés', value: formatNumber(mockSubs), icon: 'ri-user-add-line', color: '#86BC25' },
                { label: '+30j', value: `+${formatNumber(mockSubsGained)}`, icon: 'ri-arrow-up-line', color: '#059669' },
                { label: 'Vidéos', value: String(mockVideos), icon: 'ri-movie-line', color: '#D97757' },
                { label: 'CTR', value: `${CHANNEL_OVERALL_KPI.avgCtr}%`, icon: 'ri-cursor-line', color: '#0A66C2' },
                { label: 'Leads', value: CHANNEL_OVERALL_KPI.leadsGenerated, icon: 'ri-user-star-line', color: '#DC2626' },
                { label: 'Conversion', value: `${CHANNEL_OVERALL_KPI.conversionRate}%`, icon: 'ri-funds-line', color: '#059669' },
              ].map((s, i) => (
                <div key={i} className="rounded-xl bg-background-50 border border-background-200/70 p-4 text-center">
                  <div className="w-8 h-8 mx-auto mb-2 rounded-lg flex items-center justify-center" style={{ backgroundColor: `${s.color}15` }}>
                    <i className={`${s.icon} text-sm`} style={{ color: s.color }} />
                  </div>
                  <span className="block text-lg font-bold text-foreground-950">{s.value}</span>
                  <span className="text-[10px] text-foreground-400">{s.label}</span>
                </div>
              ))}
            </div>

            {/* Subscriber Growth Chart */}
            <div className="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
              <div className="rounded-2xl bg-background-50 border border-background-200/70 p-6">
                <h2 className="font-heading text-lg font-bold text-foreground-950 mb-4">Croissance Abonnés</h2>
                <div className="flex items-end gap-1 h-[140px]">
                  {SUBSCRIBER_GROWTH.map((d, i) => {
                    const maxSubs2 = Math.max(...SUBSCRIBER_GROWTH.map((s) => s.subscribers));
                    const h = (d.subscribers / maxSubs2) * 100;
                    const isLast = i === SUBSCRIBER_GROWTH.length - 1;
                    return (
                      <div key={d.date} className="flex-1 flex flex-col items-center gap-1">
                        <span className="text-[9px] font-bold text-foreground-500">{formatNumber(d.subscribers)}</span>
                        <div className="w-full rounded-t-md transition-all" style={{ height: `${h}%`, backgroundColor: isLast ? '#FF0000' : '#FF000030' }} />
                        <span className="text-[8px] text-foreground-400">{d.date.split('-')[2]}</span>
                      </div>
                    );
                  })}
                </div>
                <div className="flex items-center gap-2 mt-4 text-xs">
                  <span className="font-bold text-emerald-600">+{subsGrowth}%</span>
                  <span className="text-foreground-500">sur 30 jours · {formatNumber(latestSubs)} abonnés</span>
                </div>
              </div>

              {/* Daily Views Chart */}
              <div className="rounded-2xl bg-background-50 border border-background-200/70 p-6">
                <h2 className="font-heading text-lg font-bold text-foreground-950 mb-4">Vues Quotidiennes</h2>
                <div className="flex items-end gap-1 h-[140px]">
                  {DAILY_VIEWS.slice(-15).map((d, i) => {
                    const maxViews2 = Math.max(...DAILY_VIEWS.slice(-15).map((s) => s.views));
                    const h = (d.views / maxViews2) * 100;
                    return (
                      <div key={d.date} className="flex-1 flex flex-col items-center gap-1">
                        <span className="text-[9px] font-bold text-foreground-500">{d.views}</span>
                        <div className="w-full rounded-t-md transition-all" style={{ height: `${h}%`, backgroundColor: '#0A66C240' }} />
                        <span className="text-[8px] text-foreground-400">{d.date.split('-')[2]}</span>
                      </div>
                    );
                  })}
                </div>
                <div className="flex items-center gap-2 mt-4 text-xs">
                  <span className={`font-bold ${Number(viewsTrend) >= 0 ? 'text-emerald-600' : 'text-red-600'}`}>
                    {Number(viewsTrend) >= 0 ? '+' : ''}{viewsTrend}%
                  </span>
                  <span className="text-foreground-500">vs hier · {todayViews} vues aujourd'hui</span>
                </div>
              </div>
            </div>

            {/* Real Videos Section */}
            {realData.realData && realData.videos.length > 0 && (
              <div className="mb-8">
                <div className="flex items-center gap-3 mb-4">
                  <h2 className="font-heading text-xl font-bold text-foreground-950">Vidéos Réelles — YouTube kosData.Data API v3</h2>
                  <span className="text-xs text-emerald-600 font-bold">
                    <span className="w-2 h-2 rounded-full bg-emerald-500 inline-block mr-1 animate-pulse" />
                    {realData.videos.length} vidéos chargées
                  </span>
                </div>
                <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                  {realData.videos.slice(0, 3).map((vid: RealVideoItem) => (
                    <div key={vid.id} className="rounded-xl bg-background-50 border border-background-200/70 p-4">
                      <div className="w-full h-32 rounded-lg overflow-hidden mb-3 bg-foreground-950">
                        {vid.thumbnailUrl ? (
                          <img src={vid.thumbnailUrl} alt={vid.title} className="w-full h-full object-cover" loading="lazy" width="320" height="180" />
                        ) : (
                          <div className="w-full h-full flex items-center justify-center text-foreground-400">
                            <i className="ri-movie-line text-2xl" />
                          </div>
                        )}
                      </div>
                      <h3 className="text-sm font-bold text-foreground-950 line-clamp-2 mb-2">{vid.title}</h3>
                      <div className="flex items-center gap-3 text-xs text-foreground-500">
                        <span><i className="ri-eye-line mr-1" />{formatNumber(vid.views)}</span>
                        <span><i className="ri-thumb-up-line mr-1" />{vid.likes}</span>
                        <span className="text-emerald-600 font-bold">{vid.durationFormatted}</span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* Top 3 Mock Videos */}
            <div className="mb-8">
              <h2 className="font-heading text-xl font-bold text-foreground-950 mb-4">Top 3 Vidéos {!realData.realData && '(Mock)'}</h2>
              <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
                {VIDEO_PERFORMANCES.sort((a, b) => b.views - a.views).slice(0, 3).map((vid) => (
                  <button
                    key={vid.id}
                    onClick={() => { setSelectedVideo(vid); setActiveTab('videos'); }}
                    className="rounded-xl bg-background-50 border border-background-200/70 p-4 text-left hover:border-foreground-200 transition-colors cursor-pointer"
                  >
                    <div className="w-full h-32 rounded-lg overflow-hidden mb-3 bg-foreground-950">
                      <img src={vid.thumbnailUrl} alt={vid.title} className="w-full h-full object-cover" loading="lazy" width="320" height="180" />
                    </div>
                    <h3 className="text-sm font-bold text-foreground-950 line-clamp-2 mb-2">{vid.title}</h3>
                    <div className="flex items-center gap-3 text-xs text-foreground-500">
                      <span><i className="ri-eye-line mr-1" />{formatNumber(vid.views)}</span>
                      <span><i className="ri-thumb-up-line mr-1" />{vid.likes}</span>
                      <span><i className="ri-message-2-line mr-1" />{vid.comments}</span>
                    </div>
                  </button>
                ))}
              </div>
            </div>

            {/* Pipeline Conversion */}
            <div className="rounded-2xl bg-foreground-950 p-6 mb-8 text-white">
              <h2 className="font-heading text-lg font-bold mb-4">Pipeline YouTube → Lead → Mission</h2>
              <div className="flex items-center gap-2">
                {[
                  { label: 'Vues', value: formatNumber(mockTotalViews), color: '#FF0000' },
                  { label: 'Clics', value: formatNumber(Math.round(mockTotalViews * CHANNEL_OVERALL_KPI.avgCtr / 100)), color: '#0A66C2' },
                  { label: 'Leads', value: CHANNEL_OVERALL_KPI.leadsGenerated, color: '#CA8A04' },
                  { label: 'Convertis', value: CHANNEL_OVERALL_KPI.leadsConverted, color: '#059669' },
                ].map((step, i) => (
                  <div key={step.label} className="flex-1 text-center">
                    <div className="w-3 h-3 rounded-full mx-auto mb-2" style={{ backgroundColor: step.color }} />
                    <span className="block text-base font-bold">{step.value}</span>
                    <span className="text-[10px] text-gray-400">{step.label}</span>
                  </div>
                ))}
              </div>
              <div className="flex items-center mt-4 space-x-1">
                {[...Array(4)].map((_, i) => (
                  <div key={i} className="flex-1 h-1.5 rounded-full" style={{ backgroundColor: ['#FF0000', '#0A66C2', '#CA8A04', '#059669'][i] }} />
                ))}
              </div>
            </div>
          </div>
        </section>
      )}

      {/* ═══════ VIDEOS TAB (unchanged from mock) ═══════ */}
      {activeTab === 'videos' && (
        <section className="py-8">
          <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 className="font-heading text-2xl font-bold text-foreground-950 mb-6">Performances Vidéos — {VIDEO_PERFORMANCES.length}</h2>
            <div className="space-y-4">
              {VIDEO_PERFORMANCES.sort((a, b) => b.views - a.views).map((vid) => {
                const isSelected = selectedVideo?.id === vid.id;
                return (
                  <div key={vid.id} className={`rounded-2xl border transition-all ${isSelected ? 'border-foreground-300 bg-background-50 ring-2 ring-foreground-200' : 'border-background-200/70 bg-background-50 hover:border-foreground-200'}`}>
                    <button
                      onClick={() => setSelectedVideo(isSelected ? null : vid)}
                      className="w-full p-4 text-left flex items-start gap-4 cursor-pointer"
                    >
                      <div className="w-32 h-18 rounded-lg overflow-hidden flex-shrink-0 bg-foreground-950">
                        <img src={vid.thumbnailUrl} alt={vid.title} className="w-full h-full object-cover" loading="lazy" width="160" height="90" />
                      </div>
                      <div className="flex-1 min-w-0">
                        <h3 className="text-sm font-bold text-foreground-950 mb-1 line-clamp-2">{vid.title}</h3>
                        <p className="text-xs text-foreground-500">{vid.duration} · Publié le {new Date(vid.publishedAt).toLocaleDateString('fr-FR')}</p>
                        <div className="flex flex-wrap items-center gap-3 mt-2 text-xs">
                          <span className="font-bold text-foreground-800"><i className="ri-eye-line mr-1 text-foreground-400" />{formatNumber(vid.views)}</span>
                          <span className="text-foreground-600"><i className="ri-thumb-up-line mr-1 text-foreground-400" />{vid.likes}</span>
                          <span className="text-foreground-600"><i className="ri-message-2-line mr-1 text-foreground-400" />{vid.comments}</span>
                          <span className="text-foreground-600"><i className="ri-share-line mr-1 text-foreground-400" />{vid.shares}</span>
                          <span className="text-foreground-600"><i className="ri-timer-line mr-1 text-foreground-400" />{vid.avgViewDuration}</span>
                          <span className="font-bold" style={{ color: vid.ctr >= 7 ? '#059669' : '#CA8A04' }}>CTR {vid.ctr}%</span>
                        </div>
                        <div className="flex items-center gap-2 mt-2">
                          <div className="flex-1 h-1.5 rounded-full bg-background-100 overflow-hidden">
                            <div className="h-full rounded-full bg-emerald-500" style={{ width: `${vid.retentionRate}%` }} />
                          </div>
                          <span className="text-[10px] font-bold text-foreground-500">{vid.retentionRate}% rétention</span>
                        </div>
                      </div>
                      <i className={`ri-${isSelected ? 'subtract' : 'add'}-line text-foreground-400 text-lg`} />
                    </button>
                    {isSelected && (
                      <div className="px-5 pb-5 border-t border-background-200/70 pt-4">
                        <div className="grid grid-cols-1 md:grid-cols-3 gap-5">
                          <div className="space-y-3">
                            <div>
                              <span className="text-[10px] font-bold text-foreground-500 uppercase tracking-wider">Sources de Trafic</span>
                              <div className="space-y-1.5 mt-2">
                                {Object.entries(vid.trafficSources).map(([source, pct]) => (
                                  <div key={source} className="flex items-center gap-2">
                                    <span className="text-[10px] text-foreground-500 w-24 capitalize">{source.replace('_', ' ')}</span>
                                    <div className="flex-1 h-1.5 rounded-full bg-background-100 overflow-hidden">
                                      <div className="h-full rounded-full bg-foreground-400" style={{ width: `${pct}%` }} />
                                    </div>
                                    <span className="text-[10px] font-bold text-foreground-600">{pct}%</span>
                                  </div>
                                ))}
                              </div>
                            </div>
                          </div>
                          <div className="space-y-3">
                            <div>
                              <span className="text-[10px] font-bold text-foreground-500 uppercase tracking-wider">Top Pays</span>
                              <div className="space-y-1 mt-2">
                                {vid.topCountries.map((c) => (
                                  <div key={c.country} className="flex items-center justify-between text-xs">
                                    <span className="text-foreground-700">{c.country}</span>
                                    <span className="font-bold text-foreground-500">{formatNumber(c.views)} ({c.pct}%)</span>
                                  </div>
                                ))}
                              </div>
                            </div>
                          </div>
                          <div className="space-y-3">
                            <div className="bg-accent-50 border border-accent-200 rounded-xl p-4">
                              <span className="text-[10px] font-bold text-accent-700 uppercase tracking-wider">Résumé</span>
                              <ul className="mt-2 space-y-1.5 text-xs text-accent-800">
                                <li className="flex items-start gap-1.5"><i className="ri-checkbox-circle-line text-accent-500 mt-0.5 flex-shrink-0" />{formatNumber(vid.views)} vues — {vid.avgViewDuration} durée moyenne</li>
                                <li className="flex items-start gap-1.5"><i className="ri-checkbox-circle-line text-accent-500 mt-0.5 flex-shrink-0" />{vid.retentionRate}% rétention — CTR {vid.ctr}%</li>
                                <li className="flex items-start gap-1.5"><i className="ri-checkbox-circle-line text-accent-500 mt-0.5 flex-shrink-0" />+{vid.subscribersGained} abonnés gagnés</li>
                                <li className="flex items-start gap-1.5"><i className="ri-checkbox-circle-line text-accent-500 mt-0.5 flex-shrink-0" />{vid.topCountries[0]?.country} : {vid.topCountries[0]?.pct}% de l'audience</li>
                              </ul>
                            </div>
                          </div>
                        </div>
                      </div>
                    )}
                  </div>
                );
              })}
            </div>
          </div>
        </section>
      )}

      {/* ═══════ AUDIENCE TAB ═══════ */}
      {activeTab === 'audience' && (
        <section className="py-8">
          <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div className="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
              <div className="rounded-2xl bg-background-50 border border-background-200/70 p-6">
                <h2 className="font-heading text-lg font-bold text-foreground-950 mb-4">Âge de l'Audience</h2>
                <div className="space-y-3">
                  {AUDIENCE_INSIGHTS.map((ins) => (
                    <div key={ins.ageGroup}>
                      <div className="flex items-center justify-between text-xs mb-1">
                        <span className="font-bold text-foreground-700">{ins.ageGroup} ans</span>
                        <div className="flex items-center gap-2">
                          <span className="text-foreground-400">{ins.label}</span>
                          <span className="font-bold text-foreground-950">{ins.percentage}%</span>
                        </div>
                      </div>
                      <div className="w-full h-2.5 rounded-full bg-background-100 overflow-hidden">
                        <div className="h-full rounded-full" style={{ width: `${ins.percentage}%`, backgroundColor: ins.percentage >= 30 ? '#86BC25' : ins.percentage >= 15 ? '#C2410C' : '#6B7280' }} />
                      </div>
                    </div>
                  ))}
                </div>
              </div>
              <div className="rounded-2xl bg-background-50 border border-background-200/70 p-6">
                <h2 className="font-heading text-lg font-bold text-foreground-950 mb-4">Distribution Géographique</h2>
                <div className="space-y-2">
                  {GEO_DISTRIBUTION.map((geo) => (
                    <div key={geo.country} className="flex items-center gap-3">
                      <span className="text-sm w-7 text-center">{geo.flag}</span>
                      <span className="flex-1 text-xs font-bold text-foreground-700">{geo.country}</span>
                      <div className="flex-1 h-2 rounded-full bg-background-100 overflow-hidden">
                        <div className="h-full rounded-full bg-emerald-500" style={{ width: `${geo.pct}%` }} />
                      </div>
                      <span className="text-xs font-bold text-foreground-500 w-10 text-right">{geo.pct}%</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
            <div className="rounded-2xl bg-foreground-950 p-6 text-white">
              <h2 className="font-heading text-lg font-bold mb-4">Profil de l'Audience @KHEPRAEXPERTS</h2>
              <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                {[
                  { label: 'Top Pays', value: 'Côte d\'Ivoire', sub: '22% de l\'audience' },
                  { label: 'Tranche d\'Âge', value: '25-34 ans', sub: '38% — Jeunes cadres' },
                  { label: 'Genre', value: '72% Hommes', sub: '28% Femmes' },
                  { label: 'Langue Principale', value: 'Français', sub: '94% des viewers' },
                ].map((s, i) => (
                  <div key={i} className="text-center p-4 rounded-xl bg-white/5">
                    <span className="text-[10px] text-gray-400 uppercase tracking-wider">{s.label}</span>
                    <p className="font-heading text-xl font-bold mt-1">{s.value}</p>
                    <span className="text-xs text-gray-400">{s.sub}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </section>
      )}

      {/* ═══════ MONETIZATION TAB ═══════ */}
      {activeTab === 'monetization' && (
        <section className="py-8">
          <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div className="mb-8">
              <div className="flex items-center gap-3 mb-4">
                <div className="w-12 h-12 rounded-xl bg-[#FF0000]/15 flex items-center justify-center">
                  <i className="ri-money-dollar-circle-line text-[#FF0000] text-xl" />
                </div>
                <div>
                  <h2 className="font-heading text-2xl font-bold text-foreground-950">YouTube Partner Program</h2>
                  <p className="text-sm text-foreground-500">Statut : <span className="font-bold text-amber-600">En progression — {CHANNEL_OVERALL_KPI.daysToMonetization} jours estimés</span></p>
                </div>
              </div>
            </div>
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
              {MONETIZATION_MILESTONES.map((ms) => (
                <div key={ms.milestone} className={`rounded-xl border p-5 ${ms.achieved ? 'bg-emerald-50 border-emerald-200' : 'bg-background-50 border-background-200/70'}`}>
                  <div className="flex items-center gap-3">
                    <div className={`w-9 h-9 rounded-full flex items-center justify-center ${ms.achieved ? 'bg-emerald-500' : 'bg-background-100'}`}>
                      <i className={`${ms.achieved ? 'ri-check-line text-white' : 'ri-time-line text-foreground-400'} text-base`} />
                    </div>
                    <div>
                      <h3 className="text-sm font-bold text-foreground-950">{ms.milestone}</h3>
                      <span className="text-xs text-foreground-500">
                        {ms.achieved ? 'Atteint' : 'En attente'} — {ms.required} requis · {ms.current} actuel
                      </span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
            <div className="rounded-2xl bg-foreground-950 p-6 text-white">
              <h2 className="font-heading text-lg font-bold mb-4">Résumé Monétisation</h2>
              <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                {[
                  { label: 'Milestones Atteints', value: `${MONETIZATION_MILESTONES.filter((m) => m.achieved).length}/${MONETIZATION_MILESTONES.length}`, color: '#059669' },
                  { label: 'Abonnés', value: `${formatNumber(mockSubs)} / 1 000`, color: '#86BC25' },
                  { label: 'Watch Time', value: `${formatWatchTime(mockWatchHours * 3600)} / 4 000 h`, color: '#C2410C' },
                  { label: 'Revenus Estimés', value: CHANNEL_OVERALL_KPI.revenueEstimated, color: '#FF0000' },
                ].map((s, i) => (
                  <div key={i} className="text-center p-4 rounded-xl bg-white/5">
                    <span className="text-[10px] text-gray-400 uppercase tracking-wider">{s.label}</span>
                    <p className="font-heading text-xl font-bold mt-1" style={{ color: s.color }}>{s.value}</p>
                  </div>
                ))}
              </div>
              <div className="mt-4 p-4 rounded-xl bg-amber-500/10 border border-amber-500/20 text-sm text-amber-300">
                <i className="ri-information-line mr-2" />
                Le YPP exige 1 000 abonnés et 4 000 heures de visionnage sur 12 mois. Tous les critères quantitatifs sont atteints. Les critères qualitatifs (AdSense, vérification) sont en cours.
              </div>
            </div>
          </div>
        </section>
      )}

      {/* Cross-Link */}
      <section className="py-12 bg-foreground-950">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="flex flex-col lg:flex-row items-center justify-between gap-6">
            <div>
              <h2 className="font-heading text-2xl font-bold text-white mb-2">Écosystème KOS Media — Pipeline Complet</h2>
              <p className="text-gray-400 text-sm">YouTube Connect → Analytics Réels → Monitoring → Production Pipeline → Thumbnail Factory → Playlist Engine.</p>
            </div>
            <div className="flex flex-wrap gap-3">
              <Link to="/youtube-connect" className="flex items-center gap-2 px-5 py-3 rounded-xl bg-[#FF0000] text-white font-bold text-sm hover:bg-[#CC0000] cursor-pointer whitespace-nowrap">
                <i className="ri-youtube-fill" />YouTube Connect
              </Link>
              <Link to="/kos-youtube-monitoring" className="flex items-center gap-2 px-5 py-3 rounded-xl bg-white/10 text-white font-bold text-sm hover:bg-white/20 cursor-pointer whitespace-nowrap">
                <i className="ri-radar-line" />Monitoring Center
              </Link>
              <Link to="/kos-youtube-production-pipeline" className="flex items-center gap-2 px-5 py-3 rounded-xl text-white font-bold text-sm cursor-pointer whitespace-nowrap" style={{ backgroundColor: '#86BC25' }}>
                <i className="ri-rocket-2-line" />Production Pipeline
              </Link>
            </div>
          </div>
        </div>
      </section>
    </KOSHubLayout>
  );
}
