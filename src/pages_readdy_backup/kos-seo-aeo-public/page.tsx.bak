import { useState } from 'react';
import KOSHubLayout from '@/components/feature/KOSHubLayout';

export default function KosSeoAeoPublicPage() {
  const [kosData, setKosData] = useState<any>(null);
  useEffect(() => {
    fetch('/mocks/kos-blog.json').then(r => r.json()).then(setKosData);
  }, []);
  if (!kosData) return null;

  const [activeTab, setActiveTab] = useState<'overview' | 'cwv' | 'aeo' | 'schema' | 'seo' | 'geo'>('overview');
  const d = seoAeoPublicDashboard;

  const getStatusBadge = (status: string) => {
    const map: Record<string, string> = {
      pass: 'bg-green-100 text-green-800',
      good: 'bg-green-100 text-green-800',
      improving: 'bg-yellow-100 text-yellow-800',
      warning: 'bg-yellow-100 text-yellow-800',
      critical: 'bg-red-100 text-red-800',
      poor: 'bg-red-100 text-red-800',
      missing: 'bg-red-100 text-red-800',
      in_progress: 'bg-blue-100 text-blue-800',
      planned: 'bg-gray-100 text-gray-700',
      up: 'bg-green-100 text-green-800',
      stable: 'bg-gray-100 text-gray-700',
      down: 'bg-red-100 text-red-800',
      complete: 'bg-green-100 text-green-800',
      medium: 'bg-yellow-100 text-yellow-800',
      high: 'bg-red-100 text-red-800'
    };
    return map[status] || 'bg-gray-100 text-gray-700';
  };

  const tabs = [
    { id: 'overview' as const, label: 'Vue d\'Ensemble', icon: 'ri-dashboard-line' },
    { id: 'cwv' as const, label: 'Core Web Vitals', icon: 'ri-speed-line' },
    { id: 'aeo' as const, label: 'AEO (6 Moteurs IA)', icon: 'ri-robot-2-line' },
    { id: 'schema' as const, label: 'Schema.org', icon: 'ri-code-s-slash-line' },
    { id: 'seo' as const, label: 'SEO & Backlinks', icon: 'ri-search-line' },
    { id: 'geo' as const, label: 'GEO Visibilité', icon: 'ri-earth-line' }
  ];

  return (
    <KOSHubLayout hubId="kos-seo-aeo-public" title={d.title} subtitle={d.subtitle}>
      <div className="space-y-8">
        {/* Score Global */}
        <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div className="bg-background-100 rounded-lg p-5">
            <div className="text-xs text-foreground-600 uppercase tracking-wider mb-1">Score SEO Global</div>
            <div className="flex items-end gap-2">
              <span className="text-4xl font-bold text-foreground-950">{d.globalScore}</span>
              <span className="text-lg text-foreground-500">/100</span>
            </div>
            <div className="text-xs text-foreground-500 mt-1">Cible: {d.targetScore}/100</div>
            <div className="mt-2 w-full bg-background-200 rounded-full h-2">
              <div className="bg-green-500 h-2 rounded-full" style={{ width: `${d.globalScore}%` }} />
            </div>
          </div>
          <div className="bg-background-100 rounded-lg p-5">
            <div className="text-xs text-foreground-600 uppercase tracking-wider mb-1">Pages Expertes</div>
            <div className="flex items-end gap-2">
              <span className="text-4xl font-bold text-foreground-950">{d.seo.pagesExpertes}</span>
              <span className="text-lg text-foreground-500">/ {d.seo.targetPages}</span>
            </div>
            <div className="text-xs text-foreground-500 mt-1">{Math.round((d.seo.pagesExpertes / d.seo.targetPages) * 100)}% de l'objectif</div>
          </div>
          <div className="bg-background-100 rounded-lg p-5">
            <div className="text-xs text-foreground-600 uppercase tracking-wider mb-1">Backlinks Qualifiés</div>
            <div className="flex items-end gap-2">
              <span className="text-4xl font-bold text-foreground-950">{d.seo.backlinks}</span>
              <span className="text-lg text-foreground-500">/ {d.seo.targetBacklinks}</span>
            </div>
            <div className="text-xs text-foreground-500 mt-1">{Math.round((d.seo.backlinks / d.seo.targetBacklinks) * 100)}% de l'objectif</div>
          </div>
        </div>

        {/* Tabs */}
        <div className="flex flex-wrap gap-1 bg-background-100 rounded-full p-1">
          {tabs.map(tab => (
            <button
              key={tab.id}
              onClick={() => setActiveTab(tab.id)}
              className={`flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-medium whitespace-nowrap transition-colors cursor-pointer ${
                activeTab === tab.id
                  ? 'bg-background-50 text-foreground-950 shadow-sm'
                  : 'text-foreground-600 hover:text-foreground-900'
              }`}
            >
              <i className={`${tab.icon}`} />
              {tab.label}
            </button>
          ))}
        </div>

        {/* Tab kosData.Content */}
        {activeTab === 'overview' && (
          <div className="space-y-6">
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
              <div className="bg-background-100 rounded-lg p-4 text-center">
                <div className="text-3xl font-bold text-foreground-950">{d.coreWebVitals.score}</div>
                <div className="text-xs text-foreground-500 mt-1">Core Web Vitals</div>
                <div className="text-xs text-foreground-400">Cible: {d.coreWebVitals.target}</div>
              </div>
              <div className="bg-background-100 rounded-lg p-4 text-center">
                <div className="text-3xl font-bold text-foreground-950">{d.aeo.score}</div>
                <div className="text-xs text-foreground-500 mt-1">Score AEO</div>
                <div className="text-xs text-foreground-400">Cible: {d.aeo.target}</div>
              </div>
              <div className="bg-background-100 rounded-lg p-4 text-center">
                <div className="text-3xl font-bold text-foreground-950">{d.schema.score}</div>
                <div className="text-xs text-foreground-500 mt-1">Schema.org</div>
                <div className="text-xs text-foreground-400">Cible: {d.schema.target}</div>
              </div>
              <div className="bg-background-100 rounded-lg p-4 text-center">
                <div className="text-3xl font-bold text-foreground-950">{d.geoVisibility.score}</div>
                <div className="text-xs text-foreground-500 mt-1">GEO Visibilité</div>
                <div className="text-xs text-foreground-400">Cible: {d.geoVisibility.target}</div>
              </div>
            </div>

            <div className="bg-background-100 rounded-lg p-5">
              <h3 className="text-base font-semibold text-foreground-950 mb-4 flex items-center gap-2">
                <i className="ri-flag-line" /> Plan d'Action Prioritaire
              </h3>
              <div className="space-y-3">
                {d.actionPlan.map((action, i) => (
                  <div key={i} className="flex items-start gap-3 p-3 bg-background-50 rounded-lg">
                    <span className={`px-2 py-0.5 rounded text-xs font-medium whitespace-nowrap ${
                      action.priority === 'critical' ? 'bg-red-100 text-red-800' :
                      action.priority === 'high' ? 'bg-yellow-100 text-yellow-800' :
                      'bg-blue-100 text-blue-800'
                    }`}>
                      {action.priority === 'critical' ? 'CRITIQUE' : action.priority === 'high' ? 'HAUTE' : 'MOYENNE'}
                    </span>
                    <div className="flex-1 min-w-0">
                      <div className="text-sm font-medium text-foreground-900">{action.action}</div>
                      <div className="flex items-center gap-3 mt-1 text-xs text-foreground-500">
                        <span><i className="ri-calendar-line mr-1" />{action.deadline}</span>
                        <span><i className="ri-flashlight-line mr-1" />{action.impact}</span>
                        <span className={`px-1.5 py-0.5 rounded text-xs ${getStatusBadge(action.status)}`}>
                          {action.status === 'in_progress' ? 'En cours' : 'Planifié'}
                        </span>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}

        {activeTab === 'cwv' && (
          <div className="space-y-6">
            <div className="overflow-x-auto">
              <table className="w-full text-sm">
                <thead>
                  <tr className="border-b border-background-200">
                    <th className="text-left py-3 px-4 text-foreground-600 font-medium">Métrique</th>
                    <th className="text-left py-3 px-4 text-foreground-600 font-medium">Valeur</th>
                    <th className="text-left py-3 px-4 text-foreground-600 font-medium">Seuil</th>
                    <th className="text-left py-3 px-4 text-foreground-600 font-medium">Score</th>
                    <th className="text-left py-3 px-4 text-foreground-600 font-medium">Statut</th>
                  </tr>
                </thead>
                <tbody>
                  {d.coreWebVitals.metrics.map((m, i) => (
                    <tr key={i} className="border-b border-background-100">
                      <td className="py-3 px-4 text-foreground-900">{m.name}</td>
                      <td className="py-3 px-4 font-mono text-foreground-950">{m.value}</td>
                      <td className="py-3 px-4 text-foreground-500">{m.threshold}</td>
                      <td className="py-3 px-4 font-semibold text-foreground-950">{m.score}</td>
                      <td className="py-3 px-4">
                        <span className={`px-2 py-0.5 rounded text-xs ${getStatusBadge(m.status)}`}>
                          {m.status === 'pass' ? 'OK' : 'NOK'}
                        </span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <div className="bg-red-50 rounded-lg p-5">
              <h3 className="text-sm font-semibold text-red-900 mb-3 flex items-center gap-2">
                <i className="ri-error-warning-line" /> Pages CWV Poor ({d.coreWebVitals.pagesPoor})
              </h3>
              <div className="space-y-2">
                {d.coreWebVitals.poorPages.map((p, i) => (
                  <div key={i} className="flex items-center justify-between text-sm bg-white rounded p-3">
                    <div className="flex-1 min-w-0">
                      <div className="text-foreground-900 truncate">{p.url}</div>
                      <div className="text-xs text-foreground-500 mt-0.5">LCP: {p.lcp} · CLS: {p.cls} · {p.issue}</div>
                    </div>
                    <span className="text-xs text-red-600 font-medium whitespace-nowrap ml-3">À corriger</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}

        {activeTab === 'aeo' && (
          <div className="space-y-6">
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              {d.aeo.engines.map((e, i) => (
                <div key={i} className="bg-background-100 rounded-lg p-4">
                  <div className="flex items-center justify-between mb-2">
                    <span className="font-semibold text-foreground-950">{e.name}</span>
                    <span className={`px-2 py-0.5 rounded text-xs ${getStatusBadge(e.status)}`}>
                      {e.status === 'good' ? 'Bon' : e.status === 'improving' ? 'En progression' : 'Critique'}
                    </span>
                  </div>
                  <div className="text-3xl font-bold text-foreground-950">{e.score}<span className="text-lg text-foreground-400">/100</span></div>
                  <div className="text-xs text-foreground-500 mt-1">{e.citations} citations</div>
                  <div className="text-xs text-foreground-400 mt-2 line-clamp-2">{e.queries}</div>
                </div>
              ))}
            </div>
            <div className="bg-background-100 rounded-lg p-5">
              <h3 className="text-sm font-semibold text-foreground-950 mb-2 flex items-center gap-2">
                <i className="ri-file-text-line" /> llms.txt
              </h3>
              <div className="flex items-center gap-6 text-sm">
                <span className="text-foreground-600">Statut: <span className="text-green-700 font-medium">Actif</span></span>
                <span className="text-foreground-600">Taille: <span className="font-medium">{d.aeo.llmsTxt.size}</span></span>
                <span className="text-foreground-600">Pages indexées: <span className="font-medium">{d.aeo.llmsTxt.pagesIndexed}</span></span>
                <span className="text-foreground-600">Dernière génération: <span className="font-medium">{new Date(d.aeo.llmsTxt.lastGenerated).toLocaleDateString('fr-FR')}</span></span>
              </div>
            </div>
          </div>
        )}

        {activeTab === 'schema' && (
          <div className="space-y-4">
            <div className="overflow-x-auto">
              <table className="w-full text-sm">
                <thead>
                  <tr className="border-b border-background-200">
                    <th className="text-left py-3 px-4 text-foreground-600 font-medium">Type Schema.org</th>
                    <th className="text-left py-3 px-4 text-foreground-600 font-medium">Pages</th>
                    <th className="text-left py-3 px-4 text-foreground-600 font-medium">Statut</th>
                    <th className="text-left py-3 px-4 text-foreground-600 font-medium">Priorité</th>
                  </tr>
                </thead>
                <tbody>
                  {d.schema.types.map((t, i) => (
                    <tr key={i} className="border-b border-background-100">
                      <td className="py-3 px-4 font-medium text-foreground-900">{t.type}</td>
                      <td className="py-3 px-4 text-foreground-600">{t.pages}</td>
                      <td className="py-3 px-4">
                        <span className={`px-2 py-0.5 rounded text-xs ${t.status === 'complete' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}`}>
                          {t.status === 'complete' ? 'Complet' : 'Manquant'}
                        </span>
                      </td>
                      <td className="py-3 px-4">
                        {t.priority && (
                          <span className={`px-2 py-0.5 rounded text-xs ${getStatusBadge(t.priority)}`}>
                            {t.priority === 'high' ? 'Haute' : 'Moyenne'}
                          </span>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}

        {activeTab === 'seo' && (
          <div className="space-y-6">
            <div className="bg-background-100 rounded-lg p-5">
              <h3 className="text-sm font-semibold text-foreground-950 mb-3 flex items-center gap-2">
                <i className="ri-trophy-line" /> Top 12 Mots-Clés Stratégiques
              </h3>
              <div className="overflow-x-auto">
                <table className="w-full text-sm">
                  <thead>
                    <tr className="border-b border-background-200">
                      <th className="text-left py-2 px-3 text-foreground-600 font-medium">Mot-clé</th>
                      <th className="text-center py-2 px-3 text-foreground-600 font-medium">Position</th>
                      <th className="text-center py-2 px-3 text-foreground-600 font-medium">Volume</th>
                      <th className="text-center py-2 px-3 text-foreground-600 font-medium">Tendance</th>
                    </tr>
                  </thead>
                  <tbody>
                    {d.seo.topKeywords.map((kw, i) => (
                      <tr key={i} className="border-b border-background-100">
                        <td className="py-2 px-3 text-foreground-900">{kw.keyword}</td>
                        <td className="py-2 px-3 text-center">
                          <span className={`inline-flex items-center justify-center w-7 h-7 rounded-full text-xs font-bold ${
                            kw.position <= 3 ? 'bg-green-100 text-green-800' :
                            kw.position <= 5 ? 'bg-yellow-100 text-yellow-800' :
                            'bg-gray-100 text-gray-700'
                          }`}>
                            {kw.position}
                          </span>
                        </td>
                        <td className="py-2 px-3 text-center text-foreground-600">{kw.volume.toLocaleString('fr-FR')}</td>
                        <td className="py-2 px-3 text-center">
                          <i className={`${kw.trend === 'up' ? 'ri-arrow-up-line text-green-600' : 'ri-subtract-line text-gray-400'}`} />
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>

            <div className="bg-background-100 rounded-lg p-5">
              <h3 className="text-sm font-semibold text-foreground-950 mb-3 flex items-center gap-2">
                <i className="ri-link" /> Derniers Backlinks Acquis
              </h3>
              <div className="space-y-2">
                {d.seo.backlinksRecent.map((bl, i) => (
                  <div key={i} className="flex items-center justify-between text-sm bg-background-50 rounded p-3">
                    <div className="flex-1 min-w-0">
                      <div className="text-foreground-900 font-medium">{bl.domain}</div>
                      <div className="text-xs text-foreground-500 truncate">{bl.page}</div>
                    </div>
                    <div className="flex items-center gap-3 text-xs text-foreground-500 ml-3">
                      <span className="px-2 py-0.5 bg-background-200 rounded">DR {bl.dr}</span>
                      <span>{bl.date}</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <div className="bg-yellow-50 rounded-lg p-5">
              <h3 className="text-sm font-semibold text-yellow-900 mb-3 flex items-center gap-2">
                <i className="ri-alert-line" /> Cannibalisation Détectée ({d.seo.cannibalization.length} paires)
              </h3>
              <div className="space-y-2">
                {d.seo.cannibalization.map((c, i) => (
                  <div key={i} className="bg-white rounded p-3 text-sm">
                    <div className="flex items-center gap-2 mb-1">
                      <span className="text-foreground-900 font-medium truncate">{c.pair[0]}</span>
                      <span className="text-foreground-400">vs</span>
                      <span className="text-foreground-900 font-medium truncate">{c.pair[1]}</span>
                    </div>
                    <div className="flex items-center gap-3 text-xs text-foreground-500">
                      <span>Overlap: {c.overlap}</span>
                      <span className="text-yellow-700">{c.action}</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}

        {activeTab === 'geo' && (
          <div className="space-y-6">
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
              {d.geoVisibility.regions.map((r, i) => (
                <div key={i} className="bg-background-100 rounded-lg p-4">
                  <div className="text-sm font-semibold text-foreground-950 mb-1">{r.region}</div>
                  <div className="flex items-end gap-2 mb-1">
                    <span className="text-3xl font-bold text-foreground-950">{r.score}</span>
                    <span className="text-sm text-foreground-400">/100</span>
                  </div>
                  <div className="w-full bg-background-200 rounded-full h-1.5 mb-2">
                    <div className={`h-1.5 rounded-full ${
                      r.score >= 85 ? 'bg-green-500' : r.score >= 70 ? 'bg-yellow-500' : 'bg-red-500'
                    }`} style={{ width: `${r.score}%` }} />
                  </div>
                  <div className="flex items-center justify-between text-xs text-foreground-500">
                    <span>{r.queries} requêtes</span>
                    <span className="text-green-700">{r.improvement}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </KOSHubLayout>
  );
}
