import { useState } from 'react';
import { SeoHead } from '@/components/feature/SeoHead';
import { Link } from 'react-router-dom';
import KOSHubLayout from '@/components/feature/KOSHubLayout';
import { useKOSHybridYoutubeStudio } from '@/hooks/useKOSHybridYoutubeStudio';

const STAGE_COLORS: Record<ContentStage, string> = {
  TOPIC_DEFINED: '#6B7280',
  SCRIPT_GENERATED: '#86BC25',
  SCRIPT_VALIDATED: '#059669',
  VOICE_GENERATED: '#CA8A04',
  VOICE_VALIDATED: '#059669',
  THUMBNAIL_GENERATED: '#D4A853',
  THUMBNAIL_VALIDATED: '#059669',
  VIDEO_ASSEMBLED: '#FF0000',
  VIDEO_VALIDATED: '#059669',
  METADATA_GENERATED: '#0A66C2',
  READY: '#059669',
  UPLOADED: '#C2410C',
  PUBLISHED: '#86BC25',
  ARCHIVED: '#6B7280',
  QC_FAILED: '#DC2626',
};

const STAGE_LABELS: Record<ContentStage, string> = {
  TOPIC_DEFINED: 'Sujet défini',
  SCRIPT_GENERATED: 'Script',
  SCRIPT_VALIDATED: 'Script ✓',
  VOICE_GENERATED: 'Voix',
  VOICE_VALIDATED: 'Voix ✓',
  THUMBNAIL_GENERATED: 'Miniature',
  THUMBNAIL_VALIDATED: 'Miniature ✓',
  VIDEO_ASSEMBLED: 'Vidéo',
  VIDEO_VALIDATED: 'Vidéo ✓',
  METADATA_GENERATED: 'Métadonnées',
  READY: 'Prêt',
  UPLOADED: 'Uploadé',
  PUBLISHED: 'Publié',
  ARCHIVED: 'Archivé',
  QC_FAILED: 'QC Échoué',
};

const STAGE_ICONS: Record<ContentStage, string> = {
  TOPIC_DEFINED: 'ri-lightbulb-line',
  SCRIPT_GENERATED: 'ri-file-text-line',
  SCRIPT_VALIDATED: 'ri-check-double-line',
  VOICE_GENERATED: 'ri-mic-line',
  VOICE_VALIDATED: 'ri-check-double-line',
  THUMBNAIL_GENERATED: 'ri-image-line',
  THUMBNAIL_VALIDATED: 'ri-check-double-line',
  VIDEO_ASSEMBLED: 'ri-movie-line',
  VIDEO_VALIDATED: 'ri-check-double-line',
  METADATA_GENERATED: 'ri-code-s-slash-line',
  READY: 'ri-checkbox-circle-fill',
  UPLOADED: 'ri-upload-cloud-2-fill',
  PUBLISHED: 'ri-global-line',
  ARCHIVED: 'ri-archive-line',
  QC_FAILED: 'ri-close-circle-fill',
};

const QUEUE_STAGES = [
  { id: 'DRAFT' as const, label: 'DRAFT', icon: 'ri-pencil-line', bg: '#FEF3C7', text: '#92400E' },
  { id: 'QC_FAILED' as const, label: 'QC FAILED', icon: 'ri-close-circle-line', bg: '#FEE2E2', text: '#991B1B' },
  { id: 'READY' as const, label: 'READY', icon: 'ri-checkbox-circle-line', bg: '#D1FAE5', text: '#065F46' },
  { id: 'UPLOADED' as const, label: 'UPLOADED', icon: 'ri-upload-cloud-2-line', bg: '#E0E7FF', text: '#3730A3' },
  { id: 'PUBLISHED' as const, label: 'PUBLISHED', icon: 'ri-global-line', bg: '#D1FAE5', text: '#047857' },
  { id: 'ARCHIVED' as const, label: 'ARCHIVED', icon: 'ri-archive-line', bg: '#F3F4F6', text: '#374151' },
];

export default function YoutubePendingPage() {
  const [kosData, setKosData] = useState<any>(null);
  useEffect(() => {
    fetch('/mocks/kos-blog.json').then(r => r.json()).then(setKosData);
  }, []);
  if (!kosData) return null;

  const studio = useKOSHybridYoutubeStudio();
  const [statusFilter, setStatusFilter] = useState<string>('all');
  const [expandedItem, setExpandedItem] = useState<string | null>(null);

  const filtered = statusFilter === 'all'
    ? studio.pendingQueue
    : studio.pendingQueue.filter((q) => q.status === statusFilter);

  const readyCount = studio.pendingQueue.filter((q) => q.status === 'READY').length;
  const draftCount = studio.pendingQueue.filter((q) => q.status === 'DRAFT').length;
  const totalFilesReady = studio.pendingQueue.reduce((sum, q) => sum + q.downloadsReady, 0);
  const totalFiles = studio.pendingQueue.reduce((sum, q) => sum + q.totalDownloads, 0);

  return (
    <KOSHubLayout hubId={80}>
      <SeoHead
        title="YouTube Pending Queue™ — File d'Attente Publication KHEPRA EXPERTS | KOS Hybrid Studio"
        description="File d'attente de publication YouTube KHEPRA EXPERTS. Tous les contenus générés, indexés, horodatés, prêts à publier. Archivage et statuts DRAFT → READY → UPLOADED → PUBLISHED → ARCHIVED."
        keywords="YouTube pending queue, file attente publication, KHEPRA EXPERTS, gestion contenu YouTube, queue publication"
        canonicalPath="/youtube-pending"
        ogType="website"
        ogLocale="fr_FR"
      />

      {/* Hero */}
      <section className="relative bg-foreground-950 overflow-hidden">
        <div className="absolute inset-0 pointer-events-none" aria-hidden="true">
          <div className="absolute top-0 right-0 w-[600px] h-[600px] rounded-full opacity-[0.05]" style={{ background: 'radial-gradient(circle, #FF0000 0%, transparent 60%)' }} />
        </div>
        <div className="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
          <div className="max-w-4xl">
            <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-white/80 text-xs font-semibold mb-4 backdrop-blur-sm">
              <i className="ri-stack-line" />KOS YouTube Pending Queue™
            </div>
            <h1 className="font-heading text-2xl md:text-4xl font-bold text-white tracking-tight">
              File d&apos;Attente de Publication — Archivage & Indexation
            </h1>
            <p className="text-sm md:text-base text-gray-400 mt-3 max-w-3xl">
              Tous les contenus générés sont archivés, indexés et horodatés. Statuts : DRAFT → READY → UPLOADED → PUBLISHED → ARCHIVED. Migration automatique vers MODE B dès validation OAuth.
            </p>
            <div className="flex flex-wrap gap-2 mt-4 text-xs">
              <span className="flex items-center gap-1 text-emerald-400"><i className="ri-checkbox-circle-fill" />{readyCount} READY</span>
              <span className="flex items-center gap-1 text-amber-400"><i className="ri-pencil-line" />{draftCount} DRAFT</span>
              <span className="flex items-center gap-1 text-gray-400"><i className="ri-file-download-line" />{totalFilesReady}/{totalFiles} fichiers</span>
            </div>
          </div>
        </div>
      </section>

      {/* Quick Links */}
      <section className="bg-background-50 border-b border-background-200">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
          <div className="flex flex-wrap items-center gap-2">
            <Link to="/kos-youtube-download" className="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-background-100 text-foreground-600 text-xs font-bold hover:bg-background-200 cursor-pointer whitespace-nowrap">
              <i className="ri-arrow-left-line" />Hybrid Studio
            </Link>
            <Link to="/youtube-download-center" className="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-background-100 text-foreground-600 text-xs font-bold hover:bg-background-200 cursor-pointer whitespace-nowrap">
              <i className="ri-download-cloud-2-line" />Centre de Téléchargement
            </Link>
            <div className="h-4 w-px bg-background-300 mx-2" />
            {QUEUE_STAGES.map((s) => {
              const isActive = statusFilter === s.id;
              return (
                <button
                  key={s.id}
                  onClick={() => setStatusFilter(isActive ? 'all' : s.id)}
                  className={`flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold cursor-pointer transition-all whitespace-nowrap ${
                    isActive ? 'bg-foreground-950 text-white' : 'bg-background-100 text-foreground-500 hover:bg-background-200'
                  }`}
                >
                  <i className={`${s.icon} text-[10px]`} />{s.label}
                  <span className="text-[9px] px-1 py-0.5 rounded-full bg-white/20">
                    {studio.pendingQueue.filter((q) => q.status === s.id).length}
                  </span>
                </button>
              );
            })}
          </div>
        </div>
      </section>

      {/* Queue kosData.Content */}
      <section className="py-8">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          {/* Summary Cards */}
          <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 mb-6">
            {QUEUE_STAGES.map((s) => {
              const count = studio.pendingQueue.filter((q) => q.status === s.id).length;
              return (
                <div key={s.id} className="rounded-xl p-4 text-center" style={{ backgroundColor: s.bg, border: `1px solid ${s.bg}` }}>
                  <i className={`${s.icon} text-lg mb-1 block`} style={{ color: s.text }} />
                  <span className="block text-xl font-bold" style={{ color: s.text }}>{count}</span>
                  <span className="text-[10px]" style={{ color: s.text, opacity: 0.7 }}>{s.label}</span>
                </div>
              );
            })}
          </div>

          {/* Queue List */}
          <div className="space-y-3">
            {filtered.map((item: PendingQueueItem) => {
              const isExpanded = expandedItem === item.queueId;
              return (
                <div key={item.queueId} className={`rounded-2xl border transition-all bg-background-50 ${isExpanded ? 'border-foreground-300' : 'border-background-200/70 hover:border-foreground-200'}`}>
                  <button
                    onClick={() => setExpandedItem(isExpanded ? null : item.queueId)}
                    className="w-full p-4 text-left flex items-start gap-4 cursor-pointer"
                  >
                    <div className="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0" style={{ backgroundColor: `${STAGE_COLORS[item.stage]}15` }}>
                      <i className={`${STAGE_ICONS[item.stage]} text-lg`} style={{ color: STAGE_COLORS[item.stage] }} />
                    </div>
                    <div className="flex-1 min-w-0">
                      <div className="flex items-center gap-2 mb-1">
                        <span className="text-[10px] font-bold px-2 py-0.5 rounded-full" style={{ backgroundColor: `${STAGE_COLORS[item.stage]}15`, color: STAGE_COLORS[item.stage] }}>
                          {STAGE_LABELS[item.stage]}
                        </span>
                        <span className={`text-[10px] font-bold px-2 py-0.5 rounded-full ${
                          item.status === 'READY' ? 'bg-emerald-100 text-emerald-700' :
                          item.status === 'PUBLISHED' ? 'bg-blue-100 text-blue-700' :
                          item.status === 'UPLOADED' ? 'bg-indigo-100 text-indigo-700' :
                          item.status === 'QC_FAILED' ? 'bg-red-100 text-red-700' :
                          item.status === 'ARCHIVED' ? 'bg-gray-100 text-gray-600' :
                          'bg-amber-100 text-amber-700'
                        }`}>
                          {item.status}
                        </span>
                        <span className="text-[9px] text-foreground-400">
                          {item.priority === 'critical' ? '🔴 P0' : item.priority === 'high' ? '🟠 P1' : '🟡 P2'}
                        </span>
                      </div>
                      <h3 className="text-sm font-bold text-foreground-950 line-clamp-1">{item.title}</h3>
                      <div className="flex items-center gap-3 mt-1 text-[10px] text-foreground-400">
                        <span><i className="ri-download-cloud-line mr-1" />{item.downloadsReady}/{item.totalDownloads} fichiers</span>
                        <span>·</span>
                        <span><i className="ri-timer-line mr-1" />ETA: {item.etaToReady}</span>
                        {item.scheduledDate && (
                          <>
                            <span>·</span>
                            <span>Cible: {new Date(item.scheduledDate).toLocaleDateString('fr-FR')}</span>
                          </>
                        )}
                        {item.qualityScore > 0 && (
                          <>
                            <span>·</span>
                            <span className="font-bold" style={{ color: item.qualityScore >= 95 ? '#059669' : '#CA8A04' }}>QC: {item.qualityScore}</span>
                          </>
                        )}
                      </div>
                      {/* Timeline */}
                      <div className="mt-2 flex items-center gap-0.5">
                        {['DRAFT', 'QC_FAILED', 'READY', 'UPLOADED', 'PUBLISHED', 'ARCHIVED'].map((s) => {
                          const order = { DRAFT: 0, QC_FAILED: 0, READY: 1, UPLOADED: 2, PUBLISHED: 3, ARCHIVED: 4 };
                          const current = order[item.status] ?? 0;
                          const pos = order[s] ?? 0;
                          const filled = pos <= current && item.status !== 'DRAFT' && item.status !== 'QC_FAILED';
                          return (
                            <div key={s} className="flex-1 flex flex-col items-center" title={s}>
                              <div className={`w-full h-1 rounded-full ${filled ? 'bg-emerald-500' : 'bg-background-200'}`} />
                              <span className="text-[7px] text-foreground-300 mt-0.5">{s === 'QC_FAILED' ? 'QC' : s.substring(0, 1)}</span>
                            </div>
                          );
                        })}
                      </div>
                    </div>
                    <i className={`ri-${isExpanded ? 'subtract' : 'add'}-line text-foreground-400 flex-shrink-0`} />
                  </button>

                  {isExpanded && (
                    <div className="px-5 pb-5 border-t border-background-200/70 pt-4 animate-fade-in space-y-3">
                      <div className="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
                        <div><span className="text-foreground-400">Queue ID</span><p className="font-bold text-foreground-700 font-mono">{item.queueId}</p></div>
                        <div><span className="text-foreground-400">kosData.Content ID</span><p className="font-bold text-foreground-700 font-mono">{item.contentId}</p></div>
                        <div><span className="text-foreground-400">Créé le</span><p className="font-bold text-foreground-700">{new Date(item.createdAt).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })}</p></div>
                        <div><span className="text-foreground-400">Score Qualité</span><p className="font-bold" style={{ color: item.qualityScore >= 95 ? '#059669' : item.qualityScore > 0 ? '#CA8A04' : '#6B7280' }}>
                          {item.qualityScore > 0 ? `${item.qualityScore}/100` : 'Non évalué'}
                        </p></div>
                      </div>

                      <div className="flex flex-wrap gap-2">
                        <Link to="/kos-youtube-download" className="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-foreground-950 text-white text-xs font-bold hover:bg-foreground-800 cursor-pointer whitespace-nowrap">
                          <i className="ri-rocket-2-line" />Ouvrir dans Hybrid Studio
                        </Link>
                        <Link to="/youtube-download-center" className="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-100 text-emerald-700 text-xs font-bold hover:bg-emerald-200 cursor-pointer whitespace-nowrap">
                          <i className="ri-download-cloud-2-line" />Télécharger les fichiers
                        </Link>
                        {item.status === 'READY' && (
                          <button className="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#FF0000] text-white text-xs font-bold hover:bg-[#CC0000] cursor-pointer whitespace-nowrap">
                            <i className="ri-upload-cloud-line" />Publier sur YouTube
                          </button>
                        )}
                      </div>
                    </div>
                  )}
                </div>
              );
            })}

            {filtered.length === 0 && (
              <div className="rounded-2xl bg-background-50 border border-dashed border-background-300 p-16 text-center">
                <div className="w-16 h-16 mx-auto rounded-2xl bg-background-200 flex items-center justify-center mb-4">
                  <i className="ri-inbox-line text-3xl text-foreground-400" />
                </div>
                <h3 className="font-heading text-lg font-bold text-foreground-950 mb-2">Aucun contenu dans cette catégorie</h3>
                <p className="text-sm text-foreground-500">Changez le filtre ou lancez la production depuis le Hybrid Studio.</p>
              </div>
            )}
          </div>
        </div>
      </section>

      {/* Migration Info */}
      <section className="py-12 bg-foreground-950">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="flex flex-col lg:flex-row items-center justify-between gap-6">
            <div>
              <h2 className="font-heading text-2xl font-bold text-white mb-2">Migration vers MODE B — Prêt pour l&apos;Automatisation</h2>
              <p className="text-gray-400 text-sm">
                {readyCount} contenus READY prêts à être migrés automatiquement dès validation OAuth Google. Tous les contenus existants seront préservés, les statuts mis à jour, et les analytics récupérés.
              </p>
            </div>
            <div className="flex flex-wrap gap-3">
              <Link to="/youtube-connect" className="flex items-center gap-2 px-5 py-3 rounded-xl bg-[#FF0000] text-white font-bold text-sm hover:bg-[#CC0000] cursor-pointer whitespace-nowrap">
                <i className="ri-youtube-fill" />Connecter OAuth
              </Link>
              <Link to="/kos-youtube-download" className="flex items-center gap-2 px-5 py-3 rounded-xl bg-white text-foreground-950 font-bold text-sm hover:bg-gray-100 cursor-pointer whitespace-nowrap">
                <i className="ri-rocket-2-line" />Hybrid Studio
              </Link>
            </div>
          </div>
        </div>
      </section>
    </KOSHubLayout>
  );
}
