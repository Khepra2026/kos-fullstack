import { useState } from 'react';
import KOSHubLayout from '@/components/feature/KOSHubLayout';
import {
  PIPELINE_STAGES,
  KNOWLEDGE_CENTERS,
  SWARM_AGENTS,
  MEMEX_DOMAINS,
  FEEDBACK_CYCLES,
  PIPELINE_GLOBAL_STATS,
  type PipelineStage,
  type SwarmAgent,
  type MemexDomain,
  type FeedbackCycle,
} from '@/mocks/kosAutonomousKnowledgePipeline';

type Tab = 'pipeline' | 'centers' | 'swarm' | 'memex' | 'flow';

const CATEGORY_COLORS: Record<string, string> = {
  'Régulateurs': 'border-amber-300 bg-amber-50/50',
  'Normalisateurs': 'border-cyan-300 bg-cyan-50/50',
  'Partenaires Techniques': 'border-emerald-300 bg-emerald-50/50',
  'Institutions': 'border-violet-300 bg-violet-50/50',
  'Universités': 'border-rose-300 bg-rose-50/50',
  'Médias': 'border-teal-300 bg-teal-50/50',
};

const CATEGORY_ACCENT: Record<string, string> = {
  'Régulateurs': 'bg-amber-500',
  'Normalisateurs': 'bg-cyan-500',
  'Partenaires Techniques': 'bg-emerald-500',
  'Institutions': 'bg-violet-500',
  'Universités': 'bg-rose-500',
  'Médias': 'bg-teal-500',
};

export default function KOSAutonomousKnowledgePipelinePage() {
  const [kosData, setKosData] = useState<any>(null);
  useEffect(() => {
    fetch('/mocks/kos-blog.json').then(r => r.json()).then(setKosData);
  }, []);
  if (!kosData) return null;

  const [activeTab, setActiveTab] = useState<Tab>('pipeline');
  const [selectedStage, setSelectedStage] = useState<PipelineStage>(PIPELINE_STAGES[0]);
  const [centerFilter, setCenterFilter] = useState('all');
  const [swarmFilter, setSwarmFilter] = useState('all');
  const [selectedSwarm, setSelectedSwarm] = useState<SwarmAgent>(SWARM_AGENTS[0]);
  const [selectedDomain, setSelectedDomain] = useState<MemexDomain>(MEMEX_DOMAINS[0]);
  const [selectedCycle, setSelectedCycle] = useState<FeedbackCycle>(FEEDBACK_CYCLES[FEEDBACK_CYCLES.length - 1]);

  const categories = ['all', ...Array.from(new Set(KNOWLEDGE_CENTERS.map(c => c.category)))];

  const stageColors: Record<string, string> = {
    crawl: '#D97706',
    normalize: '#0891B2',
    seed: '#7C3AED',
    memex: '#10A37F',
    swarm: '#E11D48',
    eval: '#059669',
    flow: '#2563EB',
  };

  const filteredCenters = centerFilter === 'all'
    ? KNOWLEDGE_CENTERS
    : KNOWLEDGE_CENTERS.filter(c => c.category === centerFilter);

  const filteredSwarm = swarmFilter === 'all'
    ? SWARM_AGENTS
    : SWARM_AGENTS.filter(a => a.domain === swarmFilter);

  const swarmDomains = ['all', ...Array.from(new Set(SWARM_AGENTS.map(a => a.domain)))];

  const renderGauge = (value: number, max: number, size: number = 48, color?: string) => {
    const pct = Math.min((value / max) * 100, 100);
    const r = (size - 8) / 2;
    const circ = 2 * Math.PI * r;
    const c = color || (value >= 95 ? '#22c55e' : value >= 85 ? '#06b6d4' : '#f59e0b');
    return (
      <div className="relative" style={{ width: size, height: size }}>
        <svg className="-rotate-90" style={{ width: size, height: size }} viewBox={`0 0 ${size} ${size}`}>
          <circle cx={size / 2} cy={size / 2} r={r} fill="none" stroke="#e5e7eb" strokeWidth="4" />
          <circle cx={size / 2} cy={size / 2} r={r} fill="none" stroke={c} strokeWidth="4"
            strokeDasharray={`${(pct / 100) * circ} ${circ}`} strokeLinecap="round" />
        </svg>
        <div className="absolute inset-0 flex items-center justify-center">
          <span className="text-xs font-bold text-foreground-950">{Math.round(pct)}</span>
        </div>
      </div>
    );
  };

  const renderBar = (value: number, max: number, color?: string) => (
    <div className="flex items-center gap-2">
      <div className="flex-1 h-2 bg-background-200/70 rounded-full overflow-hidden">
        <div className={`h-full rounded-full ${color || 'bg-primary-500'}`} style={{ width: `${Math.min((value / max) * 100, 100)}%` }}></div>
      </div>
      <span className="text-xs font-bold text-foreground-950 w-12 text-right">{typeof value === 'number' && value % 1 !== 0 ? value.toFixed(1) : value}%</span>
    </div>
  );

  const getStatusBadge = (status: string) => {
    switch (status) {
      case 'active': return 'bg-green-100 text-green-700';
      case 'processing': return 'bg-amber-100 text-amber-700';
      case 'degraded': return 'bg-orange-100 text-orange-700';
      case 'blocked': return 'bg-red-100 text-red-700';
      case 'new': return 'bg-primary-100 text-primary-700';
      default: return 'bg-background-100 text-foreground-600';
    }
  };

  const getPriorityBadge = (priority: string) => {
    switch (priority) {
      case 'critical': return 'bg-red-100 text-red-700';
      case 'high': return 'bg-orange-100 text-orange-700';
      case 'medium': return 'bg-yellow-100 text-yellow-700';
      default: return 'bg-background-100 text-foreground-600';
    }
  };

  const tabs: { id: Tab; label: string; icon: string }[] = [
    { id: 'pipeline', label: 'Pipeline', icon: 'ri-git-branch-line' },
    { id: 'centers', label: '500+ Centres', icon: 'ri-radar-line' },
    { id: 'swarm', label: 'SWARM-100', icon: 'ri-group-line' },
    { id: 'memex', label: 'KOS-MEMEX', icon: 'ri-brain-line' },
    { id: 'flow', label: 'KOS-FLOW', icon: 'ri-loop-left-line' },
  ];

  return (
    <KOSHubLayout hubId={125}>
      {/* Hero */}
      <section className="relative bg-foreground-950 overflow-hidden">
        <div className="absolute inset-0 bg-gradient-to-br from-foreground-900 via-foreground-950 to-foreground-900"></div>
        <div className="relative max-w-7xl mx-auto px-4 md:px-6 py-12 md:py-16">
          <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-foreground-800 text-cyan-300 text-xs font-semibold mb-5">
            <i className="ri-radar-line"></i> KOS — Autonomous Knowledge Pipeline™
          </div>
          <h1 className="text-2xl md:text-4xl font-heading font-bold text-background-50 tracking-tight">
            Pipeline Autonome de Connaissance
          </h1>
          <p className="text-sm md:text-base text-foreground-400 mt-3 max-w-3xl">
            Boucle fermée d&apos;ingestion, normalisation, seeding, indexation et auto-amélioration.
            500+ centres de ressources crawlés, 100 agents SWARM, 2.78M embeddings, 147 cycles complets.
          </p>
          <div className="mt-6 p-4 bg-foreground-900/80 rounded-lg border border-foreground-800 font-mono text-xs text-emerald-400 overflow-x-auto whitespace-pre">
{`[CRAWL] → 500+ centres → [NORMALIZE] → [SEED] → [KOS-MEMEX]
    ↑                                              ↓
    └────────── [KOS-FLOW] ← [EVAL] ← [KOS-SWARM-100] ←┘`}
          </div>
          <div className="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-3 mt-6">
            {PIPELINE_GLOBAL_STATS.throughputByStage.map((ts) => (
              <div key={ts.stage} className="p-3 bg-foreground-900/60 rounded-lg border border-foreground-800 text-center">
                <div className="text-lg font-bold text-cyan-300">{ts.value.toLocaleString('fr-FR')}</div>
                <div className="text-[10px] text-foreground-500">{ts.stage} ({ts.unit})</div>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* Tab nav */}
      <div className="sticky top-0 z-30 bg-background-50 border-b border-background-200/70">
        <div className="max-w-7xl mx-auto px-4 md:px-6">
          <div className="flex gap-1 py-3 overflow-x-auto">
            {tabs.map((tab) => (
              <button
                key={tab.id}
                onClick={() => setActiveTab(tab.id)}
                className={`whitespace-nowrap px-4 py-2 rounded-full text-sm font-medium flex items-center gap-2 transition-colors cursor-pointer ${
                  activeTab === tab.id ? 'bg-foreground-950 text-background-50' : 'text-foreground-600 hover:bg-background-100'
                }`}
              >
                <i className={`${tab.icon} text-sm`}></i>
                {tab.label}
              </button>
            ))}
          </div>
        </div>
      </div>

      <div className="max-w-7xl mx-auto px-4 md:px-6 py-8">

        {/* ===== PIPELINE FLOW ===== */}
        {activeTab === 'pipeline' && (
          <>
            <div className="grid grid-cols-1 lg:grid-cols-7 gap-4 mb-8">
              {PIPELINE_STAGES.map((stage, i) => (
                <div
                  key={stage.id}
                  onClick={() => setSelectedStage(stage)}
                  className={`p-4 rounded-lg border cursor-pointer transition-all hover:scale-[1.02] ${
                    selectedStage.id === stage.id ? 'border-foreground-300 ring-2 ring-foreground-200' : 'border-background-200/70 bg-background-50 hover:border-background-300/60'
                  }`}
                >
                  <div className="flex items-center gap-2 mb-2">
                    <div className="w-7 h-7 rounded-full flex items-center justify-center text-white text-xs font-bold" style={{ backgroundColor: stage.color }}>
                      {stage.phase}
                    </div>
                    <span className="text-[10px] px-1.5 py-0.5 rounded-full font-medium bg-green-100 text-green-700">
                      {stage.status === 'processing' ? 'EN COURS' : 'ACTIF'}
                    </span>
                  </div>
                  <h3 className="text-xs font-bold text-foreground-950 mb-1">{stage.name}</h3>
                  <p className="text-[11px] text-foreground-500 line-clamp-2 leading-relaxed">{stage.description.split('.')[0]}.</p>
                  <div className="flex items-center gap-1 mt-2 text-[10px] text-foreground-400">
                    <span>{stage.throughput}</span>
                    <span>·</span>
                    <span>{stage.latency}</span>
                  </div>
                  {i < 6 && (
                    <div className="hidden lg:block absolute top-1/2 -right-3 text-foreground-300 text-lg z-10">
                      <i className="ri-arrow-right-s-line"></i>
                    </div>
                  )}
                </div>
              ))}
            </div>

            {/* Selected stage detail */}
            <div className="bg-background-50 rounded-lg border border-background-200/70 p-6">
              <div className="flex items-center gap-3 mb-5">
                <div className="w-10 h-10 rounded-lg flex items-center justify-center" style={{ backgroundColor: `${selectedStage.color}20` }}>
                  <i className={`${selectedStage.icon} text-lg`} style={{ color: selectedStage.color }}></i>
                </div>
                <div>
                  <h2 className="text-lg font-bold text-foreground-950">Phase {selectedStage.phase} — {selectedStage.name}</h2>
                  <p className="text-xs text-foreground-500">{selectedStage.description}</p>
                </div>
                <span className={`ml-auto text-xs px-2 py-0.5 rounded-full font-medium ${getStatusBadge(selectedStage.status)}`}>
                  {selectedStage.status === 'processing' ? 'En cours' : 'Actif'}
                </span>
              </div>
              <div className="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-5">
                {selectedStage.metrics.map((m) => (
                  <div key={m.label} className="p-3 bg-background-100 rounded-lg text-center">
                    <div className="text-lg font-bold text-foreground-950">{m.value}</div>
                    <div className="text-xs text-foreground-500">{m.label}</div>
                    <div className={`text-[10px] mt-1 ${m.trend === 'up' ? 'text-green-600' : m.trend === 'down' ? 'text-red-600' : 'text-foreground-400'}`}>
                      {m.trend === 'up' ? '▲' : m.trend === 'down' ? '▼' : '—'}
                    </div>
                  </div>
                ))}
              </div>
              <div className="grid grid-cols-3 gap-4 text-center">
                <div className="p-2 bg-background-100 rounded-lg">
                  <div className="text-xs text-foreground-500">Throughput</div>
                  <div className="text-sm font-bold text-foreground-950">{selectedStage.throughput}</div>
                </div>
                <div className="p-2 bg-background-100 rounded-lg">
                  <div className="text-xs text-foreground-500">Latence</div>
                  <div className="text-sm font-bold text-foreground-950">{selectedStage.latency}</div>
                </div>
                <div className="p-2 bg-background-100 rounded-lg">
                  <div className="text-xs text-foreground-500">Uptime</div>
                  <div className="text-sm font-bold text-foreground-950">{selectedStage.uptime}</div>
                </div>
              </div>
            </div>
          </>
        )}

        {/* ===== 500+ CENTRES ===== */}
        {activeTab === 'centers' && (
          <>
            <div className="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-3 mb-6">
              {PIPELINE_GLOBAL_STATS.categoriesBreakdown.map((cat) => (
                <div key={cat.category} className="p-3 bg-background-50 rounded-lg border border-background-200/70 text-center">
                  <div className="text-lg font-bold text-foreground-950">{cat.count}</div>
                  <div className="text-[10px] text-foreground-500">{cat.category}</div>
                  <div className="text-xs text-foreground-400">{cat.percent}%</div>
                </div>
              ))}
            </div>
            <div className="flex gap-2 mb-6 flex-wrap">
              {categories.map((cat) => (
                <button
                  key={cat}
                  onClick={() => setCenterFilter(cat)}
                  className={`px-3 py-1.5 rounded-full text-xs font-medium transition-colors cursor-pointer whitespace-nowrap ${
                    centerFilter === cat ? 'bg-foreground-950 text-background-50' : 'bg-background-100 text-foreground-600 hover:bg-background-200/70'
                  }`}
                >
                  {cat === 'all' ? 'Tous' : cat}
                  {cat !== 'all' && <span className="ml-1 opacity-50">({KNOWLEDGE_CENTERS.filter(c => c.category === cat).length})</span>}
                </button>
              ))}
            </div>
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
              {filteredCenters.map((center) => (
                <div key={center.id} className={`p-4 rounded-lg border ${CATEGORY_COLORS[center.category] || 'border-background-200/70 bg-background-50'}`}>
                  <div className="flex items-start justify-between mb-2">
                    <div className="flex-1 min-w-0">
                      <h4 className="text-sm font-semibold text-foreground-950 truncate">{center.name}</h4>
                      <p className="text-[11px] text-foreground-500">{center.subcategory} · {center.country}</p>
                    </div>
                    <span className={`text-[10px] px-1.5 py-0.5 rounded-full font-medium whitespace-nowrap ml-2 ${getStatusBadge(center.status)}`}>
                      {center.status === 'active' ? 'Actif' : center.status}
                    </span>
                  </div>
                  <div className="flex items-center justify-between mt-3">
                    <div className="flex items-center gap-2">
                      <span className={`text-[10px] px-1.5 py-0.5 rounded-full font-medium ${getPriorityBadge(center.priority)}`}>
                        {center.priority}
                      </span>
                      <span className="text-[11px] text-foreground-400">{center.crawlFrequency}</span>
                    </div>
                    <span className="text-xs font-bold text-foreground-950">{center.documentsCrawled.toLocaleString('fr-FR')} docs</span>
                  </div>
                </div>
              ))}
            </div>
          </>
        )}

        {/* ===== SWARM-100 ===== */}
        {activeTab === 'swarm' && (
          <div className="grid grid-cols-1 lg:grid-cols-4 gap-6">
            <div className="lg:col-span-1 space-y-3">
              <div className="flex items-center gap-2 mb-2">
                <div className="w-8 h-8 flex items-center justify-center rounded-lg bg-rose-100 text-rose-700">
                  <i className="ri-group-line text-lg"></i>
                </div>
                <div>
                  <h3 className="text-sm font-bold text-foreground-950">SWARM-100</h3>
                  <p className="text-xs text-foreground-500">{SWARM_AGENTS.length} agents affichés / 100 actifs</p>
                </div>
              </div>
              <div className="flex flex-wrap gap-1 mb-3">
                {swarmDomains.map((d) => (
                  <button
                    key={d}
                    onClick={() => setSwarmFilter(d)}
                    className={`px-2 py-1 rounded-full text-[11px] font-medium transition-colors cursor-pointer ${
                      swarmFilter === d ? 'bg-foreground-950 text-background-50' : 'bg-background-100 text-foreground-600 hover:bg-background-200/70'
                    }`}
                  >
                    {d === 'all' ? 'Tous' : d}
                  </button>
                ))}
              </div>
              {filteredSwarm.map((agent) => (
                <div
                  key={agent.id}
                  onClick={() => setSelectedSwarm(agent)}
                  className={`p-3 rounded-lg border cursor-pointer transition-colors ${
                    selectedSwarm.id === agent.id ? 'border-rose-300 bg-rose-50/50' : 'border-background-200/70 bg-background-50 hover:border-background-300/60'
                  }`}
                >
                  <div className="flex items-center justify-between">
                    <div>
                      <h4 className="text-xs font-semibold text-foreground-950">{agent.name}</h4>
                      <p className="text-[10px] text-foreground-500">{agent.domain}</p>
                    </div>
                    <span className={`text-[10px] px-1.5 py-0.5 rounded-full ${agent.status === 'optimal' ? 'bg-green-100 text-green-700' : 'bg-amber-100 text-amber-700'}`}>
                      {agent.status}
                    </span>
                  </div>
                  <div className="flex items-center justify-between mt-2 text-[10px] text-foreground-400">
                    <span>{agent.tasksProcessed.toLocaleString('fr-FR')} tâches</span>
                    <span className="font-bold text-foreground-950">{agent.accuracy}%</span>
                  </div>
                </div>
              ))}
            </div>
            <div className="lg:col-span-3">
              <div className="bg-background-50 rounded-lg border border-background-200/70 p-6">
                <div className="flex items-center gap-3 mb-5">
                  <div className="w-12 h-12 rounded-lg bg-rose-100 flex items-center justify-center">
                    <i className={`${selectedSwarm.icon} text-xl text-rose-600`}></i>
                  </div>
                  <div>
                    <h2 className="text-base font-bold text-foreground-950">{selectedSwarm.name}</h2>
                    <p className="text-xs text-foreground-500">{selectedSwarm.id} · {selectedSwarm.domain}</p>
                  </div>
                  <div className="ml-auto flex items-center gap-3">
                    <div className="text-center">
                      <div className="text-lg font-bold text-green-600">{selectedSwarm.accuracy}%</div>
                      <div className="text-[10px] text-foreground-500">Précision</div>
                    </div>
                    {renderGauge(selectedSwarm.accuracy, 100, 48, selectedSwarm.accuracy >= 95 ? '#22c55e' : '#06b6d4')}
                  </div>
                </div>
                <div className="grid grid-cols-2 gap-4 mb-5">
                  <div className="p-4 bg-background-100 rounded-lg">
                    <div className="text-xs text-foreground-500 mb-1">Spécialisation</div>
                    <p className="text-sm text-foreground-700 leading-relaxed">{selectedSwarm.specialization}</p>
                  </div>
                  <div className="p-4 bg-background-100 rounded-lg">
                    <div className="text-xs text-foreground-500 mb-1">Outputs générés</div>
                    <p className="text-sm text-foreground-700 leading-relaxed">{selectedSwarm.outputs}</p>
                  </div>
                </div>
                <div className="grid grid-cols-3 gap-4">
                  <div className="p-3 bg-background-100 rounded-lg text-center">
                    <div className="text-lg font-bold text-foreground-950">{selectedSwarm.tasksProcessed.toLocaleString('fr-FR')}</div>
                    <div className="text-xs text-foreground-500">Tâches Traitées</div>
                  </div>
                  <div className="p-3 bg-background-100 rounded-lg text-center">
                    <div className="text-lg font-bold text-foreground-950">{selectedSwarm.accuracy}%</div>
                    <div className="text-xs text-foreground-500">Taux Précision</div>
                  </div>
                  <div className="p-3 bg-background-100 rounded-lg text-center">
                    <div className="text-sm font-bold text-foreground-950">
                      {new Date(selectedSwarm.lastActive).toLocaleString('fr-FR', { hour: '2-digit', minute: '2-digit' })}
                    </div>
                    <div className="text-xs text-foreground-500">Dernière Activité</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        )}

        {/* ===== KOS-MEMEX ===== */}
        {activeTab === 'memex' && (
          <>
            <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 mb-6">
              <div className="p-3 bg-background-50 rounded-lg border border-background-200/70 text-center">
                <div className="text-lg font-bold text-emerald-600">2.78M</div>
                <div className="text-[10px] text-foreground-500">Embeddings</div>
              </div>
              <div className="p-3 bg-background-50 rounded-lg border border-background-200/70 text-center">
                <div className="text-lg font-bold text-foreground-950">15</div>
                <div className="text-[10px] text-foreground-500">Domaines</div>
              </div>
              <div className="p-3 bg-background-50 rounded-lg border border-background-200/70 text-center">
                <div className="text-lg font-bold text-foreground-950">54</div>
                <div className="text-[10px] text-foreground-500">Sources</div>
              </div>
              <div className="p-3 bg-background-50 rounded-lg border border-background-200/70 text-center">
                <div className="text-lg font-bold text-green-600">94.2%</div>
                <div className="text-[10px] text-foreground-500">Précision</div>
              </div>
              <div className="p-3 bg-background-50 rounded-lg border border-background-200/70 text-center">
                <div className="text-lg font-bold text-foreground-950">15ms</div>
                <div className="text-[10px] text-foreground-500">Latence p95</div>
              </div>
              <div className="p-3 bg-background-50 rounded-lg border border-background-200/70 text-center">
                <div className="text-lg font-bold text-foreground-950">99.995%</div>
                <div className="text-[10px] text-foreground-500">Uptime</div>
              </div>
            </div>
            <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
              {MEMEX_DOMAINS.map((domain) => (
                <div
                  key={domain.id}
                  onClick={() => setSelectedDomain(domain)}
                  className={`p-4 rounded-lg border cursor-pointer transition-colors ${
                    selectedDomain.id === domain.id ? 'border-emerald-300 bg-emerald-50/50' : 'border-background-200/70 bg-background-50 hover:border-background-300/60'
                  }`}
                >
                  <div className="flex items-center gap-2 mb-3">
                    <div className="w-8 h-8 rounded-lg bg-emerald-100 flex items-center justify-center">
                      <i className={`${domain.icon} text-emerald-600 text-sm`}></i>
                    </div>
                    <div>
                      <h3 className="text-sm font-bold text-foreground-950">{domain.name}</h3>
                      <p className="text-[10px] text-foreground-500">{domain.documents.toLocaleString('fr-FR')} docs · {domain.sources} sources</p>
                    </div>
                  </div>
                  <div className="flex items-center gap-2 mb-2">
                    <span className="text-xs text-foreground-500">Précision recherche</span>
                  </div>
                  {renderBar(domain.searchAccuracy, 100, 'bg-emerald-500')}
                  <div className="flex flex-wrap gap-1 mt-3">
                    {domain.topEntities.map((e) => (
                      <span key={e} className="text-[10px] px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-700">{e}</span>
                    ))}
                  </div>
                  <div className="text-[10px] text-foreground-400 mt-2">
                    {domain.embeddings.toLocaleString('fr-FR')} embeddings · MAJ {new Date(domain.lastUpdated).toLocaleString('fr-FR', { hour: '2-digit', minute: '2-digit' })}
                  </div>
                </div>
              ))}
            </div>
          </>
        )}

        {/* ===== KOS-FLOW ===== */}
        {activeTab === 'flow' && (
          <>
            <div className="mb-6">
              <h3 className="text-sm font-bold text-foreground-950 mb-1">Boucle de Feedback Fermée — 147 Cycles Complétés</h3>
              <p className="text-xs text-foreground-500">Chaque cycle de 24h mesure, évalue, ajuste et réoriente le pipeline. Auto-amélioration continue.</p>
            </div>
            <div className="grid grid-cols-1 lg:grid-cols-4 gap-6 mb-8">
              <div className="lg:col-span-3 bg-background-50 rounded-lg border border-background-200/70 p-5">
                <div className="flex items-center justify-between mb-4">
                  <h4 className="text-sm font-bold text-foreground-950">Évolution des Métriques — 8 derniers cycles</h4>
                  <span className="text-[10px] text-foreground-400">Cycle {FEEDBACK_CYCLES[0].cycle} → {FEEDBACK_CYCLES[FEEDBACK_CYCLES.length - 1].cycle}</span>
                </div>
                <div className="grid grid-cols-3 gap-3 mb-4">
                  {(['crawlQuality', 'normalizationPrecision', 'seedEfficiency', 'memexRecall', 'swarmAccuracy', 'evalScore'] as const).map((key) => (
                    <div key={key} className="flex items-center gap-2">
                      <span className="text-[10px] text-foreground-500 w-20 whitespace-nowrap">{key === 'crawlQuality' ? 'Crawl' : key === 'normalizationPrecision' ? 'Normalize' : key === 'seedEfficiency' ? 'Seed' : key === 'memexRecall' ? 'Memex' : key === 'swarmAccuracy' ? 'Swarm' : 'Eval'}</span>
                      <div className="flex-1 h-6 bg-background-100 rounded relative overflow-hidden">
                        {FEEDBACK_CYCLES.map((fc, i) => (
                          <div
                            key={fc.cycle}
                            className="absolute bottom-0 bg-cyan-500 rounded-t-sm transition-all"
                            style={{
                              left: `${(i / (FEEDBACK_CYCLES.length - 1)) * 100}%`,
                              width: `${100 / FEEDBACK_CYCLES.length - 1}%`,
                              height: `${((fc[key] - 85) / (97 - 85)) * 100}%`,
                              minHeight: '4px',
                            }}
                          ></div>
                        ))}
                      </div>
                      <span className="text-[10px] font-bold text-foreground-950 w-8 text-right">{FEEDBACK_CYCLES[FEEDBACK_CYCLES.length - 1][key].toFixed(1)}</span>
                    </div>
                  ))}
                </div>
              </div>
              <div className="space-y-2">
                {FEEDBACK_CYCLES.map((fc, i) => (
                  <div
                    key={fc.cycle}
                    onClick={() => setSelectedCycle(fc)}
                    className={`p-3 rounded-lg border cursor-pointer transition-colors ${
                      selectedCycle.cycle === fc.cycle ? 'border-primary-300 bg-primary-50/50' : 'border-background-200/70 bg-background-50 hover:border-background-300/60'
                    } ${i === FEEDBACK_CYCLES.length - 1 ? 'ring-2 ring-primary-200' : ''}`}
                  >
                    <div className="flex items-center justify-between">
                      <span className="text-xs font-bold text-foreground-950">Cycle {fc.cycle}</span>
                      <span className="text-[10px] text-foreground-500">
                        {new Date(fc.date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' })}
                      </span>
                    </div>
                    <div className="flex items-center gap-2 mt-1">
                      <span className="text-[11px] text-green-600 font-medium">+{fc.improvements} améliorations</span>
                      <span className="text-[11px] text-foreground-400">{fc.newSources} sources</span>
                      <span className="text-[11px] text-foreground-400">{fc.rulesAdjusted} règles</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
            <div className="bg-background-50 rounded-lg border border-background-200/70 p-6">
              <h4 className="text-sm font-bold text-foreground-950 mb-4">Détail Cycle {selectedCycle.cycle} — {new Date(selectedCycle.date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</h4>
              <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 mb-4">
                <div className="p-3 bg-background-100 rounded-lg text-center">
                  <div className="text-sm font-bold text-amber-600">{selectedCycle.crawlQuality}%</div>
                  <div className="text-[10px] text-foreground-500">Qualité Crawl</div>
                </div>
                <div className="p-3 bg-background-100 rounded-lg text-center">
                  <div className="text-sm font-bold text-cyan-600">{selectedCycle.normalizationPrecision}%</div>
                  <div className="text-[10px] text-foreground-500">Précision Norm.</div>
                </div>
                <div className="p-3 bg-background-100 rounded-lg text-center">
                  <div className="text-sm font-bold text-violet-600">{selectedCycle.seedEfficiency}%</div>
                  <div className="text-[10px] text-foreground-500">Efficience Seed</div>
                </div>
                <div className="p-3 bg-background-100 rounded-lg text-center">
                  <div className="text-sm font-bold text-emerald-600">{selectedCycle.memexRecall}%</div>
                  <div className="text-[10px] text-foreground-500">Recall MEMEX</div>
                </div>
                <div className="p-3 bg-background-100 rounded-lg text-center">
                  <div className="text-sm font-bold text-rose-600">{selectedCycle.swarmAccuracy}%</div>
                  <div className="text-[10px] text-foreground-500">Précision SWARM</div>
                </div>
                <div className="p-3 bg-background-100 rounded-lg text-center">
                  <div className="text-sm font-bold text-green-600">{selectedCycle.evalScore}%</div>
                  <div className="text-[10px] text-foreground-500">Score EVAL</div>
                </div>
              </div>
              <div className="grid grid-cols-3 gap-4 text-center">
                <div className="p-3 bg-primary-50/50 rounded-lg border border-primary-100">
                  <div className="text-lg font-bold text-primary-600">+{selectedCycle.improvements}</div>
                  <div className="text-xs text-foreground-500">Améliorations</div>
                </div>
                <div className="p-3 bg-cyan-50/50 rounded-lg border border-cyan-100">
                  <div className="text-lg font-bold text-cyan-600">+{selectedCycle.newSources}</div>
                  <div className="text-xs text-foreground-500">Nouvelles Sources</div>
                </div>
                <div className="p-3 bg-amber-50/50 rounded-lg border border-amber-100">
                  <div className="text-lg font-bold text-amber-600">{selectedCycle.rulesAdjusted}</div>
                  <div className="text-xs text-foreground-500">Règles Ajustées</div>
                </div>
              </div>
            </div>
          </>
        )}
      </div>

      {/* KPI Footer */}
      <section className="border-t border-background-200/70 bg-background-100">
        <div className="max-w-7xl mx-auto px-4 md:px-6 py-8">
          <h4 className="text-sm font-bold text-foreground-950 mb-6">Pipeline KPIs — {PIPELINE_GLOBAL_STATS.pipelineName}</h4>
          <div className="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-3">
            <div className="p-3 bg-background-50 rounded-lg border border-background-200/70 text-center">
              <div className="text-lg font-bold text-foreground-950">{PIPELINE_GLOBAL_STATS.totalCentersCrawled}</div>
              <div className="text-[10px] text-foreground-500">Centres Crawlés</div>
            </div>
            <div className="p-3 bg-background-50 rounded-lg border border-background-200/70 text-center">
              <div className="text-lg font-bold text-foreground-950">{PIPELINE_GLOBAL_STATS.totalDocumentsIndexed}</div>
              <div className="text-[10px] text-foreground-500">Documents</div>
            </div>
            <div className="p-3 bg-background-50 rounded-lg border border-background-200/70 text-center">
              <div className="text-lg font-bold text-foreground-950">{PIPELINE_GLOBAL_STATS.totalSwarmAgents}</div>
              <div className="text-[10px] text-foreground-500">Agents SWARM</div>
            </div>
            <div className="p-3 bg-background-50 rounded-lg border border-background-200/70 text-center">
              <div className="text-lg font-bold text-foreground-950">{PIPELINE_GLOBAL_STATS.totalCyclesCompleted}</div>
              <div className="text-[10px] text-foreground-500">Cycles FLOW</div>
            </div>
            <div className="p-3 bg-background-50 rounded-lg border border-background-200/70 text-center">
              <div className="text-lg font-bold text-green-600">{PIPELINE_GLOBAL_STATS.globalAccuracy}%</div>
              <div className="text-[10px] text-foreground-500">Précision</div>
            </div>
            <div className="p-3 bg-background-50 rounded-lg border border-background-200/70 text-center">
              <div className="text-lg font-bold text-foreground-950">{PIPELINE_GLOBAL_STATS.globalHallucinationRate}%</div>
              <div className="text-[10px] text-foreground-500">Hallucination</div>
            </div>
            <div className="p-3 bg-background-50 rounded-lg border border-background-200/70 text-center">
              <div className="text-lg font-bold text-foreground-950">{PIPELINE_GLOBAL_STATS.avgLatencyMs}ms</div>
              <div className="text-[10px] text-foreground-500">Latence Moy.</div>
            </div>
            <div className="p-3 bg-background-50 rounded-lg border border-background-200/70 text-center">
              <div className="text-lg font-bold text-foreground-950">{PIPELINE_GLOBAL_STATS.uptime}</div>
              <div className="text-[10px] text-foreground-500">Uptime</div>
            </div>
          </div>
        </div>
      </section>
    </KOSHubLayout>
  );
}
