import { useState } from 'react';
import KOSHubLayout from '@/components/feature/KOSHubLayout';
import {
  QUALITY_MONITOR_STATS, QUALITY_CHECKS, QUALITY_RECENT_CORRECTIONS,
  QUALITY_DAILY_REPORT, QUALITY_MONITOR_PG_CRON, QUALITY_MONITOR_KPI_TARGETS,
} from '@/mocks/kosQualityMonitor';

type Tab = 'cockpit' | 'checks' | 'corrections' | 'pg_cron' | 'kpis';

const TABS: { id: Tab; label: string; icon: string }[] = [
  { id: 'cockpit', label: 'Cockpit 24/7', icon: 'ri-radar-line' },
  { id: 'checks', label: '12 Checks', icon: 'ri-check-double-line' },
  { id: 'corrections', label: 'Auto-Corrections', icon: 'ri-tools-line' },
  { id: 'pg_cron', label: 'pg_cron SQL', icon: 'ri-code-s-slash-line' },
  { id: 'kpis', label: 'KPIs ISO 42001', icon: 'ri-bar-chart-grouped-line' },
];

function CheckStatusIcon({ status }: { status: string }) {
  if (status === 'pass') return <i className="ri-checkbox-circle-line text-emerald-500 text-lg flex-shrink-0"></i>;
  if (status === 'warning') return <i className="ri-alert-line text-amber-500 text-lg flex-shrink-0"></i>;
  return <i className="ri-close-circle-line text-red-500 text-lg flex-shrink-0"></i>;
}

function ScoreGauge({ score, max = 100, label }: { score: number; max?: number; label: string }) {
  const pct = Math.round((score / max) * 100);
  const color = pct >= 90 ? 'oklch(var(--primary-500))' : pct >= 70 ? '#f59e0b' : '#ef4444';
  const radius = 36;
  const circumference = 2 * Math.PI * radius;
  const offset = circumference - (pct / 100) * circumference;

  return (
    <div className="flex flex-col items-center">
      <div className="relative w-24 h-24">
        <svg width="96" height="96" viewBox="0 0 96 96" className="-rotate-90">
          <circle cx="48" cy="48" r={radius} fill="none" stroke="oklch(var(--background-200))" strokeWidth="6" />
          <circle cx="48" cy="48" r={radius} fill="none" stroke={color} strokeWidth="6" strokeLinecap="round"
            strokeDasharray={circumference} strokeDashoffset={offset} className="transition-all duration-1000" />
        </svg>
        <div className="absolute inset-0 flex items-center justify-center">
          <span className="text-lg font-bold text-foreground-950 font-heading">{score.toFixed(1)}</span>
        </div>
      </div>
      <span className="text-xs text-foreground-500 font-body mt-1 text-center">{label}</span>
    </div>
  );
}

export default function KosQualityMonitorPage() {
  const [kosData, setKosData] = useState<any>(null);
  useEffect(() => {
    fetch('/mocks/kos-blog.json').then(r => r.json()).then(setKosData);
  }, []);
  if (!kosData) return null;

  const [activeTab, setActiveTab] = useState<Tab>('cockpit');

  const categoriesGroups = QUALITY_CHECKS.reduce((acc: Record<string, typeof QUALITY_CHECKS>, c) => {
    if (!acc[c.category]) acc[c.category] = [];
    acc[c.category].push(c);
    return acc;
  }, {});

  return (
    <KOSHubLayout hubId={125}>
      <div>
        {/* Hero */}
        <div className="bg-background-100 border-b border-background-200/70 px-4 md:px-6 py-8">
          <div className="max-w-5xl mx-auto">
            <div className="flex items-start gap-4 mb-4">
              <div className="w-14 h-14 flex items-center justify-center rounded-xl bg-primary-100 flex-shrink-0">
                <i className="ri-shield-keyhole-line text-2xl text-primary-600"></i>
              </div>
              <div>
                <div className="flex items-center gap-2 flex-wrap mb-1">
                  <span className="px-2.5 py-1 rounded-full text-xs font-semibold bg-primary-100 text-primary-700 font-body">P5 — Quality Monitor</span>
                  <span className="px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-700 font-body animate-pulse">
                    <i className="ri-pulse-line mr-1"></i>Live — toutes les 6h
                  </span>
                  <span className="px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-700 font-body">Gap P4+P7 — ISO 42001</span>
                </div>
                <h1 className="text-2xl md:text-3xl font-bold text-foreground-950 font-heading">
                  KOS Auto-Correction Quality Monitor™ — Big Four 24/7
                </h1>
                <p className="text-sm text-foreground-600 font-body mt-1 max-w-2xl">
                  Garantir hallucination &lt;2% + conformité ISO 42001. 
                  {QUALITY_CHECKS.length} checks automatiques toutes les 6 heures via pg_cron. 
                  Score global: {QUALITY_MONITOR_STATS.overall_quality_score}/100. 
                  Taux hallucination: {QUALITY_MONITOR_STATS.hallucination_rate_pct}%.
                </p>
              </div>
            </div>

            <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3 mt-4 pt-4 border-t border-background-200/70">
              {[
                { v: `${QUALITY_MONITOR_STATS.overall_quality_score}`, l: 'Score Global' },
                { v: `${QUALITY_MONITOR_STATS.hallucination_rate_pct}%`, l: 'Hallucinations' },
                { v: `${QUALITY_MONITOR_STATS.iso_compliance}%`, l: 'ISO 42001' },
                { v: `${QUALITY_MONITOR_STATS.auto_corrections_today}`, l: 'Auto-Corr. Auj.' },
                { v: `${QUALITY_MONITOR_STATS.cycle_frequency_hours}h`, l: 'Cycle' },
                { v: `${QUALITY_MONITOR_STATS.uptime_pct}%`, l: 'Uptime' },
              ].map(s => (
                <div key={s.l} className="text-center">
                  <div className="text-lg font-bold text-foreground-950 font-heading">{s.v}</div>
                  <div className="text-[10px] text-foreground-500 font-body">{s.l}</div>
                </div>
              ))}
            </div>
          </div>
        </div>

        {/* Tabs */}
        <div className="border-b border-background-200/70 bg-background-50 px-4 md:px-6">
          <div className="max-w-5xl mx-auto overflow-x-auto">
            <div className="flex gap-1 py-2 min-w-max">
              {TABS.map(tab => (
                <button
                  key={tab.id}
                  onClick={() => setActiveTab(tab.id)}
                  className={`flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-body transition-all cursor-pointer whitespace-nowrap ${
                    activeTab === tab.id
                      ? 'bg-primary-100 text-primary-700 font-semibold'
                      : 'text-foreground-500 hover:text-foreground-700 hover:bg-background-200'
                  }`}
                >
                  <i className={`${tab.icon} text-sm`}></i>
                  {tab.label}
                </button>
              ))}
            </div>
          </div>
        </div>

        {/* kosData.Content */}
        <div className="max-w-5xl mx-auto px-4 md:px-6 py-8">

          {activeTab === 'cockpit' && (
            <div className="space-y-6">
              {/* Gauges */}
              <div className="bg-background-100 rounded-xl p-6 border border-background-200/70">
                <h3 className="text-sm font-bold text-foreground-800 mb-5 font-heading text-center">Rapport Quotidien — {QUALITY_DAILY_REPORT.date}</h3>
                <div className="flex justify-around flex-wrap gap-6">
                  <ScoreGauge score={QUALITY_MONITOR_STATS.overall_quality_score} label="Score Global" />
                  <ScoreGauge score={QUALITY_MONITOR_STATS.regulatory_integrity} label="Intégrité Réglementaire" />
                  <ScoreGauge score={QUALITY_MONITOR_STATS.publication_quality} label="Qualité Publications" />
                  <ScoreGauge score={QUALITY_MONITOR_STATS.infrastructure_health} label="Infrastructure" />
                  <ScoreGauge score={QUALITY_MONITOR_STATS.iso_compliance} label="ISO 42001" />
                </div>
              </div>

              {/* Summary stats */}
              <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
                {[
                  { l: 'Checks Passés', v: `${QUALITY_DAILY_REPORT.checks_passed}/${QUALITY_DAILY_REPORT.checks_performed}`, color: 'text-emerald-600' },
                  { l: 'Warnings', v: QUALITY_DAILY_REPORT.checks_warning, color: 'text-amber-600' },
                  { l: 'Auto-Corrections', v: QUALITY_DAILY_REPORT.auto_corrections, color: 'text-primary-600' },
                  { l: 'Tickets Créés', v: QUALITY_DAILY_REPORT.tickets_created, color: 'text-foreground-700' },
                ].map(s => (
                  <div key={s.l} className="bg-background-50 rounded-lg border border-background-200/70 p-4 text-center">
                    <div className={`text-3xl font-bold font-heading ${s.color}`}>{s.v}</div>
                    <div className="text-xs text-foreground-500 font-body">{s.l}</div>
                  </div>
                ))}
              </div>

              {/* Next priorities */}
              <div className="bg-amber-50 rounded-xl p-5 border border-amber-200">
                <h3 className="text-sm font-bold text-amber-800 mb-3 font-heading flex items-center gap-2">
                  <i className="ri-alarm-warning-line"></i>
                  Priorités Prochaines 24h
                </h3>
                <ul className="space-y-2">
                  {QUALITY_DAILY_REPORT.next_24h_priorities.map((p, i) => (
                    <li key={i} className="flex items-start gap-2 text-xs text-amber-700 font-body">
                      <span className="w-4 h-4 flex items-center justify-center rounded-full bg-amber-400 text-white text-[10px] font-bold flex-shrink-0 mt-0.5">{i + 1}</span>
                      {p}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          )}

          {activeTab === 'checks' && (
            <div className="space-y-6">
              {Object.entries(categoriesGroups).map(([category, checks]) => (
                <div key={category}>
                  <h3 className="text-sm font-bold text-foreground-700 mb-3 font-heading flex items-center gap-2">
                    <i className="ri-shield-check-line text-primary-500"></i>
                    {category}
                  </h3>
                  <div className="space-y-2">
                    {checks.map(check => (
                      <div key={check.id} className={`flex items-start gap-3 p-4 rounded-lg border ${
                        check.status === 'pass' ? 'bg-emerald-50 border-emerald-200' :
                        check.status === 'warning' ? 'bg-amber-50 border-amber-200' :
                        'bg-red-50 border-red-200'
                      }`}>
                        <CheckStatusIcon status={check.status} />
                        <div className="flex-1 min-w-0">
                          <p className="text-sm font-semibold text-foreground-800 font-heading">{check.check}</p>
                          <p className="text-xs text-foreground-500 font-body mt-0.5">{check.result}</p>
                          {check.action && (
                            <p className="text-xs text-amber-700 font-body mt-1">
                              <i className="ri-arrow-right-line mr-1"></i>Action: {check.action}
                            </p>
                          )}
                          {check.query && (
                            <code className="text-[10px] text-foreground-400 font-body block mt-1 break-all">{check.query.slice(0, 80)}...</code>
                          )}
                        </div>
                        {check.count > 0 && (
                          <span className="flex-shrink-0 text-xs font-bold text-foreground-700 font-body bg-background-200 px-2 py-0.5 rounded-full">
                            {check.count}
                          </span>
                        )}
                        <span className="text-[10px] text-foreground-400 font-body flex-shrink-0">
                          {check.last_check.slice(11, 16)}
                        </span>
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          )}

          {activeTab === 'corrections' && (
            <div className="space-y-3">
              {QUALITY_RECENT_CORRECTIONS.map(c => (
                <div key={c.id} className={`bg-background-50 rounded-lg border p-4 ${
                  c.severity === 'high' ? 'border-amber-300' :
                  c.severity === 'medium' ? 'border-background-300/60' :
                  'border-background-200/70'
                }`}>
                  <div className="flex items-start justify-between gap-3 mb-2">
                    <div className="flex items-center gap-2">
                      <span className={`w-5 h-5 flex items-center justify-center rounded-full text-[10px] font-bold ${
                        c.type === 'auto_correction' ? 'bg-emerald-500 text-white' :
                        c.type === 'ticket_created' ? 'bg-amber-500 text-white' :
                        'bg-red-500 text-white'
                      }`}>
                        {c.type === 'auto_correction' ? '✓' : c.type === 'ticket_created' ? 'T' : 'A'}
                      </span>
                      <span className={`text-[10px] font-semibold font-body ${
                        c.type === 'auto_correction' ? 'text-emerald-700' :
                        c.type === 'ticket_created' ? 'text-amber-700' :
                        'text-red-700'
                      }`}>
                        {c.type.replace(/_/g, ' ')}
                      </span>
                      <span className="px-2 py-0.5 rounded bg-background-200 text-[10px] text-foreground-500 font-body">{c.category}</span>
                    </div>
                    <div className="text-[10px] text-foreground-400 font-body flex-shrink-0">
                      {c.detected_at.slice(0, 16).replace('T', ' ')}
                    </div>
                  </div>
                  <p className="text-xs text-foreground-700 font-body">{c.description}</p>
                  {c.resolution_time_sec !== null && (
                    <p className="text-[10px] text-emerald-600 font-body mt-1">
                      <i className="ri-timer-line mr-1"></i>Résolu en {c.resolution_time_sec}s
                    </p>
                  )}
                </div>
              ))}
            </div>
          )}

          {activeTab === 'pg_cron' && (
            <div>
              <div className="flex items-center gap-2 mb-3">
                <span className="px-2 py-1 rounded-md text-xs font-semibold bg-primary-100 text-primary-700 font-body">ISO 42001 Ready J+60</span>
                <span className="px-2 py-1 rounded-md text-xs font-semibold bg-background-200 text-foreground-600 font-body">Cycle 6h</span>
                <span className="text-xs text-foreground-400 font-body">EY Assurance AI Standard</span>
              </div>
              <pre className="text-xs text-foreground-700 font-body bg-background-100 rounded-xl p-5 border border-background-200/70 overflow-auto whitespace-pre-wrap leading-relaxed">
                {QUALITY_MONITOR_PG_CRON}
              </pre>
            </div>
          )}

          {activeTab === 'kpis' && (
            <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
              {Object.entries(QUALITY_MONITOR_KPI_TARGETS).map(([key, kpi]) => {
                const isLowerBetter = key === 'hallucination_rate' || key === 'mttr_sec';
                const progress = isLowerBetter
                  ? Math.min(100, Math.round((1 - (kpi.current - kpi.target) / kpi.target) * 100))
                  : Math.min(100, Math.round((kpi.current / kpi.target) * 100));
                const statusColor = kpi.status === 'excellent' ? 'text-emerald-600' : kpi.status === 'on_track' ? 'text-amber-600' : 'text-red-500';
                const barColor = kpi.status === 'excellent' ? 'bg-emerald-500' : 'bg-amber-500';

                return (
                  <div key={key} className="bg-background-50 rounded-lg border border-background-200/70 p-5">
                    <h3 className="text-sm font-semibold text-foreground-800 mb-1 font-heading capitalize">{key.replace(/_/g, ' ')}</h3>
                    <div className="flex items-baseline gap-2 mb-1">
                      <span className="text-2xl font-bold text-foreground-950 font-heading">{kpi.current}</span>
                      <span className="text-xs text-foreground-400 font-body">{kpi.unit}</span>
                    </div>
                    <p className="text-[10px] text-foreground-400 font-body mb-2">Cible: {kpi.target} {kpi.unit}</p>
                    <div className="w-full bg-background-200 rounded-full h-1.5 overflow-hidden mb-1">
                      <div className={`h-1.5 rounded-full transition-all ${barColor}`} style={{ width: `${Math.min(100, progress)}%` }}></div>
                    </div>
                    <p className={`text-[10px] font-semibold font-body ${statusColor} uppercase tracking-wide`}>{kpi.status}</p>
                  </div>
                );
              })}
            </div>
          )}
        </div>
      </div>
    </KOSHubLayout>
  );
}
