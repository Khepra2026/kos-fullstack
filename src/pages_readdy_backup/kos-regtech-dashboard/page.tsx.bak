import { useState, useMemo } from 'react';
import KOSHubLayout from '@/components/feature/KOSHubLayout';

type KYCStatus = 'ALL' | 'CRITICAL' | 'MEDIUM' | 'LOW';
type ComplianceStatus = 'ALL' | 'FAIL' | 'WARNING' | 'PASS';

export default function KOSRegtechDashboardPage() {
  const [kosData, setKosData] = useState<any>(null);
  useEffect(() => {
    fetch('/mocks/kos-blog.json').then(r => r.json()).then(setKosData);
  }, []);
  if (!kosData) return null;

  const [activeTab, setActiveTab] = useState('kyc');
  const [kycFilter, setKycFilter] = useState<KYCStatus>('ALL');
  const [complianceFilter, setComplianceFilter] = useState<ComplianceStatus>('ALL');
  const [selectedScreening, setSelectedScreening] = useState<string | null>(null);
  const [selectedControl, setSelectedControl] = useState<string | null>(null);
  const [selectedAuditBlock, setSelectedAuditBlock] = useState<number | null>(null);
  const [kycForm, setKycForm] = useState({ entity_name: '', entity_type: 'COMPANY', country: 'TG' });
  const [kycResult, setKycResult] = useState<{ entity: string; overall_risk: string; sources_scanned: number; matches_found: number } | null>(null);
  const [isRunningKyc, setIsRunningKyc] = useState(false);

  const tabs = [
    { key: 'kyc', label: 'KYC Screening', icon: 'ri-user-search-line' },
    { key: 'compliance', label: 'Compliance Monitor', icon: 'ri-shield-check-line' },
    { key: 'audit', label: 'Audit Trail', icon: 'ri-git-branch-line' },
  ];

  const filteredKyc = useMemo(() => {
    if (kycFilter === 'ALL') return kosRegtechKycScreenings;
    return kosRegtechKycScreenings.filter((k) => k.risk_level === kycFilter);
  }, [kycFilter]);

  const filteredCompliance = useMemo(() => {
    if (complianceFilter === 'ALL') return kosRegtechComplianceControls;
    return kosRegtechComplianceControls.filter((c) => c.last_status === complianceFilter);
  }, [complianceFilter]);

  const handleRunKyc = () => {
    if (!kycForm.entity_name.trim()) return;
    setIsRunningKyc(true);
    setTimeout(() => {
      setKycResult({
        entity: kycForm.entity_name,
        overall_risk: kycForm.entity_name.toLowerCase().includes('wave') || kycForm.entity_name.toLowerCase().includes('sanction') ? 'CRITICAL' : 'LOW',
        sources_scanned: 5,
        matches_found: kycForm.entity_name.toLowerCase().includes('wave') ? 1 : 0,
      });
      setIsRunningKyc(false);
    }, 1500);
  };

  const riskColors: Record<string, string> = {
    CRITICAL: 'bg-red-100 text-red-800 border-red-200',
    HIGH: 'bg-red-50 text-red-700 border-red-200',
    MEDIUM: 'bg-amber-50 text-amber-700 border-amber-200',
    LOW: 'bg-emerald-50 text-emerald-700 border-emerald-200',
  };

  const statusColors: Record<string, string> = {
    PASS: 'bg-emerald-100 text-emerald-800',
    FAIL: 'bg-red-100 text-red-800',
    WARNING: 'bg-amber-100 text-amber-800',
  };

  const matchStatusColors: Record<string, string> = {
    CONFIRMED_MATCH: 'text-red-700',
    POTENTIAL_MATCH: 'text-amber-700',
    CLEAR: 'text-emerald-700',
  };

  return (
    <KOSHubLayout hubId={128}>
      <div className="min-h-screen bg-background-50">
        <div className="max-w-7xl mx-auto px-4 md:px-6 py-8">
          <div className="mb-8">
            <div className="flex items-center gap-3 mb-2 flex-wrap">
              <span className="px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-800 whitespace-nowrap">KOS REGTECH AI — BIG FOUR SUPREME</span>
              <span className="px-3 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 whitespace-nowrap">Compliance {kosRegtechGlobalStats.overallComplianceScore}/100</span>
              <span className="px-3 py-1 rounded-full text-xs font-semibold bg-primary-100 text-primary-800 whitespace-nowrap">ISO 27001 {kosRegtechGlobalStats.iso27001Score}%</span>
              <span className="px-3 py-1 rounded-full text-xs font-semibold bg-primary-100 text-primary-800 whitespace-nowrap">ISO 42001 {kosRegtechGlobalStats.iso42001Score}%</span>
            </div>
            <h1 className="text-3xl md:text-4xl font-bold text-foreground-950 font-heading">KOS REGTECH AI Dashboard</h1>
            <p className="text-foreground-600 mt-2 max-w-2xl">Console de pilotage RegTech — KYC Screening automatisé 5 sources (OFAC, UE, ONU, BEAC, CENTIF), Compliance Monitor 10 contrôles BCEAO/ISO/SOC2 temps réel, Audit Trail blockchain-like SHA-256 immuable et vérifiable.</p>
          </div>

          <div className="flex flex-wrap gap-1 mb-6 bg-background-100 rounded-full p-1">
            {tabs.map((tab) => (
              <button key={tab.key} onClick={() => setActiveTab(tab.key)} className={`flex items-center gap-1.5 px-4 py-2 rounded-full text-sm font-medium whitespace-nowrap transition-colors cursor-pointer ${activeTab === tab.key ? 'bg-background-50 text-foreground-950 shadow-sm' : 'text-foreground-600 hover:text-foreground-900'}`}>
                <i className={tab.icon} />{tab.label}
              </button>
            ))}
          </div>

          <div className="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 mb-6">
            {[
              { label: 'KYC Screenings', value: kosRegtechGlobalStats.totalKycScreenings },
              { label: 'High Risk', value: kosRegtechGlobalStats.highRiskEntities, color: 'text-red-600' },
              { label: 'Contrôles Passés', value: `${kosRegtechGlobalStats.controlsPassed}/${kosRegtechGlobalStats.totalComplianceControls}` },
              { label: 'Score Conformité', value: `${kosRegtechGlobalStats.overallComplianceScore}/100`, color: 'text-emerald-600' },
              { label: 'Blocs Audit', value: kosRegtechGlobalStats.totalAuditBlocks },
              { label: 'Chaîne Vérifiée', value: kosRegtechGlobalStats.auditChainVerified ? 'OUI' : 'NON', color: 'text-emerald-600' },
            ].map((k) => (
              <div key={k.label} className="bg-background-50 border border-background-200/70 rounded-lg p-3 text-center">
                <div className="text-xs text-foreground-500 mb-1">{k.label}</div>
                <div className={`text-lg font-bold ${k.color || 'text-foreground-950'}`}>{k.value}</div>
              </div>
            ))}
          </div>

          {/* KYC Screening Tab */}
          {activeTab === 'kyc' && (
            <div className="space-y-6">
              <div className="bg-background-50 border border-background-200/70 rounded-xl p-5">
                <div className="flex items-center gap-2 mb-4">
                  <i className="ri-user-search-line text-lg text-primary-600 w-5 h-5 flex items-center justify-center" />
                  <span className="font-semibold text-foreground-950 text-sm">KOS REGTECH AI — Lancer un Screening KYC</span>
                </div>
                <div className="grid grid-cols-1 sm:grid-cols-4 gap-3 mb-4">
                  <input type="text" placeholder="Nom de l'entité..." value={kycForm.entity_name} onChange={(e) => setKycForm((p) => ({ ...p, entity_name: e.target.value }))} className="bg-background-100 border border-background-200/70 rounded-lg px-3 py-2 text-sm text-foreground-950 placeholder-foreground-400 focus:outline-none focus:border-primary-400" />
                  <select value={kycForm.entity_type} onChange={(e) => setKycForm((p) => ({ ...p, entity_type: e.target.value }))} className="bg-background-100 border border-background-200/70 rounded-lg px-3 py-2 text-sm text-foreground-950 focus:outline-none focus:border-primary-400 cursor-pointer">
                    <option value="COMPANY">Entreprise</option>
                    <option value="INDIVIDUAL">Individu</option>
                  </select>
                  <select value={kycForm.country} onChange={(e) => setKycForm((p) => ({ ...p, country: e.target.value }))} className="bg-background-100 border border-background-200/70 rounded-lg px-3 py-2 text-sm text-foreground-950 focus:outline-none focus:border-primary-400 cursor-pointer">
                    <option value="TG">Togo</option>
                    <option value="CI">Côte d'Ivoire</option>
                    <option value="SN">Sénégal</option>
                    <option value="BJ">Bénin</option>
                    <option value="BF">Burkina Faso</option>
                    <option value="CM">Cameroun</option>
                  </select>
                  <button onClick={handleRunKyc} disabled={isRunningKyc || !kycForm.entity_name.trim()} className="bg-primary-500 hover:bg-primary-600 disabled:opacity-50 text-background-50 px-4 py-2 rounded-lg text-sm font-semibold cursor-pointer whitespace-nowrap transition-colors flex items-center justify-center gap-2">
                    {isRunningKyc ? <><i className="ri-loader-4-line animate-spin" />Scanning...</> : <><i className="ri-radar-line" />Screen 5 Sources</>}
                  </button>
                </div>
                {kycResult && (
                  <div className={`p-4 rounded-lg border ${kycResult.overall_risk === 'CRITICAL' ? 'bg-red-50 border-red-200' : 'bg-emerald-50 border-emerald-200'}`}>
                    <div className="flex items-center justify-between">
                      <div>
                        <span className="font-semibold text-foreground-950">{kycResult.entity}</span>
                        <span className="text-xs text-foreground-500 ml-2">{kycResult.sources_scanned} sources scannées</span>
                      </div>
                      <span className={`px-2 py-0.5 rounded-full text-xs font-bold whitespace-nowrap ${kycResult.overall_risk === 'CRITICAL' ? 'bg-red-200 text-red-800' : 'bg-emerald-200 text-emerald-800'}`}>{kycResult.overall_risk}</span>
                    </div>
                    {kycResult.matches_found > 0 && <div className="text-sm text-red-700 mt-2 font-medium">{kycResult.matches_found} correspondance(s) détectée(s) — Vérifier sanctions OFAC/EU/ONU</div>}
                    {kycResult.matches_found === 0 && <div className="text-sm text-emerald-700 mt-2 font-medium">Aucune correspondance — Entité validée</div>}
                  </div>
                )}
              </div>

              <div className="flex items-center gap-2 flex-wrap">
                <span className="text-sm text-foreground-500 font-medium">Filtre risque :</span>
                {(['ALL', 'CRITICAL', 'MEDIUM', 'LOW'] as const).map((f) => (
                  <button key={f} onClick={() => setKycFilter(f)} className={`px-3 py-1 rounded-full text-xs font-medium whitespace-nowrap transition-colors cursor-pointer ${kycFilter === f ? 'bg-foreground-950 text-background-50' : 'bg-background-100 text-foreground-600 hover:text-foreground-900'}`}>{f === 'ALL' ? 'Tous' : f}</button>
                ))}
              </div>

              <div className="overflow-x-auto rounded-xl border border-background-200/70">
                <table className="w-full text-sm">
                  <thead className="bg-background-100 text-left">
                    <tr>
                      <th className="px-4 py-3 font-semibold text-foreground-700 whitespace-nowrap">Entité</th>
                      <th className="px-4 py-3 font-semibold text-foreground-700 whitespace-nowrap">Type</th>
                      <th className="px-4 py-3 font-semibold text-foreground-700 whitespace-nowrap">Source</th>
                      <th className="px-4 py-3 font-semibold text-foreground-700 whitespace-nowrap">Statut</th>
                      <th className="px-4 py-3 font-semibold text-foreground-700 whitespace-nowrap">Score</th>
                      <th className="px-4 py-3 font-semibold text-foreground-700 whitespace-nowrap">Risque</th>
                    </tr>
                  </thead>
                  <tbody>
                    {filteredKyc.map((k) => (
                      <tr key={k.id} onClick={() => setSelectedScreening(selectedScreening === k.id ? null : k.id)} className="border-t border-background-200/70 hover:bg-background-100/50 cursor-pointer transition-colors">
                        <td className="px-4 py-3 text-foreground-950 font-medium">{k.entity_name}</td>
                        <td className="px-4 py-3 text-foreground-600">{k.screening_type}</td>
                        <td className="px-4 py-3 text-foreground-600">{k.source}</td>
                        <td className={`px-4 py-3 font-semibold ${matchStatusColors[k.match_status]}`}>{k.match_status === 'CONFIRMED_MATCH' ? 'MATCH CONFIRMÉ' : k.match_status === 'POTENTIAL_MATCH' ? 'Match Potentiel' : 'Aucun'}</td>
                        <td className="px-4 py-3 text-foreground-600">{(k.match_score * 100).toFixed(0)}%</td>
                        <td className="px-4 py-3"><span className={`px-2 py-0.5 rounded-full text-xs font-medium border whitespace-nowrap ${riskColors[k.risk_level]}`}>{k.risk_level}</span></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              {selectedScreening && (
                <div className="bg-background-50 border border-background-200/70 rounded-xl p-5">
                  <div className="flex items-center justify-between mb-3">
                    <span className="font-semibold text-foreground-950">Détail Screening</span>
                    <button onClick={() => setSelectedScreening(null)} className="text-foreground-400 hover:text-foreground-700 cursor-pointer"><i className="ri-close-line w-5 h-5 flex items-center justify-center" /></button>
                  </div>
                  {(() => {
                    const k = kosRegtechKycScreenings.find((x) => x.id === selectedScreening);
                    if (!k) return null;
                    return (
                      <div className="grid grid-cols-2 md:grid-cols-4 gap-3 text-sm">
                        <div><span className="text-foreground-500">Entité :</span><div className="font-medium text-foreground-950">{k.entity_name}</div></div>
                        <div><span className="text-foreground-500">ID :</span><div className="font-medium text-foreground-950">{k.entity_id_number}</div></div>
                        <div><span className="text-foreground-500">Date :</span><div className="font-medium text-foreground-950">{new Date(k.screened_at).toLocaleDateString('fr-FR')}</div></div>
                        <div><span className="text-foreground-500">Expiration :</span><div className="font-medium text-foreground-950">{new Date(k.expires_at).toLocaleDateString('fr-FR')}</div></div>
                      </div>
                    );
                  })()}
                </div>
              )}
            </div>
          )}

          {/* Compliance Monitor Tab */}
          {activeTab === 'compliance' && (
            <div className="space-y-6">
              <div className="flex items-center justify-between flex-wrap gap-3">
                <div className="flex items-center gap-2">
                  <span className="text-sm text-foreground-500 font-medium">Filtre statut :</span>
                  {(['ALL', 'FAIL', 'WARNING', 'PASS'] as const).map((f) => (
                    <button key={f} onClick={() => setComplianceFilter(f)} className={`px-3 py-1 rounded-full text-xs font-medium whitespace-nowrap transition-colors cursor-pointer ${complianceFilter === f ? 'bg-foreground-950 text-background-50' : 'bg-background-100 text-foreground-600 hover:text-foreground-900'}`}>{f === 'ALL' ? 'Tous' : f}</button>
                  ))}
                </div>
                <div className="flex items-center gap-2 text-xs text-foreground-500">
                  <span className={`w-2 h-2 rounded-full bg-emerald-500`} />
                  <span>{kosRegtechGlobalStats.controlsPassed} OK</span>
                  <span className={`w-2 h-2 rounded-full bg-red-500 ml-2`} />
                  <span>{kosRegtechGlobalStats.controlsFailed} FAIL</span>
                  <span className={`w-2 h-2 rounded-full bg-amber-500 ml-2`} />
                  <span>{kosRegtechGlobalStats.controlsWarning} WARN</span>
                  <span className="ml-2 text-foreground-400">Dernier check : {new Date(kosRegtechGlobalStats.lastComplianceCheck).toLocaleTimeString('fr-FR')}</span>
                </div>
              </div>

              <div className="space-y-3">
                {filteredCompliance.map((c) => (
                  <div key={c.id} onClick={() => setSelectedControl(selectedControl === c.id ? null : c.id)} className={`bg-background-50 border rounded-xl p-4 cursor-pointer transition-colors hover:bg-background-100/50 ${c.last_status === 'FAIL' ? 'border-red-300/70' : c.last_status === 'WARNING' ? 'border-amber-300/70' : 'border-background-200/70'}`}>
                    <div className="flex items-center justify-between mb-2">
                      <div className="flex items-center gap-3">
                        <div className={`w-3 h-3 rounded-full ${c.last_status === 'PASS' ? 'bg-emerald-500' : c.last_status === 'WARNING' ? 'bg-amber-500' : 'bg-red-500'}`} />
                        <div>
                          <span className="font-semibold text-foreground-950 text-sm">{c.control_code}</span>
                          <span className="text-xs text-foreground-500 ml-2">{c.control_name}</span>
                        </div>
                      </div>
                      <span className={`px-2 py-0.5 rounded-full text-xs font-medium whitespace-nowrap ${statusColors[c.last_status]}`}>{c.last_status}</span>
                    </div>
                    <div className="grid grid-cols-2 sm:grid-cols-4 gap-2 text-xs text-foreground-500">
                      <div>Framework : <span className="font-medium text-foreground-700">{c.framework}</span></div>
                      <div>Catégorie : <span className="font-medium text-foreground-700">{c.category}</span></div>
                      <div>Fréquence : <span className="font-medium text-foreground-700">{c.frequency}</span></div>
                      <div>Automatisé : <span className={`font-medium ${c.automated ? 'text-emerald-600' : 'text-amber-600'}`}>{c.automated ? 'OUI' : 'MANUEL'}</span></div>
                    </div>
                    {selectedControl === c.id && (
                      <div className="mt-3 pt-3 border-t border-background-200/70">
                        <div className="text-sm text-foreground-600 mb-2">{c.description}</div>
                        {c.last_evidence && (
                          <div className="bg-background-100 rounded-lg p-3 text-xs text-foreground-600 space-y-1">
                            {Object.entries(c.last_evidence as Record<string, unknown>).map(([k, v]) => (
                              <div key={k} className="flex justify-between"><span className="text-foreground-500">{k}</span><span className="font-mono text-foreground-700">{typeof v === 'string' ? v : JSON.stringify(v)}</span></div>
                            ))}
                          </div>
                        )}
                      </div>
                    )}
                  </div>
                ))}
              </div>

              <div className="bg-primary-50 border border-primary-200/70 rounded-xl p-5 text-center">
                <div className="font-semibold text-primary-800">Compliance Monitor KOS REGTECH AI — Actif 24/7</div>
                <div className="text-sm text-primary-700 mt-1">10 contrôles BCEAO + ISO 27001/42001 + SOC2 · Surveillance temps réel · Cron horaire · Notifications automatiques</div>
              </div>
            </div>
          )}

          {/* Audit Trail Tab */}
          {activeTab === 'audit' && (
            <div className="space-y-6">
              <div className="bg-background-50 border border-background-200/70 rounded-xl p-5">
                <div className="flex items-center justify-between mb-4">
                  <div className="flex items-center gap-2">
                    <i className="ri-git-branch-line text-lg text-primary-600 w-5 h-5 flex items-center justify-center" />
                    <span className="font-semibold text-foreground-950">KOS REGTECH AI — Chaîne d'Audit Immuable</span>
                  </div>
                  <span className="px-2 py-0.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 whitespace-nowrap">{kosRegtechGlobalStats.chainIntegrity}</span>
                </div>
                <div className="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-4 text-sm">
                  <div className="bg-background-100 rounded-lg p-3">
                    <div className="text-foreground-500 text-xs">Blocs dans la chaîne</div>
                    <div className="font-bold text-foreground-950 text-lg">{kosRegtechGlobalStats.totalAuditBlocks}</div>
                  </div>
                  <div className="bg-background-100 rounded-lg p-3">
                    <div className="text-foreground-500 text-xs">Dernier Hash</div>
                    <div className="font-mono text-foreground-700 text-xs truncate">{kosRegtechGlobalStats.lastAuditHash}</div>
                  </div>
                  <div className="bg-background-100 rounded-lg p-3">
                    <div className="text-foreground-500 text-xs">Signature</div>
                    <div className="font-bold text-emerald-700">HMAC SHA-256 VÉRIFIÉE</div>
                  </div>
                </div>
              </div>

              <div className="space-y-2">
                {kosRegtechAuditChain.map((block) => (
                  <div key={block.id} onClick={() => setSelectedAuditBlock(selectedAuditBlock === block.id ? null : block.id)} className="bg-background-50 border border-background-200/70 rounded-xl cursor-pointer hover:bg-background-100/50 transition-colors">
                    <div className="p-4 flex items-start gap-4">
                      <div className="min-w-[40px] h-10 bg-background-100 rounded-lg flex items-center justify-center text-xs font-bold text-foreground-500">#{block.id}</div>
                      <div className="flex-1 min-w-0">
                        <div className="flex items-center gap-2 mb-1 flex-wrap">
                          <span className="font-semibold text-foreground-950 text-sm">{block.event_type}</span>
                          <span className="text-xs text-foreground-500">{block.actor_type}</span>
                          <span className="text-xs text-foreground-500">→ {block.resource}</span>
                          <span className="text-xs text-foreground-500">: {block.action}</span>
                        </div>
                        <div className="flex items-center gap-3 text-xs text-foreground-400 flex-wrap">
                          <span>{new Date(block.created_at).toLocaleString('fr-FR')}</span>
                          {block.ip_address && <span>IP: {block.ip_address}</span>}
                          <span className="text-emerald-600 font-mono">HMAC ✓</span>
                        </div>
                        <div className="text-xs text-foreground-400 font-mono mt-1 truncate">Hash: {block.block_hash.slice(0, 40)}...</div>
                        {block.previous_hash && <div className="text-xs text-foreground-400 font-mono truncate">Prev: {block.previous_hash.slice(0, 40)}...</div>}
                      </div>
                    </div>
                    {selectedAuditBlock === block.id && block.new_value && (
                      <div className="px-4 pb-4 border-t border-background-200/70 pt-3 ml-[56px]">
                        <div className="text-xs text-foreground-500 mb-2">Payload :</div>
                        <div className="bg-background-100 rounded-lg p-3 text-xs font-mono text-foreground-700 whitespace-pre-wrap overflow-x-auto">{JSON.stringify(block.new_value, null, 2)}</div>
                      </div>
                    )}
                  </div>
                ))}
              </div>

              <div className="bg-amber-50 border border-amber-200/70 rounded-xl p-5 text-center">
                <div className="font-semibold text-amber-800">Traçabilité Vérifiable KOS REGTECH AI</div>
                <div className="text-sm text-amber-700 mt-1">Chaque bloc est chaîné SHA-256 + signé HMAC. Toute falsification est immédiatement détectable. Conforme COBAC R-3 (Audit Trail 10 ans) et ISO 27001 A.12.4.</div>
              </div>
            </div>
          )}

          <div className="mt-8 pt-6 border-t border-background-200/70 text-center text-xs text-foreground-400">
            KOS REGTECH AI · RegTech Engine v2.1 · 5 Sources KYC (OFAC, EU, UN, BEAC, CENTIF) · 10 Compliance Controls (BCEAO, ISO 27001, ISO 42001, SOC2) · Blockchain-like Audit Trail SHA-256 HMAC · Uptime {kosRegtechGlobalStats.platformUptime}
          </div>
        </div>
      </div>
    </KOSHubLayout>
  );
}
