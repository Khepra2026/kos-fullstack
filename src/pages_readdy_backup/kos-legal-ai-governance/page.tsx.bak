import { useState } from 'react';
import KOSHubLayout from '@/components/feature/KOSHubLayout';

export default function KosLegalAIGovernancePage() {
  const [kosData, setKosData] = useState<any>(null);
  useEffect(() => {
    fetch('/mocks/kos-blog.json').then(r => r.json()).then(setKosData);
  }, []);
  if (!kosData) return null;

  const [activeTab, setActiveTab] = useState<'legal' | 'aigov'>('legal');
  const d = legalAIGovernanceHub;

  return (
    <KOSHubLayout hubId="kos-legal-ai-governance" title={d.title} subtitle={d.subtitle}>
      <div className="space-y-8">
        {/* Scores */}
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div className="bg-background-100 rounded-lg p-5">
            <div className="text-xs text-foreground-600 uppercase tracking-wider mb-1">Legal Validation Score</div>
            <div className="flex items-end gap-2">
              <span className="text-4xl font-bold text-foreground-950">{d.legalScore}</span>
              <span className="text-lg text-foreground-500">/100 → Cible {d.legalTarget}</span>
            </div>
            <div className="mt-2 w-full bg-background-200 rounded-full h-2">
              <div className="bg-blue-500 h-2 rounded-full" style={{ width: `${d.legalScore}%` }} />
            </div>
          </div>
          <div className="bg-background-100 rounded-lg p-5">
            <div className="text-xs text-foreground-600 uppercase tracking-wider mb-1">AI Governance Score</div>
            <div className="flex items-end gap-2">
              <span className="text-4xl font-bold text-foreground-950">{d.aiGovernanceScore}</span>
              <span className="text-lg text-foreground-500">/100 → Cible {d.aiGovernanceTarget}</span>
            </div>
            <div className="mt-2 w-full bg-background-200 rounded-full h-2">
              <div className="bg-purple-500 h-2 rounded-full" style={{ width: `${d.aiGovernanceScore}%` }} />
            </div>
          </div>
        </div>

        {/* Tabs */}
        <div className="flex gap-1 bg-background-100 rounded-full p-1 w-fit">
          <button
            onClick={() => setActiveTab('legal')}
            className={`flex items-center gap-1.5 px-5 py-2 rounded-full text-sm font-medium whitespace-nowrap transition-colors cursor-pointer ${
              activeTab === 'legal' ? 'bg-background-50 text-foreground-950 shadow-sm' : 'text-foreground-600 hover:text-foreground-900'
            }`}
          >
            <i className="ri-scales-3-line" /> Legal Auto-Scan
          </button>
          <button
            onClick={() => setActiveTab('aigov')}
            className={`flex items-center gap-1.5 px-5 py-2 rounded-full text-sm font-medium whitespace-nowrap transition-colors cursor-pointer ${
              activeTab === 'aigov' ? 'bg-background-50 text-foreground-950 shadow-sm' : 'text-foreground-600 hover:text-foreground-900'
            }`}
          >
            <i className="ri-shield-keyhole-line" /> AI Governance & ISO 42001
          </button>
        </div>

        {activeTab === 'legal' && (
          <div className="space-y-6">
            {/* Categories */}
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              {d.legalEngine.categories.map((cat, i) => (
                <div key={i} className="bg-background-100 rounded-lg p-4">
                  <div className="flex items-center justify-between mb-2">
                    <span className="text-sm font-semibold text-foreground-950">{cat.name}</span>
                    <span className={`px-2 py-0.5 rounded text-xs font-medium ${
                      cat.status === 'excellent' ? 'bg-green-100 text-green-800' :
                      cat.status === 'good' ? 'bg-blue-100 text-blue-800' :
                      'bg-yellow-100 text-yellow-800'
                    }`}>
                      {cat.score}/100
                    </span>
                  </div>
                  <div className="w-full bg-background-200 rounded-full h-1.5 mb-2">
                    <div className={`h-1.5 rounded-full ${
                      cat.score >= 90 ? 'bg-green-500' : cat.score >= 80 ? 'bg-blue-500' : 'bg-yellow-500'
                    }`} style={{ width: `${cat.score}%` }} />
                  </div>
                  <div className="flex items-center gap-3 text-xs text-foreground-500">
                    <span>{cat.issues} issues</span>
                    {cat.examples.length > 0 && (
                      <span className="text-foreground-400 truncate">{cat.examples[0]}</span>
                    )}
                  </div>
                </div>
              ))}
            </div>

            {/* Workflow */}
            <div className="bg-background-100 rounded-lg p-5">
              <h3 className="text-sm font-semibold text-foreground-950 mb-4 flex items-center gap-2">
                <i className="ri-git-branch-line" /> Workflow de Validation Juridique
              </h3>
              <div className="space-y-0">
                {d.legalEngine.workflow.map((step, i) => (
                  <div key={i} className="flex items-start gap-3">
                    <div className="flex flex-col items-center">
                      <div className={`w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold ${
                        step.status === 'active' ? 'bg-green-500 text-white' : 'bg-background-200 text-foreground-500'
                      }`}>
                        {step.step}
                      </div>
                      {i < d.legalEngine.workflow.length - 1 && (
                        <div className="w-0.5 h-6 bg-background-200" />
                      )}
                    </div>
                    <div className="pb-4">
                      <div className="text-sm font-medium text-foreground-900">{step.name}</div>
                      <div className="text-xs text-foreground-500">{step.action}</div>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            {/* Corrections récentes */}
            <div className="bg-background-100 rounded-lg p-5">
              <h3 className="text-sm font-semibold text-foreground-950 mb-3 flex items-center gap-2">
                <i className="ri-edit-line" /> Dernières Corrections Appliquées
              </h3>
              <div className="space-y-3">
                {d.legalEngine.corrections.map((corr, i) => (
                  <div key={i} className="bg-background-50 rounded p-3 text-sm">
                    <div className="flex items-center gap-2 mb-1">
                      <span className="px-2 py-0.5 rounded text-xs bg-red-100 text-red-700">AVANT</span>
                      <span className="text-red-700 line-through text-xs">{corr.before}</span>
                    </div>
                    <div className="flex items-center gap-2 mb-1">
                      <span className="px-2 py-0.5 rounded text-xs bg-green-100 text-green-700">APRÈS</span>
                      <span className="text-green-800 text-xs">{corr.after}</span>
                    </div>
                    <div className="flex items-center gap-3 text-xs text-foreground-500">
                      <span>{corr.category}</span>
                      <span>{corr.date}</span>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        )}

        {activeTab === 'aigov' && (
          <div className="space-y-6">
            {/* ISO 42001 Progress */}
            <div className="bg-background-100 rounded-lg p-5">
              <h3 className="text-sm font-semibold text-foreground-950 mb-4 flex items-center gap-2">
                <i className="ri-award-line" /> Certification ISO 42001 — Progression
              </h3>
              <div className="flex items-center gap-3 mb-4">
                <div className="text-4xl font-bold text-foreground-950">{d.aiGovernance.iso42001Progress}%</div>
                <div className="flex-1">
                  <div className="w-full bg-background-200 rounded-full h-3">
                    <div className="bg-purple-500 h-3 rounded-full" style={{ width: `${d.aiGovernance.iso42001Progress}%` }} />
                  </div>
                </div>
              </div>
              <div className="space-y-2">
                {d.aiGovernance.iso42001Milestones.map((ms, i) => (
                  <div key={i} className="flex items-center gap-3 bg-background-50 rounded p-3">
                    <div className={`w-6 h-6 rounded-full flex items-center justify-center text-xs ${
                      ms.status === 'completed' ? 'bg-green-500 text-white' :
                      ms.status === 'in_progress' ? 'bg-purple-500 text-white' :
                      'bg-background-200 text-foreground-500'
                    }`}>
                      {ms.status === 'completed' ? '✓' : ms.status === 'in_progress' ? '●' : i + 1}
                    </div>
                    <div className="flex-1 min-w-0">
                      <div className="text-sm font-medium text-foreground-900">{ms.milestone}</div>
                      <div className="text-xs text-foreground-500">{ms.date}</div>
                    </div>
                    <div className="text-sm font-semibold text-foreground-950">{ms.progress}%</div>
                  </div>
                ))}
              </div>
            </div>

            {/* AI Agent Scores */}
            <div className="bg-background-100 rounded-lg p-5">
              <h3 className="text-sm font-semibold text-foreground-950 mb-3 flex items-center gap-2">
                <i className="ri-robot-2-line" /> Scores de Confiance — Agents IA
              </h3>
              <div className="overflow-x-auto">
                <table className="w-full text-sm">
                  <thead>
                    <tr className="border-b border-background-200">
                      <th className="text-left py-2 px-3 text-foreground-600 font-medium">Agent</th>
                      <th className="text-center py-2 px-3 text-foreground-600 font-medium">Confiance</th>
                      <th className="text-center py-2 px-3 text-foreground-600 font-medium">Vérifiabilité</th>
                      <th className="text-center py-2 px-3 text-foreground-600 font-medium">Conformité</th>
                      <th className="text-center py-2 px-3 text-foreground-600 font-medium">Global</th>
                      <th className="text-center py-2 px-3 text-foreground-600 font-medium">Statut</th>
                    </tr>
                  </thead>
                  <tbody>
                    {d.aiGovernance.agents.map((agent, i) => (
                      <tr key={i} className="border-b border-background-100">
                        <td className="py-2.5 px-3 font-medium text-foreground-900">{agent.name}</td>
                        <td className="py-2.5 px-3 text-center font-semibold text-foreground-950">{agent.confidence}</td>
                        <td className="py-2.5 px-3 text-center text-foreground-600">{agent.verifiability}</td>
                        <td className="py-2.5 px-3 text-center text-foreground-600">{agent.compliance}</td>
                        <td className="py-2.5 px-3 text-center">
                          <span className={`font-bold ${
                            agent.global >= 90 ? 'text-green-700' :
                            agent.global >= 80 ? 'text-yellow-700' :
                            'text-red-700'
                          }`}>{agent.global}</span>
                        </td>
                        <td className="py-2.5 px-3 text-center">
                          <span className={`px-2 py-0.5 rounded text-xs ${
                            agent.status === 'excellent' ? 'bg-green-100 text-green-800' :
                            agent.status === 'good' ? 'bg-blue-100 text-blue-800' :
                            agent.status === 'warning' ? 'bg-yellow-100 text-yellow-800' :
                            'bg-red-100 text-red-800'
                          }`}>
                            {agent.status === 'excellent' ? 'Excellent' : agent.status === 'good' ? 'Bon' : agent.status === 'warning' ? 'Surveillé' : 'Critique'}
                          </span>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>

            {/* Rules & Audit Trail */}
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div className="bg-background-100 rounded-lg p-5">
                <h3 className="text-sm font-semibold text-foreground-950 mb-3 flex items-center gap-2">
                  <i className="ri-ruler-line" /> Règles de Conformité IA
                </h3>
                <div className="space-y-2">
                  {d.aiGovernance.rules.map((rule, i) => (
                    <div key={i} className="flex items-center justify-between bg-background-50 rounded p-2.5 text-sm">
                      <div className="flex-1 min-w-0">
                        <div className="text-foreground-900">{rule.rule}</div>
                        <div className="text-xs text-foreground-500">{rule.incidents} incidents {rule.resolved ? `(${rule.resolved} résolus)` : ''}</div>
                      </div>
                      <span className={`px-2 py-0.5 rounded text-xs ml-2 ${
                        rule.status === 'compliant' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800'
                      }`}>
                        {rule.status === 'compliant' ? 'Conforme' : 'Surveillé'}
                      </span>
                    </div>
                  ))}
                </div>
              </div>

              <div className="bg-background-100 rounded-lg p-5">
                <h3 className="text-sm font-semibold text-foreground-950 mb-3 flex items-center gap-2">
                  <i className="ri-history-line" /> Audit Trail — Dernières Actions
                </h3>
                <div className="space-y-2">
                  {d.aiGovernance.auditTrail.map((audit, i) => (
                    <div key={i} className="bg-background-50 rounded p-2.5 text-sm">
                      <div className="flex items-center justify-between mb-0.5">
                        <span className="font-medium text-foreground-900">{audit.agent}</span>
                        <span className="text-xs text-foreground-500">{audit.date}</span>
                      </div>
                      <div className="text-xs text-foreground-600">{audit.action}</div>
                      <div className="text-xs text-foreground-400 mt-0.5">{audit.impact}</div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        )}
      </div>
    </KOSHubLayout>
  );
}
