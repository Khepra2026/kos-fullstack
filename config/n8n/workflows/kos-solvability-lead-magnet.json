{
  "name": "KOS Solvability UEMOA 2026 — Form → Edge → PDF → Email → CRM",
  "version": "1.0",
  "goLive": "J+1",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Simulateur Solvabilité UEMOA 2026 — BCEAO",
        "formDescription": "Calculez votre ratio de solvabilité réglementaire selon le Dispositif Prudentiel BCEAO 2026. Simulation non engageante — Article 14.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Fonds Propres de Base (Tier 1) en millions FCFA",
              "fieldType": "number",
              "requiredField": true,
              "fieldName": "fp_base"
            },
            {
              "fieldLabel": "Fonds Propres Complémentaires (Tier 2) en millions FCFA",
              "fieldType": "number",
              "requiredField": true,
              "fieldName": "fp_compl"
            },
            {
              "fieldLabel": "RWA Risque de Crédit en millions FCFA",
              "fieldType": "number",
              "requiredField": true,
              "fieldName": "rwa_credit"
            },
            {
              "fieldLabel": "RWA Risque de Marché en millions FCFA",
              "fieldType": "number",
              "requiredField": true,
              "fieldName": "rwa_marche"
            },
            {
              "fieldLabel": "RWA Risque Opérationnel en millions FCFA",
              "fieldType": "number",
              "requiredField": true,
              "fieldName": "rwa_ope"
            },
            {
              "fieldLabel": "Email professionnel",
              "fieldType": "email",
              "requiredField": true,
              "fieldName": "email"
            },
            {
              "fieldLabel": "Nom de l'institution",
              "fieldType": "text",
              "requiredField": false,
              "fieldName": "nom_institution"
            }
          ]
        },
        "options": {}
      },
      "id": "n8n-form-trigger",
      "name": "Formulaire Simulateur Solvabilité",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://pgfwhahiwqvqeahpirjx.supabase.co/functions/v1/kos-banking-stack/solvability",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.SUPABASE_ANON_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"fp_base\": {{ $json.fp_base }},\n  \"fp_compl\": {{ $json.fp_compl }},\n  \"rwa_credit\": {{ $json.rwa_credit }},\n  \"rwa_marche\": {{ $json.rwa_marche }},\n  \"rwa_ope\": {{ $json.rwa_ope }},\n  \"email\": \"{{ $json.email }}\",\n  \"nom_institution\": \"{{ $json.nom_institution }}\"\n}",
        "options": {
          "timeout": 3000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "edge-solvability",
      "name": "Edge Function — kos-banking-stack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [250, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.statut }}",
              "rightValue": "red",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        }
      },
      "id": "if-priority",
      "name": "IF Statut = Rouge ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [500, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://pgfwhahiwqvqeahpirjx.supabase.co/functions/v1/kos-banking-stack/lead-magnet",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.SUPABASE_ANON_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"ratio\": {{ $json.ratio }},\n  \"email\": \"{{ $json.email }}\",\n  \"nom_institution\": \"{{ $json.nom_institution }}\"\n}",
        "options": {}
      },
      "id": "lead-magnet",
      "name": "Lead Magnet Factory — Email + Score",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [750, -100]
    },
    {
      "parameters": {
        "fromEmail": "noreply@khepra-experts.com",
        "toEmail": "={{ $node['edge-solvability'].json.email }}",
        "subject": "={{ $node['lead-magnet'].json.subject }}",
        "text": "={{ $node['lead-magnet'].json.email_template }}",
        "options": {}
      },
      "id": "send-email",
      "name": "Envoi Email — Rapport BCEAO 2026",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1000, -100]
    },
    {
      "parameters": {
        "operation": "upsert",
        "table": "leads",
        "data": {
          "email": "={{ $node['edge-solvability'].json.email }}",
          "nom_institution": "={{ $node['edge-solvability'].json.nom_institution }}",
          "ratio_solvabilite": "={{ $node['edge-solvability'].json.ratio }}",
          "statut": "={{ $node['edge-solvability'].json.statut }}",
          "lead_score": "={{ $node['edge-solvability'].json.lead_score }}",
          "lead_priority": "={{ $node['edge-solvability'].json.lead_priority }}",
          "source": "Simulateur Solvabilité UEMOA 2026",
          "derniere_activite": "={{ $now }}"
        }
      },
      "id": "crm-upsert",
      "name": "CRM — Upsert Lead dans Supabase",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [1250, -100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://pgfwhahiwqvqeahpirjx.supabase.co/functions/v1/kos-tender-email-notify",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.SUPABASE_ANON_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"institution\": \"{{ $node['edge-solvability'].json.nom_institution }}\",\n  \"ratio\": {{ $node['edge-solvability'].json.ratio }},\n  \"statut\": \"{{ $node['edge-solvability'].json.statut }}\",\n  \"alert_type\": \"solvability_red_flag\"\n}",
        "options": {}
      },
      "id": "tender-alert",
      "name": "Alerte Managing Partner — Si AO Solvabilité LIVE",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [750, 100]
    },
    {
      "parameters": {
        "webhookUrl": "={{ $env.SLACK_WEBHOOK_URL }}",
        "text": "=🚨 NOUVEAU LEAD P0: {{ $node['edge-solvability'].json.nom_institution }} — Ratio Solvabilité {{ $node['edge-solvability'].json.ratio }}% — Statut: {{ $node['edge-solvability'].json.statut_label }}"
      },
      "id": "slack-notify",
      "name": "Notification Slack — Managing Partner Office",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2,
      "position": [1000, 200]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [],
          "number": [],
          "boolean": []
        },
        "options": {}
      },
      "id": "response-to-form",
      "name": "Retour Résultat au Frontend",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1000, -300]
    }
  ],
  "connections": {
