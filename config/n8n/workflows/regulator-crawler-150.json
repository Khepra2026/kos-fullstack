{
  "name": "kos-regulator-crawler-150",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "minutes", "minutesInterval": 30 }]
        }
      },
      "id": "Cron",
      "name": "Every 30min",
      "type": "n8n-nodes-base.cron",
      "position": [250, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, regulator, url, lang, content_hash FROM regulator_feed WHERE (last_crawl IS NULL OR last_crawl < now() - interval '1 hour') AND active IS NOT FALSE ORDER BY impact_score DESC NULLS LAST LIMIT 10"
      },
      "id": "PG-Get-URLs",
      "name": "Get URLs to crawl",
      "type": "n8n-nodes-base.postgres",
      "position": [450, 300]
    },
    {
      "parameters": { "batchSize": 3 },
      "id": "Split",
      "name": "Split In Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "position": [650, 300]
    },
    {
      "parameters": {
        "url": "={{ $json.url }}",
        "options": { "timeout": 15000, "redirect": { "followRedirects": true } }
      },
      "id": "HTTP",
      "name": "Crawl Page",
      "type": "n8n-nodes-base.httpRequest",
      "position": [850, 300]
    },
    {
      "parameters": {
        "jsCode": "const oldHash = $input.first().json.content_hash;\nconst body = $('HTTP').item.json;\nconst newHash = $evaluate('{{ $crypto.hash(\"md5\", body) }}');\n\nreturn {\n  id: $input.first().json.id,\n  regulator: $input.first().json.regulator,\n  url: $input.first().json.url,\n  lang: $input.first().json.lang,\n  old_hash: oldHash,\n  new_hash: newHash,\n  changed: oldHash !== newHash\n};"
      },
      "id": "Code-Hash",
      "name": "Compute Hash & Compare",
      "type": "n8n-nodes-base.code",
      "position": [1050, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true },
          "conditions": [
            {
              "id": "1",
              "leftValue": "={{ $json.changed }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ]
        }
      },
      "id": "IF-Changed",
      "name": "If Changed",
      "type": "n8n-nodes-base.if",
      "position": [1250, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE regulator_feed SET content_hash = $1, last_crawl = now() WHERE id = $2",
        "additionalFields": {
          "queryParams": "={{ [$json.new_hash, $json.id] }}"
        }
      },
      "id": "PG-Update",
      "name": "Update Hash & Timestamp",
      "type": "n8n-nodes-base.postgres",
      "position": [1450, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://pgfwhahiwqvqeahpirjx.supabase.co/functions/v1/kos-webhook-notifier/send",
        "body": {
          "url": "={{ $('kos-regulator-crawler').first().json.internal_webhook_url || 'https://pgfwhahiwqvqeahpirjx.supabase.co/functions/v1/kos-regulator-crawler' }}",
          "payload": {
            "event": "regulator_update",
            "regulator": "={{ $json.regulator }}",
            "url": "={{ $json.url }}",
            "lang": "={{ $json.lang }}",
            "old_hash": "={{ $json.old_hash }}",
            "new_hash": "={{ $json.new_hash }}"
          },
          "type": "regulator_update"
        }
      },
      "id": "Webhook-Notify",
      "name": "Notify KOS",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1650, 200]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE regulator_feed SET last_crawl = now() WHERE id = $1"
      },
      "id": "PG-Update-NoChange",
      "name": "Update Timestamp Only",
      "type": "n8n-nodes-base.postgres",
      "position": [1450, 400]
    }
  ],
  "connections": {
    "Cron": {
      "main": [[{ "node": "PG-Get-URLs" }]]
    },
    "PG-Get-URLs": {
      "main": [[{ "node": "Split" }]]
    },
    "Split": {
      "main": [[{ "node": "HTTP" }]]
    },
    "HTTP": {
      "main": [[{ "node": "Code-Hash" }]]
    },
    "Code-Hash": {
      "main": [[{ "node": "IF-Changed" }]]
    },
    "IF-Changed": {
      "main": [
        [{ "node": "PG-Update" }],
        [{ "node": "PG-Update-NoChange" }]
      ]
    },
    "PG-Update": {
      "main": [[{ "node": "Webhook-Notify" }]]
    }
  }
}