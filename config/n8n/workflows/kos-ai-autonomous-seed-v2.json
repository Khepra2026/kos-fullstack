{
  "name": "KOS-AI-Autonomous-Seed-v2.0",
  "nodes": [
    {
      "parameters": {
        "triggerTimes": {
          "item": [
            { "mode": "everyHour" },
            { "mode": "custom", "cronExpression": "0 7 * * *" }
          ]
        }
      },
      "id": "Cron-Trigger",
      "name": "Cron Trigger",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [ -400, 0 ]
    },
    {
      "parameters": {
        "authentication": "headerAuth",
        "url": "https://{{ $env.SUPABASE_PROJECT_REF }}.supabase.co/rest/v1/failed_jobs?status=eq.pending&select=*",
        "options": {}
      },
      "id": "Get-DLQ",
      "name": "Get DLQ Pending",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [ -180, -200 ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "supabase-service-role",
          "name": "Supabase Service Role"
        }
      }
    },
    {
      "parameters": {
        "function": "const jobs = $input.all()[0].json;\nif (!jobs.length) return [];\n\nreturn jobs.map(job => ({\n json: {\n id: job.id,\n payload: job.payload,\n function_name: job.function_name,\n retry_count: (job.retry_count || 0) + 1\n }\n}));"
      },
      "id": "Split-DLQ",
      "name": "Split DLQ Jobs",
      "type": "n8n-nodes-base.function",
      "typeVersion": 2,
      "position": [ 40, -200 ]
    },
    {
      "parameters": {
        "authentication": "headerAuth",
        "url": "=https://{{ $env.SUPABASE_PROJECT_REF }}.supabase.co/functions/v1/{{$json.function_name}}",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": "={{$json.payload}}",
        "options": { "timeout": 30000 }
      },
      "id": "Retry-Job",
      "name": "Retry Job via Edge Function",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [ 260, -200 ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "supabase-service-role",
          "name": "Supabase Service Role"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "authentication": "headerAuth",
        "url": "=https://{{ $env.SUPABASE_PROJECT_REF }}.supabase.co/rest/v1/failed_jobs?id=eq.{{$json.id}}",
        "method": "PATCH",
        "sendBody": true,
        "bodyParameters": "={{ { status: $json.error? 'escalated' : 'resolved', retry_count: $json.retry_count, updated_at: new Date().toISOString() } }}",
        "options": {}
      },
      "id": "Update-DLQ-Status",
      "name": "Update DLQ Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [ 500, -200 ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "supabase-service-role",
          "name": "Supabase Service Role"
        }
      }
    },
    {
      "parameters": {
        "authentication": "headerAuth",
        "url": "https://{{ $env.SUPABASE_PROJECT_REF }}.supabase.co/rest/v1/ai_prompts?status=eq.active&select=id,content,version,last_eval_at",
        "options": {}
      },
      "id": "Get-Active-Prompts",
      "name": "Get Active Prompts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [ -180, 200 ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "supabase-service-role",
          "name": "Supabase Service Role"
        }
      }
    },
    {
      "parameters": {
        "function": "const prompts = $input.all()[0].json;\nconst sevenDaysAgo = Date.now() - 7 * 24 * 60 * 60 * 1000;\n\nreturn prompts.filter(p => {\n const lastEval = new Date(p.last_eval_at || 0).getTime();\n return lastEval < sevenDaysAgo;\n}).map(p => ({ json: p }));"
      },
      "id": "Filter-Stale-Prompts",
      "name": "Filter Prompts >7j",
      "type": "n8n-nodes-base.function",
      "typeVersion": 2,
      "position": [ 40, 200 ]
    },
    {
      "parameters": {
        "authentication": "genericCredentialType",
        "url": "https://api.openai.com/v1/chat/completions",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "model", "value": "gpt-4o-mini" },
            { "name": "messages", "value": "=[{\"role\":\"system\",\"content\":\"Tu es un évaluateur de prompts. Note de 0 à 100 la clarté, sécurité, absence de biais. Retourne JSON: {score, issues[]}\"},{\"role\":\"user\",\"content\":\"Evalue ce prompt: {{$json.content}}\"}]" },
            { "name": "response_format", "value": "={{ { type: \"json_object\" } }}" }
          ]
        },
        "options": {}
      },
      "id": "Eval-Prompt-Quality",
      "name": "Eval Prompt Quality",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [ 260, 200 ],
      "credentials": {
        "httpGenericAuth": {
          "id": "openai-eval",
          "name": "OpenAI Eval"
        }
      }
    },
    {
      "parameters": {
        "authentication": "headerAuth",
        "url": "https://{{ $env.SUPABASE_PROJECT_REF }}.supabase.co/rest/v1/ai_prompt_evals",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": "={{ { prompt_id: $('Filter-Stale-Prompts').item.json.id, score: JSON.parse($json.choices[0].message.content).score, issues: JSON.parse($json.choices[0].message.content).issues, evaluated_at: new Date().toISOString() } }}",
        "options": {}
      },
      "id": "Log-Prompt-Eval",
      "name": "Log Prompt Eval",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [ 500, 200 ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "supabase-service-role",
          "name": "Supabase Service Role"
        }
      }
    },
    {
      "parameters": {
        "authentication": "headerAuth",
        "url": "https://{{ $env.SUPABASE_PROJECT_REF }}.supabase.co/rest/v1/rag_sources?select=id,content,embedding,last_validated_at",
        "options": {}
      },
      "id": "Get-RAG-Sources",
      "name": "Get RAG Sources",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [ -180, 500 ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "supabase-service-role",
          "name": "Supabase Service Role"
        }
      }
    },
    {
      "parameters": {
        "function": "const sources = $input.all()[0].json;\nconst ninetyDaysAgo = Date.now() - 90 * 24 * 60 * 60 * 1000;\n\nreturn sources.filter(s => new Date(s.last_validated_at || 0).getTime() < ninetyDaysAgo).map(s => ({ json: s }));"
      },
      "id": "Filter-Stale-RAG",
      "name": "Filter RAG >90j",
      "type": "n8n-nodes-base.function",
      "typeVersion": 2,
      "position": [ 40, 500 ]
    },
    {
      "parameters": {
        "authentication": "genericCredentialType",
        "url": "https://api.openai.com/v1/embeddings",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "model", "value": "text-embedding-3-small" },
            { "name": "input", "value": "={{$json.content}}" }
          ]
        },
        "options": {}
      },
      "id": "Re-Embed-RAG",
      "name": "Re-Embed + Hallucination Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [ 260, 500 ],
      "credentials": {
        "httpGenericAuth": {
          "id": "openai-eval",
          "name": "OpenAI Eval"
        }
      }
    },
    {
      "parameters": {
        "authentication": "headerAuth",
        "url": "=https://{{ $env.SUPABASE_PROJECT_REF }}.supabase.co/rest/v1/rag_sources?id=eq.{{$json.id}}",
        "method": "PATCH",
        "sendBody": true,
        "bodyParameters": "={{ { embedding: $json.data[0].embedding, last_validated_at: new Date().toISOString(), drift_score: 0 } }}",
        "options": {}
      },
      "id": "Update-RAG",
      "name": "Update RAG Source",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [ 500, 500 ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "supabase-service-role",
          "name": "Supabase Service Role"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "={{ $json.score }}",
            "operation": "smaller",
            "rightValue": 70
          }
        }
      },
      "id": "If-Prompt-Failed",
      "name": "If Prompt Score < 70",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [ 720, 200 ]
    },
    {
      "parameters": {
        "authentication": "genericCredentialType",
        "url": "https://hooks.slack.com/services/{{ $env.SLACK_WEBHOOK }}",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "text", "value": "=🚨 KOS AI Alert: Prompt {{$('Filter-Stale-Prompts').item.json.id}} scored {{$json.score}}/100. Issues: {{$json.issues.join(', ')}}. Auto-paused for review." }
          ]
        },
        "options": {}
      },
      "id": "Slack-Alert",
      "name": "Slack Alert L2",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [ 940, 200 ]
    }
  ],
  "connections": {
    "Cron Trigger": {
      "main": [
        [ { "node": "Get DLQ Pending", "type": "main", "index": 0 } ],
        [ { "node": "Get Active Prompts", "type": "main", "index": 0 } ],
        [ { "node": "Get RAG Sources", "type": "main", "index": 0 } ]
      ]
    },
    "Get DLQ Pending": { "main": [ [ { "node": "Split DLQ Jobs", "type": "main", "index": 0 } ] ] },
    "Split DLQ Jobs": { "main": [ [ { "node": "Retry Job via Edge Function", "type": "main", "index": 0 } ] ] },
    "Retry Job via Edge Function": { "main": [ [ { "node": "Update DLQ Status", "type": "main", "index": 0 } ] ] },
    "Get Active Prompts": { "main": [ [ { "node": "Filter Prompts >7j", "type": "main", "index": 0 } ] ] },
    "Filter Prompts >7j": { "main": [ [ { "node": "Eval Prompt Quality", "type": "main", "index": 0 } ] ] },
    "Eval Prompt Quality": { "main": [ [ { "node": "Log Prompt Eval", "type": "main", "index": 0 } ] ] },
    "Log Prompt Eval": { "main": [ [ { "node": "If Prompt Score < 70", "type": "main", "index": 0 } ] ] },
    "If Prompt Score < 70": { "main": [ [ { "node": "Slack Alert L2", "type": "main", "index": 0 } ], [] ] },
    "Get RAG Sources": { "main": [ [ { "node": "Filter RAG >90j", "type": "main", "index": 0 } ] ] },
    "Filter RAG >90j": { "main": [ [ { "node": "Re-Embed + Hallucination Check", "type": "main", "index": 0 } ] ] },
    "Re-Embed + Hallucination Check": { "main": [ [ { "node": "Update RAG Source", "type": "main", "index": 0 } ] ] }
  },
  "pinData": {},
  "meta": {
    "templateCredsSetup": [
      {
        "name": "supabase-service-role",
        "displayName": "Supabase Service Role",
        "type": "httpHeaderAuth",
        "placeholder": "Header: apikey + Authorization: Bearer <service_role>"
      },
      {
        "name": "openai-eval",
        "displayName": "OpenAI Eval",
        "type": "httpHeaderAuth",
        "placeholder": "Header: Authorization: Bearer sk-..."
      }
    ]
  }
}