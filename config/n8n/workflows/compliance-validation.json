{
  "name": "KOS Compliance Validation",
  "active": true,
  "settings": {
    "saveExecutionProgress": true,
    "saveManualExecutions": true,
    "timezone": "Africa/Douala",
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "parameters": {
        "channel": "compliance-events",
        "options": { "host": "redis", "port": 6379 }
      },
      "id": "trigger-redis",
      "name": "Redis Event Trigger",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "jsCode": "// Parse compliance event\nconst event = $input.first().json;\n\nreturn {\n  document_id: event.payload?.document_id || '',\n  regulator: event.payload?.regulator || '',\n  document_type: event.payload?.document_type || '',\n  validation_rules: event.payload?.rules || ['format', 'source', 'authority', 'date', 'cross_ref'],\n  priority: event.payload?.priority || 'normal'\n};\n"
      },
      "id": "parse-event",
      "name": "Parse Compliance Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://qdrant:6333/collections/compliance_vectors/points/search",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"vector\": $json.search_vector || [],\n  \"limit\": 5,\n  \"score_threshold\": 0.85,\n  \"with_payload\": true\n}"
      },
      "id": "semantic-check",
      "name": "Semantic Compliance Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [650, 200]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/regulatory_sources?regulator=eq.{{ $json.regulator }}&select=*",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_ANON_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_ANON_KEY }}" }
          ]
        }
      },
      "id": "source-verification",
      "name": "Verify Source Authority",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [650, 400]
    },
    {
      "parameters": {
        "jsCode": "// Evaluate compliance score\nconst semantic = $input.all()[0]?.json || {};\nconst source = $input.all()[1]?.json || [];\n\nconst sourceValid = source.length > 0;\nconst semanticScore = (semantic.result || []).length > 0 ? 0.9 : 0.5;\nconst overallScore = sourceValid ? semanticScore : semanticScore * 0.6;\n\nreturn {\n  document_id: $('Parse Compliance Event').first().json.document_id,\n  regulator: $('Parse Compliance Event').first().json.regulator,\n  compliance_score: parseFloat(overallScore.toFixed(3)),\n  source_verified: sourceValid,\n  semantic_matches: (semantic.result || []).length,\n  status: overallScore >= 0.8 ? 'approved' : overallScore >= 0.5 ? 'review' : 'rejected',\n  validated_at: new Date().toISOString()\n};\n"
      },
      "id": "score-compliance",
      "name": "Score Compliance",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "operation": "equals",
              "value2": "rejected"
            }
          ]
        }
      },
      "id": "check-rejected",
      "name": "Rejected?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://audit-service:3002/alert",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "type", "value": "compliance_rejection" },
            { "name": "document_id", "value": "={{ $json.document_id }}" },
            { "name": "regulator", "value": "={{ $json.regulator }}" },
            { "name": "score", "value": "={{ $json.compliance_score }}" }
          ]
        }
      },
      "id": "alert-rejection",
      "name": "Alert on Rejection",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1250, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/compliance_reviews",
        "sendBody": true,
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_ANON_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_ANON_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "bodyParameters": {
          "parameters": [
            { "name": "document_id", "value": "={{ $json.document_id }}" },
            { "name": "score", "value": "={{ $json.compliance_score }}" },
            { "name": "status", "value": "={{ $json.status }}" },
            { "name": "source_verified", "value": "={{ $json.source_verified }}" },
            { "name": "validated_at", "value": "={{ $json.validated_at }}" }
          ]
        }
      },
      "id": "store-supabase",
      "name": "Store to Supabase Registry",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1250, 400]
    }
  ],
  "connections": {
    "Redis Event Trigger": {
      "main": [[ { "node": "Parse Compliance Event", "type": "main", "index": 0 } ]]
    },
    "Parse Compliance Event": {
      "main": [
        [
          { "node": "Semantic Compliance Check", "type": "main", "index": 0 },
          { "node": "Verify Source Authority", "type": "main", "index": 0 }
        ]
      ]
    },
    "Semantic Compliance Check": {
      "main": [[ { "node": "Score Compliance", "type": "main", "index": 0 } ]]
    },
    "Verify Source Authority": {
      "main": [[ { "node": "Score Compliance", "type": "main", "index": 0 } ]]
    },
    "Score Compliance": {
      "main": [[ { "node": "Rejected?", "type": "main", "index": 0 } ]]
    },
    "Rejected?": {
      "main": [
        [{ "node": "Alert on Rejection", "type": "main", "index": 0 }],
        [{ "node": "Store to Supabase Registry", "type": "main", "index": 0 }]
      ]
    },
    "Alert on Rejection": {
      "main": [[ { "node": "Store to Supabase Registry", "type": "main", "index": 0 } ]]
    }
  }
}