{
  "name": "kos-webhook-notifier-priority",
  "nodes": [
    {
      "parameters": {
        "path": "kos-webhook-notifier",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "Webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "position": [250, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO webhook_notification_log(endpoint, payload, sent_at) VALUES ($1, $2, now()) RETURNING id",
        "additionalFields": {
          "queryParams": "={{ [$json.body.endpoint, $json.body] }}"
        }
      },
      "id": "Postgres",
      "name": "Log to DB",
      "type": "n8n-nodes-base.postgres",
      "position": [450, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: true, log_id: $json.id, latency_ms: $now - $item(0).$node.Webhook.json.received_at } }}"
      },
      "id": "Response",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [650, 300]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Log to DB", "type": "main", "index": 0 }]] },
    "Log to DB": { "main": [[{ "node": "Respond", "type": "main", "index": 0 }]] }
  }
}