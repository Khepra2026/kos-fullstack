{
  "dashboard": {
    "title": "KOS Sovereign Stack — Infrastructure Monitoring",
    "tags": ["kos", "sovereign", "bigfour", "infrastructure"],
    "timezone": "Africa/Douala",
    "editable": true,
    "refresh": "10s",
    "time": {
      "from": "now-6h",
      "to": "now"
    },
    "panels": [
      {
        "title": "KOS Container Health Status",
        "type": "stat",
        "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "count(up{job=~\"nginx-gateway|n8n|qdrant|memory-engine|governance-engine|ingestion-service|transform-service|audit-service|postgres|redis\"})",
            "legendFormat": "Conteneurs UP"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": { "steps": [{ "color": "red", "value": 0 }, { "color": "yellow", "value": 8 }, { "color": "green", "value": 10 }] },
            "mappings": [],
            "color": { "mode": "thresholds" }
          }
        }
      },
      {
        "title": "API Gateway — Request Rate",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
        "targets": [
          {
            "expr": "rate(nginx_http_requests_total[5m])",
            "legendFormat": "Requests/sec"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "reqps",
            "custom": { "lineInterpolation": "smooth", "fillOpacity": 20 }
          }
        }
      },
      {
        "title": "API Gateway — Latency (p95)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(nginx_http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "p95 Latency"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "custom": { "lineInterpolation": "smooth", "fillOpacity": 20 }
          }
        }
      },
      {
        "title": "Qdrant — Vector Operations/sec",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
        "targets": [
          {
            "expr": "rate(qdrant_grpc_requests_total[5m])",
            "legendFormat": "Qdrant Ops/sec"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "custom": { "lineInterpolation": "smooth", "fillOpacity": 20 }
          }
        }
      },
      {
        "title": "Redis — Queue Length",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
        "targets": [
          {
            "expr": "redis_connected_clients",
            "legendFormat": "Connected Clients"
          },
          {
            "expr": "redis_used_memory_bytes / 1024 / 1024",
            "legendFormat": "Memory (MB)"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": { "lineInterpolation": "smooth", "fillOpacity": 20 }
          }
        }
      },
      {
        "title": "PostgreSQL — Active Connections",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
        "targets": [
          {
            "expr": "pg_stat_database_numbackends",
            "legendFormat": "Active Connections"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": { "lineInterpolation": "smooth", "fillOpacity": 20 }
          }
        }
      },
      {
        "title": "Container CPU Usage (%)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
        "targets": [
          {
            "expr": "rate(container_cpu_usage_seconds_total{name=~\"kos.*\"}[5m]) * 100",
            "legendFormat": "{{name}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "max": 100,
            "custom": { "lineInterpolation": "smooth", "fillOpacity": 10 }
          }
        }
      },
      {
        "title": "Container Memory Usage (MB)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
        "targets": [
          {
            "expr": "container_memory_usage_bytes{name=~\"kos.*\"} / 1024 / 1024",
            "legendFormat": "{{name}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "decbytes",
            "custom": { "lineInterpolation": "smooth", "fillOpacity": 10 }
          }
        }
      },
      {
        "title": "n8n — Workflow Executions",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 28 },
        "targets": [
          {
            "expr": "rate(n8n_workflow_executions_total[1h])",
            "legendFormat": "Executions/h"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 50 }] }
          }
        }
      },
      {
        "title": "Qdrant — Active Collections",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 28 },
        "targets": [
          {
            "expr": "qdrant_collections_total",
            "legendFormat": "Collections"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": { "steps": [{ "color": "red", "value": 0 }, { "color": "yellow", "value": 3 }, { "color": "green", "value": 5 }] }
          }
        }
      },
      {
        "title": "System Memory Usage",
        "type": "gauge",
        "gridPos": { "h": 4, "w": 6, "x": 12, "y": 28 },
        "targets": [
          {
            "expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / node_memory_MemTotal_bytes * 100",
            "legendFormat": "Memory %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "max": 100,
            "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 85 }] }
          }
        }
      },
      {
        "title": "System Disk Usage",
        "type": "gauge",
        "gridPos": { "h": 4, "w": 6, "x": 18, "y": 28 },
        "targets": [
          {
            "expr": "(node_filesystem_size_bytes{mountpoint='/'} - node_filesystem_free_bytes{mountpoint='/'}) / node_filesystem_size_bytes{mountpoint='/'} * 100",
            "legendFormat": "Disk %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "max": 100,
            "thresholds": { "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 90 }] }
          }
        }
      },
      {
        "title": "Auto-Expansion Events (24h)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
        "targets": [
          {
            "expr": "rate(kos_auto_expansion_events_total[1h])",
            "legendFormat": "Expansion Events/h"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": { "lineInterpolation": "smooth", "fillOpacity": 30 }
          }
        }
      },
      {
        "title": "Self-Healing Actions (24h)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
        "targets": [
          {
            "expr": "rate(kos_self_healing_actions_total[1h])",
            "legendFormat": "Healing Actions/h"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "custom": { "lineInterpolation": "smooth", "fillOpacity": 30 }
          }
        }
      }
    ],
    "schemaVersion": 38,
    "version": 1
  }
}