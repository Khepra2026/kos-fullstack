# ═══════════════════════════════════════════════════════════════
# KOS SOVEREIGN STACK — Service systemd
# Démarrer automatiquement au boot + auto-restart si crash
# Fichier : /etc/systemd/system/kos-stack.service
# ═══════════════════════════════════════════════════════════════
# Installation :
#   sudo cp kos-stack.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable kos-stack.service
#   sudo systemctl start kos-stack.service
# ═══════════════════════════════════════════════════════════════

[Unit]
Description=KOS Sovereign Stack — Docker Compose 14 conteneurs
Documentation=https://khepra-experts.com
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes

# Répertoire du projet — à adapter si changement
WorkingDirectory=/opt/kos-stack

# Démarrage : build + up en détaché
ExecStart=/usr/bin/bash /opt/kos-stack/docker-deploy.sh up

# Arrêt propre : down (garde les volumes)
ExecStop=/usr/bin/bash /opt/kos-stack/docker-deploy.sh down

# Redémarrage : restart tous les conteneurs
ExecReload=/usr/bin/bash /opt/kos-stack/docker-deploy.sh restart

# Si le process crash pour une raison quelconque, on retente
Restart=on-failure
RestartSec=30s
TimeoutStartSec=600s
TimeoutStopSec=120s

# Nettoyage à l'arrêt
KillMode=mixed
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target