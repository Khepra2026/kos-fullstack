import { useState, useMemo } from 'react';
import KOSHubLayout from '@/components/feature/KOSHubLayout';
import { SeoHead } from '@/components/feature/SeoHead';
import {
  ISO27001_CONTROLS,
  OWASP_VULNERABILITIES,
  SOC2_CONTROLS,
  SECURITY_INCIDENTS,
  SECURITY_CERTIFICATIONS,
  SECURITY_RESILIENCE_STATS,
  INITIAL_SECURITY_LOGS,
  type SecurityResilienceLog,
} from '@/mocks/kosEnterpriseSecurityResilience';

type TabId = 'iso27001' | 'owasp' | 'soc2' | 'secops' | 'certifications' | 'logs';

const SEVERITY_MAP: Record<string, { label: string; hex: string; bgClass: string; borderClass: string }> = {
  critical: { label: 'CRITIQUE', hex: '#DC2626', bgClass: 'bg-red-50', borderClass: 'border-red-200' },
  high: { label: 'ÉLEVÉ', hex: '#EA580C', bgClass: 'bg-orange-50', borderClass: 'border-orange-200' },
  medium: { label: 'MOYEN', hex: '#9B7B2C', bgClass: 'bg-amber-50', borderClass: 'border-amber-200' },
  low: { label: 'FAIBLE', hex: '#86BC25', bgClass: 'bg-emerald-50', borderClass: 'border-emerald-200' },
  info: { label: 'INFO', hex: '#6366F1', bgClass: 'bg-indigo-50', borderClass: 'border-indigo-200' },
};

const TSC_MAP: Record<string, { label: string; icon: string; hex: string }> = {
  security: { label: 'Security', icon: 'ri-shield-check-line', hex: '#DC2626' },
  availability: { label: 'Availability', icon: 'ri-cloud-line', hex: '#0D9488' },
  confidentiality: { label: 'Confidentiality', icon: 'ri-lock-2-line', hex: '#6366F1' },
  processing_integrity: { label: 'Processing Integrity', icon: 'ri-check-double-line', hex: '#EA580C' },
  privacy: { label: 'Privacy', icon: 'ri-eye-off-line', hex: '#7C3AED' },
};

export default function KOSEnterpriseSecurityResiliencePage() {
  const [kosData, setKosData] = useState<any>(null);
  useEffect(() => {
    fetch('/mocks/kos-blog.json').then(r => r.json()).then(setKosData);
  }, []);
  if (!kosData) return null;

  const [activeTab, setActiveTab] = useState<TabId>('iso27001');
  const [expandedItems, setExpandedItems] = useState<Set<string>>(new Set());
  const [logs] = useState<SecurityResilienceLog[]>(INITIAL_SECURITY_LOGS);

  const toggleExpand = (id: string) => {
    setExpandedItems(prev => {
      const next = new Set(prev);
      if (next.has(id)) next.delete(id); else next.add(id);
      return next;
    });
  };

  const tabs: { id: TabId; label: string; icon: string; badge: string }[] = [
    { id: 'iso27001', label: 'ISO 27001', icon: 'ri-shield-check-line', badge: String(ISO27001_CONTROLS.length) },
    { id: 'owasp', label: 'OWASP Top 10', icon: 'ri-bug-line', badge: String(OWASP_VULNERABILITIES.length) },
    { id: 'soc2', label: 'SOC 2 Type II', icon: 'ri-verified-badge-line', badge: String(SOC2_CONTROLS.length) },
    { id: 'secops', label: 'Security Ops', icon: 'ri-radar-line', badge: String(SECURITY_INCIDENTS.length) },
    { id: 'certifications', label: 'Certifications', icon: 'ri-award-line', badge: String(SECURITY_CERTIFICATIONS.length) },
    { id: 'logs', label: 'Logs Live', icon: 'ri-terminal-box-line', badge: String(logs.length) },
  ];

  const filteredLogs = useMemo(() => {
    if (activeTab === 'logs') return logs;
    return logs.filter(l => {
      if (activeTab === 'iso27001') return l.domain === 'ISO 27001';
      if (activeTab === 'owasp') return l.domain === 'OWASP';
      if (activeTab === 'soc2') return l.domain === 'SOC 2';
      if (activeTab === 'secops') return l.domain === 'SecurityOps';
      if (activeTab === 'certifications') return l.domain === 'Certifications';
      return true;
    });
  }, [logs, activeTab]);

  return (
    <KOSHubLayout hubId={1001}>
      <SeoHead
        title="KOS Enterprise Security & Resilience Command™ — ISO 27001 + OWASP + SOC 2 | KHEPRA"
        description="Centre de commandement Sécurité & Résilience KOS. ISO 27001:2022, OWASP Top 10, SOC 2 Type II, Security Operations, Incident Response, Certifications. Triade Gouvernance → Architecture → Sécurité."
        keywords="KOS Security Command, ISO 27001, OWASP Top 10, SOC 2, sécurité, résilience, incident response, KHEPRA EXPERTS"
        canonicalPath="/kos-enterprise-security-resilience"
        ogType="website"
      />

      {/* ============ HERO ============ */}
      <section className="relative bg-foreground-950 overflow-hidden">
        <div className="absolute inset-0">
          <img
            src="https://readdy.ai/api/search-image?query=Abstract%20futuristic%20cybersecurity%20command%20center%20with%20five%20vertical%20luminous%20pillars%20each%20representing%20a%20different%20security%20domain%2C%20interconnected%20shield-shaped%20holographic%20nodes%20in%20deep%20red%20and%20teal%2C%20transparent%20crystalline%20security%20lattice%20protecting%20digital%20core%2C%20dark%20cosmic%20background%20with%20subtle%20binary%20streams%2C%20ultra%20detailed%20cinematic%208K%20render%2C%20high%20tech%20fortress%20sanctuary%20aesthetic%2C%20volumetric%20lighting%20with%20deep%20contrasts%2C%20no%20text%20no%20human%20figures%2C%20sacred%20geometry%20patterns%2C%20dramatic%20red%20amber%20teal%20triad%20color%20scheme&width=1920&height=700&seq=kos-security-resilience-hero&orientation=landscape"
            alt=""
            className="w-full h-full object-cover object-center opacity-25"
            width="1920"
            height="700"
          />
        </div>
        <div className="absolute inset-0 bg-gradient-to-b from-foreground-950/50 via-foreground-950/75 to-foreground-950" />

        <div className="max-w-7xl mx-auto px-4 md:px-6 py-14 md:py-18 relative z-10">
          <div className="text-center max-w-4xl mx-auto">
            <div className="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-red-500/20 border border-red-400/30 backdrop-blur-sm mb-6">
              <span className="w-2 h-2 rounded-full bg-red-400 animate-pulse" />
              <span className="text-sm font-semibold text-red-300 uppercase tracking-wider">
                ENTERPRISE SECURITY & RESILIENCE — ISO 27001 + OWASP + SOC 2
              </span>
            </div>
            <h1 className="font-heading text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6 leading-tight">
              Enterprise Security
              <span className="block text-red-400 mt-2">& Resilience Command™</span>
            </h1>
            <p className="text-lg text-gray-300 leading-relaxed mb-8 max-w-3xl mx-auto">
              Troisième pilier de la triade <strong className="text-white">Gouvernance → Architecture → Sécurité</strong>.{' '}
              <strong className="text-red-300">{SECURITY_RESILIENCE_STATS.iso27001Controls} contrôles</strong> ISO 27001,{' '}
              <strong className="text-amber-300">{SECURITY_RESILIENCE_STATS.owaspVulnerabilities} vulnérabilités</strong> OWASP trackées,{' '}
              <strong className="text-teal-300">{SECURITY_RESILIENCE_STATS.soc2Controls} contrôles</strong> SOC 2,{' '}
              <strong className="text-indigo-300">{SECURITY_RESILIENCE_STATS.incidentsTotal} incidents</strong> gérés.{' '}
              <span className="block mt-2 text-red-400 font-semibold">{SECURITY_RESILIENCE_STATS.securityScore}</span>
            </p>
            <div className="flex flex-wrap justify-center gap-3">
              {[
                { label: 'ISO Compliant', value: `${SECURITY_RESILIENCE_STATS.iso27001Compliant}/${SECURITY_RESILIENCE_STATS.iso27001Controls}`, icon: 'ri-shield-check-line', color: 'emerald' },
                { label: 'OWASP Fixed', value: `${SECURITY_RESILIENCE_STATS.owaspFixed}/${SECURITY_RESILIENCE_STATS.owaspVulnerabilities}`, icon: 'ri-bug-line', color: 'amber' },
                { label: 'SOC 2 Effective', value: `${SECURITY_RESILIENCE_STATS.soc2Effective}/${SECURITY_RESILIENCE_STATS.soc2Controls}`, icon: 'ri-verified-badge-line', color: 'teal' },
                { label: 'Incidents Résolus', value: `${SECURITY_RESILIENCE_STATS.incidentsResolved}/${SECURITY_RESILIENCE_STATS.incidentsTotal}`, icon: 'ri-alert-line', color: 'rose' },
                { label: 'MTTD', value: SECURITY_RESILIENCE_STATS.mttd, icon: 'ri-timer-flash-line', color: 'indigo' },
                { label: 'MTTR', value: SECURITY_RESILIENCE_STATS.mttr, icon: 'ri-heart-pulse-line', color: 'violet' },
              ].map((stat) => (
                <div key={stat.label} className="flex items-center gap-2 px-4 py-2.5 rounded-full bg-white/8 border border-white/10 backdrop-blur-sm">
                  <i className={`${stat.icon} text-${stat.color}-400 text-sm`} />
                  <span className="text-xs text-gray-400">{stat.label}</span>
                  <span className="text-sm font-bold text-white">{stat.value}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      {/* ============ TAB NAVIGATION ============ */}
      <div className="sticky top-0 z-30 bg-background-50 border-b border-background-200/70">
        <div className="max-w-7xl mx-auto px-4 md:px-6">
          <div className="flex gap-1 overflow-x-auto py-3">
            {tabs.map((tab) => (
              <button
                key={tab.id}
                onClick={() => setActiveTab(tab.id)}
                className={`flex items-center gap-2 px-4 py-2.5 rounded-full text-sm font-bold cursor-pointer transition-all whitespace-nowrap ${
                  activeTab === tab.id
                    ? 'bg-foreground-950 text-white'
                    : 'text-foreground-600 hover:bg-background-100 hover:text-foreground-900'
                }`}
              >
                <i className={`${tab.icon} text-base`} />
                {tab.label}
                <span className={`text-[10px] px-1.5 py-0.5 rounded-full ${activeTab === tab.id ? 'bg-white/20' : 'bg-background-200'}`}>
                  {tab.badge}
                </span>
              </button>
            ))}
          </div>
        </div>
      </div>

      <div className="max-w-7xl mx-auto px-4 md:px-6 py-8">

        {/* ============ TAB: ISO 27001 ============ */}
        {activeTab === 'iso27001' && (
          <div className="space-y-6">
            <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
              <div className="rounded-2xl bg-white border border-red-200 p-6">
                <div className="flex items-center gap-3 mb-4">
                  <div className="w-10 h-10 rounded-xl bg-red-50 flex items-center justify-center">
                    <i className="ri-shield-check-line text-red-600 text-lg" />
                  </div>
                  <div>
                    <h3 className="font-heading text-sm font-bold text-foreground-950">ISO/IEC 27001:2022 — SMSI</h3>
                    <p className="text-xs text-foreground-500">Système de Management de la Sécurité de l'Information — Annexes A.5 à A.18</p>
                  </div>
                </div>
                <div className="grid grid-cols-3 gap-2 text-[10px]">
                  <div className="text-center p-2 rounded-lg bg-emerald-50 border border-emerald-100">
                    <span className="block text-lg font-bold text-emerald-700">{ISO27001_CONTROLS.filter(c => c.status === 'compliant').length}</span>
                    <span className="text-emerald-600">Conformes</span>
                  </div>
                  <div className="text-center p-2 rounded-lg bg-amber-50 border border-amber-100">
                    <span className="block text-lg font-bold text-amber-700">{ISO27001_CONTROLS.filter(c => c.status === 'partially_compliant').length}</span>
                    <span className="text-amber-600">Partiels</span>
                  </div>
                  <div className="text-center p-2 rounded-lg bg-red-50 border border-red-100">
                    <span className="block text-lg font-bold text-red-700">{ISO27001_CONTROLS.filter(c => c.status === 'non_compliant').length}</span>
                    <span className="text-red-600">Non Conformes</span>
                  </div>
                </div>
              </div>
              <div className="rounded-2xl bg-foreground-950 p-6 text-white">
                <div className="flex items-center gap-3 mb-4">
                  <div className="w-10 h-10 rounded-xl bg-red-500/20 flex items-center justify-center">
                    <i className="ri-cpu-line text-red-400 text-lg" />
                  </div>
                  <div>
                    <h3 className="font-heading text-sm font-bold">Automatisation ISO 27001</h3>
                    <p className="text-xs text-gray-400">Niveau d'automatisation des contrôles</p>
                  </div>
                </div>
                <div className="grid grid-cols-3 gap-3 text-xs text-center">
                  {[
                    { label: '100% Auto', value: ISO27001_CONTROLS.filter(c => c.automationLevel === 'fully_automated').length, icon: 'ri-cpu-line', color: 'violet' },
                    { label: 'Semi-Auto', value: ISO27001_CONTROLS.filter(c => c.automationLevel === 'semi_automated').length, icon: 'ri-settings-4-line', color: 'teal' },
                    { label: 'Manuel', value: ISO27001_CONTROLS.filter(c => c.automationLevel === 'manual').length, icon: 'ri-user-line', color: 'amber' },
                  ].map((s) => (
                    <div key={s.label} className="p-3 rounded-xl bg-white/8 border border-white/10">
                      <i className={`${s.icon} text-${s.color}-400 text-lg mb-1 block`} />
                      <span className="block text-lg font-bold font-heading">{s.value}</span>
                      <span className="text-[10px] text-gray-400">{s.label}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            {/* Controls grouped by annex */}
            {(['A.5', 'A.8', 'A.9', 'A.10', 'A.12', 'A.13', 'A.14', 'A.16', 'A.17', 'A.18'] as const).map((annex) => {
              const controls = ISO27001_CONTROLS.filter(c => c.annex === annex);
              if (controls.length === 0) return null;
              return (
                <div key={annex}>
                  <h3 className="font-heading text-base font-bold text-foreground-950 mb-3 flex items-center gap-2">
                    <span className="px-2 py-0.5 rounded-md text-xs bg-red-50 text-red-700 border border-red-200">Annexe {annex}</span>
                    <span className="text-xs text-foreground-400 font-normal">{controls.length} contrôles</span>
                  </h3>
                  <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
                    {controls.map((ctrl) => {
                      const isExpanded = expandedItems.has(ctrl.id);
                      const risk = SEVERITY_MAP[ctrl.riskLevel];
                      return (
                        <div key={ctrl.id} className="rounded-xl bg-white border border-background-200/70 overflow-hidden">
                          <div className="p-4">
                            <div className="flex items-start justify-between mb-2">
                              <div className="flex items-center gap-2 flex-1 min-w-0">
                                <span className={`text-[10px] font-mono font-bold px-1.5 py-0.5 rounded ${
                                  ctrl.status === 'compliant' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' :
                                  ctrl.status === 'partially_compliant' ? 'bg-amber-50 text-amber-700 border border-amber-200' :
                                  'bg-red-50 text-red-700 border border-red-200'
                                }`}>{ctrl.controlId}</span>
                                <span className="text-sm font-bold text-foreground-900 truncate">{ctrl.name}</span>
                              </div>
                              <button onClick={() => toggleExpand(ctrl.id)} className="w-6 h-6 rounded-lg bg-background-100 flex items-center justify-center cursor-pointer hover:bg-background-200 transition-colors flex-shrink-0 ml-2">
                                <i className={`ri-${isExpanded ? 'subtract' : 'add'}-line text-foreground-400 text-sm`} />
                              </button>
                            </div>
                            <div className="flex flex-wrap items-center gap-1.5 mb-2">
                              <span className={`text-[10px] px-1.5 py-0.5 rounded-full font-bold ${risk.bgClass}`} style={{ color: risk.hex }}>{risk.label}</span>
                              <span className={`text-[10px] px-1.5 py-0.5 rounded-full ${
                                ctrl.status === 'compliant' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' :
                                ctrl.status === 'partially_compliant' ? 'bg-amber-50 text-amber-700 border border-amber-200' :
                                'bg-red-50 text-red-700 border border-red-200'
                              }`}>
                                {ctrl.status === 'compliant' ? '✓ Conforme' : ctrl.status === 'partially_compliant' ? '⚠ Partiel' : '✗ Non Conforme'}
                              </span>
                              <span className={`text-[10px] px-1.5 py-0.5 rounded-full ${
                                ctrl.automationLevel === 'fully_automated' ? 'bg-violet-50 text-violet-700 border border-violet-200' :
                                ctrl.automationLevel === 'semi_automated' ? 'bg-teal-50 text-teal-700 border border-teal-200' :
                                'bg-gray-50 text-gray-500 border border-gray-200'
                              }`}>
                                {ctrl.automationLevel === 'fully_automated' ? 'Auto' : ctrl.automationLevel === 'semi_automated' ? 'Semi-Auto' : 'Manuel'}
                              </span>
                              {ctrl.edgeFunctionSlug && (
                                <span className="text-[9px] font-mono px-1.5 py-0.5 rounded bg-cyan-50 text-cyan-700 border border-cyan-200">{ctrl.edgeFunctionSlug}</span>
                              )}
                            </div>
                            {isExpanded && (
                              <div className="mt-3 pt-3 border-t border-background-200 space-y-2 text-[10px]">
                                <p className="text-foreground-600">{ctrl.description}</p>
                                <div className="grid grid-cols-2 gap-2">
                                  <div><span className="font-bold text-foreground-500">Preuves</span><span className="text-foreground-600 ml-1">{ctrl.evidenceRefs.join(', ')}</span></div>
                                  <div><span className="font-bold text-foreground-500">Dernier Audit</span><span className="text-foreground-600 ml-1">{new Date(ctrl.lastAudited).toLocaleDateString('fr-FR')}</span></div>
                                </div>
                              </div>
                            )}
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </div>
              );
            })}
          </div>
        )}

        {/* ============ TAB: OWASP TOP 10 ============ */}
        {activeTab === 'owasp' && (
          <div className="space-y-6">
            <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
              <div className="rounded-2xl bg-white border border-amber-200 p-6">
                <div className="flex items-center gap-3 mb-4">
                  <div className="w-10 h-10 rounded-xl bg-amber-50 flex items-center justify-center">
                    <i className="ri-bug-line text-amber-600 text-lg" />
                  </div>
                  <div>
                    <h3 className="font-heading text-sm font-bold text-foreground-950">OWASP Top 10:2021 — Gestion Vulnérabilités</h3>
                    <p className="text-xs text-foreground-500">Scan automatique hebdomadaire + CVE monitoring continu + WAF rules</p>
                  </div>
                </div>
                <div className="grid grid-cols-4 gap-2 text-[10px]">
                  {[
                    { label: 'Critiques', value: OWASP_VULNERABILITIES.filter(v => v.severity === 'critical').length, color: '#DC2626' },
                    { label: 'Hautes', value: OWASP_VULNERABILITIES.filter(v => v.severity === 'high').length, color: '#EA580C' },
                    { label: 'Moyennes', value: OWASP_VULNERABILITIES.filter(v => v.severity === 'medium').length, color: '#9B7B2C' },
                    { label: 'Basses', value: OWASP_VULNERABILITIES.filter(v => v.severity === 'low').length, color: '#86BC25' },
                  ].map((s) => (
                    <div key={s.label} className="text-center p-2 rounded-lg border" style={{ backgroundColor: `${s.color}10`, borderColor: `${s.color}30` }}>
                      <span className="block text-lg font-bold" style={{ color: s.color }}>{s.value}</span>
                      <span className="text-foreground-500">{s.label}</span>
                    </div>
                  ))}
                </div>
              </div>
              <div className="rounded-2xl bg-foreground-950 p-6 text-white">
                <div className="flex items-center gap-3 mb-4">
                  <div className="w-10 h-10 rounded-xl bg-amber-500/20 flex items-center justify-center">
                    <i className="ri-shield-flash-line text-amber-400 text-lg" />
                  </div>
                  <div>
                    <h3 className="font-heading text-sm font-bold">Résumé OWASP</h3>
                    <p className="text-xs text-gray-400">Score global de sécurité applicative</p>
                  </div>
                </div>
                <div className="grid grid-cols-4 gap-3 text-xs text-center">
                  {[
                    { label: 'Résolues', value: OWASP_VULNERABILITIES.filter(v => v.remediationStatus === 'fixed').length, icon: 'ri-check-double-line', color: 'emerald' },
                    { label: 'En Cours', value: OWASP_VULNERABILITIES.filter(v => v.remediationStatus === 'in_progress').length, icon: 'ri-loader-4-line', color: 'amber' },
                    { label: 'Risque Accepté', value: OWASP_VULNERABILITIES.filter(v => v.remediationStatus === 'accepted_risk').length, icon: 'ri-shield-user-line', color: 'indigo' },
                    { label: 'Ouvertes', value: OWASP_VULNERABILITIES.filter(v => v.remediationStatus === 'open').length, icon: 'ri-error-warning-line', color: 'rose' },
                  ].map((s) => (
                    <div key={s.label} className="p-3 rounded-xl bg-white/8 border border-white/10">
                      <i className={`${s.icon} text-${s.color}-400 text-lg mb-1 block`} />
                      <span className="block text-lg font-bold font-heading">{s.value}</span>
                      <span className="text-[10px] text-gray-400">{s.label}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            {OWASP_VULNERABILITIES.map((vuln) => {
              const sev = SEVERITY_MAP[vuln.severity];
              const isExpanded = expandedItems.has(vuln.id);
              return (
                <div key={vuln.id} className="rounded-xl bg-white border border-background-200/70 overflow-hidden">
                  <div className="p-5">
                    <div className="flex items-start justify-between mb-3">
                      <div className="flex items-center gap-3 flex-1 min-w-0">
                        <div className="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0" style={{ backgroundColor: `${sev.hex}15` }}>
                          <span className="text-lg font-bold font-heading" style={{ color: sev.hex }}>{vuln.cvssScore}</span>
                        </div>
                        <div className="min-w-0">
                          <div className="flex items-center gap-2 mb-0.5">
                            <span className="text-xs font-bold text-foreground-900">{vuln.name}</span>
                          </div>
                          <div className="flex flex-wrap items-center gap-1.5">
                            <span className="text-[10px] px-1.5 py-0.5 rounded-full font-bold" style={{ backgroundColor: `${sev.hex}15`, color: sev.hex }}>{sev.label}</span>
                            <span className="text-[10px] font-mono px-1.5 py-0.5 rounded bg-amber-50 text-amber-700 border border-amber-200">{vuln.owaspRef} — {vuln.category}</span>
                            <span className={`text-[10px] px-1.5 py-0.5 rounded-full ${
                              vuln.remediationStatus === 'fixed' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' :
                              vuln.remediationStatus === 'in_progress' ? 'bg-amber-50 text-amber-700 border border-amber-200' :
                              vuln.remediationStatus === 'accepted_risk' ? 'bg-indigo-50 text-indigo-700 border border-indigo-200' :
                              'bg-red-50 text-red-700 border border-red-200'
                            }`}>
                              {vuln.remediationStatus === 'fixed' ? '✓ Corrigé' : vuln.remediationStatus === 'in_progress' ? '⚠ En Cours' : vuln.remediationStatus === 'accepted_risk' ? 'Risque Accepté' : '✗ Ouvert'}
                            </span>
                            {vuln.wafRuleActive && (
                              <span className="text-[9px] px-1.5 py-0.5 rounded bg-violet-50 text-violet-700 border border-violet-200">WAF Actif</span>
                            )}
                          </div>
                        </div>
                      </div>
                      <button onClick={() => toggleExpand(vuln.id)} className="w-6 h-6 rounded-lg bg-background-100 flex items-center justify-center cursor-pointer hover:bg-background-200 transition-colors flex-shrink-0 ml-2">
                        <i className={`ri-${isExpanded ? 'subtract' : 'add'}-line text-foreground-400 text-sm`} />
                      </button>
                    </div>
                    {isExpanded && (
                      <div className="mt-3 pt-3 border-t border-background-200 space-y-2 text-[10px]">
                        <p className="text-foreground-600">{vuln.description}</p>
                        <div className="grid grid-cols-2 sm:grid-cols-3 gap-2">
                          <div><span className="font-bold text-foreground-500">Systèmes</span><span className="text-foreground-600 ml-1">{vuln.affectedSystems.join(', ')}</span></div>
                          <div><span className="font-bold text-foreground-500">Détecté</span><span className="text-foreground-600 ml-1">{new Date(vuln.detectionDate).toLocaleDateString('fr-FR')}</span></div>
                          {vuln.fixedDate && <div><span className="font-bold text-foreground-500">Corrigé</span><span className="text-foreground-600 ml-1">{new Date(vuln.fixedDate).toLocaleDateString('fr-FR')}</span></div>}
                        </div>
                      </div>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        )}

        {/* ============ TAB: SOC 2 TYPE II ============ */}
        {activeTab === 'soc2' && (
          <div className="space-y-6">
            <div className="rounded-2xl bg-white border border-teal-200 p-6">
              <div className="flex items-center gap-3 mb-4">
                <div className="w-10 h-10 rounded-xl bg-teal-50 flex items-center justify-center">
                  <i className="ri-verified-badge-line text-teal-600 text-lg" />
                </div>
                <div>
                  <h3 className="font-heading text-sm font-bold text-foreground-950">SOC 2 Type II — Trust Services Criteria</h3>
                  <p className="text-xs text-foreground-500">AICPA TSC 2017 — Security · Availability · Confidentiality · Processing Integrity · Privacy</p>
                </div>
              </div>
              <div className="flex flex-wrap gap-2">
                {Object.entries(TSC_MAP).map(([key, tsc]) => {
                  const count = SOC2_CONTROLS.filter(c => c.trustServiceCriteria === key).length;
                  return (
                    <div key={key} className="flex items-center gap-2 px-3 py-1.5 rounded-full border text-xs" style={{ backgroundColor: `${tsc.hex}10`, borderColor: `${tsc.hex}30` }}>
                      <i className={`${tsc.icon} text-sm`} style={{ color: tsc.hex }} />
                      <span className="font-bold" style={{ color: tsc.hex }}>{tsc.label}</span>
                      <span className="text-foreground-400">{count}</span>
                    </div>
                  );
                })}
              </div>
            </div>

            {SOC2_CONTROLS.map((ctrl) => {
              const isExpanded = expandedItems.has(ctrl.id);
              const tsc = TSC_MAP[ctrl.trustServiceCriteria];
              return (
                <div key={ctrl.id} className="rounded-xl bg-white border border-background-200/70 overflow-hidden">
                  <div className="p-5">
                    <div className="flex items-start justify-between mb-3">
                      <div className="flex items-center gap-3 flex-1 min-w-0">
                        <div className="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0" style={{ backgroundColor: `${tsc.hex}15` }}>
                          <i className={`${tsc.icon} text-base`} style={{ color: tsc.hex }} />
                        </div>
                        <div className="min-w-0">
                          <span className="text-xs font-bold text-foreground-900 block">{ctrl.controlName}</span>
                          <div className="flex flex-wrap items-center gap-1.5 mt-1">
                            <span className="text-[10px] px-1.5 py-0.5 rounded-full font-bold" style={{ backgroundColor: `${tsc.hex}15`, color: tsc.hex }}>{tsc.label}</span>
                            <span className={`text-[10px] px-1.5 py-0.5 rounded-full ${
                              ctrl.status === 'effective' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' :
                              ctrl.status === 'operating' ? 'bg-teal-50 text-teal-700 border border-teal-200' :
                              ctrl.status === 'designed' ? 'bg-amber-50 text-amber-700 border border-amber-200' :
                              'bg-red-50 text-red-700 border border-red-200'
                            }`}>
                              {ctrl.status === 'effective' ? '✓ Effectif' : ctrl.status === 'operating' ? 'Opérationnel' : ctrl.status === 'designed' ? 'Designé' : '✗ Inefficace'}
                            </span>
                            <span className={`text-[10px] px-1.5 py-0.5 rounded-full ${
                              ctrl.testResult === 'pass' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' :
                              ctrl.testResult === 'pass_with_exceptions' ? 'bg-amber-50 text-amber-700 border border-amber-200' :
                              'bg-red-50 text-red-700 border border-red-200'
                            }`}>
                              Test: {ctrl.testResult === 'pass' ? 'PASS' : ctrl.testResult === 'pass_with_exceptions' ? 'PASS*' : 'FAIL'}
                            </span>
                            <span className="text-[10px] text-foreground-400">Fréq: {ctrl.testFrequency}</span>
                          </div>
                        </div>
                      </div>
                      <button onClick={() => toggleExpand(ctrl.id)} className="w-6 h-6 rounded-lg bg-background-100 flex items-center justify-center cursor-pointer hover:bg-background-200 transition-colors flex-shrink-0 ml-2">
                        <i className={`ri-${isExpanded ? 'subtract' : 'add'}-line text-foreground-400 text-sm`} />
                      </button>
                    </div>
                    <div className="grid grid-cols-3 gap-2 text-[10px]">
                      <div><span className="text-foreground-400 block">Dernier Test</span><span className="font-bold text-foreground-700">{new Date(ctrl.lastTested).toLocaleDateString('fr-FR')}</span></div>
                      <div><span className="text-foreground-400 block">Preuves</span><span className="font-bold text-foreground-700">{ctrl.evidenceCount}</span></div>
                      <div><span className="text-foreground-400 block">Procédure</span><span className="font-bold text-foreground-700 truncate block">{ctrl.testProcedure}</span></div>
                    </div>
                    {isExpanded && (
                      <div className="mt-3 pt-3 border-t border-background-200">
                        <p className="text-[10px] text-foreground-600">{ctrl.description}</p>
                      </div>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        )}

        {/* ============ TAB: SECURITY OPERATIONS ============ */}
        {activeTab === 'secops' && (
          <div className="space-y-6">
            <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
              <div className="rounded-2xl bg-white border border-indigo-200 p-6">
                <div className="flex items-center gap-3 mb-4">
                  <div className="w-10 h-10 rounded-xl bg-indigo-50 flex items-center justify-center">
                    <i className="ri-radar-line text-indigo-600 text-lg" />
                  </div>
                  <div>
                    <h3 className="font-heading text-sm font-bold text-foreground-950">Security Operations Center</h3>
                    <p className="text-xs text-foreground-500">Incident Response · Monitoring · Threat Detection · Resilience</p>
                  </div>
                </div>
                <div className="grid grid-cols-3 gap-2 text-[10px] text-center">
                  {[
                    { label: 'MTTD', value: SECURITY_RESILIENCE_STATS.mttd, color: '#6366F1', desc: 'Détection' },
                    { label: 'MTTR', value: SECURITY_RESILIENCE_STATS.mttr, color: '#0D9488', desc: 'Résolution' },
                    { label: 'Uptime', value: '99.97%', color: '#86BC25', desc: '30 jours' },
                  ].map((s) => (
                    <div key={s.label} className="p-3 rounded-xl border" style={{ backgroundColor: `${s.color}10`, borderColor: `${s.color}30` }}>
                      <span className="block text-xl font-bold font-heading" style={{ color: s.color }}>{s.value}</span>
                      <span className="text-foreground-500">{s.label}</span>
                      <span className="block text-[9px] text-foreground-400">{s.desc}</span>
                    </div>
                  ))}
                </div>
              </div>
              <div className="rounded-2xl bg-foreground-950 p-6 text-white">
                <div className="flex items-center gap-3 mb-4">
                  <div className="w-10 h-10 rounded-xl bg-rose-500/20 flex items-center justify-center">
                    <i className="ri-alert-line text-rose-400 text-lg" />
                  </div>
                  <div>
                    <h3 className="font-heading text-sm font-bold">Incidents par Sévérité</h3>
                    <p className="text-xs text-gray-400">{SECURITY_INCIDENTS.length} incidents documentés</p>
                  </div>
                </div>
                <div className="grid grid-cols-4 gap-3 text-xs text-center">
                  {[
                    { label: 'Critiques', value: SECURITY_INCIDENTS.filter(i => i.severity === 'critical').length, color: 'rose' },
                    { label: 'Hautes', value: SECURITY_INCIDENTS.filter(i => i.severity === 'high').length, color: 'orange' },
                    { label: 'Moyennes', value: SECURITY_INCIDENTS.filter(i => i.severity === 'medium').length, color: 'amber' },
                    { label: 'Basses', value: SECURITY_INCIDENTS.filter(i => i.severity === 'low').length, color: 'emerald' },
                  ].map((s) => (
                    <div key={s.label} className="p-3 rounded-xl bg-white/8 border border-white/10">
                      <span className={`block text-lg font-bold font-heading text-${s.color}-400`}>{s.value}</span>
                      <span className="text-[10px] text-gray-400">{s.label}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            {SECURITY_INCIDENTS.map((incident) => {
              const sev = SEVERITY_MAP[incident.severity];
              const isExpanded = expandedItems.has(incident.id);
              return (
                <div key={incident.id} className="rounded-xl bg-white border border-background-200/70 overflow-hidden">
                  <div className="p-5">
                    <div className="flex items-start justify-between mb-3">
                      <div className="flex items-center gap-3 flex-1 min-w-0">
                        <div className="w-10 h-10 rounded-lg flex items-center justify-center flex-shrink-0" style={{ backgroundColor: `${sev.hex}15` }}>
                          <i className={`${
                            incident.type === 'ddos' ? 'ri-flood-line' :
                            incident.type === 'intrusion' ? 'ri-shield-user-line' :
                            incident.type === 'data_leak' ? 'ri-file-warning-line' :
                            incident.type === 'misconfiguration' ? 'ri-tools-line' :
                            incident.type === 'phishing' ? 'ri-mail-close-line' :
                            incident.type === 'malware' ? 'ri-virus-line' :
                            'ri-alert-line'
                          } text-base`} style={{ color: sev.hex }} />
                        </div>
                        <div className="min-w-0">
                          <span className="text-sm font-bold text-foreground-900 block">{incident.title}</span>
                          <div className="flex flex-wrap items-center gap-1.5 mt-1">
                            <span className="text-[10px] px-1.5 py-0.5 rounded-full font-bold" style={{ backgroundColor: `${sev.hex}15`, color: sev.hex }}>{sev.label}</span>
                            <span className="text-[10px] px-1.5 py-0.5 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200 capitalize">{incident.type.replace('_', ' ')}</span>
                            <span className={`text-[10px] px-1.5 py-0.5 rounded-full ${
                              incident.status === 'resolved' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' :
                              incident.status === 'contained' ? 'bg-teal-50 text-teal-700 border border-teal-200' :
                              incident.status === 'investigating' ? 'bg-amber-50 text-amber-700 border border-amber-200' :
                              'bg-red-50 text-red-700 border border-red-200'
                            }`}>
                              {incident.status === 'resolved' ? '✓ Résolu' : incident.status === 'contained' ? 'Contenu' : incident.status === 'investigating' ? 'Investigation' : 'Ouvert'}
                            </span>
                          </div>
                        </div>
                      </div>
                      <button onClick={() => toggleExpand(incident.id)} className="w-6 h-6 rounded-lg bg-background-100 flex items-center justify-center cursor-pointer hover:bg-background-200 transition-colors flex-shrink-0 ml-2">
                        <i className={`ri-${isExpanded ? 'subtract' : 'add'}-line text-foreground-400 text-sm`} />
                      </button>
                    </div>
                    <div className="grid grid-cols-2 sm:grid-cols-4 gap-2 text-[10px]">
                      <div><span className="text-foreground-400 block">Détecté</span><span className="font-bold text-foreground-700">{new Date(incident.detectedAt).toLocaleString('fr-FR', { dateStyle: 'short', timeStyle: 'short' })}</span></div>
                      <div><span className="text-foreground-400 block">TTD</span><span className="font-bold text-indigo-600">{incident.timeToDetect}</span></div>
                      <div><span className="text-foreground-400 block">TTR</span><span className="font-bold text-teal-600">{incident.timeToResolve}</span></div>
                      {incident.resolvedAt && <div><span className="text-foreground-400 block">Résolu</span><span className="font-bold text-foreground-700">{new Date(incident.resolvedAt).toLocaleString('fr-FR', { dateStyle: 'short', timeStyle: 'short' })}</span></div>}
                    </div>
                    {isExpanded && (
                      <div className="mt-3 pt-3 border-t border-background-200 space-y-2 text-[10px]">
                        <p className="text-foreground-600">{incident.description}</p>
                        <div className="grid grid-cols-1 sm:grid-cols-2 gap-2">
                          <div className="p-2 rounded-lg bg-red-50 border border-red-100">
                            <span className="font-bold text-red-700 block mb-0.5">Cause Racine</span>
                            <span className="text-red-600">{incident.rootCause}</span>
                          </div>
                          <div className="p-2 rounded-lg bg-emerald-50 border border-emerald-100">
                            <span className="font-bold text-emerald-700 block mb-0.5">Leçons Apprises</span>
                            <span className="text-emerald-600">{incident.lessonsLearned}</span>
                          </div>
                        </div>
                      </div>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        )}

        {/* ============ TAB: CERTIFICATIONS ============ */}
        {activeTab === 'certifications' && (
          <div className="space-y-6">
            <div className="rounded-2xl bg-foreground-950 p-6 text-white">
              <div className="flex items-center gap-3 mb-4">
                <div className="w-10 h-10 rounded-xl bg-red-500/20 flex items-center justify-center">
                  <i className="ri-award-line text-red-400 text-lg" />
                </div>
                <div>
                  <h3 className="font-heading text-sm font-bold">Parcours de Certification — Roadmap 2026-2027</h3>
                  <p className="text-xs text-gray-400">{SECURITY_CERTIFICATIONS.length} certifications ciblées — {SECURITY_CERTIFICATIONS.filter(c => c.status === 'in_progress').length} en cours</p>
                </div>
              </div>
            </div>

            {SECURITY_CERTIFICATIONS.map((cert) => {
              const isExpanded = expandedItems.has(cert.id);
              return (
                <div key={cert.id} className="rounded-xl bg-white border border-background-200/70 overflow-hidden">
                  <div className="p-5">
                    <div className="flex items-start justify-between mb-3">
                      <div className="flex items-center gap-3 flex-1 min-w-0">
                        <div className="w-12 h-12 rounded-xl bg-red-50 flex items-center justify-center flex-shrink-0">
                          <i className="ri-award-line text-red-600 text-xl" />
                        </div>
                        <div className="min-w-0 flex-1">
                          <span className="text-sm font-bold text-foreground-900 block">{cert.name}</span>
                          <span className="text-xs text-foreground-500">{cert.standard}</span>
                          <div className="flex flex-wrap items-center gap-1.5 mt-1">
                            <span className={`text-[10px] px-1.5 py-0.5 rounded-full font-bold ${
                              cert.status === 'certified' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' :
                              cert.status === 'in_progress' ? 'bg-amber-50 text-amber-700 border border-amber-200' :
                              cert.status === 'renewal_due' ? 'bg-orange-50 text-orange-700 border border-orange-200' :
                              'bg-gray-50 text-gray-500 border border-gray-200'
                            }`}>
                              {cert.status === 'certified' ? '✓ Certifié' : cert.status === 'in_progress' ? '⚠ En Cours' : cert.status === 'renewal_due' ? 'Renouvellement' : 'Planifié'}
                            </span>
                            <span className="text-[10px] text-foreground-400">{cert.certificationBody}</span>
                          </div>
                        </div>
                      </div>
                      <button onClick={() => toggleExpand(cert.id)} className="w-6 h-6 rounded-lg bg-background-100 flex items-center justify-center cursor-pointer hover:bg-background-200 transition-colors flex-shrink-0 ml-2">
                        <i className={`ri-${isExpanded ? 'subtract' : 'add'}-line text-foreground-400 text-sm`} />
                      </button>
                    </div>

                    {/* Progress bar */}
                    <div className="mb-3">
                      <div className="flex items-center justify-between text-[10px] mb-1">
                        <span className="font-bold text-foreground-600">Progression</span>
                        <span className="font-bold text-red-600">{cert.progress}%</span>
                      </div>
                      <div className="h-2 rounded-full bg-background-100 overflow-hidden">
                        <div className="h-full rounded-full transition-all" style={{ width: `${cert.progress}%`, backgroundColor: cert.progress >= 80 ? '#86BC25' : cert.progress >= 50 ? '#EA580C' : '#DC2626' }} />
                      </div>
                    </div>

                    <div className="grid grid-cols-3 gap-2 text-[10px]">
                      <div><span className="text-foreground-400 block">Preuves</span><span className="font-bold text-foreground-700">{cert.evidenceCount}</span></div>
                      <div><span className="text-foreground-400 block">Findings</span><span className={`font-bold ${cert.outstandingFindings > 0 ? 'text-red-600' : 'text-emerald-600'}`}>{cert.outstandingFindings}</span></div>
                      <div><span className="text-foreground-400 block">Validité</span><span className="font-bold text-foreground-700">{cert.validUntil === '—' ? 'N/A' : new Date(cert.validUntil).toLocaleDateString('fr-FR')}</span></div>
                    </div>

                    {isExpanded && (
                      <div className="mt-3 pt-3 border-t border-background-200">
                        <p className="text-[10px] text-foreground-600"><strong className="text-foreground-700">Scope: </strong>{cert.scope}</p>
                      </div>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        )}

        {/* ============ LOGS LIVE ============ */}
        {(activeTab === 'logs' || filteredLogs.length > 0) && (
          <div className={activeTab === 'logs' ? '' : 'mt-6'}>
            <div className="rounded-2xl bg-foreground-950 border border-gray-800 overflow-hidden">
              <div className="flex items-center gap-3 p-4 border-b border-gray-800">
                <div className="flex items-center gap-1.5">
                  <span className="w-2.5 h-2.5 rounded-full bg-red-500" />
                  <span className="w-2.5 h-2.5 rounded-full bg-amber-500" />
                  <span className="w-2.5 h-2.5 rounded-full bg-emerald-500" />
                </div>
                <span className="text-xs text-gray-400 font-mono">KOS Enterprise Security & Resilience — Execution Log</span>
                <span className="text-[10px] text-gray-500 ml-auto">{filteredLogs.length} entrées</span>
              </div>
              <div className="p-4 font-mono text-xs max-h-[400px] overflow-y-auto">
                <div className="space-y-1">
                  {filteredLogs.map((log, i) => (
                    <div key={i} className={`${
                      log.status === 'success' ? 'text-emerald-400' :
                      log.status === 'warning' ? 'text-amber-400' :
                      log.status === 'error' ? 'text-red-400' :
                      'text-cyan-400'
                    }`}>
                      <span className="text-gray-600">[{log.timestamp.slice(11, 19)}]</span>{' '}
                      <span className="text-red-400">[{log.domain}]</span>{' '}
                      {log.edgeFunction && <span className="text-teal-500">[{log.edgeFunction}]</span>}{' '}
                      <span>{log.status === 'success' ? '✓' : log.status === 'warning' ? '⚠' : log.status === 'error' ? '✗' : 'ℹ'}</span>{' '}
                      <span>{log.detail}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        )}

      </div>

      {/* ============ CROSS-LINKS ============ */}
      <section className="py-12 bg-white border-t border-background-200">
        <div className="max-w-7xl mx-auto px-4 md:px-6">
          <div className="text-center mb-8">
            <h2 className="font-heading text-2xl md:text-3xl font-bold text-foreground-950 mb-2">
              Triade Gouvernance → Architecture → Sécurité
            </h2>
            <p className="text-foreground-600">Les trois piliers du système de management intégré KOS.</p>
          </div>
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
            {[
              { label: 'CDO Innovation Command', path: '/kos-cdo-innovation-command', icon: 'ri-cpu-line', color: '#0D9488' },
              { label: 'Chief Agentic Architect', path: '/kos-chief-agentic-architect', icon: 'ri-brain-line', color: '#7C3AED' },
              { label: 'AI Sovereignty & Ethics', path: '/kos-ai-sovereignty-ethics', icon: 'ri-shield-star-line', color: '#6366F1' },
              { label: 'Security Dashboard', path: '/kos-security-dashboard', icon: 'ri-shield-line', color: '#DC2626' },
              { label: 'ISO 27001 Audit Report', path: '/kos-iso-27001-audit-report', icon: 'ri-file-search-line', color: '#EA580C' },
            ].map((link) => (
              <a
                key={link.path}
                href={link.path}
                className="rounded-xl border border-background-200 bg-background-50 p-4 text-center hover:shadow-md hover:border-foreground-200 transition-all cursor-pointer block"
              >
                <div className="w-10 h-10 mx-auto mb-2 rounded-xl flex items-center justify-center" style={{ backgroundColor: `${link.color}15` }}>
                  <i className={`${link.icon} text-lg`} style={{ color: link.color }} />
                </div>
                <span className="text-sm font-bold text-foreground-800">{link.label}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    </KOSHubLayout>
  );
}
