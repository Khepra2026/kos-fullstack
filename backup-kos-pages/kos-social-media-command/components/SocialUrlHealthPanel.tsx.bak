import { useSocialUrlCorrection } from '@/hooks/useSocialUrlCorrection';
import { LINKEDIN_COMPANY_PAGE, LINKEDIN_ADMIN_POSTS } from '@/hooks/useLinkedInShare';
import type { SocialQueueItem } from '@/mocks/socialAutomationQueue';

interface SocialUrlHealthPanelProps {
  queue: SocialQueueItem[];
}

function getStatusBadge(status: string) {
  const map: Record<string, { bg: string; text: string; icon: string }> = {
    healthy: { bg: 'bg-emerald-50', text: 'text-emerald-700', icon: 'ri-check-line' },
    warning: { bg: 'bg-amber-50', text: 'text-amber-700', icon: 'ri-alert-line' },
    broken: { bg: 'bg-red-50', text: 'text-red-700', icon: 'ri-close-circle-line' },
    missing_og: { bg: 'bg-orange-50', text: 'text-orange-700', icon: 'ri-file-warning-line' },
  };
  return map[status] || { bg: 'bg-gray-50', text: 'text-gray-500', icon: 'ri-question-line' };
}

function getIssueLabel(issueType: string): string {
  const map: Record<string, string> = {
    missing_og_tags: 'Preview OG manquante',
    broken_link: 'Lien cassé',
    wrong_domain: 'Domaine incorrect',
    no_og_image: 'Image OG absente',
    spa_direct_link: 'URL SPA directe',
    none: 'OK',
  };
  return map[issueType] || issueType;
}

function ReportRow({ report }: { report: UrlHealthReport }) {
  const badge = getStatusBadge(report.status);
  const shortUrl = report.url.replace('https://khepraexperts.com', '').substring(0, 60);

  return (
    <div className="flex items-start gap-3 p-3 rounded-xl border border-background-200 bg-white hover:bg-background-50 transition-colors">
      <div className={`w-7 h-7 rounded-lg flex items-center justify-center flex-shrink-0 ${badge.bg} ${badge.text}`}>
        <i className={`${badge.icon} text-sm`} />
      </div>
      <div className="flex-1 min-w-0">
        <div className="flex items-center gap-2 flex-wrap">
          <code className="text-xs font-mono text-foreground-700 truncate">{shortUrl}</code>
          <span className={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold ${badge.bg} ${badge.text}`}>
            {getIssueLabel(report.issue_type)}
          </span>
          <span className={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold ${
            report.severity === 'critical' ? 'bg-red-100 text-red-700' :
            report.severity === 'high' ? 'bg-amber-100 text-amber-700' :
            report.severity === 'medium' ? 'bg-orange-50 text-orange-600' :
            'bg-gray-50 text-gray-500'
          }`}>
            {report.severity}
          </span>
        </div>
        <p className="text-xs text-foreground-500 mt-1">{report.suggestion}</p>
        {report.corrected_url && (
          <p className="text-xs text-emerald-600 mt-1">
            <i className="ri-arrow-right-line mr-1" />
            Corrigé : {report.corrected_url.replace('https://khepraexperts.com', '')}
          </p>
        )}
      </div>
      {report.og_preview_supported && (
        <div className="w-5 h-5 rounded-full bg-emerald-50 flex items-center justify-center flex-shrink-0" title="OG Preview supportée">
          <i className="ri-check-line text-emerald-500 text-xs" />
        </div>
      )}
    </div>
  );
}

export default function SocialUrlHealthPanel({ queue }: SocialUrlHealthPanelProps) {
  const [kosData, setKosData] = useState<any>(null);
  useEffect(() => {
    fetch('/mocks/kos-blog.json').then(r => r.json()).then(setKosData);
  }, []);
  if (!kosData) return null;

  const { scan, healthScore, criticalIssues, ogGaps, loading, error, runScan, autoFixes } = useSocialUrlCorrection(queue);

  return (
    <section className="py-8">
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        {/* Header */}
        <div className="flex items-center justify-between mb-6">
          <div className="flex items-center gap-3">
            <div className="w-10 h-10 rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center">
              <i className="ri-shield-check-line text-white text-lg" />
            </div>
            <div>
              <h2 className="font-heading text-xl font-bold text-foreground-950">Santé des URLs Sociales — Correction Automatique</h2>
              <p className="text-sm text-foreground-500">Scan automatique des source_url de la file d'attente</p>
            </div>
          </div>
          <button
            onClick={runScan}
            disabled={loading}
            className="flex items-center gap-2 px-4 py-2 rounded-full bg-foreground-950 text-white text-sm font-bold hover:bg-foreground-800 transition-colors cursor-pointer whitespace-nowrap disabled:opacity-50"
          >
            <i className={`${loading ? 'ri-loader-2-line animate-spin' : 'ri-refresh-line'} text-sm`} />
            {loading ? 'Scan en cours...' : 'Relancer le scan'}
          </button>
        </div>

        {/* Error */}
        {error && (
          <div className="mb-4 p-4 rounded-xl bg-red-50 border border-red-200 flex items-start gap-3">
            <div className="w-7 h-7 rounded-lg bg-red-100 flex items-center justify-center flex-shrink-0 mt-0.5">
              <i className="ri-error-warning-line text-red-600 text-sm" />
            </div>
            <p className="text-sm text-red-700">{error}</p>
          </div>
        )}

        {scan && (
          <>
            {/* Stats Cards */}
            <div className="grid grid-cols-2 md:grid-cols-5 gap-4 mb-6">
              <div className="rounded-xl bg-white border border-background-200 p-4">
                <div className="flex items-center justify-between">
                  <span className="text-xs text-foreground-400">Score Global</span>
                  <span className={`text-lg font-bold font-heading ${
                    healthScore >= 90 ? 'text-emerald-600' :
                    healthScore >= 70 ? 'text-amber-600' :
                    'text-red-600'
                  }`}>{healthScore}%</span>
                </div>
                <div className="w-full h-2 rounded-full bg-background-200 mt-2">
                  <div className={`h-full rounded-full transition-all ${
                    healthScore >= 90 ? 'bg-emerald-500' :
                    healthScore >= 70 ? 'bg-amber-500' :
                    'bg-red-500'
                  }`} style={{ width: `${healthScore}%` }} />
                </div>
              </div>

              <div className="rounded-xl bg-white border border-emerald-200 p-4">
                <div className="flex items-center gap-2">
                  <div className="w-8 h-8 rounded-lg bg-emerald-50 flex items-center justify-center">
                    <i className="ri-check-line text-emerald-600 text-sm" />
                  </div>
                  <div>
                    <span className="text-xs text-foreground-400">Saines</span>
                    <span className="block text-lg font-bold font-heading text-emerald-600">{scan.healthy}</span>
                  </div>
                </div>
              </div>

              <div className="rounded-xl bg-white border border-amber-200 p-4">
                <div className="flex items-center gap-2">
                  <div className="w-8 h-8 rounded-lg bg-amber-50 flex items-center justify-center">
                    <i className="ri-alert-line text-amber-600 text-sm" />
                  </div>
                  <div>
                    <span className="text-xs text-foreground-400">Avertissements</span>
                    <span className="block text-lg font-bold font-heading text-amber-600">{scan.warnings}</span>
                  </div>
                </div>
              </div>

              <div className="rounded-xl bg-white border border-red-200 p-4">
                <div className="flex items-center gap-2">
                  <div className="w-8 h-8 rounded-lg bg-red-50 flex items-center justify-center">
                    <i className="ri-close-circle-line text-red-600 text-sm" />
                  </div>
                  <div>
                    <span className="text-xs text-foreground-400">Cassées</span>
                    <span className="block text-lg font-bold font-heading text-red-600">{scan.broken}</span>
                  </div>
                </div>
              </div>

              <div className="rounded-xl bg-white border border-orange-200 p-4">
                <div className="flex items-center gap-2">
                  <div className="w-8 h-8 rounded-lg bg-orange-50 flex items-center justify-center">
                    <i className="ri-file-warning-line text-orange-600 text-sm" />
                  </div>
                  <div>
                    <span className="text-xs text-foreground-400">OG Manquante</span>
                    <span className="block text-lg font-bold font-heading text-orange-600">{scan.missing_og}</span>
                  </div>
                </div>
              </div>
            </div>

            {/* Auto-Fixes */}
            {autoFixes.length > 0 && (
              <div className="mb-6 p-4 rounded-xl bg-emerald-50 border border-emerald-200">
                <div className="flex items-center gap-2 mb-3">
                  <i className="ri-magic-line text-emerald-600 text-sm" />
                  <span className="text-sm font-bold text-emerald-700">
                    {autoFixes.length} correction(s) automatique(s) appliquée(s)
                  </span>
                </div>
                <div className="space-y-2">
                  {autoFixes.map((fix, i) => (
                    <div key={i} className="flex items-center gap-2 text-xs">
                      <i className="ri-arrow-right-line text-emerald-500" />
                      <code className="text-red-500 bg-red-50 px-1.5 py-0.5 rounded font-mono">{fix.original_url}</code>
                      <span className="text-foreground-400">→</span>
                      <code className="text-emerald-600 bg-emerald-50 px-1.5 py-0.5 rounded font-mono">{fix.corrected_url}</code>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* Critical Issues */}
            {criticalIssues.length > 0 && (
              <div className="mb-6">
                <div className="flex items-center gap-2 mb-3">
                  <i className="ri-error-warning-line text-red-600 text-sm" />
                  <h3 className="text-sm font-bold text-red-700">Problèmes Critiques ({criticalIssues.length})</h3>
                </div>
                <div className="space-y-2">
                  {criticalIssues.map((report, i) => (
                    <ReportRow key={`critical-${i}`} report={report} />
                  ))}
                </div>
              </div>
            )}

            {/* OG Gaps */}
            {ogGaps.length > 0 && (
              <div className="mb-6">
                <div className="flex items-center gap-2 mb-3">
                  <i className="ri-file-warning-line text-orange-600 text-sm" />
                  <h3 className="text-sm font-bold text-orange-700">Pages sans Preview OG ({ogGaps.length})</h3>
                  <span className="text-xs text-foreground-400">— À ajouter dans og-social-preview</span>
                </div>
                <div className="space-y-2">
                  {ogGaps.map((report, i) => (
                    <ReportRow key={`oggap-${i}`} report={report} />
                  ))}
                </div>
              </div>
            )}

            {/* Full Report */}
            <details className="group">
              <summary className="flex items-center gap-2 text-sm font-bold text-foreground-500 hover:text-foreground-700 cursor-pointer mb-3">
                <i className="ri-list-check text-sm" />
                Rapport complet ({scan.total_urls} URLs)
                <i className="ri-arrow-down-s-line group-open:rotate-180 transition-transform" />
              </summary>
              <div className="space-y-1.5 max-h-[400px] overflow-y-auto">
                {scan.reports.map((report, i) => (
                  <ReportRow key={`full-${i}`} report={report} />
                ))}
              </div>
            </details>
          </>
        )}

        {!scan && loading && (
          <div className="text-center py-12">
            <div className="w-10 h-10 rounded-full border-2 border-emerald-500 border-t-transparent animate-spin mx-auto mb-4" />
            <p className="text-sm text-foreground-500">Scan des URLs en cours...</p>
          </div>
        )}

        {!scan && !loading && (
          <div className="text-center py-8 bg-background-50 rounded-2xl">
            <div className="w-12 h-12 rounded-xl bg-background-200 flex items-center justify-center mx-auto mb-3">
              <i className="ri-link text-foreground-400 text-xl" />
            </div>
            <p className="text-sm text-foreground-500">Aucune donnée de scan disponible</p>
          </div>
        )}

        {/* Rattachement Page Entreprise LinkedIn */}
        <div className="mt-8 p-4 rounded-2xl bg-gradient-to-r from-[#0A66C2]/5 to-[#0A66C2]/10 border border-[#0A66C2]/15">
          <div className="flex items-center gap-3 mb-3">
            <div className="w-8 h-8 rounded-lg bg-[#0A66C2] flex items-center justify-center">
              <i className="ri-linkedin-fill text-white text-sm" />
            </div>
            <div>
              <span className="text-sm font-bold text-foreground-950">Page Entreprise Rattachee</span>
              <p className="text-xs text-foreground-500">Tous les partages LinkedIn utilisent les URLs de cette page</p>
            </div>
          </div>
          <div className="flex flex-wrap gap-2">
            <a
              href={LINKEDIN_COMPANY_PAGE}
              target="_blank"
              rel="noopener noreferrer"
              className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-[#0A66C2] text-white text-xs font-bold hover:bg-[#004182] transition-colors cursor-pointer whitespace-nowrap"
            >
              <i className="ri-building-line text-sm" />
              Page Entreprise
            </a>
            <a
              href={LINKEDIN_ADMIN_POSTS}
              target="_blank"
              rel="noopener noreferrer"
              className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white border border-[#0A66C2]/20 text-[#0A66C2] text-xs font-bold hover:bg-[#0A66C2]/5 transition-colors cursor-pointer whitespace-nowrap"
            >
              <i className="ri-file-list-3-line text-sm" />
              kosData.Posts Publiés
            </a>
          </div>
        </div>
      </div>
    </section>
  );
}
