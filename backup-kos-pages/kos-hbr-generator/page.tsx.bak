import { useState } from 'react';
import KOSHubLayout from '@/components/feature/KOSHubLayout';
import {
  HBR_REPORT_TYPES, HBR_SAMPLE_REPORTS, HBR_PIPELINE,
  HBR_FRAMEWORKS_PROPRIETARY, HBR_KPI_TARGETS, HBR_MASTER_PROMPT_PREVIEW,
} from '@/mocks/kosHBRGenerator';

type Tab = 'pipeline' | 'rapports' | 'frameworks' | 'master_prompt' | 'kpis';

const TABS: { id: Tab; label: string; icon: string }[] = [
  { id: 'pipeline', label: 'Pipeline HBR', icon: 'ri-database-line' },
  { id: 'rapports', label: '3 Rapports Live', icon: 'ri-article-line' },
  { id: 'frameworks', label: 'Frameworks Propriétaires', icon: 'ri-award-line' },
  { id: 'master_prompt', label: 'Master Prompt P4', icon: 'ri-code-box-line' },
  { id: 'kpis', label: 'KPIs', icon: 'ri-bar-chart-grouped-line' },
];

function StatutBadge({ statut }: { statut: string }) {
  const map: Record<string, string> = {
    published: 'bg-emerald-100 text-emerald-700',
    in_review: 'bg-amber-100 text-amber-700',
    draft: 'bg-background-200 text-foreground-500',
    planned: 'bg-primary-50 text-primary-600',
  };
  return (
    <span className={`px-2 py-0.5 rounded-full text-[10px] font-semibold font-body ${map[statut] ?? 'bg-background-200 text-foreground-500'}`}>
      {statut}
    </span>
  );
}

export default function KosHbrGeneratorPage() {
  const [kosData, setKosData] = useState<any>(null);
  useEffect(() => {
    fetch('/mocks/kos-blog.json').then(r => r.json()).then(setKosData);
  }, []);
  if (!kosData) return null;

  const [activeTab, setActiveTab] = useState<Tab>('pipeline');
  const [selectedReport, setSelectedReport] = useState(HBR_SAMPLE_REPORTS[0]);

  return (
    <KOSHubLayout hubId={124}>
      <div>
        {/* Hero */}
        <div className="bg-background-100 border-b border-background-200/70 px-4 md:px-6 py-8">
          <div className="max-w-5xl mx-auto">
            <div className="flex items-start gap-4 mb-4">
              <div className="w-14 h-14 flex items-center justify-center rounded-xl bg-accent-100 flex-shrink-0">
                <i className="ri-book-open-line text-2xl text-accent-600"></i>
              </div>
              <div>
                <div className="flex items-center gap-2 flex-wrap mb-1">
                  <span className="px-2.5 py-1 rounded-full text-xs font-semibold bg-accent-100 text-accent-700 font-body">P4 — HBR Generator</span>
                  <span className="px-2.5 py-1 rounded-full text-xs font-semibold bg-amber-100 text-amber-700 font-body">Gap P8 — Think Tank</span>
                  <span className="px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-700 font-body">{HBR_PIPELINE.published} publiés</span>
                </div>
                <h1 className="text-2xl md:text-3xl font-bold text-foreground-950 font-heading">
                  KOS HBR Generator™ — Rapport Niveau Harvard Business Review
                </h1>
                <p className="text-sm text-foreground-600 font-body mt-1 max-w-2xl">
                  Transformer KOS en Think Tank Big Four. 1 rapport HBR/semaine, 9 frameworks propriétaires, 
                  indice fiabilité ≥95/100. Cité par Jeune Afrique/Financial Afrik J+90. 
                  {HBR_PIPELINE.downloads_total.toLocaleString()} téléchargements, {HBR_PIPELINE.leads_generated} leads générés.
                </p>
              </div>
            </div>

            <div className="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-7 gap-3 mt-4 pt-4 border-t border-background-200/70">
              {[
                { v: HBR_PIPELINE.published, l: 'Publiés' },
                { v: HBR_PIPELINE.in_review, l: 'En Revue' },
                { v: `${HBR_PIPELINE.avg_score_qualite}/10`, l: 'Score Qualité' },
                { v: `${HBR_PIPELINE.avg_indice_fiabilite}/100`, l: 'Indice KOS' },
                { v: HBR_PIPELINE.downloads_total.toLocaleString(), l: 'Téléchargements' },
                { v: HBR_PIPELINE.leads_generated, l: 'Leads Générés' },
                { v: HBR_FRAMEWORKS_PROPRIETARY.length, l: 'Frameworks™' },
              ].map(s => (
                <div key={s.l} className="text-center">
                  <div className="text-lg font-bold text-foreground-950 font-heading">{s.v}</div>
                  <div className="text-[10px] text-foreground-500 font-body">{s.l}</div>
                </div>
              ))}
            </div>
          </div>
        </div>

        {/* Tabs */}
        <div className="border-b border-background-200/70 bg-background-50 px-4 md:px-6">
          <div className="max-w-5xl mx-auto overflow-x-auto">
            <div className="flex gap-1 py-2 min-w-max">
              {TABS.map(tab => (
                <button
                  key={tab.id}
                  onClick={() => setActiveTab(tab.id)}
                  className={`flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-body transition-all cursor-pointer whitespace-nowrap ${
                    activeTab === tab.id
                      ? 'bg-accent-100 text-accent-700 font-semibold'
                      : 'text-foreground-500 hover:text-foreground-700 hover:bg-background-200'
                  }`}
                >
                  <i className={`${tab.icon} text-sm`}></i>
                  {tab.label}
                </button>
              ))}
            </div>
          </div>
        </div>

        {/* kosData.Content */}
        <div className="max-w-5xl mx-auto px-4 md:px-6 py-8">

          {activeTab === 'pipeline' && (
            <div className="space-y-6">
              {/* Types de rapport */}
              <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
                {HBR_REPORT_TYPES.map(type => (
                  <div key={type.id} className="bg-background-50 rounded-lg border border-background-200/70 p-4 text-center">
                    <div className="w-10 h-10 mx-auto mb-2 flex items-center justify-center rounded-lg bg-accent-100">
                      <i className={`${type.icon} text-lg text-accent-600`}></i>
                    </div>
                    <div className="text-sm font-bold text-foreground-800 font-heading">{type.label}</div>
                    <div className="text-xs text-foreground-400 font-body">{type.pages} pages</div>
                    <div className="text-xs text-foreground-400 font-body">{type.words} mots</div>
                  </div>
                ))}
              </div>

              {/* Pipeline Stats */}
              <div className="bg-background-100 rounded-xl p-5 border border-background-200/70">
                <h3 className="text-sm font-bold text-foreground-800 mb-4 font-heading">Pipeline Global</h3>
                <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
                  {[
                    { label: 'Publiés', value: HBR_PIPELINE.published, color: 'text-emerald-600' },
                    { label: 'En Revue', value: HBR_PIPELINE.in_review, color: 'text-amber-600' },
                    { label: 'Brouillons', value: HBR_PIPELINE.drafts, color: 'text-foreground-600' },
                    { label: 'Planifiés', value: HBR_PIPELINE.planned, color: 'text-primary-600' },
                  ].map(s => (
                    <div key={s.label} className="text-center">
                      <div className={`text-3xl font-bold font-heading ${s.color}`}>{s.value}</div>
                      <div className="text-xs text-foreground-500 font-body">{s.label}</div>
                    </div>
                  ))}
                </div>
              </div>

              {/* Mentions externes */}
              <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
                {[
                  { label: 'Citations Jeune Afrique', value: HBR_PIPELINE.citations_jeune_afrique, target: 10 },
                  { label: 'Citations Financial Afrik', value: HBR_PIPELINE.citations_financial_afrik, target: 20 },
                  { label: 'Citations Ecofin', value: HBR_PIPELINE.citations_ecofin, target: 15 },
                  { label: 'Citations Académiques', value: HBR_PIPELINE.citations_academic, target: 20 },
                ].map(s => (
                  <div key={s.label} className="bg-background-50 rounded-lg border border-background-200/70 p-4">
                    <div className="text-2xl font-bold text-foreground-950 font-heading">{s.value}</div>
                    <div className="text-xs text-foreground-500 font-body">{s.label}</div>
                    <div className="text-[10px] text-foreground-400 font-body mt-1">Cible: {s.target}</div>
                  </div>
                ))}
              </div>
            </div>
          )}

          {activeTab === 'rapports' && (
            <div className="grid grid-cols-1 lg:grid-cols-3 gap-4">
              {/* List */}
              <div className="space-y-2">
                {HBR_SAMPLE_REPORTS.map(report => (
                  <button
                    key={report.id}
                    onClick={() => setSelectedReport(report)}
                    className={`w-full text-left p-4 rounded-lg border transition-all cursor-pointer ${
                      selectedReport.id === report.id
                        ? 'border-accent-300 bg-accent-50'
                        : 'border-background-200/70 bg-background-50 hover:border-background-300/60'
                    }`}
                  >
                    <StatutBadge statut={report.statut} />
                    <h3 className="text-xs font-semibold text-foreground-800 font-heading mt-2 line-clamp-3">{report.titre}</h3>
                    <div className="flex items-center gap-2 mt-2">
                      <span className="text-[10px] text-foreground-400 font-body">{report.score_qualite}/10</span>
                      <span className="text-[10px] text-foreground-400 font-body">·</span>
                      <span className="text-[10px] text-foreground-400 font-body">{report.mots.toLocaleString()} mots</span>
                    </div>
                  </button>
                ))}
              </div>

              {/* Detail */}
              <div className="lg:col-span-2 bg-background-50 rounded-xl border border-background-200/70 p-5">
                <div className="flex items-start justify-between gap-3 mb-3">
                  <h3 className="text-base font-bold text-foreground-950 font-heading">{selectedReport.titre}</h3>
                  <StatutBadge statut={selectedReport.statut} />
                </div>
                <div className="flex items-center gap-3 flex-wrap mb-4 text-xs text-foreground-500 font-body">
                  <span><strong>Secteur:</strong> {selectedReport.secteur}</span>
                  <span><strong>Audience:</strong> {selectedReport.audience}</span>
                  <span><strong>Score:</strong> {selectedReport.score_qualite}/10</span>
                  <span><strong>Sources:</strong> {selectedReport.sources_count}</span>
                  {selectedReport.date_pub && <span><strong>Pub:</strong> {selectedReport.date_pub}</span>}
                </div>
                {selectedReport.framework && (
                  <div className="mb-4 px-3 py-2 rounded-lg bg-accent-50 border border-accent-200">
                    <span className="text-xs font-semibold text-accent-700 font-body">
                      <i className="ri-award-line mr-1"></i>Framework: {selectedReport.framework}
                    </span>
                  </div>
                )}
                <div className="space-y-1">
                  {selectedReport.sections.map(sec => (
                    <div key={sec.num} className={`flex items-center gap-3 px-3 py-2 rounded-lg text-xs font-body ${sec.complete ? 'bg-emerald-50' : 'bg-amber-50'}`}>
                      <span className={`w-5 h-5 flex items-center justify-center rounded-full text-[10px] font-bold ${sec.complete ? 'bg-emerald-500 text-white' : 'bg-amber-400 text-white'}`}>{sec.num}</span>
                      <span className="flex-1 font-semibold text-foreground-700">{sec.titre}</span>
                      <span className="text-foreground-400">{sec.mots.toLocaleString()} mots</span>
                      {sec.complete ? <i className="ri-check-line text-emerald-500 text-xs"></i> : <i className="ri-time-line text-amber-500 text-xs"></i>}
                    </div>
                  ))}
                </div>
                {selectedReport.cites_by.length > 0 && (
                  <div className="mt-4 pt-3 border-t border-background-200/70">
                    <p className="text-xs font-semibold text-foreground-600 font-heading mb-2">Cité par:</p>
                    <div className="flex items-center gap-2 flex-wrap">
                      {selectedReport.cites_by.map(c => (
                        <span key={c} className="px-2 py-0.5 rounded-md text-[10px] bg-primary-50 text-primary-700 font-body">{c}</span>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            </div>
          )}

          {activeTab === 'frameworks' && (
            <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
              {HBR_FRAMEWORKS_PROPRIETARY.map(fw => (
                <div key={fw.nom} className="bg-background-50 rounded-lg border border-background-200/70 p-5">
                  <div className="w-10 h-10 flex items-center justify-center rounded-lg bg-accent-100 mb-3">
                    <i className="ri-award-line text-lg text-accent-600"></i>
                  </div>
                  <h3 className="text-sm font-bold text-foreground-800 font-heading mb-1">{fw.nom}</h3>
                  <p className="text-xs text-foreground-500 font-body mb-2">{fw.domaine}</p>
                  <div className="flex items-center justify-between text-[10px] text-foreground-400 font-body">
                    <span>v{fw.version}</span>
                    <span>{fw.rapports} rapports</span>
                  </div>
                </div>
              ))}
            </div>
          )}

          {activeTab === 'master_prompt' && (
            <div>
              <div className="flex items-center gap-2 mb-3">
                <span className="px-2 py-1 rounded-md text-xs font-semibold bg-accent-100 text-accent-700 font-body">Master Prompt P4</span>
                <span className="text-xs text-foreground-500 font-body">Gap P8 — Think Tank Big Four</span>
              </div>
              <pre className="text-xs text-foreground-700 font-body bg-background-100 rounded-xl p-5 border border-background-200/70 overflow-auto whitespace-pre-wrap leading-relaxed">
                {HBR_MASTER_PROMPT_PREVIEW}
              </pre>
              <div className="mt-4 p-4 rounded-lg bg-emerald-50 border border-emerald-200">
                <p className="text-xs text-emerald-800 font-body">
                  <strong>Usage:</strong> Ce prompt alimente le pipeline HBR — 9 sections obligatoires, 
                  indice fiabilité ≥95/100, score SEO ≥85/100. 
                  Génère un rapport complet en JSON → conversion PDF Weasyprint avec watermark Khepra Premium.
                </p>
              </div>
            </div>
          )}

          {activeTab === 'kpis' && (
            <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
              {Object.entries(HBR_KPI_TARGETS).map(([key, kpi]) => {
                const progress = Math.min(100, Math.round((kpi.current / kpi.target) * 100));
                const isExceeded = kpi.current >= kpi.target;
                return (
                  <div key={key} className="bg-background-50 rounded-lg border border-background-200/70 p-5">
                    <h3 className="text-sm font-semibold text-foreground-800 mb-1 font-heading capitalize">{key.replace(/_/g, ' ')}</h3>
                    <div className="flex items-baseline gap-2 mb-2">
                      <span className="text-2xl font-bold text-foreground-950 font-heading">{kpi.current}</span>
                      <span className="text-xs text-foreground-400 font-body">/ {kpi.target} {kpi.unit}</span>
                    </div>
                    <div className="w-full bg-background-200 rounded-full h-1.5 overflow-hidden">
                      <div
                        className={`h-1.5 rounded-full transition-all ${isExceeded ? 'bg-emerald-500' : 'bg-accent-500'}`}
                        style={{ width: `${progress}%` }}
                      ></div>
                    </div>
                    <p className={`text-[10px] font-body mt-1 ${isExceeded ? 'text-emerald-600 font-semibold' : 'text-foreground-400'}`}>
                      {isExceeded ? '✓ Cible atteinte' : `${progress}% vers objectif`}
                    </p>
                  </div>
                );
              })}
            </div>
          )}
        </div>
      </div>
    </KOSHubLayout>
  );
}
